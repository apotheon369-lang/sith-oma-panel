  source d = android.drawer
  source bat = android.battery every 2m
  source osSaver = android.modes   // event-driven; Android Battery Saver freezes ambient FX
  source ag = android.agents

  // App popup menu & UI interaction state
  state tapBounce = ""   // press-bounce: which tappable is held (springs back on release)
  state menu = ""
  state menuShortcuts = null
  state menuNaming = ""
  state tab = "personal"
  state pick = null
  state filterTab = "all"
  state creatingFolder = false
  state pressedBtn = ""

  // Persistent Folders, Favorites & Icon Customization state (preserves all existing user data)
  state folderMap = {} persist
  state customFolders = [] persist
  state folderOpen = ""
  state folderRenaming = false
  state favored = [] persist
  state fxEnabled = true persist      // drawer-local animation switch (persisted)
  state customizerOpen = false
  state iconSize = "md" persist       // "sm" | "md" | "lg" (3 icon sizes)
  state iconColor = "theme" persist   // "theme" | "crimson" | "ember" | "venom" | "cyber" | "revan" | "ice" (6 colors + theme auto)
  state iconShape = "circle" persist  // "circle" | "hex" | "diamond" | "square" | "shield" | "pentagon"
  state appColorMap = {} persist      // per-app color override
  state appSizeMap = {} persist       // per-app size override ("sm" | "md" | "lg")
  state shapeMap = {} persist         // per-app shape override
  state warp = 0   // scroll-warp energy: kicked to 1 when a drag turns into a scroll, decays to 0

  // Persistent Customization & Display options (single-source from hub.json)
  let rzBusy = (hub.busy ?? false) == true
  let rzRes = rzBusy ? 0.34 : 1
  let gpuRes = clamp(num(hub.res, 0.38), 0.25, 0.38)   // capped ≤0.38 full-screen shader resolution (<1ms GPU cost)
  let hubDr = hub.drawer ?? {}
  let showWork = (hubDr.showWork ?? true) == true
  let voice = hubDr.voice ?? "sith"
  let hubTex = hub.texture ?? "grid"
  let surfaceTex = hubTex == "none" ? "void" : hubTex
  let hubSurf = hub.surface ?? "obsidian"
  let cardSkin = hubSurf == "glass" ? "glass" : (hubSurf == "oled" ? "minimal" : "obsidian")
  let glowLvl = num(hub.glow, 1)
  let motion = (hub.fx ?? true) == false ? "still" : (num(hub.fxLevel, 1) >= 2 ? "storm" : "breathe")

  on hubDr.cellDp {
    let v = num(value, 80)
    iconSize = v <= 76 ? "sm" : (v >= 96 ? "lg" : "md")
  }

  // Master animation & eco gating (100% from hub.json)
  let saver = ((bat.level ?? 100) < 20 && !((bat.charging ?? false) == true)) || (osSaver.saver ?? false) == true   // low battery or Android Battery Saver: hold still instead of stutter
  let animMaster = (hub.fx ?? true) == true && !ecoOn && !saver
  let animHaptics = (hub.haptics ?? true) != false
  let animSpeed = clamp(num(hub.speed, 1.0), 0.25, 3.0)
  let drawerFxOn = animMaster && fxEnabled
  let effMotion = !drawerFxOn ? "still" : (motion == "still" ? "still" : (motion == "storm" || animSpeed >= 1.75 ? "storm" : "breathe"))
  // Icon shimmer: on by default; set "shimmer": false under "drawer" in hub.json to turn it off
  let shimOn = effMotion != "still" && !rzBusy && (hubDr.shimmer ?? true) == true
  let shimSpeed = clamp(num(hubDr.shimSpeed, 1), 0.3, 3)
  let shimCycle = 3.6   // seconds between glints on one icon
  let shimSweep = 0.9   // seconds the band takes to cross

  // ◈ ICON GLITCH (hub drawer.glitch 0 off / 1 subtle / 2 chaos) + SCROLL WARP (drawer.scrollFx 0/1/2)
  let fxLive = effMotion != "still" && !rzBusy
  let glitchLvl = fxLive ? clamp(num(hubDr.glitch, 1), 0, 2) : 0
  let scrollLvl = fxLive ? clamp(num(hubDr.scrollFx, 1), 0, 2) : 0
  let glCycle = glitchLvl >= 2 ? 2.6 : 5.2     // seconds between bursts on one icon
  let glBurst = glitchLvl >= 2 ? 0.45 : 0.28   // burst length
  let wMul = scrollLvl >= 2 ? 1.7 : 1
  let wLive = warp > 0.02
  let gTick = glitchLvl > 0 || wLive ? floor(time * 18) : 0   // stepped 18Hz noise clock
  let wTick = wLive ? gTick : 0                               // idle cells never wake at 18Hz when not scrolling
  let shimClock = shimOn ? time * animSpeed * shimSpeed : 0
  let glClock = glitchLvl > 0 ? time * animSpeed : 0
  let glCyan = #00e5ff

  // Strict <4ms adaptive FPS ladder (0 wakeups in still/eco, smooth 12fps ambient, 24fps active scroll warp)
  fps: (rzBusy || effMotion == "still") ? 1 : (wLive ? 24 : 12)

  every frame {
    if warp > 0.01 { warp = max(0, warp - dt * (scrollLvl >= 2 ? 0.95 : 1.4)) } else if warp != 0 { warp = 0 }
  }

  // Semantic 4-theme palette mapped directly from hub.tok
  let redAccent   = cPri
  let hotAccent   = cHot
  let labelTone   = cInk
  let mutedTone   = cMuted
  let darkCard    = cCard
  let deepSurface = cObs

  // Surface shader & glow parameters
  let texIdx = surfaceTex == "carbon" ? 1.0 : (surfaceTex == "hex" ? 2.0 : (surfaceTex == "void" ? 3.0 : 0.0))
  let glowAmp = ecoOn ? 0.45 : (glowLvl == 0 ? 0.42 : (glowLvl == 2 ? 1.48 : 1.0))
  let skinRadius = cardSkin == "cyber" ? 6 * corners : (cardSkin == "glass" ? 16 * corners : 13 * corners)
  let skinFrost = cardSkin == "glass" && !ecoOn ? 14 : 0
  let skinBorderW = cardSkin == "cyber" ? 1.4 : (cardSkin == "minimal" ? 0.6 : 1)

  // 6 Icon Colors + 3 Icon Sizes + 6 Icon Shapes (global drawer & per-app customization)
  let iconColorList = [
    {id: "crimson", lbl: str.colCrimson, pri: #ff1e3c, hot: #ff8596},
    {id: "ember",   lbl: str.colEmber,   pri: #ff9f1a, hot: #ffe07d},
    {id: "venom",   lbl: str.colVenom,   pri: #1aff5c, hot: #adff6e},
    {id: "cyber",   lbl: str.colCyber,   pri: #18d8ff, hot: #9ceeff},
    {id: "revan",   lbl: str.colRevan,   pri: #b44aff, hot: #e89eff},
    {id: "ice",     lbl: str.colIce,     pri: #eaf4ff, hot: #ffffff}
  ]
  let shapeMeta = ["circle", "hex", "diamond", "square", "shield", "pentagon"]
  let gColObj = iconColorList.find(c => c.id == iconColor)
  let gIconPri = gColObj != null ? gColObj.pri : redAccent
  let gIconHot = gColObj != null ? gColObj.hot : hotAccent

  // 3 Icon Sizes: Small (5-col compact), Medium (4-col balanced), Large (3-col showcase)
  let cellDp = iconSize == "sm" ? 72 : (iconSize == "lg" ? 120 : 92)
  let cols = max(1, floor(((screenWidth ?? 390) - 24) / cellDp))
  let iconPx = iconSize == "sm" ? 44 : (iconSize == "lg" ? 74 : 56)
  let labelSize = iconSize == "sm" ? 8.6 : (iconSize == "lg" ? 10.8 : 9.8)
  let labelTrack = iconSize == "sm" ? -0.22 : (iconSize == "lg" ? 0.0 : -0.1)
  let typed = trim(query)
  let searching = typed != ""

  // Strict A–Z Alphabetical Apps (no categories; folders preserved intact)
  let allApps = d.apps
  let mine = allApps.filter(a => (tab == "work") == (a.profile == "work"))
  let sortedApps = mine.sortBy(a => lower(a.name ?? ""))

  // Folders list (safely filters out null/empty ghost keys, sorted A–Z)
  let folderNames = unique(flatten([customFolders, values(folderMap)])).filter(n => n != null && n != "" && lower("${n}") != "null")
  let folders = folderNames.map(n => {key: "f:" + n, name: n, apps: allApps.filter(a => get(folderMap, a.key) == n)})
  let shownFolders = folders.sortBy(f => lower(f.name ?? ""))
  let folderCellRows = chunk(shownFolders, cols).map((cells, r) => {key: "fd:" + r, fcells: cells})

  // Favorites list (sorted A–Z)
  let favoredApps = sortedApps.filter(a => indexOf(favored, a.key) >= 0)
  let favoredRows = chunk(favoredApps, cols).map((cells, r) => {key: "fv:" + r, cells: cells})

  // Open folder view apps (sorted A–Z)
  let openFolderRaw = allApps.filter(a => get(folderMap, a.key) == folderOpen)
  let openFolderApps = openFolderRaw.sortBy(a => lower(a.name ?? ""))
  let folderRows = chunk(openFolderApps, cols).map((cells, r) => {key: "fo:" + r, cells: cells})

  // Single Alphabetical App Grid (all unfiled apps A–Z, zero categories)
  let unfiledApps = sortedApps.filter(a => get(folderMap, a.key, "") == "")
  let appGridRows = chunk(unfiledApps, cols).map((cells, r) => {key: "az:" + r, cells: cells})
  let mainAppSection = tab == "work"
    ? [{key: "h:work", cat: "", plain: d.work.paused ? str.workPaused : str.workApps, epithet: d.work.paused ? str.sithWorkPaused : str.sithWork, work: true, count: len(unfiledApps)}] + appGridRows
    : (len(unfiledApps) > 0
      ? (len(shownFolders) > 0 ? [{key: "h:all", cat: "", plain: str.allAppsAz, epithet: "", count: len(unfiledApps)}] + appGridRows : appGridRows)
      : [])

  // Filtered Grid Rows (ALL / FAVORITES / FOLDERS)
  let allRows = (len(shownFolders) > 0 ? [{key: "h:folders", cat: "folders", plain: str.folders, epithet: str.sithFolders, count: len(shownFolders)}] + folderCellRows : []) +
    mainAppSection

  let rows = filterTab == "fav"
    ? (len(favoredApps) > 0 ? [{key: "h:favored", cat: "favored", plain: str.favored, epithet: str.sithFavored, count: len(favoredApps)}] + favoredRows : [])
    : filterTab == "folders"
    ? (len(shownFolders) > 0 ? [{key: "h:folders", cat: "folders", plain: str.folders, epithet: str.sithFolders, count: len(shownFolders)}] + folderCellRows : [])
    : allRows

  // Search hits
  let hits = searching ? rank(allApps, typed) : []
  let hitRows = chunk(hits, cols).map((cells, r) => {key: "q:" + r, start: r * cols, cells: cells})
  let opens = len(hits) > 0 && strongMatch(hits[0], typed)
  let chosen = pick ?? (opens ? 0 : -1)
  let agent = ag.default
  let track = lang() == "zh" ? 0.4 : 1.4

  onKey: {
    if searching {
      pick = clamp(chosen + (value == "up" || value == "tab" ? 1 : -1), -1, len(hits) - 1)
    }
  }

  on typed { pick = null }

  opacity: 0.98
  enter: searching ? (chosen >= 0 ? "▸ " + str.open : "⏎ " + str.ask) : ""

  onSubmit: {
    if searching {
      if chosen >= 0 {
        open(hits[chosen].key)
      } else if !linux {
        launcher("linux")
      } else {
        ask(value)
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // 0-LOOP GPU AGSL OBSIDIAN CHAMBER BACKDROP (<0.25ms/frame, true AMOLED #000)
  // Supports 4 procedural textures (grid / carbon / hex / void), volumetric top
  // kyber bloom, rim edge rails, storm plasma arcs, filmic tonemap & anti-banding.
  // ═══════════════════════════════════════════════════════════════════════════
  component ChamberBackdrop(tVal, stormLvl, warpLvl = 0) {
    Box {
      fill: true; align: center; clip: true
      if false {
      Shader {
        // low-res render (hub.res), scaled up to fill: ~1/res^2 the GPU work
        width: (screenWidth ?? 420) * gpuRes; height: (screenHeight ?? 900) * gpuRes; scale: 1 / gpuRes
        fallback: linear(0, 0, 0, 1, [alpha(redAccent, 0.06 * glowAmp), #000000, #000000])
        uniforms: { uRes: rzRes,
          uT: tVal,
          uCol: redAccent,
          uHot: hotAccent,
          uTex: texIdx,
          uGlow: glowAmp,
          uStorm: stormLvl,
          uWarp: warpLvl
        }
        code: """
            uniform float uRes;
          uniform float uT;
          uniform half4 uCol;
          uniform half4 uHot;
          uniform float uTex;
          uniform float uGlow;
          uniform float uStorm;
          uniform float uWarp;

          float hash12(float2 p) {
            float3 p3 = fract(float3(p.xyx) * 0.1031);
            p3 += dot(p3, p3.yzx + 33.33);
            return fract((p3.x + p3.y) * p3.z);
          }

          // 0-loop analytical hex grid edge distance
          float hexEdge(float2 p) {
            const float2 s = float2(1.0, 1.7320508);
            float2 a = mod(p, s) - s * 0.5;
            float2 b = mod(p - s * 0.5, s) - s * 0.5;
            float2 g = dot(a, a) < dot(b, b) ? a : b;
            float2 ag = abs(g);
            float d = max(dot(ag, normalize(s)), ag.x);
            return 0.5 - d;
          }

          half4 main(float2 p) {
              p = (floor(p * uRes) + 0.5) / uRes;
            float2 safe = max(size, float2(1.0));
            float2 uv = p / safe;
            float aspect = safe.x / safe.y;
            float dpr = max(1.0, safe.x / 380.0);

            // 1. True AMOLED pure black base
            half3 col = half3(0.0);
            half3 acc = uCol.rgb;
            half3 hot = uHot.rgb;

            // 2. Volumetric top obsidian chamber bloom (around Seal & Header)
            float2 topD = float2((uv.x - 0.24) * aspect * 1.15, (uv.y - 0.03) * 1.75);
            float topBloom = exp(-dot(topD, topD) * 4.4);
            float2 topWide = float2((uv.x - 0.50) * aspect * 0.85, (uv.y - 0.0) * 2.1);
            float headerSheen = exp(-dot(topWide, topWide) * 2.8);
            float breath = 0.88 + 0.12 * sin(uT * 1.45);
            col += acc * half((topBloom * 0.24 + headerSheen * 0.13) * uGlow * breath);
            col += hot * half(topBloom * 0.06 * uGlow * breath);

            // Subtle lower depth glow
            float botGlow = exp(-((1.0 - uv.y) * 3.8) * ((1.0 - uv.y) * 3.8));
            col += acc * half(botGlow * 0.055 * uGlow);

            // 3. Procedural GPU Surface Texture (0 loops!)
            float texEnergy = 0.0;
            if (uTex < 0.5) {
              // GRID: Precision tactical dot-grid + 4x4 major reticles
              float stepPx = 22.0 * dpr;
              float2 cell = mod(p + stepPx * 0.5, stepPx) - stepPx * 0.5;
              float r = 0.95 * dpr;
              float dotM = 1.0 - smoothstep(r - 0.55, r + 0.55, length(cell));
              float2 idx = floor((p + stepPx * 0.5) / stepPx);
              float isMaj = step(mod(abs(idx.x) + 0.5, 4.0), 1.0)
                          * step(mod(abs(idx.y) + 0.5, 4.0), 1.0);
              float cross = (1.0 - smoothstep(0.0, 1.1 * dpr, abs(cell.x))) * (1.0 - smoothstep(3.0 * dpr, 4.5 * dpr, abs(cell.y)))
                          + (1.0 - smoothstep(0.0, 1.1 * dpr, abs(cell.y))) * (1.0 - smoothstep(3.0 * dpr, 4.5 * dpr, abs(cell.x)));
              texEnergy = dotM * (0.045 + isMaj * 0.075) + isMaj * min(cross, 1.0) * 0.032;
            } else if (uTex < 1.5) {
              // CARBON: Diagonal woven carbon-fiber micro-hatch + anisotropic sheen
              float sc = 1.0 / (4.5 * dpr);
              float d1 = sin((p.x + p.y) * sc);
              float d2 = sin((p.x - p.y) * sc);
              float weave = smoothstep(0.15, 0.85, d1 * d2 * 0.5 + 0.5);
              float diagBand = exp(-((uv.x * 0.7 + uv.y * 0.5 - 0.42) * 3.2) * ((uv.x * 0.7 + uv.y * 0.5 - 0.42) * 3.2));
              texEnergy = weave * (0.028 + diagBand * 0.055);
            } else if (uTex < 2.5) {
              // HEX: Analytical obsidian hex lattice
              float hexScale = 26.0 * dpr;
              float he = hexEdge(p / hexScale);
              float lineM = 1.0 - smoothstep(0.015, 0.068, he);
              float pulse = 0.75 + 0.25 * sin(uv.y * 7.0 - uT * 1.6);
              texEnergy = lineM * 0.055 * pulse;
            }
            // uTex >= 2.5 => VOID (pure AMOLED pitch black, texEnergy = 0)

            // Modulate texture visibility subtly by top/edge light so deep center stays true AMOLED
            float texMask = 0.42 + 0.58 * clamp(headerSheen * 1.4 + botGlow * 0.7 + (1.0 - abs(uv.x - 0.5) * 2.0) * 0.25, 0.0, 1.0);
            col += mix(acc, hot, half(0.28)) * half(texEnergy * texMask * (0.65 + 0.45 * uGlow));

            // 4. Precision Left/Right Edge Plasma Bevel Rails
            float edgeDist = min(p.x, safe.x - p.x) / dpr;
            float rimLine = exp(-edgeDist * 0.55);
            float rimGlow = exp(-edgeDist * 0.065);
            col += acc * half((rimGlow * 0.065 + rimLine * 0.14) * uGlow);

            // 5. Living Motion: Breathing sweep + Storm plasma arcs (0 loops!)
            if (uStorm > 0.05) {
              float sweepY = fract(uT * 0.11);
              float dy = (uv.y - sweepY) * 7.5;
              float scan = exp(-(dy * dy)) * 0.055 * uGlow * uStorm;

              // Storm lateral plasma crackle along outer rails
              if (uStorm > 0.65) {
                float phase = mod(uT, 4.4);
                float flash = phase < 0.38 ? (1.0 - phase / 0.38) : (phase > 2.2 && phase < 2.52 ? (1.0 - (phase - 2.2) / 0.32) : 0.0);
                float jitter = sin(uv.y * 34.0 + floor(uT * 14.0) * 3.7) * 6.0 * dpr
                             + cos(uv.y * 71.0 - floor(uT * 14.0) * 5.1) * 3.0 * dpr;
                float arcD = abs(min(p.x, safe.x - p.x) - (10.0 * dpr + jitter));
                float arcCore = exp(-arcD * (0.48 / dpr)) * flash * uGlow;
                float arcHalo = exp(-arcD * (0.11 / dpr)) * flash * 0.35 * uGlow;
                col += acc * half(arcHalo) + hot * half(arcCore * 0.85);
              }
            }

            // 6. Soft Filmic Reinhard Tonemap + Anti-Banding OLED Dither
            col = col / (half3(1.0) + half(0.42) * col);
            half dither = half((hash12(p) - 0.5) * 0.004);
            col = col * half(0.22);
            col = max(col - half3(0.012), half3(0.0));

            // 7. SCROLL WARP (0 loops): torn horizontal bands, RGB tear streaks, rolling scanlines
            if (uWarp > 0.01) {
              float tk = floor(uT * 22.0);
              float band = floor(uv.y * 56.0);
              float rb = hash12(float2(band, tk));
              float tear = step(1.0 - 0.32 * uWarp, rb);
              float xr = hash12(float2(band + 7.0, tk));
              float streak = tear * smoothstep(0.0, 0.25, abs(uv.x - xr)) * (1.0 - smoothstep(0.25, 0.9, abs(uv.x - xr)));
              half3 tearCol = rb > 0.5 ? half3(0.0, 0.9, 1.0) : hot;
              col += tearCol * half(streak * uWarp * 0.22);
              float scanl = 0.5 + 0.5 * sin(p.y * 1.4 - uT * 60.0);
              col += acc * half(scanl * uWarp * 0.035);
              col *= half(1.0 - 0.25 * uWarp * step(0.93, hash12(float2(tk, 3.0))));   // frame drop flicker
            }
            col = clamp(col + dither, half3(0.0), half3(1.0));
            return half4(col, half(1.0));
          }
        """
      }
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // 4-MODE ADAPTIVE HEADER SEAL — Infernal / Future / Mask / Skeletor (Havoc Ram-Skull)
  // ═══════════════════════════════════════════════════════════════════════════
  component Seal(animOn) {
    Canvas {
      size: 46
      let cx = width / 2
      let cy = height / 2 + 1
      let r = min(width, height) * 0.32
      let pulse = animOn ? 0.5 + 0.5 * sin(time * 1.6 * animSpeed) : 0.5
      circle(cx, cy, r * 1.52, fill: radial(cx, cy, r * 1.52, [alpha(cPri, (0.24 + pulse * 0.16) * glowAmp), alpha(#000000, 0)]))
      circle(cx, cy, r * 1.12, stroke: alpha(cPri, 0.58 + pulse * 0.34), width: 1.35)
      circle(cx, cy, r * 0.94, stroke: alpha(cHot, 0.24), width: 0.7)
      // Cardinal precision ticks (no rotate() matrix overhead)
      line(cx, cy - r * 1.28, cx, cy - r * 1.06, stroke: cHot, width: 1.3, cap: round)
      line(cx, cy + r * 1.06, cx, cy + r * 1.28, stroke: cHot, width: 1.3, cap: round)
      line(cx - r * 1.28, cy, cx - r * 1.06, cy, stroke: alpha(cPri, 0.8), width: 1.2, cap: round)
      line(cx + r * 1.06, cy, cx + r * 1.28, cy, stroke: alpha(cPri, 0.8), width: 1.2, cap: round)

      if curMode == "skeletor" {
        // HAVOC RAM-SKULL: curled ram horns + faceted bone-ivory ram skull + blazing arcane crystal
        path([[cx - r * 0.28, cy - r * 0.34], [cx - r * 0.76, cy - r * 0.84], [cx - r * 1.04, cy - r * 0.32], [cx - r * 0.86, cy + r * 0.22], [cx - r * 0.56, cy + r * 0.08], [cx - r * 0.72, cy - r * 0.28], [cx - r * 0.44, cy - r * 0.06]], closed: true, fill: cDim, stroke: cHot, width: 1.0)
        path([[cx + r * 0.28, cy - r * 0.34], [cx + r * 0.76, cy - r * 0.84], [cx + r * 1.04, cy - r * 0.32], [cx + r * 0.86, cy + r * 0.22], [cx + r * 0.56, cy + r * 0.08], [cx + r * 0.72, cy - r * 0.28], [cx + r * 0.44, cy - r * 0.06]], closed: true, fill: cDim, stroke: cHot, width: 1.0)
        path([[cx, cy - r * 0.58], [cx + r * 0.46, cy - r * 0.20], [cx + r * 0.34, cy + r * 0.36], [cx, cy + r * 0.74], [cx - r * 0.34, cy + r * 0.36], [cx - r * 0.46, cy - r * 0.20]], closed: true, fill: cBone, stroke: cObs, width: 1.05)
        // Recessed eye sockets + blazing forehead amethyst crystal
        path([[cx - r * 0.32, cy - r * 0.06], [cx - r * 0.09, cy + r * 0.04], [cx - r * 0.24, cy + r * 0.16]], closed: true, fill: cObs)
        path([[cx + r * 0.32, cy - r * 0.06], [cx + r * 0.09, cy + r * 0.04], [cx + r * 0.24, cy + r * 0.16]], closed: true, fill: cObs)
        circle(cx, cy - r * 0.24, r * 0.16, fill: cSec)
        circle(cx, cy - r * 0.24, r * 0.06, fill: #ffffff)
        line(cx - r * 0.18, cy + r * 0.44, cx + r * 0.18, cy + r * 0.44, stroke: cObs, width: 1.1, cap: round)
      } else if curMode == "future" {
        // ULTRON HEX VISOR: armored Stark hexagon + angled dual cyber visor + energy core
        path([[cx, cy - r * 0.74], [cx + r * 0.64, cy - r * 0.37], [cx + r * 0.64, cy + r * 0.37], [cx, cy + r * 0.74], [cx - r * 0.64, cy + r * 0.37], [cx - r * 0.64, cy - r * 0.37]], closed: true, fill: cObs, stroke: cPri, width: 1.25)
        path([[cx - r * 0.44, cy - r * 0.14], [cx - r * 0.08, cy - r * 0.02], [cx - r * 0.16, cy + r * 0.10], [cx - r * 0.40, cy + r * 0.02]], closed: true, fill: cHot)
        path([[cx + r * 0.44, cy - r * 0.14], [cx + r * 0.08, cy - r * 0.02], [cx + r * 0.16, cy + r * 0.10], [cx + r * 0.40, cy + r * 0.02]], closed: true, fill: cHot)
        path([[cx - r * 0.26, cy + r * 0.30], [cx, cy + r * 0.44], [cx + r * 0.26, cy + r * 0.30]], stroke: cSec, width: 1.2, cap: round)
        circle(cx, cy - r * 0.36, r * 0.11, fill: cBone)
      } else if curMode == "mask" {
        // CYBER-MASK VORTEX: triple vortex blades + neon mask silhouette + Zoot-gold grin
        path([[cx - r * 0.74, cy - r * 0.46], [cx - r * 0.18, cy - r * 0.76], [cx + r * 0.48, cy - r * 0.52]], stroke: alpha(cHot, 0.85), width: 1.25, cap: round)
        path([[cx + r * 0.76, cy - r * 0.16], [cx + r * 0.56, cy + r * 0.56], [cx - r * 0.16, cy + r * 0.76]], stroke: alpha(cPri, 0.9), width: 1.25, cap: round)
        path([[cx - r * 0.46, cy - r * 0.48], [cx, cy - r * 0.64], [cx + r * 0.46, cy - r * 0.48], [cx + r * 0.38, cy + r * 0.36], [cx, cy + r * 0.64], [cx - r * 0.38, cy + r * 0.36]], closed: true, fill: cObs, stroke: cPri, width: 1.15)
        path([[cx - r * 0.28, cy - r * 0.12], [cx - r * 0.08, cy - r * 0.04], [cx - r * 0.22, cy + r * 0.06]], closed: true, fill: cHot)
        path([[cx + r * 0.28, cy - r * 0.12], [cx + r * 0.08, cy - r * 0.04], [cx + r * 0.22, cy + r * 0.06]], closed: true, fill: cHot)
        path([[cx - r * 0.26, cy + r * 0.22], [cx, cy + r * 0.38], [cx + r * 0.26, cy + r * 0.22]], stroke: cSec, width: 1.6, cap: round)
      } else {
        // INFERNAL: Horned Sith Crest
        path([[cx - r * 0.42, cy - r * 0.2], [cx - r * 0.96, cy - r * 1.06], [cx - r * 0.62, cy - r * 0.02]], closed: true, fill: alpha(cPri, 0.35), stroke: cPri, width: 0.9)
        path([[cx + r * 0.42, cy - r * 0.2], [cx + r * 0.96, cy - r * 1.06], [cx + r * 0.62, cy - r * 0.02]], closed: true, fill: alpha(cPri, 0.35), stroke: cPri, width: 0.9)
        path([[cx - r * 0.5, cy - r * 0.42], [cx, cy - r * 0.64], [cx + r * 0.5, cy - r * 0.42], [cx + r * 0.42, cy + r * 0.42], [cx, cy + r * 0.66], [cx - r * 0.42, cy + r * 0.42]], closed: true, fill: deepSurface, stroke: cPri, width: 1.1)
        path([[cx - r * 0.25, cy - r * 0.03], [cx + r * 0.25, cy - r * 0.03], [cx + r * 0.17, cy + r * 0.11], [cx - r * 0.17, cy + r * 0.11]], closed: true, fill: cPri)
        rect(cx - 0.8, cy + r * 0.19, 1.6, r * 0.28, radius: 0.7, fill: cHot)
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // MINI SHAPE & FOLDER VECTOR BADGES (font-independent crisp Canvas shapes)
  // ═══════════════════════════════════════════════════════════════════════════
  component CatBadge(cat, sz = 14, col = hotAccent) {
    Canvas {
      size: sz
      let cx = width / 2
      let cy = height / 2
      let r = min(width, height) * 0.42
      if cat == "folders" {
        let w = width * 0.43
        let h = height * 0.34
        path([[cx - w, cy - h * 0.92], [cx - w * 0.12, cy - h * 0.92], [cx + w * 0.16, cy - h * 0.46], [cx + w, cy - h * 0.46], [cx + w, cy + h * 0.88], [cx - w, cy + h * 0.88]], closed: true, fill: alpha(col, 0.18), stroke: col, width: 1.25)
        line(cx - w * 0.55, cy + h * 0.22, cx + w * 0.55, cy + h * 0.22, stroke: col, width: 1.15, cap: round)
      } else if cat == "hex" {
        path([[cx - r * 0.52, cy - r * 0.90], [cx + r * 0.52, cy - r * 0.90], [cx + r * 1.04, cy], [cx + r * 0.52, cy + r * 0.90], [cx - r * 0.52, cy + r * 0.90], [cx - r * 1.04, cy]], closed: true, fill: alpha(col, 0.16), stroke: col, width: 1.25)
      } else if cat == "circle" {
        circle(cx, cy, r * 0.94, fill: alpha(col, 0.16), stroke: col, width: 1.25)
      } else if cat == "diamond" {
        path([[cx, cy - r * 1.06], [cx + r * 1.06, cy], [cx, cy + r * 1.06], [cx - r * 1.06, cy]], closed: true, fill: alpha(col, 0.16), stroke: col, width: 1.25)
      } else if cat == "square" {
        rect(cx - r * 0.84, cy - r * 0.84, r * 1.68, r * 1.68, radius: 2, fill: alpha(col, 0.16), stroke: col, width: 1.25)
      } else if cat == "shield" {
        path([[cx - r * 0.86, cy - r * 0.84], [cx + r * 0.86, cy - r * 0.84], [cx + r * 0.86, cy + r * 0.08], [cx, cy + r * 1.06], [cx - r * 0.86, cy + r * 0.08]], closed: true, fill: alpha(col, 0.16), stroke: col, width: 1.25)
      } else {
        path([[cx, cy - r * 1.02], [cx + r * 0.98, cy - r * 0.22], [cx + r * 0.64, cy + r * 0.92], [cx - r * 0.64, cy + r * 0.92], [cx - r * 0.98, cy - r * 0.22]], closed: true, fill: alpha(col, 0.16), stroke: col, width: 1.25)
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // CUSTOMIZABLE TRAY SIGIL — 6 shapes, 6 colors + theme auto, 3 sizes (<4ms!)
  // ═══════════════════════════════════════════════════════════════════════════
  component TraySigil(src, sz, lbl = "", ini = "", isFav = false, shape = "circle", priCol = redAccent, hotCol = hotAccent) {
    let gk = hash(lbl + ini)
    let gPh = glitchLvl > 0 ? (glClock + gk * glCycle) % glCycle : 99
    let gI = max(gPh < glBurst ? (glitchLvl >= 2 ? 1 : 0.6) : 0, wLive ? warp * (scrollLvl >= 2 ? 1 : 0.65) : 0)
    let gOn = gI > 0.04
    let n1 = gOn ? hash(gk, gTick) - 0.5 : 0
    let n2 = gOn ? hash(gk, gTick, 1) - 0.5 : 0
    let n3 = gOn ? hash(gk, gTick, 2) - 0.5 : 0
    let n4 = gOn ? hash(gk, gTick, 3) : 0.5
    let sliceY = gOn ? round(n3 * sz * 0.62) : 0
    let glyph = round(sz * 0.45)
    let iconOffY = shape == "pentagon" ? 1.5 : (shape == "shield" ? -1.0 : 0)
    let shU = shimOn ? clamp((((shimClock + gk * shimCycle) % shimCycle) / shimSweep), 0, 1) : 0
    let shLive = shimOn && shU > 0 && shU < 1
    Box {
      size: sz
      align: center
      offset: gOn ? [round(n1 * 5 * gI), round(n2 * 2.5 * gI)] : [0, 0]
      scale: gOn && n4 > 0.82 ? 1 + 0.09 * gI : 1
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) * 0.42
        let haloA = clamp((isFav ? 0.22 : 0.13) * glowAmp, 0.06, 0.34)
        let stCol = alpha(priCol, isFav ? 0.94 : 0.74)
        let stW = isFav ? 1.55 : 1.25
        let bgFill = alpha(deepSurface, 0.84)
        circle(cx, cy, r * 1.12, fill: alpha(priCol, haloA * 0.48))

        if shape == "hex" {
          path([[cx - r * 0.52, cy - r * 0.90], [cx + r * 0.52, cy - r * 0.90], [cx + r * 1.04, cy], [cx + r * 0.52, cy + r * 0.90], [cx - r * 0.52, cy + r * 0.90], [cx - r * 1.04, cy]], closed: true, fill: bgFill, stroke: stCol, width: stW)
          line(cx - r * 1.14, cy, cx - r * 0.95, cy, stroke: hotCol, width: 1.4, cap: round)
          line(cx + r * 0.95, cy, cx + r * 1.14, cy, stroke: hotCol, width: 1.4, cap: round)
        } else if shape == "diamond" {
          path([[cx, cy - r * 1.10], [cx + r * 1.10, cy], [cx, cy + r * 1.10], [cx - r * 1.10, cy]], closed: true, fill: bgFill, stroke: stCol, width: stW)
          circle(cx, cy - r * 1.10, 1.5, fill: hotCol)
          circle(cx, cy + r * 1.10, 1.5, fill: hotCol)
        } else if shape == "square" {
          rect(cx - r * 0.88, cy - r * 0.88, r * 1.76, r * 1.76, radius: 4, fill: bgFill, stroke: stCol, width: stW)
          line(cx - r * 0.30, cy - r * 0.88, cx + r * 0.30, cy - r * 0.88, stroke: hotCol, width: 1.8, cap: round)
        } else if shape == "shield" {
          path([[cx - r * 0.88, cy - r * 0.84], [cx + r * 0.88, cy - r * 0.84], [cx + r * 0.88, cy + r * 0.10], [cx, cy + r * 1.08], [cx - r * 0.88, cy + r * 0.10]], closed: true, fill: bgFill, stroke: stCol, width: stW)
          line(cx - r * 0.32, cy - r * 0.84, cx + r * 0.32, cy - r * 0.84, stroke: hotCol, width: 1.8, cap: round)
        } else if shape == "pentagon" {
          path([[cx, cy - r * 1.04], [cx + r * 0.99, cy - r * 0.24], [cx + r * 0.64, cy + r * 0.92], [cx - r * 0.64, cy + r * 0.92], [cx - r * 0.99, cy - r * 0.24]], closed: true, fill: bgFill, stroke: stCol, width: stW)
          line(cx - r * 0.28, cy + r * 0.92, cx + r * 0.28, cy + r * 0.92, stroke: hotCol, width: 1.8, cap: round)
        } else {
          circle(cx, cy, r * 0.98, fill: bgFill, stroke: stCol, width: stW)
          line(cx, cy - r * 1.10, cx, cy - r * 0.90, stroke: hotCol, width: 1.4, cap: round)
          line(cx, cy + r * 0.90, cx, cy + r * 1.10, stroke: hotCol, width: 1.4, cap: round)
        }
      }
      // RGB-split ghosts (cyan left / hot right): nodes exist only during a burst or scroll warp
      if (glitchLvl > 0 || scrollLvl > 0) && gOn {
        if src != null {
          Image { src: src; size: glyph; tint: glCyan; opacity: gOn ? 0.55 : 0; offset: [round(-(1.5 + abs(n1) * 7) * gI), round(n2 * 2 * gI + iconOffY)] }
          Image { src: src; size: glyph; tint: hotCol; opacity: gOn ? 0.6 : 0; offset: [round((1.5 + abs(n2) * 7) * gI), round(-n1 * 2 * gI + iconOffY)] }
        } else {
          Text { font: dispFont; text: ini; fontSize: round(sz * 0.26); color: glCyan; bold: true; align: center; opacity: gOn ? 0.55 : 0; offset: [round(-(1.5 + abs(n1) * 7) * gI), iconOffY] }
          Text { font: dispFont; text: ini; fontSize: round(sz * 0.26); color: hotCol; bold: true; align: center; opacity: gOn ? 0.6 : 0; offset: [round((1.5 + abs(n2) * 7) * gI), iconOffY] }
        }
      }
      if src != null {
        Image { src: src; size: glyph; tint: isFav ? hotCol : priCol; label: lbl; offset: [0, iconOffY]; opacity: gOn && n4 < 0.12 ? 0.25 : 1 }
      } else {
        Text { font: dispFont; text: ini; fontSize: round(sz * 0.26); color: isFav ? hotCol : priCol; bold: true; align: center; offset: [0, iconOffY]; opacity: gOn && n4 < 0.12 ? 0.25 : 1 }
      }
      if (glitchLvl > 0 || scrollLvl > 0) && gOn {
        Box {
          width: round(sz * 0.86); height: max(3, round(sz * 0.12)); clip: true; align: center
          offset: [round(n1 * sz * 0.34 * gI), sliceY]
          opacity: gOn && n4 > 0.3 ? 1 : 0
          background: alpha(n4 > 0.65 ? glCyan : hotCol, 0.16)
          if src != null {
            Image { src: src; size: glyph; tint: n4 > 0.65 ? glCyan : cBone; offset: [0, iconOffY - sliceY] }
          } else {
            Text { font: dispFont; text: ini; fontSize: round(sz * 0.26); color: cBone; bold: true; align: center; offset: [0, iconOffY - sliceY] }
          }
        }
      }
      if shLive {
        Box {
          size: round(sz * 0.56); radius: round(sz * 0.28); clip: true; align: center
          let u = shU
          Box {
            width: round(sz * 0.22); height: round(sz * 0.90)
            rotation: 22
            offset: [round((-0.65 + 1.3 * u) * sz), 0]
            opacity: u > 0 && u < 1 ? 1 : 0
            background: linear(0, 0, 1, 0, [alpha(hotCol, 0), alpha(cBone, isFav ? 0.44 : 0.30), alpha(hotCol, 0)])
          }
        }
      }
    }
  }

  // App icon with glowing favorite star coin or notification dot
  component AppIcon(a, isFav = false, icPri = gIconPri, icHot = gIconHot, icShape = iconShape, icPx = iconPx) {
    Box {
      size: iconPx
      align: center
      TraySigil { src: a.hasIcon ? a.icon : null; sz: icPx; lbl: a.label; ini: a.initials; isFav: isFav; shape: icShape; priCol: icPri; hotCol: icHot }
      if isFav {
        Box {
          size: iconPx
          align: topEnd
          Box {
            size: 16
            radius: 8
            offset: [2, -2]
            background: linear(0, 0, 1, 1, [alpha(icPri, 0.18), deepSurface, #000000, alpha(cSec, 0.10)])
            border: 1.2
            borderColor: icHot
            align: center
            Text { font: uiFont; text: "★"; fontSize: 9; color: icHot }
          }
        }
      }
      if a.dot && !isFav {
        Box {
          size: iconPx
          align: topEnd
          Box {
            size: 11
            radius: 6
            offset: [-1, 1]
            background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), icHot, #000000, alpha(icPri, 0.09)])
            border: 2
            borderColor: deepSurface
          }
        }
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // APP CELL — Skin-aware obsidian tile + upgraded Long-Press Context Popup
  // (Zero per-cell `time` binding for strict <4ms/frame!)
  // ═══════════════════════════════════════════════════════════════════════════
  component Cell(a, picked) {
    let isFav = indexOf(favored, a.key) >= 0
    let ovColId = get(appColorMap, a.key, "")
    let ovColObj = ovColId != "" ? iconColorList.find(c => c.id == ovColId) : null
    let icPri = ovColObj != null ? ovColObj.pri : gIconPri
    let icHot = ovColObj != null ? ovColObj.hot : gIconHot
    let icShape = get(shapeMap, a.key, "") != "" ? get(shapeMap, a.key, "") : iconShape
    let ovSz = get(appSizeMap, a.key, "")
    let icPx = ovSz == "sm" ? round(iconPx * 0.80) : (ovSz == "lg" ? round(iconPx * 1.14) : iconPx)
    // Per-app duotone: each tile gets its own stable pairing of the theme's two contrasting colors
    let hv = hash(a.key)
    let tileA = hv < 0.34 ? icPri : hv < 0.67 ? cSec : icPri
    let tileB = hv < 0.34 ? cSec : hv < 0.67 ? icPri : icHot
    Box {
      scale: tapBounce == a.key ? 0.9 : 1
      offset: [0, tapBounce == a.key ? -4 : 0]
      animate scale: spring(0.32, 520)
      animate offset: spring(0.32, 520)
      onPress: tapBounce = a.key
      onRelease: {
        tapBounce = ""
        if scrollLvl > 0 { warp = 1 }   // release-to-scroll (or lift) kicks the scroll warp
      }
      weight: 1
      radius: skinRadius
      clip: true
      frost: skinFrost
      border: picked ? 1.8 : (isFav ? max(skinBorderW, 1.2) : skinBorderW)
      borderColor: picked ? icHot : isFav ? alpha(icPri, clamp(0.45 * glowAmp, 0.25, 0.85)) : (cardSkin == "minimal" ? alpha(icPri, 0.08) : alpha(icPri, cardSkin == "cyber" ? 0.30 : 0.16))
      background: picked
        ? linear(0, 0, 1, 1, [alpha(icPri, 0.32), alpha(darkCard, 0.90)])
        : cardSkin == "minimal"
        ? (isFav ? alpha(darkCard, 0.42) : transparent)
        : cardSkin == "glass"
        ? linear(0, 0, 0, 1, [alpha(darkCard, isFav ? 0.66 : 0.50), alpha(deepSurface, isFav ? 0.76 : 0.60)])
        : cardSkin == "cyber"
        ? linear(hv < 0.5 ? 0 : 1, 0, hv < 0.5 ? 1 : 0, 1, [alpha(tileA, isFav ? 0.26 : 0.16), #000000, #000000, alpha(tileB, isFav ? 0.22 : 0.13)])
        : linear(hv < 0.5 ? 0 : 1, 0, hv < 0.5 ? 1 : 0, 1, [alpha(tileA, isFav ? 0.22 : 0.12), alpha(darkCard, 0.6), #000000, alpha(tileB, isFav ? 0.18 : 0.10)])
      opacity: a.paused ? 0.38 : 1
      onTap: open(a.key)
      onLongPress: {
        if animHaptics { haptic() }
        menuShortcuts = null
        menuNaming = ""
        menu = a.key
        menuShortcuts = shortcuts(a.key)
      }

      // Top specular glass-obsidian highlight hairline on favorite / cyber / picked cells
      if cardSkin == "cyber" || picked || isFav {
        Box {
          fill: width
          height: cardSkin == "cyber" || picked ? 2 : 1.5
          background: picked
            ? linear(0, 0, 1, 0, [alpha(icPri, 0.0), icHot, cBone, icHot, alpha(icPri, 0.0)])
            : isFav
            ? linear(0, 0, 1, 0, [alpha(icPri, 0.0), alpha(icPri, 0.55), icHot, alpha(cBone, 0.85), alpha(icPri, 0.55), alpha(icPri, 0.0)])
            : linear(0, 0, 1, 0, [alpha(icPri, 0.0), alpha(icPri, 0.9), alpha(icPri, 0.0)])
        }
      }

      Column {
        fill: width
        align: center
        gap: 4
        padding: [2, 7]
        // SCROLL WARP: cells shear sideways, tilt and flicker while the drawer is flung (0 wakeups when wLive == false)
        offset: wLive ? [round((hash(a.key, wTick) - 0.5) * 20 * warp * wMul), round((hash(a.key, wTick, 1) - 0.5) * 7 * warp * wMul)] : [0, 0]
        rotation: wLive ? (hv - 0.5) * 9 * warp * wMul : 0
        opacity: wLive && hash(a.key, wTick, 2) < 0.14 * warp * wMul ? 0.3 : 1

        AppIcon { a: a; isFav: isFav; icPri: icPri; icHot: icHot; icShape: icShape; icPx: icPx }

        Text {
          font: bodyFont
          text: upper(a.name ?? "")
          fontSize: labelSize
          letterSpacing: labelTrack
          align: center
          maxLines: 2
          minLines: 2
          fill: width
          color: warp > 0.25 && hash(a.key, wTick, 3) < 0.35 ? (hash(a.key, wTick, 4) < 0.5 ? glCyan : icHot) : (picked ? #ffffff : isFav ? icHot : labelTone)
          offset: warp > 0.25 ? [round((hash(a.key, wTick, 5) - 0.5) * 8 * warp * wMul), 0] : [0, 0]
        }

        // ─── UPGRADED LONG-PRESS CONTEXT MENU POPUP (lazy-mounted only when open) ───
        Popup {
          visible: menu == a.key && menuShortcuts != null
          position: above
          onDismiss: { menu = ""; menuNaming = "" }
          width: 266
          gap: 0
          background: linear(0, 0, 1, 1, [alpha(icPri, 0.13), deepSurface, #000000, alpha(cSec, 0.10)])
          border: 1.3
          borderColor: alpha(icPri, 0.82)
          radius: 14 * corners

          if menu == a.key && menuShortcuts != null {
            // Top Plasma Accent Bar
            Spacer { height: 2.5; fill: width; background: linear(0, 0, 1, 0, [alpha(icPri, 0.1), icHot, alpha(icPri, 0.1)]) }

            // App Identity Header inside Context Menu
            Row {
              fill: width
              align: center
              gap: 10
              padding: [12, 10]
              background: linear(0, 0, 1, 0, [alpha(icPri, 0.18), alpha(darkCard, 0.85)])
              Box {
                size: 32
                align: center
                CatBadge { cat: icShape; sz: 32; col: icPri }
                if a.hasIcon {
                  Image { src: a.icon; size: 16; tint: icHot; label: a.label }
                } else {
                  Text { font: uiFont; text: a.initials; fontSize: 10; color: icHot; bold: true }
                }
              }
              Column {
                weight: 1
                gap: 1
                Text { font: uiFont; text: upper(a.name ?? ""); fontSize: 12; color: #ffffff; maxLines: 1; fontWeight: "bold"; letterSpacing: 0.6 }
                Text { font: uiFont; text: upper(a.kind ?? "app") + (isFav ? " · ★ FAV" : ""); fontSize: 9; color: icHot; letterSpacing: 0.8; maxLines: 1 }
              }
            }

            Spacer { height: 1; fill: width; background: alpha(icPri, 0.3) }

            // Per-App Icon Customization: 6 Colors + 3 Sizes + 6 Shapes
            Column {
              fill: width
              gap: 6
              padding: [12, 8, 12, 8]
              Text { font: uiFont; text: "◈ " + upper(str.iconColor); color: icHot; fontSize: 9; letterSpacing: 1.1 }
              Row {
                fill: width
                gap: 5
                for col in iconColorList key col.id {
                  let cSel = ovColId == col.id
                  Box {
                    weight: 1
                    height: 26
                    radius: 7 * corners
                    background: cSel ? alpha(col.pri, 0.32) : alpha(darkCard, 0.78)
                    border: cSel ? 1.4 : 0.8
                    borderColor: cSel ? col.hot : alpha(col.pri, 0.45)
                    align: center
                    onTap: {
                      if animHaptics { haptic() }
                      appColorMap = cSel ? remove(appColorMap, a.key) : set(appColorMap, a.key, col.id)
                    }
                    Box { size: 12; radius: 6; background: col.pri; border: 1; borderColor: col.hot }
                  }
                }
              }
              Row {
                fill: width
                gap: 5
                align: center
                Text { font: uiFont; text: upper(str.iconSize); color: mutedTone; fontSize: 8.5; letterSpacing: 0.9; width: 64 }
                for szOpt in [{id: "sm", lbl: "S"}, {id: "md", lbl: "M"}, {id: "lg", lbl: "L"}] key szOpt.id {
                  let sSel = ovSz == szOpt.id
                  Box {
                    weight: 1
                    height: 24
                    radius: 6 * corners
                    background: sSel ? alpha(icPri, 0.32) : alpha(darkCard, 0.78)
                    border: sSel ? 1.2 : 0.8
                    borderColor: sSel ? icHot : alpha(icPri, 0.28)
                    align: center
                    onTap: {
                      if animHaptics { haptic() }
                      appSizeMap = sSel ? remove(appSizeMap, a.key) : set(appSizeMap, a.key, szOpt.id)
                    }
                    Text { font: bodyFont; text: szOpt.lbl; fontSize: 9.5; bold: true; color: sSel ? #ffffff : labelTone; align: center }
                  }
                }
              }
              Row {
                fill: width
                gap: 5
                for shId in shapeMeta key shId {
                  let shSel = get(shapeMap, a.key, "") == shId
                  Box {
                    weight: 1
                    height: 26
                    radius: 7 * corners
                    background: shSel ? alpha(icPri, 0.30) : alpha(darkCard, 0.78)
                    border: shSel ? 1.2 : 0.8
                    borderColor: shSel ? icHot : alpha(icPri, 0.28)
                    align: center
                    onTap: {
                      if animHaptics { haptic() }
                      shapeMap = shSel ? remove(shapeMap, a.key) : set(shapeMap, a.key, shId)
                    }
                    CatBadge { cat: shId; sz: 15; col: shSel ? #ffffff : icHot }
                  }
                }
              }
            }

            Spacer { height: 1; fill: width; background: alpha(icPri, 0.25) }

          // App Shortcuts
          for s in menuShortcuts key s.key {
            Row {
              scale: tapBounce == "2${hash(a, picked)}${s.key}" ? 0.9 : 1
              offset: [0, tapBounce == "2${hash(a, picked)}${s.key}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "2${hash(a, picked)}${s.key}"
              onRelease: tapBounce = ""
              fill: width
              align: center
              gap: 10
              padding: [12, 9]
              onTap: { if animHaptics { haptic() }; menu = ""; open(s.key) }
              Image { src: s.icon; size: 20; tint: d.monochrome ? redAccent : null; label: s.name }
              Text { font: uiFont; text: s.name; fontSize: 12; weight: 1; maxLines: 1; color: labelTone }
              Text {
                scale: tapBounce == "3${hash(a, picked)}${s.key}" ? 0.9 : 1
                offset: [0, tapBounce == "3${hash(a, picked)}${s.key}" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "3${hash(a, picked)}${s.key}"
                onRelease: tapBounce = ""
                font: uiFont
                text: "+PIN"
                fontSize: 9
                color: hotAccent
                padding: [6, 3]
                radius: 6 * corners
                background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(redAccent, 0.18), #000000, alpha(cSec, 0.11)])
                border: 0.8
                borderColor: alpha(redAccent, 0.5)
                onTap: { if animHaptics { haptic() }; menu = ""; appAction("pin", s.key) }
              }
            }
          }
          Spacer { visible: len(menuShortcuts) > 0; height: 1; fill: width; background: alpha(redAccent, 0.25) }

          // Standard App Actions with crisp vector glyph badges
          for w in a.actions {
            Row {
              scale: tapBounce == "4${hash(a, picked)}" ? 0.9 : 1
              offset: [0, tapBounce == "4${hash(a, picked)}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "4${hash(a, picked)}"
              onRelease: tapBounce = ""
              fill: width
              align: center
              gap: 10
              padding: [12, 9]
              onTap: { if animHaptics { haptic() }; menu = ""; appAction(w, a.key) }
              Text {
                font: uiFont
                text: w == "pin" ? "◈" : w == "info" ? "ⓘ" : (w == "uninstall" || w == "remove") ? "✕" : w == "edit" ? "✎" : "↗"
                fontSize: 13
                color: (w == "uninstall" || w == "remove") ? hotAccent : redAccent
              }
              Text { font: uiFont; text: upper(get(str, w, w)); fontSize: 12; letterSpacing: 0.5; weight: 1; color: labelTone }
            }
          }

          Spacer { height: 1; fill: width; background: alpha(redAccent, 0.25) }

          // FAVORITES TOGGLE ROW
          Row {
            scale: tapBounce == "5${hash(a, picked)}" ? 0.9 : 1
            offset: [0, tapBounce == "5${hash(a, picked)}" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "5${hash(a, picked)}"
            onRelease: tapBounce = ""
            fill: width
            align: center
            gap: 10
            padding: [12, 10]
            background: isFav ? alpha(redAccent, 0.20) : transparent
            onTap: {
              if animHaptics { haptic() }
              menu = ""
              favored = isFav ? favored.filter(k => k != a.key) : flatten([favored, [a.key]])
            }
            Text { font: uiFont; text: isFav ? "★" : "☆"; color: hotAccent; fontSize: 15 }
            Text { font: uiFont; text: upper(isFav ? str.unfavor : str.favor); fontSize: 12; color: isFav ? #ffffff : labelTone; weight: 1; letterSpacing: 0.5 }
            Text {
              font: uiFont
              text: isFav ? "ON" : "ADD"
              fontSize: 9
              color: isFav ? #ffffff : hotAccent
              letterSpacing: 0.6
              padding: [6, 2]
              radius: 6 * corners
              background: isFav ? alpha(redAccent, 0.35) : alpha(redAccent, 0.12)
              border: 0.8
              borderColor: alpha(redAccent, isFav ? 0.8 : 0.35)
            }
          }

          Spacer { height: 1; fill: width; background: alpha(redAccent, 0.25) }

          // FOLDERS FILING SECTION
          Row {
            fill: width
            padding: [12, 8, 12, 4]
            align: center
            Text { font: uiFont; text: "◈ " + upper(str.folders); color: hotAccent; fontSize: 10; letterSpacing: 1.2; weight: 1 }
          }

          for f in folders key f.key {
            let inFld = get(folderMap, a.key, "") == f.name
            Row {
              scale: tapBounce == "6${hash(a, picked)}${f.key}" ? 0.9 : 1
              offset: [0, tapBounce == "6${hash(a, picked)}${f.key}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "6${hash(a, picked)}${f.key}"
              onRelease: tapBounce = ""
              fill: width
              align: center
              gap: 8
              padding: [12, 8]
              background: inFld ? alpha(redAccent, 0.22) : transparent
              onTap: { if animHaptics { haptic() }; menu = ""; folderMap = set(folderMap, a.key, f.name) }
              Text { font: uiFont; text: inFld ? "◆" : "◇"; color: inFld ? hotAccent : redAccent; fontSize: 12 }
              Text { font: uiFont; text: upper(f.name); fontSize: 12; weight: 1; maxLines: 1; color: inFld ? #ffffff : labelTone }
              Text { font: uiFont; text: "✓"; visible: inFld; color: hotAccent; fontSize: 12 }
            }
          }

          // New folder row
          Row {
            scale: tapBounce == "7${hash(a, picked)}" ? 0.9 : 1
            offset: [0, tapBounce == "7${hash(a, picked)}" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "7${hash(a, picked)}"
            onRelease: tapBounce = ""
            fill: width
            align: center
            gap: 8
            padding: [12, 8]
            onTap: { if animHaptics { haptic() }; menuNaming = a.key }
            Text { font: uiFont; text: "+"; color: hotAccent; fontSize: 15 }
            Text { font: uiFont; text: upper(str.newFolder); fontSize: 11.5; color: redAccent; letterSpacing: 0.5; weight: 1 }
          }

          Row {
            visible: menuNaming == a.key
            fill: width
            gap: 6
            padding: [12, 4, 12, 10]
            Input {
              weight: 1
              placeholder: str.folderName
              underline: false
              background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), darkCard, #000000, alpha(cSec, 0.10)])
              border: 1.2
              borderColor: redAccent
              radius: 8 * corners
              padding: [10, 6]
              color: #ffffff
              onSubmit: {
                let n = trim(value)
                if n != "" {
                  folderMap = set(folderMap, a.key, n)
                  if indexOf(customFolders, n) < 0 {
                    customFolders = flatten([customFolders, [n]])
                  }
                }
                menu = ""
                menuNaming = ""
              }
            }
          }

          // Remove from folder option
          Row {
            scale: tapBounce == "8${hash(a, picked)}" ? 0.9 : 1
            offset: [0, tapBounce == "8${hash(a, picked)}" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "8${hash(a, picked)}"
            onRelease: tapBounce = ""
            visible: get(folderMap, a.key, "") != ""
            fill: width
            align: center
            gap: 8
            padding: [12, 8, 12, 11]
            onTap: { if animHaptics { haptic() }; menu = ""; folderMap = remove(folderMap, a.key) }
            Text { font: uiFont; text: "✕"; color: hotAccent; fontSize: 12 }
            Text { font: uiFont; text: upper(str.unfile); fontSize: 11.5; color: hotAccent; weight: 1 }
          }
          }
        }
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // UNIVERSAL FUTURISTIC FOLDER ICON — Same sleek cyber-dossier silhouette across
  // every theme, dynamically lit by the active theme's Kyber/AMOLED tokens.
  // ═══════════════════════════════════════════════════════════════════════════
  component FuturisticFolder(sz, count = 0, animOn = false) {
    Canvas {
      size: sz
      let cx = width / 2
      let cy = height / 2
      let w = width * 0.40
      let h = height * 0.31
      let pulse = animOn ? 0.5 + 0.5 * sin(time * 2.4 * animSpeed) : 0.5

      // 1. Ambient under-glow halo
      circle(cx, cy + h * 0.06, w * 1.26, fill: radial(cx, cy + h * 0.06, w * 1.26, [alpha(cPri, clamp((0.22 + pulse * 0.10) * glowAmp, 0.10, 0.44)), alpha(#000000, 0)]))

      // 2. Back dossier chassis with 45° angled cyber tab
      path([
        [cx - w, cy + h * 0.72],
        [cx - w, cy - h * 0.82],
        [cx - w * 0.86, cy - h * 0.98],
        [cx - w * 0.14, cy - h * 0.98],
        [cx + w * 0.12, cy - h * 0.58],
        [cx + w * 0.88, cy - h * 0.58],
        [cx + w, cy - h * 0.40],
        [cx + w, cy + h * 0.72],
        [cx + w * 0.84, cy + h * 0.92],
        [cx - w * 0.84, cy + h * 0.92]
      ], closed: true, fill: alpha(deepSurface, 0.92), stroke: alpha(cPri, 0.78), width: 1.25)

      // Glowing top-left tab status accent
      line(cx - w * 0.76, cy - h * 0.78, cx - w * 0.24, cy - h * 0.78, stroke: hotAccent, width: 1.4, cap: round)

      // 3. Recessed data sheet edge (visible when folder contains apps)
      if count > 0 {
        line(cx - w * 0.74, cy - h * 0.40, cx + w * 0.76, cy - h * 0.40, stroke: alpha(cBone, 0.72), width: 1.15, cap: round)
      }

      // 4. Stepped futuristic front cyber-pocket plate with chamfered base
      path([
        [cx - w * 1.02, cy - h * 0.18],
        [cx - w * 0.22, cy - h * 0.18],
        [cx - w * 0.04, cy - h * 0.32],
        [cx + w * 1.02, cy - h * 0.32],
        [cx + w * 1.02, cy + h * 0.72],
        [cx + w * 0.84, cy + h * 0.94],
        [cx - w * 0.84, cy + h * 0.94],
        [cx - w * 1.02, cy + h * 0.72]
      ], closed: true, fill: linear(cx, cy - h * 0.32, cx, cy + h * 0.94, [alpha(cPri, 0.24), alpha(darkCard, 0.94), alpha(deepSurface, 0.98)]), stroke: cPri, width: 1.45)

      // 5. Minimalist glowing visor slit & core lock node
      line(cx - w * 0.56, cy + h * 0.32, cx + w * 0.56, cy + h * 0.32, stroke: alpha(hotAccent, count > 0 ? 0.90 : 0.48), width: 1.45, cap: round)
      if count > 0 {
        circle(cx, cy + h * 0.32, 4.2, fill: alpha(cSec, 0.30))
        circle(cx, cy + h * 0.32, 2.3, fill: cBone)
      } else {
        circle(cx, cy + h * 0.32, 1.8, fill: hotAccent)
      }
    }
  }

  component FolderCell(f) {
    Box {
      scale: tapBounce == "9${hash(f)}" ? 0.9 : 1
      offset: [0, tapBounce == "9${hash(f)}" ? -4 : 0]
      animate scale: spring(0.32, 520)
      animate offset: spring(0.32, 520)
      onPress: tapBounce = "9${hash(f)}"
      onRelease: tapBounce = ""
      weight: 1
      radius: skinRadius
      clip: true
      frost: skinFrost
      background: linear(0, 0, 1, 1, [alpha(redAccent, 0.14), alpha(darkCard, 0.84), alpha(deepSurface, 0.94)])
      border: 1.2
      borderColor: alpha(redAccent, clamp(0.42 * glowAmp, 0.25, 0.80))
      onTap: { if animHaptics { haptic() }; folderOpen = f.name }

      // Top plasma edge strip
      Box {
        fill: width
        height: 2
        background: linear(0, 0, 1, 0, [alpha(redAccent, 0.0), hotAccent, alpha(redAccent, 0.0)])
      }

      Column {
        fill: width
        align: center
        gap: 4
        padding: [4, 7]
        FuturisticFolder { sz: iconPx; count: len(f.apps); animOn: effMotion == "storm" }
        Text { font: bodyFont; text: upper(f.name ?? ""); fontSize: labelSize; letterSpacing: labelTrack; align: center; maxLines: 2; minLines: 2; fill: width; color: #ffffff }
        Row {
          align: center
          padding: [7, 1.5]
          radius: 8 * corners
          background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(redAccent, 0.24), #000000, alpha(cPri, 0.09)])
          border: 0.8
          borderColor: alpha(redAccent, 0.55)
          Text { font: bodyFont; text: "${len(f.apps)}"; color: hotAccent; fontSize: 9.5; bold: true }
        }
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // ZERO-COST SECTION HEADER — Static glowing beam with bone-ivory specular glint
  // ═══════════════════════════════════════════════════════════════════════════
  component SectionHead(plain, epithet = "", work = false, offer = false, count = null, cat = "") {
    let title = voice == "sith" && epithet != "" ? upper("${plain} · ${epithet}") : upper(plain)
    Column {
      gap: 4
      fill: width
      padding: [2, 10, 2, 4]
      // Subtle top specular glass hairline
      Box {
        fill: width
        height: 1
        background: linear(0, 0, 1, 0, [alpha(cPri, 0.0), alpha(cHot, 0.36), alpha(cBone, 0.45), alpha(cPri, 0.0)])
      }
      Row {
        fill: width
        gap: 6
        align: center
        if cat == "favored" {
          Text { font: uiFont; text: "★"; color: hotAccent; fontSize: 11.5 }
        } else if cat != "" {
          CatBadge { cat: cat; sz: 15; col: hotAccent }
        } else {
          Text { font: dispFont; text: tc.glyph ?? "✦"; color: hotAccent; fontSize: 11 }
        }
        Text { font: dispFont; text: title; color: labelTone; letterSpacing: track; fontSize: 11.5; weight: 1; maxLines: 1; fontWeight: "bold" }
        if count != null && count > 0 {
          Text {
            font: bodyFont
            text: "${count}"
            color: hotAccent
            fontSize: 9.5
            padding: [6, 1.5]
            radius: 6 * corners
            background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(redAccent, 0.16), #000000, alpha(cSec, 0.11)])
            border: 0.8
            borderColor: alpha(redAccent, 0.42)
          }
        }
        if work == true {
          Text {
            scale: tapBounce == "10${hash(plain, epithet, work, offer, count)}" ? 0.9 : 1
            offset: [0, tapBounce == "10${hash(plain, epithet, work, offer, count)}" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "10${hash(plain, epithet, work, offer, count)}"
            onRelease: tapBounce = ""
            font: bodyFont
            text: upper(d.work.paused ? str.turnOn : str.pause)
            fontSize: 9.5
            color: #ffffff
            padding: [7, 2.5]
            radius: 8 * corners
            background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(redAccent, 0.22), #000000, alpha(cSec, 0.10)])
            border: 1
            borderColor: redAccent
            onTap: { if animHaptics { haptic() }; workApps("toggle") }
          }
        }
        if offer == true {
          Text {
            scale: tapBounce == "11${hash(plain, epithet, work, offer, count)}" ? 0.9 : 1
            offset: [0, tapBounce == "11${hash(plain, epithet, work, offer, count)}" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "11${hash(plain, epithet, work, offer, count)}"
            onRelease: tapBounce = ""
            font: bodyFont
            text: upper(d.linux == "installing" ? str.installing : str.installLinux)
            fontSize: 9.5
            color: #ffffff
            padding: [7, 2.5]
            radius: 8 * corners
            background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(redAccent, 0.22), #000000, alpha(cPri, 0.09)])
            border: 1
            borderColor: redAccent
            onTap: { if animHaptics { haptic() }; launcher("linux") }
          }
        }
      }
      // Precision obsidian energy beam with bone-tipped specular glint (zero Canvas/frame cost)
      Box {
        fill: width
        height: 1.5
        background: linear(0, 0, 1, 0, [alpha(cPri, 0.04), alpha(cPri, 0.65), cHot, alpha(cBone, 0.88), alpha(cPri, 0.35), alpha(cPri, 0.02)])
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // ROOT CHAMBER STACK
  // ═══════════════════════════════════════════════════════════════════════════
  Box {
    fill: true

    // GPU AGSL Textured Obsidian Chamber (0 wakeups in still mode, 0 loops, zero extra full-screen overdraw passes!)
    ChamberBackdrop { tVal: effMotion == "still" ? 0.0 : time * animSpeed; stormLvl: effMotion == "still" ? 0.0 : (effMotion == "storm" ? 1.0 : 0.35); warpLvl: clamp(warp * wMul, 0, 1.7) }

    Column {
      fill: true
      gap: 0
      padding: [10, 0]

      // ─── COMMAND HEADER BANNER ───
      Row {
        visible: !searching && folderOpen == ""
        fill: width
        align: center
        padding: [2, 10, 2, 6]
        gap: 10
        Seal { animOn: effMotion != "still" }
        Column {
          weight: 1
          gap: 2
          Row {
            align: center
            gap: 6
            Text { font: dispFont; text: tc.vaultTitle ?? str.vault; color: redAccent; letterSpacing: track + 0.4; fontSize: 14; maxLines: 1; fontWeight: "bold" }
            Text {
              font: bodyFont
              text: "${len(mine)} · ★${len(favoredApps)}"
              fontSize: 8.5
              maxLines: 1
              color: curMode == "mask" ? cSec : curMode == "skeletor" ? cBone : hotAccent
              letterSpacing: 0.3
              padding: [5, 1.5]
              radius: 6 * corners
              background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(redAccent, 0.16), #000000, alpha(cSec, 0.11)])
              border: 0.8
              borderColor: alpha(curMode == "mask" ? cSec : curMode == "skeletor" ? cBone : redAccent, 0.55)
            }
          }
          Text { font: bodyFont; text: tc.vaultMotto ?? upper(str.motto); color: mutedTone; letterSpacing: track * 0.7; fontSize: 9.5; maxLines: 1 }
        }

        // ◈ FX SWITCH — toggles all drawer animations on/off (persisted)
        Row {
          height: 38
          padding: [10, 0]
          gap: 5
          align: center
          radius: 19 * corners
          background: fxEnabled
            ? linear(0, 0, 1, 1, [alpha(cPri, 0.24), alpha(darkCard, 0.92), #000000, alpha(cSec, 0.14)])
            : alpha(darkCard, 0.78)
          scale: pressedBtn == "fx" ? 0.92 : 1.0
          animate scale: spring(0.7, 480)
          border: 1
          borderColor: fxEnabled ? alpha(hotAccent, 0.75) : alpha(mutedTone, 0.32)
          onPress: pressedBtn = "fx"
          onRelease: pressedBtn = ""
          onTap: { if animHaptics { haptic() }; fxEnabled = !fxEnabled; if !fxEnabled { warp = 0 } }
          Box {
            size: 7
            radius: 4
            background: fxEnabled ? hotAccent : alpha(mutedTone, 0.35)
          }
          Text {
            font: bodyFont
            text: fxEnabled ? "FX" : "OFF"
            fontSize: 10.5
            bold: true
            letterSpacing: 1.0
            color: fxEnabled ? #ffffff : mutedTone
            maxLines: 1
          }
        }

        // ◈ HUB — all customization lives in the Command Deck hub
        Box {
          height: 38
          width: 64
          radius: 19 * corners
          background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(darkCard, 0.92), #000000, alpha(cSec, 0.10)])
          scale: pressedBtn == "hub" ? 0.92 : 1.0
          animate scale: spring(0.7, 480)
          border: 1
          borderColor: alpha(redAccent, 0.55)
          align: center
          onPress: pressedBtn = "hub"
          onRelease: pressedBtn = ""
          onTap: { if animHaptics { haptic() }; run("owl-send 25-sith-command-deck.owl set forgeReq $(date +%s%N)"); launcher("page:0") }
          Text { font: bodyFont; text: "◈ HUB"; fontSize: 11; bold: true; letterSpacing: 1.0; color: hotAccent; align: center }
        }

        // ⚙ LAUNCHER SETTINGS ORB
        Box {
          size: 38
          radius: 19 * corners
          background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(darkCard, 0.92), #000000, alpha(cPri, 0.09)])
          scale: pressedBtn == "settings" ? 0.92 : 1.0
          animate scale: spring(0.7, 480)
          border: 1
          borderColor: alpha(redAccent, 0.55)
          align: center
          onPress: pressedBtn = "settings"
          onRelease: pressedBtn = ""
          onTap: { if animHaptics { haptic() }; launcher("settings") }
          Image { src: gear; size: 19; tint: redAccent; label: str.settings }
          Box { visible: d.updates > 0; align: topEnd; size: 38; padding: 5; Box { size: 8; radius: 4; background: hotAccent; border: 1.5; borderColor: deepSurface } }
        }
      }

      // ─── INTERACTIVE FILTER PILL BAR & QUICK FOLDER ACTION ───
      Row {
        visible: !searching && folderOpen == ""
        fill: width
        align: center
        padding: [2, 2, 2, 6]
        gap: 4

        for ft in [{id: "all", lbl: str.filterAll, ic: "◈"}, {id: "fav", lbl: str.filterFav, ic: "★"}, {id: "folders", lbl: str.filterFolders, ic: "◆"}] {
          let fAct = filterTab == ft.id
          Row {
            align: center
            gap: 3
            padding: [7, 5]
            radius: 11 * corners
            background: fAct ? alpha(redAccent, 0.26) : alpha(darkCard, 0.78)
            animate background: tween(160ms, "out")
            scale: pressedBtn == ("f:" + ft.id) ? 0.94 : 1.0
            animate scale: spring(0.7, 480)
            border: 1
            borderColor: fAct ? hotAccent : alpha(redAccent, 0.26)
            onPress: pressedBtn = "f:" + ft.id
            onRelease: pressedBtn = ""
            onTap: { if animHaptics { haptic() }; filterTab = ft.id }
            if ft.id == "folders" {
              CatBadge { cat: "folders"; sz: 12; col: fAct ? hotAccent : redAccent }
            } else {
              Text { font: bodyFont; text: ft.ic; fontSize: 9; color: fAct ? hotAccent : redAccent }
            }
            Text { font: bodyFont; text: upper(ft.lbl); fontSize: 9.5; letterSpacing: 0.4; color: fAct ? #ffffff : labelTone; bold: fAct; maxLines: 1 }
          }
        }

        Spacer { weight: 1 }

        // Inline Icon Style Customizer toggle (3 Sizes · 6 Colors · 6 Shapes)
        Text {
          font: bodyFont
          text: "◈ " + upper(str.customize)
          fontSize: 9
          letterSpacing: 0.4
          color: customizerOpen ? #ffffff : hotAccent
          bold: true
          maxLines: 1
          padding: [7, 5]
          radius: 11 * corners
          background: customizerOpen ? alpha(redAccent, 0.30) : alpha(darkCard, 0.78)
          animate background: tween(160ms, "out")
          scale: pressedBtn == "style" ? 0.94 : 1.0
          animate scale: spring(0.7, 480)
          border: 1
          borderColor: customizerOpen ? hotAccent : alpha(redAccent, 0.38)
          onPress: pressedBtn = "style"
          onRelease: pressedBtn = ""
          onTap: { if animHaptics { haptic() }; customizerOpen = !customizerOpen }
        }

        // Quick + FOLDER pill
        Text {
          font: bodyFont
          text: "+ DIR"
          fontSize: 9
          letterSpacing: 0.4
          color: creatingFolder ? #ffffff : hotAccent
          bold: true
          maxLines: 1
          padding: [7, 5]
          radius: 11 * corners
          background: creatingFolder ? alpha(redAccent, 0.30) : alpha(darkCard, 0.78)
          animate background: tween(160ms, "out")
          scale: pressedBtn == "newfld" ? 0.94 : 1.0
          animate scale: spring(0.7, 480)
          border: 1
          borderColor: creatingFolder ? hotAccent : alpha(redAccent, 0.38)
          onPress: pressedBtn = "newfld"
          onRelease: pressedBtn = ""
          onTap: { if animHaptics { haptic() }; creatingFolder = !creatingFolder }
        }
      }

      // ─── INLINE ICON CUSTOMIZER PANEL (3 SIZES · 6 COLORS · 6 SHAPES) ───
      if customizerOpen && !searching && folderOpen == "" {
        Column {
          fill: width
          gap: 8
          padding: [12, 10]
          radius: 14 * corners
          background: linear(0, 0, 1, 1, [alpha(gIconPri, 0.14), alpha(darkCard, 0.92), alpha(deepSurface, 0.96)])
          border: 1
          borderColor: alpha(gIconPri, 0.45)

          // 3 ICON SIZES (Small / Medium / Large)
          Row {
            fill: width
            align: center
            gap: 8
            Text { font: bodyFont; text: "◈ " + upper(str.iconSize); fontSize: 9.5; letterSpacing: 1.0; color: gIconHot; bold: true; width: 82 }
            Row {
              weight: 1
              gap: 5
              for szOpt in [{id: "sm", lbl: str.sizeSm}, {id: "md", lbl: str.sizeMd}, {id: "lg", lbl: str.sizeLg}] key szOpt.id {
                let sAct = iconSize == szOpt.id
                Box {
                  weight: 1
                  padding: [0, 6]
                  radius: 9 * corners
                  background: sAct ? alpha(gIconPri, 0.32) : alpha(deepSurface, 0.85)
                  animate background: tween(160ms, "out")
                  border: 1
                  borderColor: sAct ? gIconHot : alpha(gIconPri, 0.28)
                  align: center
                  onTap: { if animHaptics { haptic() }; iconSize = szOpt.id }
                  Text { font: bodyFont; text: upper(szOpt.lbl); fontSize: 9.5; letterSpacing: 0.7; color: sAct ? #ffffff : labelTone; bold: sAct; align: center }
                }
              }
            }
          }

          // 6 ICON COLORS (tap active again to return to Theme Auto)
          Column {
            fill: width
            gap: 5
            Row {
              fill: width
              align: center
              Text { font: bodyFont; text: "◈ " + upper(str.iconColor); fontSize: 9.5; letterSpacing: 1.0; color: gIconHot; bold: true; weight: 1 }
              Text { font: bodyFont; text: iconColor == "theme" ? upper(str.themeAuto) : upper(gColObj != null ? gColObj.lbl : iconColor); fontSize: 8.5; letterSpacing: 0.8; color: mutedTone }
            }
            Row {
              fill: width
              gap: 5
              for col in iconColorList key col.id {
                let cAct = iconColor == col.id
                Box {
                  weight: 1
                  padding: [0, 6]
                  radius: 9 * corners
                  background: cAct ? alpha(col.pri, 0.28) : alpha(deepSurface, 0.85)
                  animate background: tween(160ms, "out")
                  border: cAct ? 1.4 : 0.9
                  borderColor: cAct ? col.hot : alpha(col.pri, 0.42)
                  align: center
                  onTap: { if animHaptics { haptic() }; iconColor = cAct ? "theme" : col.id }
                  Column {
                    align: center
                    gap: 3
                    Box { size: 14; radius: 7; background: col.pri; border: 1.2; borderColor: col.hot }
                    Text { font: bodyFont; text: upper(col.lbl); fontSize: 7.5; letterSpacing: 0.3; color: cAct ? #ffffff : mutedTone; maxLines: 1; align: center }
                  }
                }
              }
            }
          }

          // 6 ICON SHAPES
          Row {
            fill: width
            align: center
            gap: 8
            Text { font: bodyFont; text: "◈ " + upper(str.iconShape); fontSize: 9.5; letterSpacing: 1.0; color: gIconHot; bold: true; width: 82 }
            Row {
              weight: 1
              gap: 5
              for shId in shapeMeta key shId {
                let shAct = iconShape == shId
                Box {
                  weight: 1
                  height: 28
                  radius: 8 * corners
                  background: shAct ? alpha(gIconPri, 0.30) : alpha(deepSurface, 0.85)
                  border: shAct ? 1.2 : 0.8
                  borderColor: shAct ? gIconHot : alpha(gIconPri, 0.28)
                  align: center
                  onTap: { if animHaptics { haptic() }; iconShape = shId }
                  CatBadge { cat: shId; sz: 15; col: shAct ? #ffffff : gIconHot }
                }
              }
            }
          }
        }
        Spacer { height: 6 }
      }

      // Personal / Work Profile Switcher (only shown when work profile is available & enabled)
      Row {
        visible: d.work != null && showWork && !searching && folderOpen == ""
        fill: width
        gap: 6
        padding: [2, 0, 2, 6]
        for t in ["personal", "work"] {
          let tAct = tab == t
          Box {
            scale: tapBounce == ("12:" + t) ? 0.9 : 1
            offset: [0, tapBounce == ("12:" + t) ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "12:" + t
            onRelease: tapBounce = ""
            weight: 1
            padding: [10, 6]
            radius: 10 * corners
            background: tAct ? alpha(redAccent, 0.24) : alpha(darkCard, 0.65)
            animate background: tween(160ms, "out")
            border: 1
            borderColor: tAct ? hotAccent : alpha(redAccent, 0.2)
            align: center
            onTap: { if animHaptics { haptic() }; tab = t }
            Text { font: bodyFont; text: upper(get(str, t)); fontSize: 11; letterSpacing: 1.0; color: tAct ? #ffffff : mutedTone; bold: tAct }
          }
        }
      }

      // Inline Quick-Create Folder Input Bar
      Row {
        visible: creatingFolder && !searching && folderOpen == ""
        fill: width
        align: center
        gap: 6
        padding: [2, 2, 2, 8]
        Input {
          weight: 1
          placeholder: str.folderName
          underline: false
          clear: true
          background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), darkCard, #000000, alpha(cSec, 0.11)])
          border: 1.2
          borderColor: hotAccent
          radius: 10 * corners
          padding: [12, 7]
          color: #ffffff
          onSubmit: {
            let n = trim(value)
            if n != "" && indexOf(customFolders, n) < 0 {
              customFolders = flatten([customFolders, [n]])
              if animHaptics { haptic() }
            }
            creatingFolder = false
          }
        }
        Text {
          scale: tapBounce == "13" ? 0.9 : 1
          offset: [0, tapBounce == "13" ? -4 : 0]
          animate scale: spring(0.32, 520)
          animate offset: spring(0.32, 520)
          onPress: tapBounce = "13"
          onRelease: tapBounce = ""
          font: bodyFont
          text: "✕"
          fontSize: 11
          color: hotAccent
          padding: [10, 8]
          radius: 10 * corners
          background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(redAccent, 0.24), #000000, alpha(cSec, 0.10)])
          border: 1
          borderColor: alpha(redAccent, 0.6)
          onTap: creatingFolder = false
        }
      }

      // ─── EMPTY STATE CARD (when Favorites or Folders filter has 0 items) ───
      Box {
        visible: !searching && folderOpen == "" && len(rows) == 0
        weight: 1
        fill: width
        align: center
        Column {
          align: center
          gap: 6
          padding: [24, 22]
          radius: 16 * corners
          background: linear(0, 0, 1, 1, [alpha(darkCard, 0.85), alpha(deepSurface, 0.92)])
          border: 1
          borderColor: alpha(redAccent, 0.38)
          if filterTab == "fav" {
            Text { font: dispFont; text: "☆"; fontSize: 28; color: hotAccent }
          } else {
            FuturisticFolder { sz: 44; count: 0; animOn: false }
          }
          Text { font: dispFont; text: filterTab == "fav" ? str.emptyFav : str.emptyFld; fontSize: 13; letterSpacing: 1.2; color: #ffffff; bold: true }
          Text { font: bodyFont; text: filterTab == "fav" ? str.emptyFavSub : str.emptyFldSub; fontSize: 9.5; letterSpacing: 0.6; color: mutedTone; align: center }
        }
      }

      // ─── MAIN VIRTUALIZED APP GRID LIST ───
      Column {
        visible: !searching && folderOpen == "" && len(rows) > 0
        lazy: true
        onRelease: { if scrollLvl > 0 { warp = 1 } }
        weight: 1
        fill: width
        gap: 5

        for row in rows key row.key {
          if row.fcells != null {
            Row {
              fill: width
              gap: 5
              for f in row.fcells { FolderCell { f: f } }
              for s in range(0, cols - len(row.fcells)) { Spacer { weight: 1 } }
            }
          } else if row.plain != null {
            SectionHead { plain: row.plain; epithet: row.epithet; work: row.work; offer: row.offer; count: row.count; cat: row.cat ?? "" }
          } else {
            Row {
              fill: width
              gap: 5
              for a in row.cells { Cell { a: a; picked: false } }
              for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
            }
          }
        }
      }

      // ─── OPENED FOLDER VIEW ───
      Column {
        visible: !searching && folderOpen != ""
        weight: 1
        fill: width
        gap: 6

        Row {
          fill: width
          align: center
          gap: 8
          padding: [2, 10, 2, 4]
          Box {
            scale: tapBounce == "14" ? 0.9 : 1
            offset: [0, tapBounce == "14" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "14"
            onRelease: tapBounce = ""
            size: 36
            radius: 18 * corners
            background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(darkCard, 0.9), #000000, alpha(cPri, 0.09)])
            border: 1
            borderColor: alpha(redAccent, 0.55)
            align: center
            onTap: { if animHaptics { haptic() }; folderOpen = ""; folderRenaming = false }
            Text { font: bodyFont; text: "‹"; fontSize: 22; color: hotAccent }
          }
          FuturisticFolder { sz: 30; count: len(openFolderApps); animOn: false }
          Column {
            weight: 1
            gap: 1
            Text { font: dispFont; text: upper(folderOpen); color: #ffffff; letterSpacing: track + 0.4; maxLines: 1; fontSize: 15; fontWeight: "bold" }
            Text { font: bodyFont; text: "FOLDER · ${len(openFolderApps)} ITEMS"; color: hotAccent; fontSize: 9; letterSpacing: 1.0 }
          }
          Box {
            scale: tapBounce == "15" ? 0.9 : 1
            offset: [0, tapBounce == "15" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "15"
            onRelease: tapBounce = ""
            size: 34
            radius: 10 * corners
            background: folderRenaming ? alpha(redAccent, 0.3) : alpha(darkCard, 0.85)
            border: 1
            borderColor: alpha(redAccent, 0.5)
            align: center
            onTap: { if animHaptics { haptic() }; folderRenaming = !folderRenaming }
            Text { font: uiFont; text: "✎"; fontSize: 14; color: hotAccent }
          }
          Box {
            scale: tapBounce == "16" ? 0.9 : 1
            offset: [0, tapBounce == "16" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "16"
            onRelease: tapBounce = ""
            size: 34
            radius: 10 * corners
            background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(darkCard, 0.85), #000000, alpha(cSec, 0.11)])
            border: 1
            borderColor: alpha(redAccent, 0.5)
            align: center
            onTap: {
              if animHaptics { haptic() }
              folderMap = reduce(entries(folderMap), (m, e) => e.value == folderOpen ? m : set(m, e.key, e.value), {})
              customFolders = customFolders.filter(n => n != folderOpen)
              folderOpen = ""
              folderRenaming = false
            }
            Text { font: uiFont; text: "✕"; fontSize: 13; color: hotAccent }
          }
        }

        // Precision glowing header divider (zero Canvas cost)
        Box {
          fill: width
          height: 1.5
          background: linear(0, 0, 1, 0, [alpha(redAccent, 0.05), redAccent, hotAccent, alpha(redAccent, 0.05)])
        }

        // Rename folder input row
        Row {
          visible: folderRenaming
          fill: width
          gap: 8
          padding: [2, 2, 2, 4]
          Input {
            weight: 1
            placeholder: str.folderName
            underline: false
            background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), darkCard, #000000, alpha(cSec, 0.10)])
            border: 1.2
            borderColor: hotAccent
            radius: 10 * corners
            padding: [10, 7]
            color: #ffffff
            onSubmit: {
              let n = trim(value)
              if n != "" && n != folderOpen {
                folderMap = reduce(entries(folderMap), (m, e) => e.value == folderOpen ? set(m, e.key, n) : set(m, e.key, e.value), {})
                customFolders = customFolders.map(c => c == folderOpen ? n : c)
                folderOpen = n
              }
              folderRenaming = false
            }
          }
          Text {
            scale: tapBounce == "17" ? 0.9 : 1
            offset: [0, tapBounce == "17" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "17"
            onRelease: tapBounce = ""
            font: uiFont
            text: "✕"
            color: hotAccent
            padding: [10, 8]
            radius: 10 * corners
            background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(redAccent, 0.25), #000000, alpha(cPri, 0.09)])
            border: 1
            borderColor: alpha(redAccent, 0.55)
            onTap: folderRenaming = false
          }
        }

        // Open Folder App Grid
        Column {
          lazy: true
          onRelease: { if scrollLvl > 0 { warp = 1 } }
          weight: 1
          fill: width
          gap: 5
          for row in folderRows key row.key {
            Row {
              fill: width
              gap: 5
              for a in row.cells { Cell { a: a; picked: false } }
              for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
            }
          }
        }
      }

      // ─── SEARCH RESULTS GRID ───
      Column {
        visible: searching
        lazy: true
        onRelease: { if scrollLvl > 0 { warp = 1 } }
        reverse: true
        weight: 1
        fill: width
        gap: 5
        for row in hitRows key row.key {
          Row {
            fill: width
            gap: 5
            for a, i in row.cells { Cell { a: a; picked: row.start + i == chosen } }
            for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
          }
        }
      }

      // ─── PROMPT BAR ASK AGENT ROW ───
      Row {
        scale: tapBounce == "18" ? 0.9 : 1
        offset: [0, tapBounce == "18" ? -4 : 0]
        animate scale: spring(0.32, 520)
        animate offset: spring(0.32, 520)
        onPress: tapBounce = "18"
        onRelease: tapBounce = ""
        visible: searching
        fill: width
        align: center
        gap: 10
        padding: [12, 10]
        border: chosen == -1 ? 1.5 : 1
        borderColor: chosen == -1 ? hotAccent : alpha(redAccent, 0.35)
        radius: 14 * corners
        background: chosen == -1
          ? linear(0, 0, 1, 0, [alpha(redAccent, 0.28), alpha(darkCard, 0.90)])
          : alpha(deepSurface, 0.88)
        onTap: {
          if animHaptics { haptic() }
          if !linux {
            launcher("linux")
          } else if agent == null {
            launcher("agents")
          } else {
            ask(typed)
          }
        }
        Box {
          width: 3
          height: 20
          radius: 2
          background: chosen == -1 ? hotAccent : alpha(redAccent, 0.45)
        }
        Text { font: uiFont; text: "⏎"; fontSize: 14; color: chosen == -1 ? hotAccent : mutedTone }
        Text {
          font: uiFont
          text: !linux ? str.askInstallLinux : agent == null ? str.askInstallAgent : str.askAgent(agent.bin, typed)
          color: chosen == -1 ? #ffffff : labelTone
          maxLines: 1
          weight: 1
        }
      }
    }

    // ◈ SCROLL WARP OVERLAY: chromatic tear bars that jump around while the drawer is flung (no touch handlers, passes taps through)
    if scrollLvl > 0 {
      Box {
        fill: true
        align: topStart
        clip: true
        opacity: warp > 0.02 ? 1 : 0
        for i in range(0, scrollLvl >= 2 ? 7 : 4) {
          Box {
            width: round((screenWidth ?? 390) * (0.25 + hash(i, 11) * 0.75))
            height: round(2 + hash(i, 12) * (scrollLvl >= 2 ? 20 : 9))
            offset: [round((hash(i, gTick, 2) - 0.35) * (screenWidth ?? 390) * 0.6), round(hash(i, gTick, 3) * (screenHeight ?? 800))]
            background: linear(0, 0, 1, 0, [alpha(i % 2 == 0 ? glCyan : hotAccent, 0), alpha(i % 2 == 0 ? glCyan : hotAccent, 0.12 + 0.26 * warp), alpha(i % 2 == 0 ? glCyan : hotAccent, 0)])
            opacity: hash(i, gTick, 4) < 0.2 + 0.8 * warp ? 1 : 0
          }
        }
      }
    }
  }
}
