panel "app drawer" {
  // Infernal Obsidian App Drawer — OWL 22 GPU-accelerated overhaul.
  // Swiping up on home opens this panel above the prompt bar.
  // Features: 0-loop GPU AGSL surface textures & volumetric glow, 4 card skins, 8 Kyber accents,
  // filter tabs (All / Favorites / Folders), quick folder creation, settings via the Command Deck HUB,
  // upgraded long-press context menu, and strict <4ms/frame optimization.
  meta { description: "Infernal Obsidian AMOLED app drawer with GPU AGSL surface textures, card skins, Kyber accents, filter tabs, custom folders, and <4ms optimization"; version: "3.0"; license: "MIT"; category: "system"; owl: 22 }

  // Unified 4-Theme Token Engine (hub.json -> hub.tok: infernal / future / mask / skeletor)
  source hub = file("~/.config/omalauncher/hub.json") json optional
  let curMode  = hub.mode ?? "infernal"
  let ecoOn    = (hub.eco ?? false) == true
  let T        = hub.tok ?? {}
  let tc       = T.copy ?? {}
  let cPri     = ecoOn ? (T.ecoPri != null ? rgb(T.ecoPri[0], T.ecoPri[1], T.ecoPri[2]) : #b8263a) : (T.pri != null ? rgb(T.pri[0], T.pri[1], T.pri[2]) : #ff1e3c)
  let cMid     = T.mid   != null ? rgb(T.mid[0],   T.mid[1],   T.mid[2])   : #ff3850
  let cHot     = ecoOn ? (T.ecoHot != null ? rgb(T.ecoHot[0], T.ecoHot[1], T.ecoHot[2]) : #d94c5e) : (T.hot != null ? rgb(T.hot[0], T.hot[1], T.hot[2]) : #ff8596)
  let cSec     = T.sec   != null ? rgb(T.sec[0],   T.sec[1],   T.sec[2])   : #ff6a1a
  let cBone    = ecoOn ? (T.ecoBone != null ? rgb(T.ecoBone[0], T.ecoBone[1], T.ecoBone[2]) : #c7a3a8) : (T.bone != null ? rgb(T.bone[0], T.bone[1], T.bone[2]) : #fff0f2)
  let cDim     = ecoOn ? (T.ecoDim != null ? rgb(T.ecoDim[0], T.ecoDim[1], T.ecoDim[2]) : #4d0c18) : (T.dim != null ? rgb(T.dim[0], T.dim[1], T.dim[2]) : #6b0918)
  let cDeep    = T.deep  != null ? rgb(T.deep[0],  T.deep[1],  T.deep[2])  : #170206
  let cCard    = T.card  != null ? rgb(T.card[0],  T.card[1],  T.card[2])  : #0c0104
  let cObs     = T.obs   != null ? rgb(T.obs[0],   T.obs[1],   T.obs[2])   : #050002
  let cInk     = T.ink   != null ? rgb(T.ink[0],   T.ink[1],   T.ink[2])   : #fff0f2
  let cMuted   = T.muted != null ? rgb(T.muted[0], T.muted[1], T.muted[2]) : #c77c88
  let uiFont   = T.fontPath ?? "sans"
  let dispFont = T.displayFontPath ?? uiFont
  let bodyFont = T.bodyFont ?? (hub.font == "mono" ? "mono" : "sans")
  let modeIdx  = num(T.modeIdx, 0)
  asset gear = base64""

  strings {
    en {
      personal: "personal"; work: "work"; apps: "apps"; linux: "linux"; shortcuts: "shortcuts"; android: "android"
      workApps: "work apps"; workPaused: "work apps paused"; linuxApps: "linux apps"
      pin: "add to home"; info: "app info"; uninstall: "uninstall"; remove: "remove"; edit: "edit"; share: "share"
      settings: "settings"; turnOn: "turn on"; pause: "pause"; installing: "installing…"; installLinux: "install linux"
      folders: "folders"; folderName: "folder name"; newFolder: "new folder"; unfile: "remove from folder"
      density: "density"; compact: "compact"; normal: "normal"; wide: "wide"; workTab: "work tab"
      vault: "CINDER VAULT"; motto: "through fire, into night"
      life: "animation"; still: "still"; breathe: "breathe"; storm: "storm"
      voice: "voice"; plain: "plain"; sith: "sith"; order: "order"; byKind: "kind"; byName: "name"
      favored: "favorites"; favor: "favorite"; unfavor: "unfavorite"
      sithFolders: "reliquary"; sithApps: "holocron"; sithLinux: "crucible"; sithShortcuts: "sigil"
      sithAndroid: "legion"; sithWork: "garrison"; sithWorkPaused: "stilled"; sithFavored: "the chosen"
      catCyber: "cyber & ai"; catComms: "comms & web"; catMedia: "media & audio"
      catFiles: "files & tools"; catFinance: "finance & nav"; catSystem: "system & os"
      sithCyber: "cortex"; sithComms: "holonet"; sithMedia: "resonator"
      sithFiles: "archive"; sithFinance: "vault"; sithSystem: "chassis"; category: "category"
      open: "open"; ask: "ask"; askInstallLinux: "ask an agent · install linux"; askInstallAgent: "ask an agent · install one"
      accent: "accent"; crimson: "crimson"; blood: "blood"; scarlet: "scarlet"; ember: "ember"; cyber: "cyber"
      revan: "revan"; bane: "bane"; venom: "venom"
      surface: "surface texture"; texGrid: "grid"; texCarbon: "carbon"; texHex: "hex"; texVoid: "void"
      skin: "card skin"; skinObsidian: "obsidian"; skinGlass: "glass"; skinCyber: "cyber"; skinMinimal: "minimal"
      glow: "glow intensity"; glowLow: "stealth"; glowMed: "ember"; glowHigh: "overdrive"
      tabStyle: "style"; tabTheme: "theme"; tabLayout: "layout"
      filterAll: "ALL"; filterFav: "FAVORITES"; filterFolders: "FOLDERS"; createFolder: "+ FOLDER"
