            [cx - u * 0.24, cy - u * 0.59]
          ], closed: true, fill: radial(cx - u * 0.10, cy - u * 0.16, u * 1.10, [#4eff82, #1fd454, #0d8530, #054217]), stroke: rimGreen, width: 1.9)

          // Soft velvety radial cheekbone & forehead gloss highlights (buttery smooth, zero angular seams!)
          circle(cx - u * 0.36, cy + u * 0.08, u * 0.20, fill: radial(cx - u * 0.36, cy + u * 0.08, u * 0.20, [alpha(#a6ff8c, 0.34), alpha(#1aff5c, 0)]))
          circle(cx + u * 0.36, cy + u * 0.08, u * 0.20, fill: radial(cx + u * 0.36, cy + u * 0.08, u * 0.20, [alpha(#a6ff8c, 0.34), alpha(#1aff5c, 0)]))
          circle(cx, cy - u * 0.32, u * 0.22, fill: radial(cx, cy - u * 0.32, u * 0.22, [alpha(#9eff82, 0.24), alpha(#1aff5c, 0)]))

          // 5. Smooth Expressive Arched Jim Carrey Eyebrows (classic mischievous asymmetric swagger)
          path([
            [cx - u * 0.47, cy - u * 0.20], [cx - u * 0.36, cy - u * 0.32], [cx - u * 0.22, cy - u * 0.34], [cx - u * 0.09, cy - u * 0.22],
            [cx - u * 0.11, cy - u * 0.18], [cx - u * 0.23, cy - u * 0.27], [cx - u * 0.35, cy - u * 0.25], [cx - u * 0.44, cy - u * 0.16]
          ], closed: true, fill: #03210c)
          path([
