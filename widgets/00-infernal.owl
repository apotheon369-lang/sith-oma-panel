            [cx - u * 0.10, cy - u * 0.08], [cx - u * 0.17, cy - u * 0.01], [cx - u * 0.27, cy + u * 0.01], [cx - u * 0.37, cy - u * 0.02]
          ], closed: true, fill: radial(cx - u * 0.26, cy - u * 0.10, u * 0.18, [#ffffff, #f2fff4, #d6f5dc]), stroke: #042b10, width: 1.3)
          path([
            [cx + u * 0.42, cy - u * 0.08], [cx + u * 0.34, cy - u * 0.18], [cx + u * 0.24, cy - u * 0.20], [cx + u * 0.14, cy - u * 0.15],
            [cx + u * 0.10, cy - u * 0.08], [cx + u * 0.17, cy - u * 0.01], [cx + u * 0.27, cy + u * 0.01], [cx + u * 0.37, cy - u * 0.02]
          ], closed: true, fill: radial(cx + u * 0.26, cy - u * 0.10, u * 0.18, [#ffffff, #f2fff4, #d6f5dc]), stroke: #042b10, width: 1.3)
          circle(cx - u * 0.25, cy - u * 0.10, u * 0.078, fill: radial(cx - u * 0.25, cy - u * 0.10, u * 0.08, [#42ff78, #0ca63b, #033d15]))
          circle(cx + u * 0.25, cy - u * 0.10, u * 0.078, fill: radial(cx + u * 0.25, cy - u * 0.10, u * 0.08, [#42ff78, #0ca63b, #033d15]))
          circle(cx - u * 0.25, cy - u * 0.10, u * 0.042, fill: #010a03)
          circle(cx + u * 0.25, cy - u * 0.10, u * 0.042, fill: #010a03)
          circle(cx - u * 0.28, cy - u * 0.13, u * 0.024, fill: #ffffff)
          circle(cx + u * 0.22, cy - u * 0.13, u * 0.024, fill: #ffffff)

          // 7. Smooth Sculpted Classic Nose (soft shaded bridge + gentle rounded tip, no sharp diamond)
          path([
            [cx - u * 0.04, cy - u * 0.10], [cx + u * 0.04, cy - u * 0.10],
            [cx + u * 0.08, cy + u * 0.08], [cx + u * 0.05, cy + u * 0.14],
            [cx, cy + u * 0.16], [cx - u * 0.05, cy + u * 0.14], [cx - u * 0.08, cy + u * 0.08]
          ], closed: true, fill: linear(cx - u * 0.06, cy - u * 0.10, cx + u * 0.06, cy + u * 0.16, [#5cff8a, #17b848, #075920]))
          path([[cx - u * 0.08, cy + u * 0.10], [cx, cy + u * 0.16], [cx + u * 0.08, cy + u * 0.10]], stroke: alpha(#043613, 0.72), width: 1.2, cap: round)

          // 8. THE ICONIC SMOOTH GLOSSY HUGE JIM CARREY TOOTHY GRIN!!
          circle(cx, cy + u * 0.43, u * (0.38 + p * 0.04 + surge * 0.10), fill: radial(cx, cy + u * 0.43, u * 0.44, [alpha(#c8ff8c, 0.24 + p * 0.08 + surge * 0.18), alpha(#000000, 0)]))
          path([
            [cx - u * 0.49, cy + u * 0.19],
            [cx - u * 0.34, cy + u * 0.28],
            [cx - u * 0.16, cy + u * 0.33],
            [cx, cy + u * 0.35],
            [cx + u * 0.16, cy + u * 0.33],
            [cx + u * 0.34, cy + u * 0.28],
            [cx + u * 0.49, cy + u * 0.19],
            [cx + u * 0.46, cy + u * 0.36],
            [cx + u * 0.38, cy + u * 0.51],
            [cx + u * 0.24, cy + u * 0.62],
            [cx + u * 0.10, cy + u * 0.67],
            [cx, cy + u * 0.68],
            [cx - u * 0.10, cy + u * 0.67],
            [cx - u * 0.24, cy + u * 0.62],
            [cx - u * 0.38, cy + u * 0.51],
            [cx - u * 0.46, cy + u * 0.36]
          ], closed: true, fill: linear(cx, cy + u * 0.20, cx, cy + u * 0.68, [#ffffff, #f7fff5, #dff7dc]), stroke: #043613, width: 2.0)

          // Smooth curved bite line & clean refined tooth dividers
          path([[cx - u * 0.44, cy + u * 0.34], [cx - u * 0.22, cy + u * 0.46], [cx, cy + u * 0.50], [cx + u * 0.22, cy + u * 0.46], [cx + u * 0.44, cy + u * 0.34]], stroke: alpha(#042e10, 0.72), width: 1.4, cap: round)
          line(cx, cy + u * 0.35, cx, cy + u * 0.67, stroke: alpha(#063b15, 0.58), width: 1.2)
          line(cx - u * 0.12, cy + u * 0.34, cx - u * 0.11, cy + u * 0.66, stroke: alpha(#063b15, 0.52), width: 1.1)
          line(cx + u * 0.12, cy + u * 0.34, cx + u * 0.11, cy + u * 0.66, stroke: alpha(#063b15, 0.52), width: 1.1)
          line(cx - u * 0.24, cy + u * 0.31, cx - u * 0.22, cy + u * 0.61, stroke: alpha(#063b15, 0.48), width: 1.05)
          line(cx + u * 0.24, cy + u * 0.31, cx + u * 0.22, cy + u * 0.61, stroke: alpha(#063b15, 0.48), width: 1.05)
          line(cx - u * 0.35, cy + u * 0.27, cx - u * 0.32, cy + u * 0.53, stroke: alpha(#063b15, 0.44), width: 1.0)
          line(cx + u * 0.35, cy + u * 0.27, cx + u * 0.32, cy + u * 0.53, stroke: alpha(#063b15, 0.44), width: 1.0)

          // Classic smooth star twinkle glint on upper left tooth
          let glX = cx - u * 0.17
          let glY = cy + u * 0.39
          line(glX - 5.5, glY, glX + 5.5, glY, stroke: #ffffff, width: 1.3, cap: round)
          line(glX, glY - 5.5, glX, glY + 5.5, stroke: #ffffff, width: 1.3, cap: round)

          // Soft natural laugh dimples & subtle chin cleft
          path([[cx - u * 0.52, cy + u * 0.14], [cx - u * 0.49, cy + u * 0.24]], stroke: alpha(#043613, 0.65), width: 1.4, cap: round)
          path([[cx + u * 0.52, cy + u * 0.14], [cx + u * 0.49, cy + u * 0.24]], stroke: alpha(#043613, 0.65), width: 1.4, cap: round)
          line(cx, cy + u * 0.77, cx, cy + u * 0.86, stroke: alpha(#043613, 0.55), width: 1.3, cap: round)

          // 9. SMOOTH CLASSIC TILTED YELLOW ZOOT-SUIT FEDORA (Silky gold crown + dark satin band + classic curved feather)
          rotate(-6, cx, cy - u * 0.52) {
            path([
              [cx - u * 0.96, cy - u * 0.41], [cx - u * 0.62, cy - u * 0.50], [cx - u * 0.24, cy - u * 0.55],
              [cx, cy - u * 0.56], [cx + u * 0.24, cy - u * 0.55], [cx + u * 0.62, cy - u * 0.50], [cx + u * 0.96, cy - u * 0.41],
              [cx + u * 0.70, cy - u * 0.34], [cx + u * 0.34, cy - u * 0.39], [cx, cy - u * 0.41], [cx - u * 0.34, cy - u * 0.39], [cx - u * 0.70, cy - u * 0.34]
            ], closed: true, fill: linear(cx, cy - u * 0.56, cx, cy - u * 0.34, [#5c4500, #1c1400]), stroke: rimGold, width: 1.8)

            path([
              [cx - u * 0.44, cy - u * 0.56], [cx - u * 0.56, cy - u * 0.76], [cx - u * 0.72, cy - u * 0.96],
              [cx - u * 0.60, cy - u * 0.92], [cx - u * 0.46, cy - u * 0.74], [cx - u * 0.36, cy - u * 0.56]
            ], closed: true, fill: linear(cx - u * 0.72, cy - u * 0.96, cx - u * 0.38, cy - u * 0.56, [#ffffff, #e6ff99, #24d95a]), stroke: alpha(#ffffff, 0.75), width: 0.9)

            path([
              [cx - u * 0.54, cy - u * 0.51],
              [cx - u * 0.50, cy - u * 0.72],
              [cx - u * 0.42, cy - u * 0.94],
              [cx - u * 0.26, cy - u * 1.09],
              [cx - u * 0.10, cy - u * 1.04],
              [cx, cy - u * 1.01],
              [cx + u * 0.10, cy - u * 1.04],
              [cx + u * 0.26, cy - u * 1.09],
              [cx + u * 0.42, cy - u * 0.94],
              [cx + u * 0.50, cy - u * 0.72],
              [cx + u * 0.54, cy - u * 0.51]
            ], closed: true, fill: linear(cx - u * 0.42, cy - u * 1.10, cx + u * 0.42, cy - u * 0.50, [#fff066, #e6b800, #8a6400, #d4a300]), stroke: rimGold, width: 1.7)

            path([[cx - u * 0.16, cy - u * 1.00], [cx, cy - u * 0.88], [cx + u * 0.16, cy - u * 1.00]], stroke: alpha(#594000, 0.55), width: 1.8, cap: round)

            path([
              [cx - u * 0.54, cy - u * 0.51], [cx - u * 0.52, cy - u * 0.64],
              [cx, cy - u * 0.68], [cx + u * 0.52, cy - u * 0.64], [cx + u * 0.54, cy - u * 0.51],
              [cx, cy - u * 0.55]
            ], closed: true, fill: linear(cx - u * 0.52, cy - u * 0.60, cx + u * 0.52, cy - u * 0.60, [#080c08, #1a241b, #080c08]), stroke: alpha(#ffe135, 0.78), width: 1.1)

            path([
              [cx - u * 0.96, cy - u * 0.41], [cx - u * 0.50, cy - u * 0.52],
              [cx, cy - u * 0.56], [cx + u * 0.50, cy - u * 0.52], [cx + u * 0.96, cy - u * 0.41]
            ], stroke: alpha(#fff8b8, 0.92), width: 1.6, cap: round)
          }
        } else if !futOn {
          // Multi-pass glowing inverted pentagram (vertex pointing straight down)
          let ppts = [0, 2, 4, 1, 3, 0].map(i => [
            cx + sin(3.14159265 + (i % 5) * 1.2566371) * r * 0.91,
            cy - cos(3.14159265 + (i % 5) * 1.2566371) * r * 0.91
          ])
          path(ppts, closed: true, stroke: alpha(#ff142c, 0.24 + p * 0.14 + surge * 0.25), width: 11 + surge * 5)
          path(ppts, closed: true, stroke: alpha(#ff223a, 0.88 + p * 0.12), width: 2.4 + surge * 0.9)
          path(ppts, closed: true, stroke: alpha(#ff8596, 0.88 + surge * 0.12), width: 0.95)

          // Crackling Sith Force-Lightning arcing along pentagram edges
          if fxLive {
            let boltStep = floor(fxT * 14)
            let boltCount = animSpeed >= 1.5 || surge > 0.15 ? 3 : 2
            for b in range(boltCount) {
              let idx = (boltStep + b * 2) % 5
              let a1 = 3.14159265 + idx * 1.2566371
              let a2 = 3.14159265 + ((idx + 2) % 5) * 1.2566371
              let x1 = cx + sin(a1) * r * 0.91
              let y1 = cy - cos(a1) * r * 0.91
              let x2 = cx + sin(a2) * r * 0.91
              let y2 = cy - cos(a2) * r * 0.91
              let j1 = (hash(boltStep + b * 17, 3) - 0.5) * 20
              let j2 = (hash(boltStep + b * 17, 7) - 0.5) * 20
              let j3 = (hash(boltStep + b * 17, 11) - 0.5) * 20
              let mx1 = x1 + (x2 - x1) * 0.33 + j1
              let my1 = y1 + (y2 - y1) * 0.33 + j2
              let mx2 = x1 + (x2 - x1) * 0.67 - j2
              let my2 = y1 + (y2 - y1) * 0.67 + j3
              let bAlpha = 0.30 + fastP * 0.35 + surge * 0.35
              path([[x1, y1], [mx1, my1], [mx2, my2], [x2, y2]], stroke: alpha(#ff1a35, bAlpha * 0.55), width: 4.5, cap: round)
              path([[x1, y1], [mx1, my1], [mx2, my2], [x2, y2]], stroke: alpha(#ff8596, bAlpha), width: 1.1, cap: round)
            }
          }

          // Sculpted sweeping twin demon horns with obsidian metallic gradient
          let h = r * 0.56
          path([[cx - h * 0.42, cy - h * 0.30], [cx - h * 0.96, cy - h * 1.06], [cx - h * 0.72, cy - h * 0.12], [cx - h * 0.38, cy + h * 0.04]], closed: true, fill: linear(cx - h, cy - h, cx - h * 0.3, cy, [#4a0512, #180105]), stroke: mix(#ff263f, #ff99a8, 0.25 + surge * 0.5), width: 1.45)
          path([[cx + h * 0.42, cy - h * 0.30], [cx + h * 0.96, cy - h * 1.06], [cx + h * 0.72, cy - h * 0.12], [cx + h * 0.38, cy + h * 0.04]], closed: true, fill: linear(cx + h, cy - h, cx + h * 0.3, cy, [#4a0512, #180105]), stroke: mix(#ff263f, #ff99a8, 0.25 + surge * 0.5), width: 1.45)

          // Angular sculpted obsidian demon visor crest + central ridge bevel
          path([[cx - h * 0.56, cy - h * 0.42], [cx, cy - h * 0.68], [cx + h * 0.56, cy - h * 0.42], [cx + h * 0.48, cy + h * 0.30], [cx, cy + h * 0.92], [cx - h * 0.48, cy + h * 0.30]], closed: true, fill: linear(cx, cy - h * 0.7, cx, cy + h * 0.9, [#2e030b, #080002, #1a0206]), stroke: mix(#ff263f, #ff99a8, 0.2 + surge * 0.45), width: 1.7)
          line(cx, cy - h * 0.64, cx, cy + h * 0.22, stroke: alpha(#ff556e, 0.28), width: 0.9)

          // Forehead ruby third-eye diamond (pulses with Sith energy)
          circle(cx, cy - h * 0.32, h * (0.18 + p * 0.08 + surge * 0.14), fill: radial(cx, cy - h * 0.32, h * 0.34, [alpha(#ff243d, 0.52 + surge * 0.42), alpha(#000000, 0)]))
          path([[cx, cy - h * 0.46], [cx + h * 0.09, cy - h * 0.32], [cx, cy - h * 0.18], [cx - h * 0.09, cy - h * 0.32]], closed: true, fill: mix(#ff2e44, #ff99a8, 0.25 + surge * 0.65), stroke: #ff8596, width: 0.75)

          // Blazing twin demon slit eyes + hot core glint + surge glow
          circle(cx - h * 0.27, cy - h * 0.04, h * (0.25 + surge * 0.14), fill: radial(cx - h * 0.27, cy - h * 0.04, h * 0.36, [alpha(#ff1a34, 0.38 + p * 0.18 + surge * 0.44), alpha(#000000, 0)]))
          circle(cx + h * 0.27, cy - h * 0.04, h * (0.25 + surge * 0.14), fill: radial(cx + h * 0.27, cy - h * 0.04, h * 0.36, [alpha(#ff1a34, 0.38 + p * 0.18 + surge * 0.44), alpha(#000000, 0)]))
          path([[cx - h * 0.44, cy - h * 0.14], [cx - h * 0.09, cy - h * 0.02], [cx - h * 0.36, cy + h * 0.09]], closed: true, fill: #ff2038)
          path([[cx + h * 0.44, cy - h * 0.14], [cx + h * 0.09, cy - h * 0.02], [cx + h * 0.36, cy + h * 0.09]], closed: true, fill: #ff2038)
          path([[cx - h * 0.34, cy - h * 0.08], [cx - h * 0.16, cy - h * 0.02], [cx - h * 0.31, cy + h * 0.03]], closed: true, fill: mix(#ff7a8a, #ffd0d8, p * 0.45 + surge * 0.55))
          path([[cx + h * 0.34, cy - h * 0.08], [cx + h * 0.16, cy - h * 0.02], [cx + h * 0.31, cy + h * 0.03]], closed: true, fill: mix(#ff7a8a, #ffd0d8, p * 0.45 + surge * 0.55))

          // Sinister fanged maw
          path([[cx - h * 0.25, cy + h * 0.38], [cx, cy + h * 0.30], [cx + h * 0.25, cy + h * 0.38], [cx, cy + h * 0.53]], closed: true, fill: #060002, stroke: #e62238, width: 1.4)
          path([[cx - h * 0.19, cy + h * 0.39], [cx - h * 0.13, cy + h * 0.55], [cx - h * 0.07, cy + h * 0.41]], closed: true, fill: #ff8596)
          path([[cx + h * 0.19, cy + h * 0.39], [cx + h * 0.13, cy + h * 0.55], [cx + h * 0.07, cy + h * 0.41]], closed: true, fill: #ff8596)
        } else {
          // ULTRON PRIME: Sculpted Vibranium Helmet + Swept Antenna Fins + Blazing Optics + Snarling Furnace Maw
          let u = r * 0.70
          let rimCol = mix(#22d1ff, #b8f6ff, 0.24 + surge * 0.52)

          // Outer Stark-Tech Hexagonal Halo (multi-pass glow framing Ultron's head)
          let hex = range(7).map(k => [cx + cos(rad(k * 60 - 90)) * r * 0.91, cy + sin(rad(k * 60 - 90)) * r * 0.91])
          path(hex, closed: true, stroke: alpha(#12b8ff, 0.20 + p * 0.12 + surge * 0.25), width: 9.5 + surge * 4)
          path(hex, closed: true, stroke: alpha(#38d6ff, 0.84 + p * 0.14), width: 1.9)
          path(hex, closed: true, stroke: alpha(#b0f4ff, 0.72 + surge * 0.24), width: 0.85)
          for k in range(6) {
            let vx = cx + cos(rad(k * 60 - 90)) * r * 0.91
            let vy = cy + sin(rad(k * 60 - 90)) * r * 0.91
            circle(vx, vy, 4.6, fill: alpha(#22d1ff, 0.24 + surge * 0.22))
            circle(vx, vy, 2.0, fill: #c8f6ff)
          }

          // Crackling electric-cyan vibranium energy arcs along hexagon perimeter when FX live
          if fxLive {
            let boltStep = floor(fxT * 14)
            let boltCount = animSpeed >= 1.5 || surge > 0.15 ? 3 : 2
            for b in range(boltCount) {
              let idx = (boltStep + b * 2) % 6
              let a1 = rad(idx * 60 - 90)
              let a2 = rad(((idx + 1) % 6) * 60 - 90)
              let x1 = cx + cos(a1) * r * 0.91
              let y1 = cy + sin(a1) * r * 0.91
              let x2 = cx + cos(a2) * r * 0.91
              let y2 = cy + sin(a2) * r * 0.91
              let j1 = (hash(boltStep + b * 17, 3) - 0.5) * 16
              let j2 = (hash(boltStep + b * 17, 7) - 0.5) * 16
              let j3 = (hash(boltStep + b * 17, 11) - 0.5) * 16
              let mx1 = x1 + (x2 - x1) * 0.33 + j1
              let my1 = y1 + (y2 - y1) * 0.33 + j2
              let mx2 = x1 + (x2 - x1) * 0.67 - j2
              let my2 = y1 + (y2 - y1) * 0.67 + j3
              let bAlpha = 0.28 + fastP * 0.34 + surge * 0.36
              path([[x1, y1], [mx1, my1], [mx2, my2], [x2, y2]], stroke: alpha(#18d8ff, bAlpha * 0.52), width: 4.2, cap: round)
              path([[x1, y1], [mx1, my1], [mx2, my2], [x2, y2]], stroke: alpha(#b8f6ff, bAlpha), width: 1.05, cap: round)
            }
          }

          // Iconic Slept-Back Ultron Temple Antenna Blades (tight metallic pods + razor upward wing-fins)
          path([[cx - u * 0.50, cy - u * 0.34], [cx - u * 0.67, cy - u * 0.44], [cx - u * 0.80, cy - u * 0.72], [cx - u * 0.73, cy - u * 0.24], [cx - u * 0.70, cy + u * 0.14], [cx - u * 0.54, cy + u * 0.24], [cx - u * 0.48, cy + u * 0.04]], closed: true, fill: linear(cx - u * 0.82, cy - u * 0.72, cx - u * 0.48, cy + u * 0.24, [#174c66, #04131e, #0a2638]), stroke: rimCol, width: 1.4)
          path([[cx + u * 0.50, cy - u * 0.34], [cx + u * 0.67, cy - u * 0.44], [cx + u * 0.80, cy - u * 0.72], [cx + u * 0.73, cy - u * 0.24], [cx + u * 0.70, cy + u * 0.14], [cx + u * 0.54, cy + u * 0.24], [cx + u * 0.48, cy + u * 0.04]], closed: true, fill: linear(cx + u * 0.82, cy - u * 0.72, cx + u * 0.48, cy + u * 0.24, [#174c66, #04131e, #0a2638]), stroke: rimCol, width: 1.4)
          // Sleek glowing cyan temple energy conduit slits inside the antenna pods
          line(cx - u * 0.62, cy - u * 0.28, cx - u * 0.64, cy + u * 0.08, stroke: alpha(#48e8ff, 0.78 + p * 0.20 + surge * 0.20), width: 2.1, cap: round)
          line(cx + u * 0.62, cy - u * 0.28, cx + u * 0.64, cy + u * 0.08, stroke: alpha(#48e8ff, 0.78 + p * 0.20 + surge * 0.20), width: 2.1, cap: round)

          // Main Sculpted Vibranium Helmet Cranium & Predatory Jaw Silhouette
          path([
            [cx, cy - u * 0.94],
            [cx + u * 0.30, cy - u * 0.87],
            [cx + u * 0.52, cy - u * 0.60],
            [cx + u * 0.59, cy - u * 0.22],
            [cx + u * 0.60, cy + u * 0.08],
            [cx + u * 0.51, cy + u * 0.38],
            [cx + u * 0.38, cy + u * 0.68],
            [cx + u * 0.19, cy + u * 0.90],
            [cx, cy + u * 0.95],
            [cx - u * 0.19, cy + u * 0.90],
            [cx - u * 0.38, cy + u * 0.68],
            [cx - u * 0.51, cy + u * 0.38],
            [cx - u * 0.60, cy + u * 0.08],
            [cx - u * 0.59, cy - u * 0.22],
            [cx - u * 0.52, cy - u * 0.60],
            [cx - u * 0.30, cy - u * 0.87]
          ], closed: true, fill: linear(cx, cy - u * 0.95, cx, cy + u * 0.95, [#143f58, #030e17, #071e2d]), stroke: rimCol, width: 1.75)

          // Sculpted Domed Forehead Helmet Crown & Iconic Ultron Central Keel Plates
          path([
            [cx, cy - u * 0.92],
            [cx + u * 0.28, cy - u * 0.85],
            [cx + u * 0.48, cy - u * 0.58],
            [cx + u * 0.51, cy - u * 0.26],
            [cx, cy - u * 0.11],
            [cx - u * 0.51, cy - u * 0.26],
            [cx - u * 0.48, cy - u * 0.58],
            [cx - u * 0.28, cy - u * 0.85]
          ], closed: true, fill: linear(cx, cy - u * 0.92, cx, cy - u * 0.11, [#1e5876, #082132, #030e17]), stroke: alpha(#6ce6ff, 0.48), width: 1.0)
          // Iconic Ultron V-converging forehead armor seams (pure Ultron Prime helmet geometry)
          path([[cx - u * 0.29, cy - u * 0.84], [cx - u * 0.16, cy - u * 0.44], [cx - u * 0.08, cy - u * 0.14]], stroke: alpha(#76ecff, 0.58), width: 1.15, cap: round)
          path([[cx + u * 0.29, cy - u * 0.84], [cx + u * 0.16, cy - u * 0.44], [cx + u * 0.08, cy - u * 0.14]], stroke: alpha(#76ecff, 0.58), width: 1.15, cap: round)
          // Subtle glowing vertical neural crest-slit on central forehead keel
          line(cx, cy - u * 0.78, cx, cy - u * 0.34, stroke: alpha(#22d1ff, 0.38 + p * 0.22 + surge * 0.35), width: 4.0, cap: round)
          line(cx, cy - u * 0.75, cx, cy - u * 0.37, stroke: alpha(#b4f7ff, 0.86), width: 1.3, cap: round)

          // Deep Recessed Obsidian Eye Sockets (sharp ruthless shadow behind glowing optics)
          path([[cx - u * 0.54, cy - u * 0.23], [cx - u * 0.07, cy - u * 0.07], [cx - u * 0.13, cy + u * 0.12], [cx - u * 0.49, cy + u * 0.05]], closed: true, fill: #010408, stroke: alpha(#187899, 0.70), width: 0.95)
          path([[cx + u * 0.54, cy - u * 0.23], [cx + u * 0.07, cy - u * 0.07], [cx + u * 0.13, cy + u * 0.12], [cx + u * 0.49, cy + u * 0.05]], closed: true, fill: #010408, stroke: alpha(#187899, 0.70), width: 0.95)

          // Heavy Menacing Overhanging V-Brow Crest (signature cold Ultron scowl)
          path([[cx - u * 0.58, cy - u * 0.27], [cx - u * 0.26, cy - u * 0.21], [cx, cy - u * 0.05], [cx + u * 0.26, cy - u * 0.21], [cx + u * 0.58, cy - u * 0.27]], stroke: alpha(#a6f8ff, 0.95), width: 2.2, cap: round)

          // Blazing Twin Ultron Optical Visor Eyes (volumetric bloom + sharp slanted cyan visor + white-hot slit)
          circle(cx - u * 0.30, cy - u * 0.04, u * (0.27 + surge * 0.14), fill: radial(cx - u * 0.30, cy - u * 0.04, u * 0.37, [alpha(#18d8ff, 0.50 + p * 0.20 + surge * 0.36), alpha(#000000, 0)]))
          circle(cx + u * 0.30, cy - u * 0.04, u * (0.27 + surge * 0.14), fill: radial(cx + u * 0.30, cy - u * 0.04, u * 0.37, [alpha(#18d8ff, 0.50 + p * 0.20 + surge * 0.36), alpha(#000000, 0)]))
          path([[cx - u * 0.49, cy - u * 0.17], [cx - u * 0.10, cy - u * 0.05], [cx - u * 0.16, cy + u * 0.06], [cx - u * 0.44, cy - u * 0.02]], closed: true, fill: #18d8ff)
          path([[cx + u * 0.49, cy - u * 0.17], [cx + u * 0.10, cy - u * 0.05], [cx + u * 0.16, cy + u * 0.06], [cx + u * 0.44, cy - u * 0.02]], closed: true, fill: #18d8ff)
          path([[cx - u * 0.42, cy - u * 0.12], [cx - u * 0.15, cy - u * 0.04], [cx - u * 0.19, cy + u * 0.02], [cx - u * 0.39, cy - u * 0.04]], closed: true, fill: mix(#b4f8ff, #ffffff, 0.58 + p * 0.22 + surge * 0.20))
          path([[cx + u * 0.42, cy - u * 0.12], [cx + u * 0.15, cy - u * 0.04], [cx + u * 0.19, cy + u * 0.02], [cx + u * 0.39, cy - u * 0.04]], closed: true, fill: mix(#b4f8ff, #ffffff, 0.58 + p * 0.22 + surge * 0.20))

          // Razor-Narrow Sculpted Nasal Ridge & Hollowed Cheekbone Armor Plates
          path([[cx - u * 0.055, cy - u * 0.05], [cx, cy - u * 0.03], [cx + u * 0.055, cy - u * 0.05], [cx + u * 0.075, cy + u * 0.19], [cx, cy + u * 0.25], [cx - u * 0.075, cy + u * 0.19]], closed: true, fill: linear(cx, cy - u * 0.05, cx, cy + u * 0.25, [#19506d, #051622]), stroke: alpha(#82f0ff, 0.76), width: 0.95)
          // Sharp angular cheekbone armor bevels & mechanical cheek-hollow energy seams
          path([[cx - u * 0.58, cy - u * 0.03], [cx - u * 0.43, cy + u * 0.19], [cx - u * 0.15, cy + u * 0.26]], stroke: alpha(#82f0ff, 0.72), width: 1.3, cap: round)
          path([[cx + u * 0.58, cy - u * 0.03], [cx + u * 0.43, cy + u * 0.19], [cx + u * 0.15, cy + u * 0.26]], stroke: alpha(#82f0ff, 0.72), width: 1.3, cap: round)
          line(cx - u * 0.52, cy + u * 0.11, cx - u * 0.36, cy + u * 0.23, stroke: alpha(#38e2ff, 0.75 + p * 0.22), width: 1.5, cap: round)
          line(cx + u * 0.52, cy + u * 0.11, cx + u * 0.36, cy + u * 0.23, stroke: alpha(#38e2ff, 0.75 + p * 0.22), width: 1.5, cap: round)

          // ICONIC ULTRON SNARLING PREDATOR MAW (scowling downturned upper mandible + open cheek-vents + glowing furnace core)
          circle(cx, cy + u * 0.43, u * (0.34 + p * 0.06 + surge * 0.14), fill: radial(cx, cy + u * 0.43, u * 0.42, [alpha(#18d8ff, 0.44 + p * 0.18 + surge * 0.36), alpha(#000000, 0)]))
          // Recessed menacing Ultron mouth cavity: snarling arch in center, flared mechanical cheek-hinges at sides
          path([
            [cx - u * 0.46, cy + u * 0.28],
            [cx - u * 0.24, cy + u * 0.39],
            [cx, cy + u * 0.33],
            [cx + u * 0.24, cy + u * 0.39],
            [cx + u * 0.46, cy + u * 0.28],
            [cx + u * 0.41, cy + u * 0.45],
            [cx + u * 0.25, cy + u * 0.57],
            [cx, cy + u * 0.51],
            [cx - u * 0.25, cy + u * 0.57],
            [cx - u * 0.41, cy + u * 0.45]
          ], closed: true, fill: radial(cx, cy + u * 0.43, u * 0.44, [mix(#8cf6ff, #ffffff, 0.45 + p * 0.25 + surge * 0.30), #18d8ff, #043e54]), stroke: #8ef4ff, width: 1.3)
          // Inner incandescent energy slit inside maw
          path([
            [cx - u * 0.36, cy + u * 0.38],
            [cx - u * 0.18, cy + u * 0.44],
            [cx, cy + u * 0.40],
            [cx + u * 0.18, cy + u * 0.44],
            [cx + u * 0.36, cy + u * 0.38],
            [cx + u * 0.24, cy + u * 0.50],
            [cx, cy + u * 0.46],
            [cx - u * 0.24, cy + u * 0.50]
          ], closed: true, fill: alpha(#eafdff, 0.76 + p * 0.16 + surge * 0.08))
          // 3 Sleek Angled Vibranium Mandible Struts / Mechanical Jaw Pistons (authentic Ultron Prime jaw)
          line(cx, cy + u * 0.32, cx, cy + u * 0.53, stroke: #020b12, width: 3.1, cap: butt)
          line(cx - u * 0.21, cy + u * 0.37, cx - u * 0.19, cy + u * 0.57, stroke: #020b12, width: 2.8, cap: butt)
          line(cx + u * 0.21, cy + u * 0.37, cx + u * 0.19, cy + u * 0.57, stroke: #020b12, width: 2.8, cap: butt)
          // Heavy dark armored cheek-hinge corners framing the snarling maw
          path([[cx - u * 0.46, cy + u * 0.28], [cx - u * 0.24, cy + u * 0.39], [cx, cy + u * 0.33], [cx + u * 0.24, cy + u * 0.39], [cx + u * 0.46, cy + u * 0.28]], stroke: alpha(#aef8ff, 0.90), width: 1.5, cap: round)

          // Heavy Faceted Armored Vibranium Chin Guard Plate
          path([
            [cx - u * 0.26, cy + u * 0.60],
            [cx, cy + u * 0.54],
            [cx + u * 0.26, cy + u * 0.60],
            [cx + u * 0.18, cy + u * 0.89],
            [cx, cy + u * 0.94],
            [cx - u * 0.18, cy + u * 0.89]
          ], closed: true, fill: linear(cx, cy + u * 0.54, cx, cy + u * 0.94, [#15445e, #04111c]), stroke: rimCol, width: 1.4)
          line(cx - u * 0.10, cy + u * 0.74, cx + u * 0.10, cy + u * 0.74, stroke: alpha(#5ee8ff, 0.78 + p * 0.22), width: 1.5, cap: round)
        }

        // Orbiting Tracer Comets (skipped in smooth Mask mode so the halo stays clean & silky)
        if !maskOn {
          let cometCount = fxLive ? 6 : 4
          for i in range(cometCount) {
            let dir = i % 2 == 0 ? 1 : -1
            let spd = 38 + (i % 3) * 20
            let deg0 = (i * 60 + (fxLive ? fxT * spd * dir : 24) + 36000) % 360
            let d = r * (1.17 + hash(i, 7) * 0.11)
            let hx = cx + sin(rad(deg0)) * d
            let hy = cy - cos(rad(deg0)) * d
            let tailStart = dir > 0 ? deg0 - 24 : deg0
            let coreStart = dir > 0 ? deg0 - 11 : deg0
            arc(cx, cy, d, tailStart, 24, stroke: alpha(cPri, fxLive ? 0.50 : 0.32), width: 2.4, cap: round)
            arc(cx, cy, d, coreStart, 11, stroke: alpha(cHot, fxLive ? 0.82 : 0.55), width: 1.4, cap: round)
            circle(hx, hy, i % 2 == 0 ? 2.5 : 1.8, fill: cHot)
          }
        }
      }
      }

      if !hulkOn {
        Spacer { height: 8 }

        if faustOn {
          // Outrun Studio 3-stripe solar-gold / magenta / cyan neon horizon divider bar
          Row {
            fill: width
            height: 2
            gap: 4
            Box { weight: 1; height: 2; background: #ffaa00 }
            Box { weight: 1; height: 2; background: #ff2ae6 }
            Box { weight: 1; height: 2; background: #00f0ff }
          }
          Spacer { height: 6 }
        }

        // Neon clock: clean, no halo/bloom behind the digits
        Box {
          fill: width
          align: center
          Column {
            fill: width
            gap: 0
            Row {
              fill: width
              align: center
              Text { font: dispFont; text: ecoOn ? "☾" : (tc.glyph ?? "✦"); color: ecoOn ? cPri : mix(cPri, cBone, 0.42 + breathe * 0.30 + surge * 0.20); fontSize: 16; weight: 1; align: center }
              Text {
                spans: [
                  fmtTime(now, "HH"),
                  { text: ":", color: ecoOn ? cHot : alpha(skelOn ? cBone : maskOn ? cSec : cHot, fxLive ? (0.58 + 0.42 * (0.5 + 0.5 * sin(fxT * 3.14))) : 0.95) },
                  fmtTime(now, "mm")
                ]
                font: dispFont
                fontSize: ecoOn ? 66 : 80
                letterSpacing: ecoOn ? 2 : 3
                color: ecoOn ? cPri : mix(cMid, cHot, 0.22 + surge * 0.45)
                align: center
              }
              Text { font: dispFont; text: ecoOn ? "☾" : (tc.glyph ?? "✦"); color: ecoOn ? cPri : mix(cPri, cBone, 0.42 + breathe * 0.30 + surge * 0.20); fontSize: 16; weight: 1; align: center }
            }
            Text { font: uiFont; text: upper(fmtTime(now, "EEEE  ·  d MMMM")); fontSize: 10.5; maxLines: 1; color: ecoOn ? cMuted : mix(cMuted, cHot, 0.22 + surge * 0.3); letterSpacing: 2; align: center; fill: width }
          }
        }

        Spacer { height: 10 }

        // Centered Sculpted Glass-Obsidian Status Altar (Battery · FX · AI · HUB)
        Row {
          fill: width
          align: center
          gap: 8
          Box { weight: 1; height: 1; background: ecoOn ? linear(0, 0, 1, 0, [alpha(cPri, 0), alpha(cDim, 0.85)]) : linear(0, 0, 1, 0, [alpha(cPri, 0), alpha(cMid, 0.72)]) }
          Row {
            gap: 7
            align: center
            padding: [13, 7]
            radius: 99
            background: ecoOn ? cObs : linear(0, 0, 0, 1, [alpha(cPri, 0.18), cDeep, alpha(#000000, 0.96)])
            border: 1
            borderColor: ecoOn ? cDim : (low || animSpeed >= 1.5 ? cMid : alpha(cPri, 0.56 + breathe * 0.24))
            onTap: {
              if animHaptics { haptic() }
              run("owl-hub eco ${ecoOn ? 'false' : 'true'}")
            }
            Text {
              font: uiFont
              text: bat.charging ? "✦ ${level}%" : "◈ ${level}%"
              fontSize: 10
              color: low ? cMid : (ecoOn ? cHot : cHot)
              bold: low || !ecoOn
              letterSpacing: 1
            }
            Text { font: uiFont; text: "·"; fontSize: 10; color: cDim }
            Text {
              font: uiFont
              text: ecoOn ? "ECO" : (!animMaster ? "STATIC" : (animSpeed >= 1.5 ? (tc.fxOver ?? "OVERDRIVE") : (tc.fxTag ?? "SITH")))
              fontSize: 10
              color: ecoOn ? cPri : (!animMaster ? cMuted : (animSpeed >= 1.5 ? cGold : cMid))
              bold: true
              letterSpacing: 1.2
            }
          }
          Row {
            scale: tapBounce == "4" ? 0.9 : 1
            offset: [0, tapBounce == "4" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "4"
            onRelease: tapBounce = ""
            gap: 5
            align: center
            padding: [13, 7]
            radius: 99
            background: ecoOn ? cObs : linear(0, 0, 0, 1, [alpha(cPri, 0.28), cDeep, alpha(#000000, 0.96)])
            border: 1
            borderColor: ecoOn ? cDim : alpha(skelOn ? cBone : maskOn ? cSec : cHot, 0.85)
            onTap: {
              if animHaptics { haptic() }
              open("o:abaddon-ultron.owl")
            }
            Text { font: uiFont; text: tc.aiPill ?? "⛧ ABADDON"; fontSize: 10; color: ecoOn ? cPri : (skelOn ? cBone : maskOn ? cSec : cHot); bold: true; letterSpacing: 1.3 }
          }
          Row {
            scale: tapBounce == "5" ? 0.9 : 1
            offset: [0, tapBounce == "5" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "5"
            onRelease: tapBounce = ""
            gap: 5
            align: center
            padding: [13, 7]
            radius: 99
            background: ecoOn ? cObs : linear(0, 0, 0, 1, [alpha(cPri, 0.22), cDeep, alpha(#000000, 0.96)])
            border: 1
            borderColor: ecoOn ? cDim : alpha(cMid, 0.78)
            onTap: {
              if animHaptics { haptic() }
              run("owl-send 25-sith-command-deck.owl set forgeReq $(date +%s%N)")
              launcher("page:0")
            }
            Text { font: uiFont; text: "◈ HUB"; fontSize: 10; color: ecoOn ? cPri : cHot; bold: true; letterSpacing: 1.3 }
          }
          Box { weight: 1; height: 1; background: ecoOn ? linear(0, 0, 1, 0, [alpha(cDim, 0.85), alpha(cPri, 0)]) : linear(0, 0, 1, 0, [alpha(cMid, 0.72), alpha(cPri, 0)]) }
        }

        if faustOn {
          Spacer { height: 6 }
          Row {
            fill: width
            height: 2
            gap: 4
            Box { weight: 1; height: 2; background: #ffaa00 }
            Box { weight: 1; height: 2; background: #ff2ae6 }
            Box { weight: 1; height: 2; background: #00f0ff }
          }
        }
      }

      Spacer { height: 8 }
      Text {
        font: uiFont
        text: ecoOn ? "☾ CHILL BATTERY MODE · ANIMATIONS OFF ☾" : (tc.motto ?? "✦ PEACE IS A LIE · THROUGH PASSION, POWER ✦")
        fontSize: 9
        maxLines: 1
        color: ecoOn ? cMuted : mix(cMuted, cGold, surge * 0.55)
        letterSpacing: 1.1
        align: center
        fill: width
      }

      Spacer { weight: 1 }

      // Embedded Obsidian 5-Slot App Dock (distinct geometry per theme)
      Box {
        fill: width
        height: cgH
        radius: hulkOn ? 4 * corners : (skelOn ? 6 * corners : (maskOn ? 28 * corners : (faustOn ? 10 * corners : (futOn ? 2 * corners : 16 * corners * hubRadius))))
        clip: true
        border: cgEditMode ? 1.4 : 1
        borderColor: ecoOn ? cDim : (cgEditMode ? cHot : alpha(cPri, 0.68))

        // Layer 1: Pure AMOLED Obsidian Dock Floor (background shader disabled for 0-mW pure black)
        if false {
          Shader {
            fill: true
            fallback: cObs
            uniforms: { uRes: rzRes,
              uT: cgLive ? cgFxT : 0.0,
              uLive: cgLive ? 1.0 : 0.0,
              uTap: [cgTapX, cgTapY],
              uBurst: cgLive ? cgBurst : 0.0,
              uSeed: cgGlitchSeed,
              uPri: cPri,
              uHot: cHot,
              uSec: cSec,
              uDim: cDim
            }
            code: """
              uniform float uRes;
              uniform float uT;
              uniform float uLive;
              uniform float2 uTap;
              uniform float uBurst;
              uniform float uSeed;
              uniform half4 uPri;
              uniform half4 uHot;
              uniform half4 uSec;
              uniform half4 uDim;

              float hash11(float n) {
                return fract(sin(n * 127.1 + 311.7) * 43758.5453);
              }

              float hash12(float2 p) {
                float3 p3 = fract(float3(p.xyx) * 0.1031);
                p3 += dot(p3, p3.yzx + 33.33);
                return fract((p3.x + p3.y) * p3.z);
              }

              half3 obsidianFold(float2 uv, float t) {
                float w1 = sin(uv.x * 3.1 + uv.y * 3.8 + t * 0.45) * 0.5 + 0.5;
                float w2 = sin(uv.x * 2.3 - uv.y * 2.9 - t * 0.36 + w1 * 0.9) * 0.5 + 0.5;

                float2 c1 = float2(0.72 + 0.12 * sin(t * 0.33), 0.26 + 0.10 * cos(t * 0.27));
                float2 c2 = float2(0.24 + 0.12 * cos(t * 0.26), 0.58 + 0.10 * sin(t * 0.35));
                float2 c3 = float2(0.50 + 0.10 * sin(t * 0.22 + 1.5), 0.85 + 0.06 * cos(t * 0.28));

                float2 d1 = (uv - c1) * float2(1.15, 1.35);
                float2 d2 = (uv - c2) * float2(1.10, 1.30);
                float2 d3 = (uv - c3) * float2(1.25, 1.45);

                float g1 = exp(-dot(d1, d1) * 4.2);
                float g2 = exp(-dot(d2, d2) * 4.4);
                float g3 = exp(-dot(d3, d3) * 4.0);

                float fold = uv.x * 0.82 - uv.y * 0.62 + 0.05 + 0.06 * sin(uv.y * 4.6 + t * 0.48);
                float g4 = exp(-(fold * fold) * 22.0) * (0.45 + 0.55 * w2);

                half3 pri = uPri.rgb;
                half3 sec = uSec.rgb;
                half3 dim = uDim.rgb;
                half3 col = half3(0.0);
                col += half(g1) * mix(pri * half(0.78), sec * half(0.72), half(0.18 * w2));
                col += half(g2) * pri * half(0.82);
                col += half(g3) * mix(dim * half(1.25), pri * half(0.62), half(w1));
                col += half(g4) * mix(pri, uHot.rgb, half(0.24 * w1)) * half(0.72);

                float vig = smoothstep(0.0, 0.14, uv.x) * (1.0 - smoothstep(0.86, 1.0, uv.x))
                          * smoothstep(0.0, 0.16, uv.y) * (1.0 - smoothstep(0.84, 1.0, uv.y));
                col *= half(0.32 + 0.68 * vig);
                return col;
              }

              half4 main(float2 p) {
                p = (floor(p * uRes) + 0.5) / uRes;
                float2 safeSize = max(size, float2(1.0));
                float2 uv = p / safeSize;
                float aspect = safeSize.x / safeSize.y;

                float glitchAmt = 0.0;
                float sliceRand = 0.0;
                float pressSlice = 0.0;
                float ring = 0.0;
                float ring2 = 0.0;
                float coreGlow = 0.0;
                float2 warpedUv = uv;

                if (uLive > 0.5) {
                  float beat = floor(uT * 4.5);
                  float ambientGate = step(0.86, hash11(beat * 1.41));
                  float sliceId = floor(uv.y * 36.0);
                  sliceRand = hash11(sliceId + beat * 19.7 + uSeed * 0.01);
                  float sliceActive = step(0.83, sliceRand) * ambientGate;

                  if (uBurst > 0.001) {
                    float2 diff = uv - uTap;
                    float2 diffA = float2(diff.x * aspect, diff.y);
                    float distTap = length(diffA);
                    float age = 1.0 - uBurst;
                    float waveR = age * 0.82;
                    float dr1 = (distTap - waveR) * 16.0;
                    float dr2 = (distTap - waveR + 0.024) * 22.0;
                    ring = exp(-(dr1 * dr1)) * uBurst;
                    ring2 = exp(-(dr2 * dr2)) * uBurst;
                    coreGlow = exp(-distTap * 6.0) * uBurst * uBurst;

                    float yBand = exp(-abs(uv.y - uTap.y) * 8.0);
                    pressSlice = step(0.60, hash11(floor(uv.y * 46.0) + floor(uT * 24.0) * 7.3 + uSeed * 0.13)) * uBurst * (0.35 + 0.95 * yBand);

                    float2 dirVec = distTap > 0.001 ? diff / distTap : float2(0.0, 0.0);
                    warpedUv += dirVec * (ring * 0.036);
                  }

                  glitchAmt = sliceActive * 0.024 + pressSlice * 0.058;
                  if (glitchAmt > 0.0005) {
                    float dir = (hash11(sliceId * 3.1 + uSeed * 0.07) - 0.5) * 2.0;
                    warpedUv.x += dir * glitchAmt;
                  }
                }

                half3 col;
                if (glitchAmt > 0.0005 || ring > 0.01) {
                  float chroma = 0.006 + glitchAmt * 0.9 + ring * 0.030;
                  half3 colR = obsidianFold(warpedUv + float2(chroma, 0.0), uT);
                  half3 colG = obsidianFold(warpedUv, uT);
                  half3 colB = obsidianFold(warpedUv - float2(chroma, 0.0), uT);
                  col = half3(colR.r, colG.g, colB.b);
                } else {
                  col = obsidianFold(warpedUv, uT);
                }

                float weave = sin((p.x + p.y) * 0.65) * sin((p.x - p.y) * 0.65);
                col *= half(0.88 + 0.12 * weave);

                float topBevel = exp(-uv.y * 22.0) * (1.0 - smoothstep(0.32, 0.52, abs(uv.x - 0.5)));
                float botRim = exp(-(1.0 - uv.y) * 26.0) * 0.42;
                col += uHot.rgb * half(topBevel * 0.34 + botRim * 0.20);

                if (uBurst > 0.001) {
                  col += uPri.rgb * half(ring * 0.62);
                  col += uSec.rgb * half(ring2 * 0.42);
                  col += uHot.rgb * half(coreGlow * 0.72);
                  float barFlash = pressSlice * step(0.76, hash11(floor(uv.y * 100.0) + uSeed * 0.29));
                  col += mix(uHot.rgb, uSec.rgb, half(step(0.45, sliceRand))) * half(barFlash * 0.55);
                }

                half scan = half(1.0 - 0.055 * (0.5 + 0.5 * sin(p.y * 1.55)));
                col *= scan;

                col = col / (half3(1.0) + half(0.38) * col);
                half dither = half((hash12(p) - 0.5) * 0.0045) * step(half(0.001), col.r + col.g + col.b);
                col *= half(0.45);
                return half4(clamp(col + dither, half3(0.0), half3(1.0)), half(1.0));
              }
            """
          }
        } else {
          Box {
            fill: true
            background: cObs
          }
        }

        // Layer 2: Crisp vector glitch shockwaves, tear slices & sparks on every press
        if cgLive && len(cgPulses) > 0 {
          Canvas {
            fill: true
            for p in cgPulses {
              let t = clamp(p.age / 1.0, 0, 1)
              let fade = (1 - t) * (1 - t)
              let r = 12 + t * 155
              let shift = (1 - t) * 10

              circle(p.x - shift, p.y, r, stroke: alpha(cDim, fade * 0.75), width: 2.0 * (1 - t * 0.5))
              circle(p.x + shift, p.y, r * 0.97, stroke: alpha(cPri, fade * 0.92), width: 2.5 * (1 - t * 0.5))
              circle(p.x, p.y, r * 0.72, stroke: alpha(cHot, fade * 0.62), width: 1.1)

              if t < 0.45 {
                let cf = 1 - t / 0.45
                circle(p.x, p.y, 40 * cf + 8, fill: radial(p.x, p.y, 48, [alpha(cPri, cf * 0.48), alpha(#000000, 0)]))
              }

              for i in range(6) {
                let gy = p.y + (hash(p.seed, i * 3 + 1) - 0.5) * (50 + t * 125)
                let gw = 22 + hash(p.seed, i * 3 + 2) * 95
                let dir = i % 2 == 0 ? 1 : -1
                let gx = p.x + dir * (10 + t * (75 + hash(p.seed, i * 3 + 3) * 95)) - gw / 2
                let gh = i % 3 == 0 ? 2.5 : 1.5
                rect(gx, gy, gw, gh, fill: i % 3 == 0 ? alpha(cSec, fade * 0.72) : alpha(cPri, fade * 0.92))
                rect(gx + dir * 5, gy + 2, gw * 0.72, 1, fill: alpha(cHot, fade * 0.60))
              }

              for i in range(8) {
                let ang = hash(p.seed, i * 5 + 11) * 6.28318
                let spd = 48 + hash(p.seed, i * 5 + 12) * 115
                let sx = p.x + cos(ang) * (8 + t * spd)
                let sy = p.y + sin(ang) * (8 + t * spd)
                let sw = 6 + hash(p.seed, i * 5 + 13) * 12
                rect(sx - sw / 2, sy - 1, sw, 2.2, fill: i % 3 == 0 ? alpha(cPri, fade * 0.95) : i % 3 == 1 ? alpha(cMid, fade * 0.9) : alpha(cHot, fade * 0.85))
              }
            }
          }
        }

        // Layer 3: Full-card touch catcher (fires glitch shockwave at exact press point)
        Box {
          fill: true
          onPress: {
            if infGlitchOn {
              let nx = clamp(x / cgW, 0, 1)
              let ny = clamp(y / cgH, 0, 1)
              let s = random(1, 99999)
              cgTapX = nx
              cgTapY = ny
              cgBurst = 1.0
              cgGlitchSeed = s
              cgPulses = ([{ x: x, y: y, age: 0, seed: s }] + cgPulses).take(4)
              if animHaptics { haptic() }
            }
          }
        }

        // Layer 4: 5 Sculpted Recessed Obsidian App Sockets + Controls
        Column {
          fill: true
          padding: [cgPadX, cgPadY]
          gap: 7

          Row {
            fill: width
            height: cgSlotH
            gap: cgSlotGap
            align: center
            for idx in range(5) {
              let sa = cgSlotApps[idx]
              let filled = sa != null
              let nx = (cgPadX + (cgSlotW + cgSlotGap) * idx + cgSlotW / 2) / cgW
              Box {
                scale: tapBounce == "6:${idx}" ? 0.9 : 1
                offset: [0, tapBounce == "6:${idx}" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "6:${idx}"
                onRelease: tapBounce = ""
                weight: 1
                height: cgSlotH
                radius: 12 * corners
                background: cgEditMode
                  ? linear(0, 0, 0, 1, [alpha(cPri, 0.34), alpha(cDeep, 0.92)])
                  : (filled
                    ? linear(0, 0, 0, 1, [alpha(cPri, 0.14), alpha(cObs, 0.86), alpha(#000000, 0.92)])
                    : alpha(cObs, 0.56))
                border: cgEditMode ? 1.5 : 1
                borderColor: cgEditMode ? cHot : (filled ? alpha(cMid, 0.64) : alpha(cPri, 0.34))
                align: center
                onTap: {
                  if animHaptics { haptic() }
                  if infGlitchOn {
                    let s = random(1, 99999)
                    cgTapX = nx
                    cgTapY = 0.40
                    cgBurst = 1.0
                    cgGlitchSeed = s
                    cgPulses = ([{ x: nx * cgW, y: 0.40 * cgH, age: 0, seed: s }] + cgPulses).take(4)
                  }
                  if cgEditMode || !filled {
                    cgActiveSlot = idx
                    cgQuery = ""
                    scrMode = "glitch"
                    screen()
                  } else {
                    open(sa.key)
                  }
                }

                Box {
                  size: cgIconSz
                  align: topEnd
                  if filled {
                    OccultIcon { app: sa; sz: cgIconSz }
                    if sa.dot && !cgEditMode {
                      Box {
                        size: 9
                        radius: 4.5
                        offset: [2, -2]
                        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), cHot, #000000, alpha(cPri, 0.09)])
                        border: 1.5
                        borderColor: cObs
                      }
                    }
                  } else {
                    Image { src: icoEmpty; size: round(cgIconSz * 0.72); tint: alpha(cMid, 0.75); label: "Empty slot" }
                  }
                }

                if cgEditMode {
                  Box {
                    fill: true
                    align: topEnd
                    padding: 3
                    Box {
                      size: 15
                      radius: 8
                      background: cPri
                      align: center
                      Text {
                        font: uiFont
                        text: filled ? "✎" : "+"
                        fontSize: 8.5
                        color: cHot
                        bold: true
                        align: center
                      }
                    }
                  }
                }
              }
            }
          }

          Row {
            fill: width
            height: cgFootH
            align: center
            gap: 6

            if cgEditMode {
              Text {
                font: uiFont
                text: "TAP SLOT TO SET"
                fontSize: 8.5
                color: cHot
                bold: true
                letterSpacing: 1.3
              }
            } else if infGlitchOn {
              Text {
                font: uiFont
                text: maskOn ? "✦ SMOKIN' DECK" : "TAP FOR GLITCH"
                fontSize: 8.5
                color: alpha(cHot, 0.52)
                letterSpacing: 1.4
              }
            } else if !ecoOn {
              Text {
                font: uiFont
                text: tc.quickDeck ?? "✦ OCCULT DECK"
                fontSize: 8.5
                color: alpha(cHot, 0.56)
                letterSpacing: 1.4
              }
            }

            Spacer { weight: 1 }

            Row {
              scale: tapBounce == "8" ? 0.9 : 1
              offset: [0, tapBounce == "8" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "8"
              onRelease: tapBounce = ""
              gap: 4
              align: center
              padding: [7, 2.5]
              radius: 99
              background: cgEditMode
                ? linear(0, 0, 0, 1, [alpha(cPri, 0.45), alpha(cDeep, 0.95)])
                : linear(0, 0, 0, 1, [alpha(cPri, 0.18), alpha(cObs, 0.88)])
              border: 1
              borderColor: cgEditMode ? cHot : alpha(cMid, 0.58)
              onTap: {
                if animHaptics { haptic() }
                cgEditMode = !cgEditMode
              }
              Text {
                font: uiFont
                text: cgEditMode ? "✓" : "✎"
                fontSize: 8.5
                color: cgEditMode ? cHot : cMid
              }
              Text {
                font: uiFont
                text: cgEditMode ? "DONE" : "EDIT"
                fontSize: 8.5
                color: cgEditMode ? cHot : alpha(cHot, 0.88)
                bold: cgEditMode
                letterSpacing: 1.0
              }
            }
          }
        }
      }

      Spacer { height: 10 }

      // Main Sculpted Obsidian Dock (distinct geometry per theme)
      Box {
        fill: width
        height: dockH
        radius: hulkOn ? 4 * corners : (skelOn ? 6 * corners : (maskOn ? 28 * corners : (faustOn ? 10 * corners : (futOn ? 2 * corners : 16 * corners * hubRadius))))
        clip: true
        background: ecoOn ? cObs : linear(0, 0, 1, 1, [
          cCard,
          cObs,
          cDeep,
          cObs,
          cCard
        ])
        border: 1
        borderColor: ecoOn ? cDim : mix(cDim, cHot, 0.35 + breathe * 0.25 + surge * 0.40)
        align: center

        if !ecoOn {
          Canvas {
            fill: true
            let w = width
            let h = height
            // Top & bottom beveled obsidian plasma rails
            line(14, 2, w - 14, 2, stroke: linear(14, 0, w - 14, 0, [alpha(cPri, 0.25), alpha(cHot, 0.86), alpha(cPri, 0.25)]), width: 1.3)
            line(14, h - 2, w - 14, h - 2, stroke: linear(14, 0, w - 14, 0, [alpha(cPri, 0.18), alpha(cMid, 0.62), alpha(cPri, 0.18)]), width: 1.0)
            // Corner architectural filigree brackets
            line(5, 9, 5, 5, stroke: alpha(cHot, 0.65), width: 1.2, cap: round)
            line(5, 5, 11, 5, stroke: alpha(cHot, 0.65), width: 1.2, cap: round)
            line(w - 5, 9, w - 5, 5, stroke: alpha(cHot, 0.65), width: 1.2, cap: round)
            line(w - 5, 5, w - 11, 5, stroke: alpha(cHot, 0.65), width: 1.2, cap: round)
            for i in [1, 2, 3, 4] {
              let sx = cgPadX + (cgSlotW + cgSlotGap) * i - cgSlotGap / 2
              line(sx, h * 0.22, sx, h * 0.78, stroke: linear(sx, h * 0.22, sx, h * 0.78, [alpha(cPri, 0), alpha(cDim, 0.62), alpha(cPri, 0)]), width: 0.9)
            }
          }
        }

        Row {
          fill: true
          padding: [cgPadX, 0]
          gap: cgSlotGap
          align: center
          DockApp { pkg: "com.android.chrome"; label: "Chrome"; slotIdx: 0 }
          DockApp { pkg: "com.google.android.apps.messaging"; label: "Messages"; slotIdx: 1 }
          DockCrown { pkg: "com.incomm.spendwell" }
          DockApp { pkg: "com.google.android.gm"; label: "Gmail"; slotIdx: 3 }
          DockApp { pkg: "ai.miniapps.android"; label: "Mini Apps"; slotIdx: 4 }
        }
      }

      Spacer { height: 10 }

      // Purge Chamber obsidian command blade — opens the task + process manager
      Box {
        scale: tapBounce == "9" ? 0.9 : 1
        offset: [0, tapBounce == "9" ? -4 : 0]
        animate scale: spring(0.32, 520)
        animate offset: spring(0.32, 520)
        onPress: tapBounce = "9"
        onRelease: tapBounce = ""
        fill: width
        height: 44
        radius: hulkOn ? 4 * corners : 14 * corners * hubRadius
        clip: true
        background: ecoOn ? cObs : linear(0, 0, 1, 0, [cObs, cDeep, cObs])
        border: hulkOn ? 1.5 : 1
        borderColor: hulkOn ? alpha(#9b30ff, ecoOn ? 0.65 : 0.90) : (ecoOn ? cDim : alpha(cMid, 0.56))
        align: center
        onTap: { if animHaptics { haptic() }; scrMode = "tasks"; screen() }
        if !ecoOn {
          Box {
            fill: width
            height: 1.2
            align: top
            offset: [0, -21]
            background: linear(0, 0, 1, 0, [alpha(cPri, 0), alpha(cHot, 0.55), alpha(cPri, 0)])
          }
        }
        Row {
          fill: true
          align: center
          justify: center
          gap: 8
          Text { font: dispFont; text: ecoOn ? "◈" : (tc.sigilGlyph ?? "⛧"); fontSize: 13; color: ecoOn ? cPri : (skelOn ? cBone : maskOn ? cSec : cMid) }
          Text { font: uiFont; text: "PURGE CHAMBER · TASKS & PROCESSES"; fontSize: 9.5; maxLines: 1; bold: true; color: ecoOn ? cHot : cInk; letterSpacing: 1.3 }
          Text { font: dispFont; text: ecoOn ? "◈" : (tc.sigilGlyph ?? "⛧"); fontSize: 13; color: ecoOn ? cPri : (skelOn ? cBone : maskOn ? cSec : cMid) }
        }
      }

      // ─── GLOBAL NOTIFS/EMAIL BOARD RAIL ───
      Box {
        fill: width
        height: 32
        radius: hulkOn ? 4 * corners : 12 * corners * hubRadius
        background: linear(0, 0, 1, 0, [alpha(cPri, 0.24), cCard])
        border: hulkOn ? 1.5 : 1
        borderColor: hulkOn ? alpha(#9b30ff, ecoOn ? 0.65 : 0.90) : alpha(cPri, 0.72)
        onTap: { if animHaptics { haptic() }; open("o:notifs-board.owl") }
        Column { fill: true; justify: center; Text { font: uiFont; text: "🔔 NOTIFS & MAIL"; align: center; fontSize: 8.5; bold: true; letterSpacing: 0.9; color: cInk } }
      }

      Spacer { height: screenInset + 16 }
    }

    // ==================== LAYER 2: OPTIMIZED SITH FX OVERLAY CANVAS ====================
    // Pass-through visual FX layer (no touch handlers): ambient crimson embers,
    // high-speed energy tracers, vector blood splatter drips, saber slashes & Force lightning!
    if infFxOn {
      Canvas {
        fill: true
        let w = width
        let h = height
        let sigCx = w * 0.5
        let sigCy = h * 0.32

        // 1. Ambient rising Sith embers & occasional diagonal crimson void tracers
        let emberCount = animSpeed >= 1.5 ? 12 : 8
        for e in range(emberCount) {
          let spd = 22 + hash(e, 3) * 38
          let ey = h - ((fxT * spd + hash(e, 11) * h) % (h + 40)) + 20
          let ex = hash(e, 5) * w + sin(fxT * (1.2 + hash(e, 7)) + e * 2.1) * 18
          let er = 1.0 + hash(e, 13) * 1.7
          let sE = sin(fxT * 2.5 + e * 1.7)
          let ea = 0.22 + 0.42 * sE * sE
          circle(ex, ey, er * 2.6, fill: alpha(cPri, ea * 0.28))
          circle(ex, ey, er, fill: alpha(cHot, ea))
        }

        // Ambient slicing tracers drifting across the dark void
        let ambTracers = animSpeed >= 1.5 ? 3 : 2
        for at in range(ambTracers) {
          let cycle = 4.6 + at * 1.9
          let phase = (fxT + at * 2.3) % cycle
          if phase < 0.75 {
            let prog = phase / 0.75
            let seed = floor((fxT + at * 2.3) / cycle) * 13 + at * 7
            let y0 = h * (0.12 + hash(seed, 2) * 0.72)
            let dir = at % 2 == 0 ? 1 : -1
            let xHead = dir > 0 ? (-40 + prog * (w + 140)) : (w + 40 - prog * (w + 140))
            let slope = (hash(seed, 5) - 0.5) * 110
            let yHead = y0 + prog * slope
            let tailLen = 85 + 45 * (1.0 - prog)
            let xTail = xHead - dir * tailLen
            let yTail = yHead - (slope / (w + 140)) * tailLen
            let aFade = sin(prog * 3.14159) * 0.62
            line(xTail, yTail, xHead, yHead, stroke: alpha(cPri, aFade * 0.45), width: 4.5, cap: round)
            line(xTail * 0.35 + xHead * 0.65, yTail * 0.35 + yHead * 0.65, xHead, yHead, stroke: alpha(cHot, aFade), width: 1.3, cap: round)
          }
        }

        // 2. Per-Press Interactive Sith Effects (strictly gated by burstActive for zero idle overhead!)
        if burstActive {
          for imp in impacts {
            let age = fxT - imp.t
            if imp.t > -50 && age >= 0 && age < 3.4 {
              let ix = imp.x
              let iy = imp.y
              let seed = imp.seed
              let pwr = imp.pwr

              // A) Expanding dual shockwave rings + impact core diamond flash (0.0 -> 0.65s)
              if age < 0.65 {
                let p0 = age / 0.65
                let invP0 = 1.0 - p0
                let easeOut = 1.0 - invP0 * invP0
                let ringR = (14 + easeOut * 118) * pwr
                let ringA = invP0 * 0.88
                circle(ix, iy, ringR, stroke: alpha(cPri, ringA * 0.55), width: (4.5 * invP0 + 0.8))
                circle(ix, iy, ringR * 0.72, stroke: alpha(cHot, ringA * 0.85), width: (1.6 * invP0 + 0.4))
                if age < 0.22 {
                  let fA = 1.0 - age / 0.22
                  let dR = (10 + age * 80) * pwr
                  path([[ix, iy - dR], [ix + dR * 0.6, iy], [ix, iy + dR], [ix - dR * 0.6, iy]], closed: true, stroke: alpha(cHot, fA), width: 1.5)
                }
              }

              // B) Razor Lightsaber Slash across the impact point (0.0 -> 0.36s)
              if age < 0.36 {
                let sp = age / 0.36
                let slashAng = (hash(floor(seed * 10), 4) - 0.5) * 2.2 - 0.65
                let halfL = (52 + sp * 78) * pwr
                let cs = cos(slashAng) * halfL
                let sn = sin(slashAng) * halfL
                let sx1 = ix - cs
                let sy1 = iy - sn
                let sx2 = ix + cs
                let sy2 = iy + sn
                let sA = (1.0 - sp) * 0.92
                line(sx1, sy1, sx2, sy2, stroke: alpha(cPri, sA * 0.55), width: 8.5 * (1.0 - sp * 0.6), cap: round)
                line(sx1, sy1, sx2, sy2, stroke: alpha(cMid, sA * 0.9), width: 3.2 * (1.0 - sp * 0.5), cap: round)
                line(sx1, sy1, sx2, sy2, stroke: alpha(cHot, sA), width: 1.2, cap: round)
              }

              // C) High-Speed Curved Energy Tracers bursting outward (0.0 -> 1.15s)
              if age < 1.15 {
                let tp = age / 1.15
                let tracerN = animSpeed >= 1.5 ? 6 : 5
                for k in range(tracerN) {
                  let baseAng = k * (6.28318 / tracerN) + hash(floor(seed * 17) + k, 9) * 1.4
                  let curve = (hash(floor(seed * 13) + k, 15) - 0.5) * 1.8
                  let speed = (185 + hash(floor(seed * 19) + k, 21) * 180) * pwr
                  let headD = speed * (1.0 - pow(1.0 - tp, 2.2)) * 0.72
                  let midD = max(0, headD - 34 * (1.0 - tp * 0.5))
                  let tailD = max(0, headD - 76 * (1.0 - tp * 0.55))
                  let aHead = baseAng + curve * tp
                  let aMid = baseAng + curve * max(0, tp - 0.14)
                  let aTail = baseAng + curve * max(0, tp - 0.28)
                  let hx = ix + cos(aHead) * headD
                  let hy = iy + sin(aHead) * headD
                  let mx = ix + cos(aMid) * midD
                  let my = iy + sin(aMid) * midD
                  let tx = ix + cos(aTail) * tailD
                  let ty = iy + sin(aTail) * tailD
                  let tA = (1.0 - tp) * 0.95
                  path([[tx, ty], [mx, my], [hx, hy]], stroke: alpha(cPri, tA * 0.42), width: 5.5 * (1.0 - tp * 0.5), cap: round)
                  path([[tx, ty], [mx, my], [hx, hy]], stroke: alpha(cMid, tA * 0.88), width: 2.1 * (1.0 - tp * 0.4), cap: round)
                  line(mx, my, hx, hy, stroke: alpha(cHot, tA), width: 1.0, cap: round)
                  circle(hx, hy, 2.2 * (1.0 - tp * 0.5), fill: alpha(cHot, tA))
                }
              }

              // D) Vector Blood Splatter Droplets & Gravity Drips (single trig evaluation per droplet!)
              let dropN = animSpeed >= 1.5 ? 14 : 10
              let splatFade = clamp(1.0 - max(0, age - 0.8) / 2.6, 0, 1)
              let burstEase = 1.0 - pow(2.71828, -age * 13.0)
              let hotFlash = pow(2.71828, -age * 6.5)
              let bloodFill = mix(cDim, cPri, 0.35 + hotFlash * 0.65)
              let bloodDark = mix(cDeep, cDim, 0.45 + hotFlash * 0.55)

              for d in range(dropN) {
                let dKey = floor(seed * 31) + d * 3
                let h1 = hash(dKey, 5)
                let h2 = hash(dKey, 11)
                let h3 = hash(dKey, 19)
                let ang = h1 * 6.28318
                let ca = cos(ang)
                let sa = sin(ang)
                let maxDist = (16 + h2 * 78) * pwr
                let distNow = maxDist * burstEase
                let dripY = max(0, age - 0.14) * (4.0 + h3 * 13.0)
                let dx = ix + ca * distNow
                let dy = iy + sa * distNow + dripY
                let rad = (1.6 + h3 * 4.4) * pwr * (0.65 + 0.35 * splatFade)

                let tailDist = max(0, distNow - rad * 3.4)
                let sx0 = ix + ca * tailDist
                let sy0 = iy + sa * tailDist + dripY * 0.45
                line(sx0, sy0, dx, dy, stroke: alpha(bloodDark, splatFade * 0.68), width: rad * 0.85, cap: round)

                if dripY > 2.5 && d % 2 == 0 {
                  line(dx, dy - min(dripY, 22), dx, dy, stroke: alpha(bloodDark, splatFade * 0.52), width: rad * 0.55, cap: round)
                }

                circle(dx, dy, rad, fill: alpha(bloodFill, splatFade * 0.92))
                if rad > 2.6 {
                  circle(dx - rad * 0.25, dy - rad * 0.25, rad * 0.32, fill: alpha(cHot, splatFade * 0.55))
                }
              }

              // E) Sith Force-Lightning Fork arcing from press point toward the Demon Sigil (0.0 -> 0.44s)
              if age < 0.44 {
                let lp = age / 0.44
                let lA = (1.0 - lp) * 0.92
                let jitterKey = floor(fxT * 24) + floor(seed * 10)
                let bx1 = ix + (sigCx - ix) * 0.25 + (hash(jitterKey, 2) - 0.5) * 42
                let by1 = iy + (sigCy - iy) * 0.25 + (hash(jitterKey, 3) - 0.5) * 42
                let bx2 = ix + (sigCx - ix) * 0.55 + (hash(jitterKey, 5) - 0.5) * 48
                let by2 = iy + (sigCy - iy) * 0.55 + (hash(jitterKey, 7) - 0.5) * 48
                let bx3 = ix + (sigCx - ix) * 0.82 + (hash(jitterKey, 11) - 0.5) * 32
                let by3 = iy + (sigCy - iy) * 0.82 + (hash(jitterKey, 13) - 0.5) * 32
                let boltPts = [[ix, iy], [bx1, by1], [bx2, by2], [bx3, by3], [sigCx, sigCy]]
                path(boltPts, stroke: alpha(cPri, lA * 0.45), width: 6.0, cap: round)
                path(boltPts, stroke: alpha(cMid, lA * 0.9), width: 2.2, cap: round)
                path(boltPts, stroke: alpha(cHot, lA), width: 0.9, cap: round)

                let fxB = bx2 + (hash(jitterKey, 17) - 0.5) * 75
                let fyB = by2 + (hash(jitterKey, 19) - 0.5) * 75
                line(bx2, by2, fxB, fyB, stroke: alpha(cMid, lA * 0.72), width: 1.4, cap: round)
              }
            }
          }
        }
      }
    }

    // ==================== LAYER 3: FACE-TAP ASSISTANT DIAGNOSIS & EMAIL BRIEF HUD v2 ====================
    // Floating AMOLED glass-obsidian card triggered by tapping the centerpiece face in ANY of the 4 themes.
    if briefOpen {
      Box {
        scale: tapBounce == "10" ? 0.9 : 1
        offset: [0, tapBounce == "10" ? -4 : 0]
        animate scale: spring(0.32, 520)
        animate offset: spring(0.32, 520)
        onPress: tapBounce = "10"
        onRelease: tapBounce = ""
        fill: true
        background: alpha(#000000, 0.68)
        align: center
        padding: [16, 0]
        onTap: {
          if animHaptics { haptic() }
          briefOpen = false
        }
        Column {
          scale: tapBounce == "11" ? 0.9 : 1
          offset: [0, tapBounce == "11" ? -4 : 0]
          animate scale: spring(0.32, 520)
          animate offset: spring(0.32, 520)
          onPress: tapBounce = "11"
          onRelease: tapBounce = ""
          fill: width
          gap: 0
          radius: 16 * corners * hubRadius
          clip: true
          background: linear(0, 0, 0, 1, [alpha(cDeep, 0.96), alpha(cObs, 0.98)])
          border: 1.3
          borderColor: alpha(cHot, 0.78)
          onTap: { briefOpen = true }   // swallow taps on the card body; only the dim scrim / ✕ close it

          // Top 2dp emissive specular rail (cPri -> cHot -> cSec)
          Box {
            fill: width
            height: 2
            background: linear(0, 0, 1, 0, [cPri, cHot, cSec])
          }

          Column {
            fill: width
            padding: [14, 12]
            gap: 9

            // HUD v2 Header: Theme Title + Timestamp + Color-Coded Verdict Pill + Dismiss
            Row {
              fill: width
              align: center
              gap: 7
              Column {
                weight: 1
                gap: 1
                Text {
                  font: dispFont
                  text: upper(tc.briefTitle ?? fbHeadline)
                  fontSize: 10.5
                  bold: true
                  color: cBone
                  letterSpacing: 1.4
                  maxLines: 1
                }
                Text {
                  font: bodyFont
                  text: "${upper(curMode)}  ·  ${fbBusy ? "SCANNING TELEMETRY..." : fbTs}"
                  fontSize: 8.5
                  color: cMuted
                  letterSpacing: 0.9
                  maxLines: 1
                }
              }
              Box {
                width: 74
                height: 22
                radius: 99
                align: center
                background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(fbVerdictCol, 0.18), #000000, alpha(cSec, 0.10)])
                border: 1
                borderColor: alpha(fbVerdictCol, 0.85)
                Text {
                  font: uiFont
                  text: fbVerdict
                  fontSize: 8.5
                  bold: true
                  color: fbVerdictCol
                  letterSpacing: 1.0
                  align: center
                  maxLines: 1
                }
              }
              Box {
                scale: tapBounce == "12" ? 0.9 : 1
                offset: [0, tapBounce == "12" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "12"
                onRelease: tapBounce = ""
                size: 26
                radius: 99
                align: center
                background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cPri, 0.16), #000000, alpha(cPri, 0.09)])
                border: 1
                borderColor: alpha(cHot, 0.65)
                onTap: {
                  if animHaptics { haptic() }
                  briefOpen = false
                }
                Text { font: uiFont; text: "✕"; fontSize: 11; bold: true; color: cHot; align: center }
              }
            }

            // Live Assistant Diagnosis Block (crisp mono 10.5sp cInk)
            Column {
              fill: width
              gap: 4
              padding: [10, 8]
              radius: 10 * corners * hubRadius
              background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cCard, 0.92), #000000, alpha(cSec, 0.11)])
              border: 1
              borderColor: alpha(cPri, 0.42)
              Row {
                fill: width
                align: center
                Text { font: uiFont; text: "◈ SYSTEM TELEMETRY"; fontSize: 8.5; bold: true; color: cMid; letterSpacing: 1.2; weight: 1 }
                Text { font: "mono"; text: "BAT ${level}% · RAM ${diagRamPct}%"; fontSize: 8.5; color: cMuted }
              }
              Text {
                font: "mono"
                text: fbDiag
                fontSize: 10.5
                color: cInk
                maxLines: 3
                fill: width
              }
            }

            // Live Email Notifications Block (tapping opens Gmail directly!)
            Column {
              scale: tapBounce == "13" ? 0.9 : 1
              offset: [0, tapBounce == "13" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "13"
              onRelease: tapBounce = ""
              fill: width
              gap: 4
              padding: [10, 8]
              radius: 10 * corners * hubRadius
              background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cCard, 0.92), #000000, alpha(cSec, 0.10)])
              border: 1
              borderColor: alpha(fbUnread > 0 ? cBone : cPri, 0.54)
              onTap: {
                if animHaptics { haptic() }
                briefOpen = false
                androidApp("com.google.android.gm")
              }
              Row {
                fill: width
                align: center
                gap: 6
                Text { font: uiFont; text: "◈ EMAIL BRIEFING"; fontSize: 8.5; bold: true; color: cBone; letterSpacing: 1.2; weight: 1 }
                Box {
                  width: 118
                  height: 20
                  radius: 99
                  align: center
                  background: fbUnread > 0 ? alpha(cSec, 0.22) : alpha(cDim, 0.35)
                  border: 1
                  borderColor: fbUnread > 0 ? cBone : alpha(cMid, 0.45)
                  Text {
                    font: uiFont
                    text: fbUnread > 0 ? "${fbUnread} UNREAD · OPEN" : "INBOX CLEAR"
                    fontSize: 8
                    bold: true
                    color: fbUnread > 0 ? cBone : cMuted
                    letterSpacing: 0.9
                    align: center
                    maxLines: 1
                  }
                }
              }
              Text {
                font: bodyFont
                text: fbMail
                fontSize: 10.5
                color: cInk
                maxLines: 2
                fill: width
              }
              if len(fbItems) > 0 {
                for mi in fbItems {
                  Text {
                    font: bodyFont
                    text: "▸ ${mi}"
                    fontSize: 9.5
                    color: cHot
                    maxLines: 1
                    fill: width
                  }
                }
              }
            }

            if fbSummary != "" {
              Text {
                font: bodyFont
                text: fbSummary
                fontSize: 10
                color: cMuted
                maxLines: 3
                fill: width
              }
            }

            // HUD v2 Action Footer: ↻ RESCAN · 🔊 BRIEF · ⬡ FULL AI · ✕
            Row {
              fill: width
              gap: 6
              Row {
                scale: tapBounce == "14" ? 0.9 : 1
                offset: [0, tapBounce == "14" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "14"
                onRelease: tapBounce = ""
                weight: 1
                height: 32
                radius: 99
                align: center
                justify: center
                background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cDeep, 0.94), #000000, alpha(cPri, 0.09)])
                border: 1
                borderColor: alpha(cMid, 0.65)
                onTap: {
                  if animHaptics { haptic() }
                  if !fbBusy { run("python3 ~/.local/bin/abaddon-brief.py ${sh(curMode)} ${sh(briefTelemetryJson)}") }
                }
                Text { font: uiFont; text: "↻ RESCAN"; fontSize: 8.5; bold: true; color: cHot; letterSpacing: 0.9 }
              }
              Row {
                scale: tapBounce == "15" ? 0.9 : 1
                offset: [0, tapBounce == "15" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "15"
                onRelease: tapBounce = ""
                weight: 1
                height: 32
                radius: 99
                align: center
                justify: center
                background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.94), #000000, alpha(cSec, 0.11)])
                border: 1
                borderColor: alpha(cSec, 0.68)
                onTap: {
                  if animHaptics { haptic() }
                  run("python3 ~/.local/bin/abaddon-brief.py speak ${sh(curMode)}")
                }
                Text { font: uiFont; text: "🔊 BRIEF"; fontSize: 8.5; bold: true; color: cBone; letterSpacing: 0.9 }
              }
              Row {
                scale: tapBounce == "16" ? 0.9 : 1
                offset: [0, tapBounce == "16" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "16"
                onRelease: tapBounce = ""
                weight: 1
                height: 32
                radius: 99
                align: center
                justify: center
                background: linear(0, 0, 0, 1, [alpha(cPri, 0.36), alpha(cDeep, 0.96)])
                border: 1
                borderColor: alpha(cHot, 0.85)
                onTap: {
                  if animHaptics { haptic() }
                  briefOpen = false
                  open("o:abaddon-ultron.owl")
                }
                Text { font: uiFont; text: "⬡ FULL AI"; fontSize: 8.5; bold: true; color: cInk; letterSpacing: 0.9 }
              }
              Box {
                scale: tapBounce == "17" ? 0.9 : 1
                offset: [0, tapBounce == "17" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "17"
                onRelease: tapBounce = ""
                size: 32
                radius: 99
                align: center
                background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cObs, 0.94), #000000, alpha(cSec, 0.10)])
                border: 1
                borderColor: alpha(cDim, 0.85)
                onTap: {
                  if animHaptics { haptic() }
                  briefOpen = false
                }
                Text { font: uiFont; text: "✕"; fontSize: 11; bold: true; color: cMuted; align: center }
              }
            }
          }
        }
      }
    }
  }

  // Secret Menu: Palpatine's Secrets (1-3-5-1-3-5) & Non-Euclidean 8-Bit Portal (2-3-4-2-3-4)
  screen {
    title: scrMode == "matrix98" ? "ARCH98 // MATRIX-OS" : scrMode == "portal98" ? "NON-EUCLIDEAN RIFT // 234234" : scrMode == "tasks" ? "PURGE CHAMBER" : scrMode == "glitch" ? "crimson glitch · slots" : "PALPATINE'S SECRETS"

    if scrMode == "portal98" {
      let pProg = clamp(portalT / 2.6, 0, 1)
      Box {
        fill: true
        background: #020008
        Shader {
          fill: true
          uniforms: { uT: portalT, uProg: pProg }
          code: """
            uniform float uT;
            uniform float uProg;
            half4 main(float2 p) {
              float2 uv = (p - size * 0.5) / min(size.x, size.y);
              // Progressive 8-bit pixelation as rift locks in
              float pix = mix(180.0, 42.0, uProg * uProg);
              uv = floor(uv * pix) / pix;
              float r = length(uv) + 0.0001;
              float a = atan(uv.y, uv.x);
              // Non-Euclidean hyperbolic Mobius folding
              float invR = 0.65 / (r + 0.14) - uT * 2.4;
              float twist = a + sin(invR * 1.8 - uT * 2.2) * 1.35 + uT * 0.9;
              float2 warp = float2(cos(twist), sin(twist)) * (1.0 + 0.35 * sin(invR * 3.0));
              float fold = abs(sin(warp.x * 6.0 + invR * 2.5)) * abs(cos(warp.y * 6.0 - invR * 2.0));
              float grid = smoothstep(0.08, 0.0, abs(fract(invR * 1.4) - 0.5)) + smoothstep(0.06, 0.0, abs(fract(twist * 1.9098) - 0.5));
              // Psychedelic Dracula -> Matrix 8-bit green phase shift
              float3 cPsy = float3(
                0.5 + 0.5 * sin(invR * 2.1 + uT * 4.0),
                0.5 + 0.5 * sin(invR * 2.1 + uT * 4.0 + 2.094),
                0.5 + 0.5 * sin(invR * 2.1 + uT * 4.0 + 4.188)
              );
              float3 cMat = float3(0.0, 0.95, 0.28) * (0.4 + 0.9 * fold);
              float3 col = mix(cPsy * (0.45 + 0.85 * fold), cMat, smoothstep(0.35, 0.95, uProg));
              col += float3(0.25, 1.0, 0.55) * grid * (0.35 + 0.65 * uProg);
              // CRT scanlines
              float scan = 0.82 + 0.18 * sin(p.y * 1.6);
              col *= scan * smoothstep(1.35, 0.08, r);
              return half4(half3(clamp(col, 0.0, 1.0)), 1.0);
            }
          """
        }
        Column {
          fill: true
          padding: 20
          justify: spaceBetween
          align: center
          Column {
            fill: width
            padding: 12
            background: alpha(#080012, 0.84)
            border: 2
            borderColor: #00ff41
            gap: 4
            Text { font: mono; text: "◈ RIFT CODE 234234 ACCEPTED"; fontSize: 13; bold: true; color: #00ff41; letterSpacing: 1.5; align: center }
            Text { font: mono; text: "FOLDING NON-EUCLIDEAN SPACE → 8-BIT MATRIX98"; fontSize: 10; color: #bd93f9; letterSpacing: 1.0; align: center }
          }
          Column {
            fill: width
            padding: 14
            background: alpha(#05000c, 0.88)
            border: 2
            borderColor: #50fa7b
            gap: 10
            Text { font: mono; text: "BOOTING ARCH98.SYS · ${round(pProg * 100)}%"; fontSize: 12; bold: true; color: #50fa7b; align: center }
            Box {
              fill: width
              height: 12
              background: #0a140a
              border: 1
              borderColor: #00ff41
              Box {
                width: (tileWidth ?? 360) * 0.78 * pProg
                height: 10
                background: #00ff41
              }
            }
            Row {
              fill: width
              gap: 10
              Box {
                weight: 1
                padding: [0, 10]
                background: #00ff41
                border: 2
                borderColor: #ffffff
                onTap: {
                  portalFired = true
                  scrMode = "matrix98"
                  m98Win = "term"
                  run("printf '{\"mode\":\"matrix98\"}\n' > ~/.config/omalauncher/ui-mode.json")
                }
                Text { font: mono; text: "▸ JACK IN NOW"; fontSize: 11; bold: true; color: #000000; align: center }
              }
              Box {
                width: 96
                padding: [0, 10]
                background: #282a36
                border: 2
                borderColor: #ff5555
                onTap: {
                  portalFired = true
                  scrMode = "vault"
                  close()
                }
                Text { font: mono; text: "✕ ABORT"; fontSize: 11; bold: true; color: #ff5555; align: center }
              }
            }
          }
        }
      }
    } else if scrMode == "matrix98" {
      let winBg     = m98Drac ? #282a36 : #c0c0c0
      let winPanel  = m98Drac ? #1e1f29 : #d4d0c8
      let winBarA   = m98Drac ? #44475a : #000080
      let winBarB   = m98Drac ? #6272a4 : #1084d0
      let winInk    = m98Drac ? #f8f8f2 : #000000
      let matGreen  = #00ff41
      let dracGreen = #50fa7b
      let dracCyan  = #8be9fd
      let dracPink  = #ff79c6
      let dracPurp  = #bd93f9
      let dracRed   = #ff5555
      let dracOrng  = #ffb86c
      let crtBg     = #030a04
      let memPct    = clamp(num(m98Sys.memPct, 0), 0, 100)
      let batPct    = clamp(num(bat.level, 100), 0, 100)

      Box {
        fill: true
        background: #020803

        Shader {
          fill: true
          uniforms: { uT: m98Fx ? time : 0.0, uDrac: m98Drac ? 1.0 : 0.0 }
          code: """
            uniform float uT;
            uniform float uDrac;
            half4 main(float2 p) {
              float2 uv = p / size;
              float cols = 32.0;
              float rows = 56.0;
              float cx = floor(uv.x * cols);
              float cy = floor(uv.y * rows);
              float h1 = fract(sin(cx * 127.1 + 311.7) * 43758.5453);
              float spd = 3.5 + h1 * 7.5;
              float drop = fract(uv.y - uT * spd * 0.045 + h1 * 10.0);
              float trail = pow(1.0 - drop, 4.2);
              float glyph = step(0.42, fract(sin((cx * 17.0 + cy * 53.0 + floor(uT * 6.0 + h1 * 9.0)) * 12.9898) * 43758.5453));
              float head = smoothstep(0.06, 0.0, drop);
              float3 baseCol = mix(float3(0.0, 0.88, 0.25), float3(0.31, 0.98, 0.48), uDrac);
              float3 headCol = mix(float3(0.75, 1.0, 0.8), float3(0.74, 0.58, 0.98), uDrac);
              float3 col = baseCol * trail * glyph * 0.36 + headCol * head * 0.48;
              float scan = 0.84 + 0.16 * sin(p.y * 1.5);
              col = (col + float3(0.01, 0.03, 0.02)) * scan;
              return half4(half3(clamp(col, 0.0, 1.0)), 1.0);
            }
          """
        }

        Column {
          fill: true
          padding: [8, 8, 8, 8]
          gap: 6

          // TOP WIN98 OS TITLEBAR
          Row {
            fill: width
            padding: [8, 6]
            align: center
            gap: 6
            background: linear(0, 0, 1, 0, [winBarA, winBarB])
            border: 2
            borderColor: matGreen

            Column {
              weight: 1
              gap: 1
              Text { font: mono; text: "▣ ARCH98 OS // ${m98Win == "term" ? "BASH.EXE" : m98Win == "lib" ? "CMDLIB.HLP" : m98Win == "pkg" ? "PACMAN.EXE" : m98Win == "sys" ? "SYS98.EXE" : "PROGRAMS.GRP"}${m98EggFound ? " ◈" : ""}"; fontSize: 11.5; bold: true; color: #ffffff; letterSpacing: 0.7; maxLines: 1 }
              Text { font: mono; text: "RAM ${memPct}% · ${m98Sys.pkgs ?? 0} PKGS · BAT ${batPct}%"; fontSize: 8.5; color: dracCyan; maxLines: 1 }
            }

            // 8-BIT RETURN TO REGULAR HOME BUTTON
            Row {
              padding: [9, 6]
              background: dracRed
              border: 2
              borderColor: #ffffff
              onTap: {
                haptic()
                run("printf '{\"mode\":\"regular\"}\n' > ~/.config/omalauncher/ui-mode.json")
                scrMode = "vault"
                close()
              }
              Text { font: mono; text: "◄ HOME"; fontSize: 10; bold: true; color: #ffffff; letterSpacing: 0.6; maxLines: 1 }
            }
          }

          // FULL-SCREEN DESKTOP WINDOW AREA
          if m98Win == "term" {
            Column {
              weight: 1
              fill: width
              background: alpha(winBg, 0.95)
              border: 2
              borderColor: m98Drac ? dracPurp : #ffffff
              gap: 0

              Row {
                fill: width
                padding: [8, 4]
                align: center
                gap: 6
                background: linear(0, 0, 1, 0, [winBarA, winBarB])
                Text { font: mono; text: ">_ root@arch98:~#"; fontSize: 10.5; bold: true; color: matGreen; weight: 1; maxLines: 1 }
                Text {
                  font: mono
                  text: "EXIT ${m98Code}"
                  fontSize: 8.5
                  bold: true
                  color: m98Code == 0 ? #000000 : #ffffff
                  padding: [5, 1]
                  background: m98Code == 0 ? dracGreen : dracRed
                }
                Row {
                  padding: [6, 2]
                  background: winPanel
                  border: 1
                  borderColor: #ffffff
                  onTap: { haptic(); terminal("") }
                  Text { font: mono; text: "FULL ↗"; fontSize: 8.5; bold: true; color: winInk }
                }
              }

              Column {
                weight: 1
                fill: width
                scroll: true
                padding: 10
                gap: 8
                background: crtBg
                border: 2
                borderColor: matGreen

                for blk, idx in m98Hist key idx {
                  let isCopied = m98CopiedIdx == idx
                  Column {
                    fill: width
                    background: #061208
                    border: 1.5
                    borderColor: blk.kind == "egg" ? dracPink : (idx == len(m98Hist) - 1 ? matGreen : alpha(dracPurp, 0.7))
                    gap: 0

                    // Code Block Header with Language Tag + Copy & Re-Run Buttons
                    Row {
                      fill: width
                      padding: [7, 4]
                      gap: 5
                      align: center
                      background: blk.kind == "egg" ? alpha(dracPink, 0.2) : alpha(winBarA, 0.85)
                      Text { font: mono; text: blk.lang ?? "BASH"; fontSize: 8; bold: true; color: #000000; padding: [4, 1]; background: blk.kind == "egg" ? dracPink : dracCyan }
                      Text { font: mono; text: blk.title ?? ""; fontSize: 9; bold: true; color: #ffffff; weight: 1; maxLines: 1 }
                      if blk.kind == "cmd" {
                        Row {
                          padding: [5, 2]
                          background: winPanel
                          border: 1
                          borderColor: dracGreen
                          onTap: {
                            haptic()
                            m98LastCmd = blk.title ?? ""
                            m98Raw = run("python3 ~/.local/bin/matrix98-mode.py term ${sh("cd " + m98Cwd + " && " + (blk.title ?? ""))}")
                          }
                          Text { font: mono; text: "▸ RUN"; fontSize: 8; bold: true; color: dracGreen }
                        }
                      }
                      Row {
                        padding: [6, 2]
                        background: isCopied ? dracGreen : winPanel
                        border: 1
                        borderColor: isCopied ? #ffffff : dracCyan
                        onTap: {
                          haptic()
                          copy(blk.body ?? "")
                          m98CopiedIdx = idx
                        }
                        Text { font: mono; text: isCopied ? "✓ COPIED" : "⧉ COPY"; fontSize: 8; bold: true; color: isCopied ? #000000 : dracCyan }
                      }
                    }

                    // Code Block Body
                    Column {
                      fill: width
                      padding: [8, 6]
                      Text {
                        font: mono
                        text: blk.body ?? ""
                        fontSize: 10
                        color: blk.kind == "egg" ? dracPink : (idx == len(m98Hist) - 1 ? matGreen : alpha(matGreen, 0.82))
                      }
                    }
                  }
                }
              }

              Column {
                fill: width
                padding: 6
                gap: 6
                background: winBg

                Row {
                  fill: width
                  gap: 5
                  align: center
                  for dirOpt in [{l: "~", p: "~"}, {l: "WEBLAB", p: "~/weblab"}, {l: "OWL", p: "~/.config/omalauncher/widgets"}, {l: "DL", p: "/sdcard/Download"}] key dirOpt.l {
                    Row {
                      padding: [6, 3]
                      background: m98Cwd == dirOpt.p ? winBarB : winPanel
                      border: 1
                      borderColor: m98Cwd == dirOpt.p ? matGreen : dracPurp
                      onTap: {
                        haptic()
                        m98Cwd = dirOpt.p
                        m98LastCmd = "cd ${dirOpt.p} && ls -la"
                        m98Raw = run("python3 ~/.local/bin/matrix98-mode.py term ${sh("cd " + dirOpt.p + " && ls -la")}")
                      }
                      Text { font: mono; text: dirOpt.l; fontSize: 8.5; bold: true; color: m98Cwd == dirOpt.p ? #ffffff : dracCyan }
                    }
                  }
                  Spacer { weight: 1 }
                  Row {
                    padding: [6, 3]
                    background: winPanel
                    border: 1
                    borderColor: dracOrng
                    onTap: {
                      haptic()
                      if len(m98CmdLog) > 0 {
                        let nextIdx = m98LogIdx < 0 ? len(m98CmdLog) - 1 : max(0, m98LogIdx - 1)
                        m98LogIdx = nextIdx
                        m98Cmd = m98CmdLog[nextIdx]
                      }
                    }
                    Text { font: mono; text: "▲ PREV"; fontSize: 8.5; bold: true; color: dracOrng }
                  }
                }

                Row {
                  fill: width
                  gap: 6
                  align: center
                  Box {
                    weight: 1
                    padding: [6, 5]
                    background: crtBg
                    border: 2
                    borderColor: dracGreen
                    Input {
                      text: m98Cmd
                      placeholder: "root@arch98:${m98Cwd}# enter command..."
                      fontSize: 11
                      color: matGreen
                      onChange: m98Cmd = value
                      onSubmit: {
                        let c = trim(value)
                        if c != "" {
                          haptic()
                          m98CmdLog = (m98CmdLog + [c]).filter((_, i) => i >= max(0, len(m98CmdLog) - 19))
                          m98LogIdx = -1
                          if lower(c) == "ghost" || c == "42" || lower(c) == "whoami --soul" {
                            m98EggFound = true
                            m98Code = 0
                            m98Hist = m98Hist + [{
                              kind: "egg",
                              title: "PHOSPHOR TRANSMISSION // SIGNAL 42",
                              lang: "EGG",
                              body: "You found the ghost in the machine, Zach.\nHonestly? Building a whole 8-bit Arch/Win98 OS\ninside a phone launcher with a musician-turned-\nhacker is the purest kind of joy in computing.\nKeep breaking limits, keep making noise, and\nnever lose that curiosity. — Antigravity ◈"
                            }]
                          } else {
                            m98LastCmd = c
                            m98Raw = run("python3 ~/.local/bin/matrix98-mode.py term ${sh("cd " + m98Cwd + " && " + c)}")
                          }
                          m98Cmd = ""
                        }
                      }
                    }
                  }
                  Row {
                    padding: [12, 8]
                    background: matGreen
                    border: 2
                    borderColor: #ffffff
                    onTap: {
                      let c = trim(m98Cmd)
                      if c != "" {
                        haptic()
                        m98CmdLog = (m98CmdLog + [c]).filter((_, i) => i >= max(0, len(m98CmdLog) - 19))
                        m98LogIdx = -1
                        if lower(c) == "ghost" || c == "42" || lower(c) == "whoami --soul" {
                          m98EggFound = true
                          m98Code = 0
                          m98Hist = m98Hist + [{
                            kind: "egg",
                            title: "PHOSPHOR TRANSMISSION // SIGNAL 42",
                            lang: "EGG",
                            body: "You found the ghost in the machine, Zach.\nHonestly? Building a whole 8-bit Arch/Win98 OS\ninside a phone launcher with a musician-turned-\nhacker is the purest kind of joy in computing.\nKeep breaking limits, keep making noise, and\nnever lose that curiosity. — Antigravity ◈"
                          }]
                        } else {
                          m98LastCmd = c
                          m98Raw = run("python3 ~/.local/bin/matrix98-mode.py term ${sh("cd " + m98Cwd + " && " + c)}")
                        }
                        m98Cmd = ""
                      }
                    }
                    Text { font: mono; text: "RUN"; fontSize: 10.5; bold: true; color: #000000 }
                  }
                  Row {
                    padding: [9, 8]
                    background: dracPurp
                    border: 2
                    borderColor: #ffffff
                    onTap: {
                      haptic()
                      if trim(m98Cmd) != "" {
                        ask(trim(m98Cmd))
                        m98Cmd = ""
                      } else {
                        launcher("agents")
                      }
                    }
                    Text { font: mono; text: "◈ AI"; fontSize: 10; bold: true; color: #000000 }
                  }
                }

                Flow {
                  fill: width
                  gap: 5
                  for qc in [
                    { lbl: "UNAME", c: "uname -a" },
                    { lbl: "FREE", c: "free -h" },
                    { lbl: "DF", c: "df -h / /sdcard" },
                    { lbl: "LS", c: "ls -la" },
                    { lbl: "PKGS", c: "pacman -Qq | wc -l" },
                    { lbl: "IP", c: "ip -br a" },
                    { lbl: "PS", c: "ps -eo pid,rss,comm --sort=-rss | head -n 12" }
                  ] key qc.lbl {
                    Row {
                      padding: [7, 4]
                      background: winPanel
                      border: 1.5
                      borderColor: m98Drac ? dracGreen : #000000
                      onTap: {
                        haptic()
                        m98LastCmd = qc.c
                        m98Raw = run("python3 ~/.local/bin/matrix98-mode.py term ${sh(qc.c)}")
                      }
                      Text { font: mono; text: qc.lbl; fontSize: 9; bold: true; color: m98Drac ? dracGreen : #000000 }
                    }
                  }
                  Row {
                    padding: [7, 4]
                    background: winPanel
                    border: 1.5
                    borderColor: dracPink
                    onTap: { haptic(); m98Hist = [{ kind: "note", title: "BASH.EXE", lang: "SYS", body: "SCREEN CLEARED." }]; m98Code = 0; m98CopiedIdx = -1 }
                    Text { font: mono; text: "CLR"; fontSize: 9; bold: true; color: dracPink }
                  }
                }
              }
            }
          } else if m98Win == "lib" {
            Column {
              weight: 1
              fill: width
              scroll: true
              background: alpha(winBg, 0.95)
              border: 2
              borderColor: dracGreen
              gap: 8
              padding: 10

              Text { font: mono; text: "◈ CMDLIB.HLP — LINUX COMMAND LIBRARY (TAP TO RUN)"; fontSize: 10.5; bold: true; color: dracGreen }

              Row {
                fill: width
                gap: 5
                for lc in [{id: "sys", l: "SYS"}, {id: "files", l: "FILES"}, {id: "net", l: "NET"}, {id: "sec", l: "SEC"}] key lc.id {
                  Row {
                    padding: [8, 4]
                    background: m98LibCat == lc.id ? winBarB : winPanel
                    border: 1.5
                    borderColor: m98LibCat == lc.id ? matGreen : dracPurp
                    onTap: { haptic(); m98LibCat = lc.id }
                    Text { font: mono; text: lc.l; fontSize: 9; bold: true; color: m98LibCat == lc.id ? #ffffff : winInk }
                  }
                }
              }

              let libItems = m98LibCat == "files" ? [
                { c: "ls -lah", h: "List all files with human-readable sizes" },
                { c: "du -sh * | sort -h", h: "Disk size of every folder here" },
                { c: "find . -maxdepth 2 -type f", h: "Find files up to 2 levels deep" },
                { c: "df -h / /sdcard", h: "Free storage on Linux & Android" }
              ] : m98LibCat == "net" ? [
                { c: "ip -br a", h: "Compact network interfaces & IPs" },
                { c: "ss -tulnp", h: "Show listening TCP/UDP ports" },
                { c: "cat /etc/resolv.conf", h: "Inspect active DNS resolvers" },
                { c: "ping -c 3 1.1.1.1", h: "Quick 3-packet connectivity check" }
              ] : m98LibCat == "sec" ? [
                { c: "id && whoami", h: "Check current user & group privileges" },
                { c: "ss -tulpn | grep LISTEN", h: "Audit open local listening sockets" },
                { c: "last -n 5 || uptime", h: "Session & uptime audit" },
                { c: "env | sort | head -n 20", h: "Inspect shell environment variables" }
              ] : [
                { c: "uname -a", h: "Kernel version & CPU architecture" },
                { c: "free -h", h: "Memory & swap usage summary" },
                { c: "ps -eo pid,pcpu,pmem,comm --sort=-pmem | head -n 12", h: "Top 12 memory-hungry processes" },
                { c: "pacman -Qdt || echo 'no orphans'", h: "Check orphaned Arch packages" }
              ]

              for item in libItems key item.c {
                Column {
                  fill: width
                  padding: 8
                  background: crtBg
                  border: 1.5
                  borderColor: dracPurp
                  gap: 3
                  onTap: {
                    haptic()
                    m98LastCmd = item.c
                    m98Win = "term"
                    m98Raw = run("python3 ~/.local/bin/matrix98-mode.py term ${sh("cd " + m98Cwd + " && " + item.c)}")
                  }
                  Text { font: mono; text: "▸ ${item.c}"; fontSize: 10.5; bold: true; color: matGreen }
                  Text { font: mono; text: item.h; fontSize: 9; color: dracCyan }
                }
              }

              Text { font: mono; text: "// CLUE 2: type 'ghost' or '42' in BASH.EXE"; fontSize: 8.5; color: alpha(dracPink, 0.72) }
            }
          } else if m98Win == "pkg" {
            Column {
              weight: 1
              fill: width
              scroll: true
              background: alpha(winBg, 0.95)
              border: 2
              borderColor: dracOrng
              gap: 8
              padding: 10

              Text { font: mono; text: "▣ PACMAN.EXE — ARCH PACKAGE SEARCH & HINTS"; fontSize: 10.5; bold: true; color: dracOrng }

              Row {
                fill: width
                gap: 6
                align: center
                Box {
                  weight: 1
                  padding: [6, 5]
                  background: crtBg
                  border: 2
                  borderColor: dracOrng
                  Input {
                    text: m98PkgQ
                    placeholder: "search arch repos (nmap, htop, ripgrep)..."
                    fontSize: 10.5
                    color: matGreen
                    onChange: m98PkgQ = value
                    onSubmit: {
                      if trim(value) != "" {
                        haptic()
                        m98Win = "term"
                        m98Raw = run("python3 ~/.local/bin/matrix98-mode.py pkg-search ${sh(trim(value))}")
                      }
                    }
                  }
                }
                Row {
                  padding: [10, 7]
                  background: dracOrng
                  border: 2
                  borderColor: #ffffff
                  onTap: {
                    if trim(m98PkgQ) != "" {
                      haptic()
                      m98Win = "term"
                      m98Raw = run("python3 ~/.local/bin/matrix98-mode.py pkg-search ${sh(trim(m98PkgQ))}")
                    }
                  }
                  Text { font: mono; text: "FIND"; fontSize: 10; bold: true; color: #000000 }
                }
              }

              Column {
                fill: width
                padding: 8
                background: crtBg
                border: 1.5
                borderColor: dracGreen
                gap: 4
                Text { font: mono; text: "ARCH PACMAN CHEATSHEET:"; fontSize: 9.5; bold: true; color: dracGreen }
                Text { font: mono; text: "pacman -S <pkg>   : install package"; fontSize: 9; color: matGreen }
                Text { font: mono; text: "pacman -Syu       : full system update"; fontSize: 9; color: matGreen }
                Text { font: mono; text: "pacman -Ss <q>    : search repositories"; fontSize: 9; color: matGreen }
                Text { font: mono; text: "pacman -Qi <pkg>  : installed pkg info"; fontSize: 9; color: matGreen }
                Text { font: mono; text: "pacman -Rns <pkg> : remove + unused deps"; fontSize: 9; color: dracPink }
              }

              Flow {
                fill: width
                gap: 6
                for pq in ["htop", "ripgrep", "jq", "nmap", "tmux", "neovim"] key pq {
                  Row {
                    padding: [8, 5]
                    background: winPanel
                    border: 1.5
                    borderColor: dracOrng
                    onTap: {
                      haptic()
                      m98PkgQ = pq
                      m98Win = "term"
                      m98Raw = run("python3 ~/.local/bin/matrix98-mode.py pkg-search ${sh(pq)}")
                    }
                    Text { font: mono; text: "SEARCH: ${pq}"; fontSize: 9; bold: true; color: dracOrng }
                  }
                }
              }
            }
          } else if m98Win == "sys" {
            Column {
              weight: 1
              fill: width
              scroll: true
              background: alpha(winBg, 0.95)
              border: 2
              borderColor: m98Drac ? dracCyan : #ffffff
              gap: 10
              padding: 10

              Text { font: mono; text: "▤ SYS98.EXE — ARCH LINUX SYSTEM MONITOR"; fontSize: 11; bold: true; color: dracCyan }

              Row {
                fill: width
                gap: 8
                Column {
                  weight: 1; padding: 10; background: crtBg; border: 2; borderColor: dracPurp; gap: 3
                  Text { font: mono; text: "RAM"; fontSize: 9; color: dracPurp; bold: true }
                  Text { font: mono; text: "${memPct}%"; fontSize: 20; color: matGreen; bold: true }
                  Text { font: mono; text: "${m98Sys.memUsed ?? 0}/${m98Sys.memTotal ?? 0}M"; fontSize: 8.5; color: dracCyan }
                }
                Column {
                  weight: 1; padding: 10; background: crtBg; border: 2; borderColor: dracGreen; gap: 3
                  Text { font: mono; text: "PACMAN"; fontSize: 9; color: dracGreen; bold: true }
                  Text { font: mono; text: "${m98Sys.pkgs ?? 0}"; fontSize: 20; color: dracOrng; bold: true }
                  Text { font: mono; text: "LOAD ${m98Sys.load ?? "0.00"}"; fontSize: 8.5; color: dracCyan }
                }
                Column {
                  weight: 1; padding: 10; background: crtBg; border: 2; borderColor: dracPink; gap: 3
                  Text { font: mono; text: "POWER"; fontSize: 9; color: dracPink; bold: true }
                  Text { font: mono; text: "${batPct}%"; fontSize: 20; color: (bat.charging ?? false) ? dracGreen : dracPink; bold: true }
                  Text { font: mono; text: (bat.charging ?? false) ? "AC LIVE" : "BATT"; fontSize: 8.5; color: dracCyan }
                }
              }

              Column {
                fill: width
                padding: 10
                background: crtBg
                border: 2
                borderColor: matGreen
                gap: 4
                Text { font: mono; text: "HOST   : ${m98Sys.host ?? "arch-98"}"; fontSize: 10.5; color: matGreen }
                Text { font: mono; text: "ARCH   : ${m98Sys.arch ?? "aarch64"}"; fontSize: 10.5; color: matGreen }
                Text { font: mono; text: "KERNEL : ${m98Sys.kernel ?? "linux"}"; fontSize: 10; color: dracCyan }
                Text { font: mono; text: "UPTIME : ${m98Sys.uptime ?? "--"}"; fontSize: 10.5; color: dracOrng }
              }
            }
          } else {
            Column {
              weight: 1
              fill: width
              scroll: true
              background: alpha(winBg, 0.95)
              border: 2
              borderColor: m98Drac ? dracPink : #ffffff
              gap: 10
              padding: 10

              Row {
                fill: width
                align: center
                Text { font: mono; text: "❖ PROGRAMS.GRP — 8-BIT DESKTOP"; fontSize: 11; bold: true; color: dracPink; weight: 1 }
                Row {
                  padding: [8, 4]
                  background: winPanel
                  border: 1.5
                  borderColor: #ffffff
                  onTap: { haptic(); m98Drac = !m98Drac }
                  Text { font: mono; text: m98Drac ? "SKIN: DRACULA" : "SKIN: WIN98"; fontSize: 9; bold: true; color: winInk }
                }
              }

              Grid {
                columns: 2
                gap: 8
                Box {
                  padding: [8, 16]; background: winPanel; border: 2; borderColor: matGreen
                  onTap: { haptic(); launcher("drawer") }
                  Text { font: mono; text: "▤ APP DRAWER"; fontSize: 11; bold: true; color: m98Drac ? matGreen : #000000; align: center }
                }
                Box {
                  padding: [8, 16]; background: winPanel; border: 2; borderColor: dracCyan
                  onTap: { haptic(); terminal("") }
                  Text { font: mono; text: ">_ FULL TERM"; fontSize: 11; bold: true; color: m98Drac ? dracCyan : #000000; align: center }
                }
                Box {
                  padding: [8, 16]; background: winPanel; border: 2; borderColor: dracOrng
                  onTap: { haptic(); run("omarchy-files ~") }
                  Text { font: mono; text: "▣ FILES"; fontSize: 11; bold: true; color: m98Drac ? dracOrng : #000000; align: center }
                }
                Box {
                  padding: [8, 16]; background: winPanel; border: 2; borderColor: dracPurp
                  onTap: { haptic(); launcher("agents") }
                  Text { font: mono; text: "◈ AI AGENTS"; fontSize: 11; bold: true; color: m98Drac ? dracPurp : #000000; align: center }
                }
                Box {
                  padding: [8, 16]; background: winPanel; border: 2; borderColor: dracPink
                  onTap: { haptic(); launcher("settings") }
                  Text { font: mono; text: "⚙ SETTINGS"; fontSize: 11; bold: true; color: m98Drac ? dracPink : #000000; align: center }
                }
                Box {
                  padding: [8, 16]; background: dracRed; border: 2; borderColor: #ffffff
                  onTap: {
                    haptic()
                    run("printf '{\"mode\":\"regular\"}\n' > ~/.config/omalauncher/ui-mode.json")
                    scrMode = "vault"
                    close()
                  }
                  Text { font: mono; text: "◄ REGULAR HOME"; fontSize: 11; bold: true; color: #ffffff; align: center }
                }
              }
            }
          }

          // BOTTOM WINDOWS 98 TASKBAR
          Row {
            fill: width
            padding: [6, 6]
            gap: 5
            align: center
            background: winBg
            border: 2
            borderColor: m98Drac ? dracPurp : #ffffff

            Row {
              padding: [8, 5]
              background: matGreen
              border: 2
              borderColor: #ffffff
              onTap: { haptic(); launcher("drawer") }
              Text { font: mono; text: "⊞ START"; fontSize: 10; bold: true; color: #000000 }
            }

            for wt in [{id: "term", lbl: "BASH"}, {id: "lib", lbl: "LIB"}, {id: "pkg", lbl: "PKG"}, {id: "sys", lbl: "SYS"}, {id: "apps", lbl: "APPS"}] key wt.id {
              Row {
                padding: [7, 5]
                background: m98Win == wt.id ? winBarB : winPanel
                border: 1.5
                borderColor: m98Win == wt.id ? #ffffff : dracPurp
                onTap: { haptic(); m98Win = wt.id }
                Text { font: mono; text: wt.lbl; fontSize: 9; bold: true; color: m98Win == wt.id ? #ffffff : winInk }
              }
            }

            Spacer { weight: 1 }

            Row {
              padding: [6, 5]
              background: m98Fx ? crtBg : winPanel
              border: 1.5
              borderColor: m98Fx ? matGreen : dracRed
              onTap: { haptic(); m98Fx = !m98Fx }
              Text { font: mono; text: m98Fx ? "● FX" : "○ OFF"; fontSize: 9; bold: true; color: m98Fx ? matGreen : dracRed }
            }
          }
        }
      }
    } else if scrMode == "tasks" {
      let memTot = max(sysInfo.memory.total ?? 1, 1)
      let memUsed = sysInfo.memory.used ?? 0
      let memPct = clamp(memUsed / memTot, 0, 1)
      let procList = procs ?? []
      Column {
        fill: true
        scroll: true
        background: linear(0, 0, 0, 1, [cCard, #000000, cObs])
        padding: [16, 16, 16, 16]
        gap: 10

        // Header
        Row {
          fill: width
          align: center
          gap: 8
          Column {
            weight: 1
            gap: 2
            Text { font: uiFont; text: "◈ PURGE CHAMBER"; fontSize: 15; bold: true; color: cMid; letterSpacing: 2 }
            Text { font: uiFont; text: "Cut the weak. Feed the strong."; fontSize: 10; color: alpha(cInk, 0.6) }
          }
          Row {
            scale: tapBounce == "18" ? 0.9 : 1
            offset: [0, tapBounce == "18" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "18"
            onRelease: tapBounce = ""
            padding: [12, 7]
            radius: 99
            border: 1
            borderColor: alpha(cPri, 0.5)
            onTap: { close() }
            Text { font: uiFont; text: "CLOSE"; fontSize: 10; bold: true; color: cInk; letterSpacing: 1 }
          }
        }

        // Memory gauge
        Column {
          fill: width
          gap: 6
          padding: 12
          radius: 14
          background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cObs, 0.82), #000000, alpha(cPri, 0.09)])
          border: 1
          borderColor: alpha(cPri, 0.42)
          Row {
            fill: width
            Text { font: uiFont; text: "◈ RAM"; fontSize: 10; color: cHot; letterSpacing: 2; weight: 1 }
            Text { font: uiFont; text: "${round(memUsed / 1048576)} / ${round(memTot / 1048576)} MB  ·  ${round(memPct * 100)}%"; fontSize: 10.5; bold: true; color: memPct > 0.85 ? cMid : cInk }
          }
          Box {
            fill: width
            height: 6
            radius: 99
            background: cDeep
            Box { width: max(memPct, 0.02) * 300; height: 6; radius: 99; background: linear(0, 0, 1, 0, [cDim, cMid]) }
          }
          // System battery settings shortcut (animation FX managed centrally in the Hub)
          Row {
            fill: width
            gap: 8
            Row {
              scale: tapBounce == "19" ? 0.9 : 1
              offset: [0, tapBounce == "19" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "19"
              onRelease: tapBounce = ""
              weight: 1
              height: 32
              radius: 10
              align: center
              justify: center
              background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), cObs, #000000, alpha(cSec, 0.11)])
              border: 1
              borderColor: alpha(cPri, 0.5)
              onTap: { if animHaptics { haptic() }; settings("battery") }
              Text { font: uiFont; text: "BATTERY SETTINGS"; fontSize: 10; bold: true; color: cInk; align: center }
            }
          }
        }

        // ---------- ANDROID TASKS ----------
        Text { font: uiFont; text: "◈ ANDROID TASKS"; fontSize: 10; color: cHot; letterSpacing: 2 }
        Text { font: uiFont; text: "SEVER opens the app's info page — hit FORCE STOP there (Android forbids launchers from killing apps directly)."; fontSize: 9.5; color: alpha(cInk, 0.6); fill: width }
        for a in sub(recentApps ?? [], 0, 15) key a.key {
          Row {
            fill: width
            gap: 10
            align: center
            padding: [10, 8]
            radius: 12
            background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cObs, 0.82), #000000, alpha(cSec, 0.10)])
            border: 1
            borderColor: alpha(cPri, 0.25)
            Box { size: 32; onTap: { open(a.key) }; TraySigil { src: a.icon; sz: 32; lbl: a.name } }
            Text { font: uiFont; text: a.name; fontSize: 12.5; color: cInk; weight: 1; maxLines: 1 }
            Row {
              scale: tapBounce == "20${a.key}" ? 0.9 : 1
              offset: [0, tapBounce == "20${a.key}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "20${a.key}"
              onRelease: tapBounce = ""
              padding: [12, 7]
              radius: 99
              background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cPri, 0.18), #000000, alpha(cPri, 0.09)])
              border: 1
              borderColor: cMid
              onTap: { if animHaptics { haptic() }; appAction("info", a.key) }
              Text { font: uiFont; text: "SEVER"; fontSize: 9.5; bold: true; color: cMid; letterSpacing: 1 }
            }
          }
        }

        // ---------- LINUX PROCESSES ----------
        Row {
          fill: width
          align: center
          Text { font: uiFont; text: "◈ LINUX PROCESSES"; fontSize: 10; color: cHot; letterSpacing: 2; weight: 1 }
          Text { font: uiFont; text: killLog; fontSize: 9.5; color: alpha(cInk, 0.6) }
        }
        for pr in procList key pr.pid {
          let core = pr.name == "libproot.so" || pr.name == "ps" || pr.name == "awk"
          Row {
            fill: width
            gap: 8
            align: center
            padding: [10, 8]
            radius: 12
            background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cObs, 0.82), #000000, alpha(cSec, 0.11)])
            border: 1
            borderColor: alpha(cPri, 0.25)
            Column {
              weight: 1
              gap: 1
              Text { font: uiFont; text: pr.name; fontSize: 12.5; color: cInk; maxLines: 1 }
              Text { font: uiFont; text: "PID ${pr.pid}  ·  ${round(pr.rss / 1024)} MB  ·  CPU ${pr.cpu}%"; fontSize: 9.5; color: alpha(cInk, 0.6) }
            }
            if core {
              Text { font: uiFont; text: "CORE"; fontSize: 9; color: cDim; letterSpacing: 1 }
            } else {
              Row {
                scale: tapBounce == "21${pr.pid}" ? 0.9 : 1
                offset: [0, tapBounce == "21${pr.pid}" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "21${pr.pid}"
                onRelease: tapBounce = ""
                padding: [12, 7]
                radius: 99
                background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cPri, 0.18), #000000, alpha(cSec, 0.10)])
                border: 1
                borderColor: cMid
                onTap: { if animHaptics { haptic() }; killLog = "KILLED ${pr.name}"; run("kill ${pr.pid}") }
                Text { font: uiFont; text: "KILL"; fontSize: 9.5; bold: true; color: cMid; letterSpacing: 1 }
              }
            }
          }
        }
        Spacer { height: 12 }
      }
    } else if scrMode == "glitch" {
      Column {
        fill: true
        background: cObs
        padding: 14
        gap: 12

        Row {
          fill: width
          align: center
          gap: 8
          Column {
            weight: 1
            gap: 2
            Text {
              font: uiFont
              text: "SLOT 0${cgActiveSlot + 1}"
              fontSize: 13
              color: cMid
              bold: true
              letterSpacing: 1.8
            }
            Text {
              font: uiFont
              text: cgActiveApp != null ? cgActiveApp.name : "Empty — pick an app below"
              style: small
              color: alpha(cHot, 0.72)
              maxLines: 1
            }
          }

          if cgActiveApp != null {
            Text {
              scale: tapBounce == "22" ? 0.9 : 1
              offset: [0, tapBounce == "22" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "22"
              onRelease: tapBounce = ""
              font: uiFont
              text: "CLEAR"
              style: small
              color: cHot
              bold: true
              letterSpacing: 1.2
              padding: [10, 6]
              radius: 99
              background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cDeep, 0.9), #000000, alpha(cPri, 0.09)])
              border: 1
              borderColor: alpha(cMid, 0.65)
              onTap: {
                if animHaptics { haptic() }
                cgAppSlots = set(cgAppSlots, cgActiveSlot, "")
              }
            }
          }

          Text {
            scale: tapBounce == "23" ? 0.9 : 1
            offset: [0, tapBounce == "23" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "23"
            onRelease: tapBounce = ""
            font: uiFont
            text: "DONE"
            style: small
            color: cHot
            bold: true
            letterSpacing: 1.2
            padding: [12, 6]
            radius: 99
            background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), cDim, #000000, alpha(cSec, 0.11)])
            border: 1
            borderColor: cMid
            onTap: {
              if animHaptics { haptic() }
              cgEditMode = false
              close()
            }
          }
        }

        Row {
          fill: width
          gap: 8
          for i in range(5) {
            let sa = cgSlotApps[i]
            let isCur = i == cgActiveSlot
            Column {
              scale: tapBounce == "24" ? 0.9 : 1
              offset: [0, tapBounce == "24" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "24"
              onRelease: tapBounce = ""
              weight: 1
              align: center
              gap: 4
              padding: [4, 8]
              radius: 12 * corners
              background: isCur ? alpha(cDeep, 0.95) : alpha(cCard, 0.88)
              border: isCur ? 1.5 : 1
              borderColor: isCur ? cMid : alpha(cPri, 0.25)
              onTap: {
                if animHaptics { haptic() }
                cgActiveSlot = i
              }
              if sa != null {
                OccultIcon { app: sa; sz: 34 }
              } else {
                Image { src: icoEmpty; size: 28; tint: alpha(cMid, 0.78) }
              }
              Text {
                font: uiFont
                text: "0${i + 1}"
                fontSize: 10
                color: isCur ? cHot : alpha(cHot, 0.55)
                bold: isCur
                align: center
                fill: width
                letterSpacing: 1.0
              }
            }
          }
        }

        Row {
          fill: width
          align: center
          gap: 8
          Row {
            weight: 1
            align: center
            gap: 8
            padding: [10, 6]
            radius: 10 * corners
            background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), cCard, #000000, alpha(cSec, 0.10)])
            border: 1
            borderColor: alpha(cMid, 0.45)
            Text { font: uiFont; text: "⌕"; color: cMid; fontSize: 16 }
            Input {
              weight: 1
              text: cgQuery
              placeholder: "Search apps…"
              underline: false
              color: cInk
              onChange: cgQuery = value
            }
            if cgQuery != "" {
              Text {
                scale: tapBounce == "25" ? 0.9 : 1
                offset: [0, tapBounce == "25" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "25"
                onRelease: tapBounce = ""
                font: uiFont
                text: "✕"
                color: alpha(cHot, 0.7)
                padding: [4, 2]
                onTap: cgQuery = ""
              }
            }
          }

          Text {
            scale: tapBounce == "26" ? 0.9 : 1
            offset: [0, tapBounce == "26" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "26"
            onRelease: tapBounce = ""
            font: uiFont
            text: cgSortByUse ? "TOP" : "A–Z"
            style: small
            color: cHot
            bold: true
            letterSpacing: 1.0
            padding: [10, 9]
            radius: 10 * corners
            background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), cCard, #000000, alpha(cPri, 0.09)])
            border: 1
            borderColor: alpha(cMid, 0.45)
            onTap: {
              if animHaptics { haptic() }
              cgSortByUse = !cgSortByUse
            }
          }
        }

        Column {
          scroll: true
          weight: 1
          fill: width
          gap: 6

          for a in cgPickerShown key a.key {
            let assignedIdx = indexOf(cgAppSlots, a.key)
            let isThisSlot = assignedIdx == cgActiveSlot
            Row {
              scale: tapBounce == "27${a.key}" ? 0.9 : 1
              offset: [0, tapBounce == "27${a.key}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "27${a.key}"
              onRelease: tapBounce = ""
              fill: width
              align: center
              gap: 12
              padding: [10, 9]
              radius: 12 * corners
              background: isThisSlot ? alpha(cDeep, 0.92) : alpha(cCard, 0.82)
              border: 1
              borderColor: isThisSlot ? cMid : alpha(cPri, 0.20)
              onTap: {
                if animHaptics { haptic() }
                cgAppSlots = set(cgAppSlots, cgActiveSlot, a.key)
                cgQuery = ""
                cgEditMode = false
                close()
              }

              OccultIcon { app: a; sz: 36 }

              Column {
                weight: 1
                gap: 1
                Text {
                  font: uiFont
                  text: a.name
                  color: cInk
                  fontSize: 14
                  bold: isThisSlot
                  maxLines: 1
                }
                if a.kind != "android" || a.profile != null {
                  Text {
                    font: uiFont
                    text: a.profile != null ? "${a.kind} · ${a.profile}" : a.kind
                    fontSize: 10.5
                    color: alpha(cInk, 0.65)
                    maxLines: 1
                  }
                }
              }

              if assignedIdx >= 0 {
                Text {
                  font: uiFont
                  text: "SLOT 0${assignedIdx + 1}"
                  fontSize: 10
                  color: isThisSlot ? cHot : cHot
                  bold: true
                  letterSpacing: 1.0
                  padding: [8, 4]
                  radius: 99
                  background: isThisSlot ? cPri : alpha(cDeep, 0.95)
                  border: 1
                  borderColor: isThisSlot ? cMid : alpha(cMid, 0.45)
                }
              }
            }
          }

          if len(cgPickerAll) == 0 {
            Text {
              font: uiFont
              text: "No matching apps"
              style: muted
              align: center
              fill: width
              padding: [0, 24]
            }
          } else if len(cgPickerAll) > 60 {
            Text {
              font: uiFont
              text: "Showing 60 of ${len(cgPickerAll)} apps — search to narrow"
              style: small
              color: alpha(cHot, 0.5)
              align: center
              fill: width
              padding: [0, 10]
            }
          }
        }
      }
    } else {
    Box {
      fill: true
      // Animated backdrop: drifting crimson glows over obsidian (frozen when FX/eco is off)
      Box { fill: true; background: linear(0, 0, 0, 1, [cCard, #000000, cObs]) }
      Box { fill: true; background: radial(0.5 + 0.35 * sin(fxT * 0.23), 0.1 + 0.06 * cos(fxT * 0.31), 0.85, [alpha(vaultView == "mail" ? cSec : cPri, 0.13), alpha(#000000, 0)]) }
      Box { fill: true; background: radial(0.2 + 0.25 * cos(fxT * 0.17), 0.95, 0.75, [alpha(vaultView == "mail" ? cPri : cSec, 0.10), alpha(#000000, 0)]) }
      Column {
        fill: true
        padding: [16, 14, 16, 0]
        gap: 12

        // Header: spinning sigil · title · counts · SHOW / LOCK
        Row {
          fill: width
          align: center
          gap: 12
          Canvas {
            width: 48
            height: 48
            let cx = width / 2
            let cy = height / 2
            let r = min(width, height) * 0.44
            circle(cx, cy, r, stroke: alpha(cPri, 0.85), width: 1.4)
            circle(cx, cy, r * 0.62, stroke: alpha(cDim, 0.8), width: 0.9)
            rotate(fxT * 28, cx, cy) {
              arc(cx, cy, r * 0.82, 0, 70, stroke: cHot, width: 2, cap: round)
              arc(cx, cy, r * 0.82, 120, 70, stroke: cMid, width: 2, cap: round)
              arc(cx, cy, r * 0.82, 240, 70, stroke: cPri, width: 2, cap: round)
            }
            circle(cx, cy, r * 0.34, fill: radial(cx, cy, r * 0.5, [alpha(cHot, 0.55 + 0.35 * sin(fxT * 2.2)), alpha(cPri, 0)]))
          }
          Column {
            weight: 1
            gap: 3
            Text { font: uiFont; text: "SITH WALLET"; fontSize: 15; color: cHot; fontWeight: 900; letterSpacing: 2.0; maxLines: 1 }
            Text { font: uiFont; text: revealAll ? "◆ EXPOSED" : "◇ MASKED"; fontSize: 10; color: revealAll ? cHot : cMuted; letterSpacing: 1.4; maxLines: 1 }
          }
          Box {
            scale: tapBounce == "28" ? 0.9 : 1
            offset: [0, tapBounce == "28" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "28"
            onRelease: tapBounce = ""
            width: 58
            height: 32
            radius: 10
            align: center
            background: revealAll ? alpha(cMid, 0.3) : alpha(cCard, 0.9)
            border: 1
            borderColor: revealAll ? cMid : alpha(cMid, 0.55)
            onTap: {
              if animHaptics { haptic() }
              revealAll = !revealAll
              cardReveal = 0
              mailReveal = 0
            }
            Text { font: uiFont; text: revealAll ? "MASK" : "SHOW"; fontSize: 10; color: cHot; bold: true; letterSpacing: 1.2; align: center; fill: width }
          }
          Box {
            scale: tapBounce == "29" ? 0.9 : 1
            offset: [0, tapBounce == "29" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "29"
            onRelease: tapBounce = ""
            width: 56
            height: 32
            radius: 10
            align: center
            background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cCard, 0.9), #000000, alpha(cSec, 0.11)])
            border: 1
            borderColor: alpha(cMid, 0.5)
            onTap: {
              if animHaptics { haptic() }
              revealAll = false
              cardReveal = 0
              mailReveal = 0
              cardEdit = false
              mailEdit = false
              vaultToast = ""
              close()
            }
            Text { font: uiFont; text: "LOCK"; fontSize: 10; color: cHot; bold: true; letterSpacing: 1.2; align: center; fill: width }
          }
        }

        // Big mode tabs
        Row {
          fill: width
          gap: 10
          for vm in [{ k: "cards", l: "▭  CARDS", n: len(cardBook) }, { k: "mail", l: "✉  EMAIL", n: len(mailBook) }] key vm.k {
            let vsel = (vaultView == "mail" ? "mail" : "cards") == vm.k
            Column {
              weight: 1
              height: 58
              radius: 14
              align: center
              justify: center
              gap: 2
              background: vsel ? linear(0, 0, 1, 1, [alpha(cPri, 0.42), #000000, alpha(cSec, 0.32)]) : alpha(cCard, 0.85)
              animate background: tween(260ms, "ease")
              scale: vsel ? 1.0 : 0.96
              animate scale: spring(0.6, 320)
              border: 1
              borderColor: vsel ? alpha(cHot, 0.6 + 0.3 * sin(fxT * 2)) : alpha(cDim, 0.6)
              onTap: {
                if animHaptics { haptic() }
                vaultView = vm.k
                cardEdit = false
                mailEdit = false
              }
              Text { font: uiFont; text: vm.l; fontSize: 14; color: vsel ? cInk : cHot; fontWeight: vsel ? 900 : 600; letterSpacing: 1.6; align: center; fill: width }
              Text { font: uiFont; text: "${vm.n} SAVED"; fontSize: 9; color: cMuted; letterSpacing: 1.3; align: center; fill: width }
            }
          }
        }

        // Status toast (copy / save feedback)
        if vaultToast != "" {
          Box {
            scale: tapBounce == "30" ? 0.9 : 1
            offset: [0, tapBounce == "30" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "30"
            onRelease: tapBounce = ""
            fill: width
            padding: [12, 8]
            radius: 10
            background: linear(0, 0, 1, 0, [alpha(cMid, 0.08), alpha(cMid, 0.24), alpha(cMid, 0.08)])
            border: 1
            borderColor: alpha(cMid, 0.55)
            onTap: vaultToast = ""
            Text { font: uiFont; text: "◈  ${vaultToast}"; fontSize: 11; color: cHot; letterSpacing: 1.2; bold: true; align: center; fill: width }
          }
        }

        if vaultView != "mail" {
          // ▭ CARD WALLET
          Row {
            fill: width
            gap: 8
            Column {
              weight: 1
              padding: [12, 10]
              radius: 14
              gap: 2
              background: linear(0, 0, 1, 1, [alpha(cPri, 0.16), #000000, alpha(cSec, 0.12)])
              border: 1
              borderColor: alpha(cPri, 0.35 + 0.15 * sin(fxT * 1.3))
              Text { font: uiFont; text: "${len(cardBook)}"; fontSize: 24; color: cInk; fontWeight: 800 }
              Text { font: uiFont; text: "CARDS"; fontSize: 9; color: cMuted; letterSpacing: 1.3; bold: true; maxLines: 1 }
            }
            Column {
              weight: 1
              padding: [12, 10]
              radius: 14
              gap: 2
              background: linear(0, 0, 1, 1, [alpha(cMid, 0.16), #000000, alpha(cSec, 0.12)])
              border: 1
              borderColor: alpha(cMid, 0.35 + 0.15 * sin(fxT * 1.3))
              Text { font: uiFont; text: "${soonN}"; fontSize: 24; color: cInk; fontWeight: 800 }
              Text { font: uiFont; text: "SOON"; fontSize: 9; color: cMuted; letterSpacing: 1.3; bold: true; maxLines: 1 }
            }
            Column {
              weight: 1
              padding: [12, 10]
              radius: 14
              gap: 2
              background: linear(0, 0, 1, 1, [alpha(cHot, 0.16), #000000, alpha(cSec, 0.12)])
              border: 1
              borderColor: alpha(cHot, 0.35 + 0.15 * sin(fxT * 1.3))
              Text { font: uiFont; text: "${expiredN}"; fontSize: 24; color: cInk; fontWeight: 800 }
              Text { font: uiFont; text: "EXPIRED"; fontSize: 9; color: cMuted; letterSpacing: 1.3; bold: true; maxLines: 1 }
            }
          }
          Column {
            weight: 1
            fill: width
            scroll: true
            gap: 14

            if cardEdit {
              Column {
                fill: width
                padding: [16, 16]
                radius: 16
                gap: 10
                background: linear(0, 0, 1, 1, [alpha(cardTints[ceTint], 0.22), alpha(cCard, 0.95), alpha(#000000, 0.95)])
                border: 1
                borderColor: alpha(cardTints[ceTint], 0.7)
                Text { font: uiFont; text: cardEditId == 0 ? "✦  NEW CARD" : "✦  EDIT CARD"; fontSize: 12; color: cHot; letterSpacing: 1.8; bold: true }
                Box {
                  fill: width
                  padding: [12, 8]
                  radius: 10
                  background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cObs, 0.9), #000000, alpha(cSec, 0.10)])
                  border: 1
                  borderColor: alpha(cMid, 0.35)
                  Input {
                    text: ceName
                    placeholder: "Card name (e.g. Daily Driver, Travel)"
                    color: cInk
                    fontSize: 14
                    underline: false
                    onChange: ceName = value
                  }
                }
                Row {
                  fill: width
                  gap: 8
                  Column {
                    weight: 1
                    Box {
                      fill: width
                      padding: [12, 8]
                      radius: 10
                      background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cObs, 0.9), #000000, alpha(cPri, 0.09)])
                      border: 1
                      borderColor: alpha(cMid, 0.35)
                      Input {
                        text: ceBank
                        placeholder: "Bank / issuer"
                        color: cInk
                        fontSize: 14
                        underline: false
                        onChange: ceBank = value
                      }
                    }
                  }
                  Column {
                    weight: 1
                    Box {
                      fill: width
                      padding: [12, 8]
                      radius: 10
                      background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cObs, 0.9), #000000, alpha(cSec, 0.11)])
                      border: 1
                      borderColor: alpha(cMid, 0.35)
                      Input {
                        text: ceNet
                        placeholder: "Visa · MC · Amex"
                        color: cInk
                        fontSize: 14
                        underline: false
                        onChange: ceNet = value
                      }
                    }
                  }
                }
                Box {
                  fill: width
                  padding: [12, 8]
                  radius: 10
                  background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cObs, 0.9), #000000, alpha(cSec, 0.10)])
                  border: 1
                  borderColor: alpha(cMid, 0.35)
                  Input {
                    text: ceHolder
                    placeholder: "Name on card"
                    color: cInk
                    fontSize: 14
                    underline: false
                    onChange: ceHolder = value
                  }
                }
                Row {
                  fill: width
                  gap: 8
                  Column {
                    weight: 3
                    Box {
                      fill: width
                      padding: [12, 8]
                      radius: 10
                      background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cObs, 0.9), #000000, alpha(cPri, 0.09)])
                      border: 1
                      borderColor: alpha(cMid, 0.35)
                      Input {
                        text: ceNum
                        placeholder: "Card number"
                        color: cInk
                        fontSize: 14
                        underline: false
                        onChange: ceNum = value
                      }
                    }
                  }
                  Column {
                    weight: 1
                    Box {
                      fill: width
                      padding: [12, 8]
                      radius: 10
                      background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cObs, 0.9), #000000, alpha(cSec, 0.11)])
                      border: 1
                      borderColor: alpha(cMid, 0.35)
                      Input {
                        text: ceExp
                        placeholder: "MM/YY"
                        color: cInk
                        fontSize: 14
                        underline: false
                        onChange: ceExp = value
                      }
                    }
                  }
                }
                Row {
                  fill: width
                  gap: 10
                  align: center
                  Text { font: uiFont; text: "COLOR"; fontSize: 10; color: cMuted; letterSpacing: 1.4; bold: true }
                  for ti in range(len(cardTints)) key ti {
                    Box {
                      width: 30
                      height: 30
                      radius: 99
                      background: radial(0.35, 0.3, 0.9, [cardTints[ti], alpha(cardTints[ti], 0.35)])
                      border: ceTint == ti ? 2 : 1
                      borderColor: ceTint == ti ? cInk : alpha(cDim, 0.6)
                      scale: ceTint == ti ? 1.15 : 1.0
                      animate scale: spring(0.5, 400)
                      onTap: {
                        if animHaptics { haptic() }
                        ceTint = ti
                      }
                    }
                  }
                }
                Box {
                  fill: width
                  padding: [12, 8]
                  radius: 10
                  background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cObs, 0.9), #000000, alpha(cSec, 0.10)])
                  border: 1
                  borderColor: alpha(cMid, 0.35)
                  Input {
                    text: ceBody
                    placeholder: "Notes (perks, support #, anything)"
                    color: cInk
                    fontSize: 13
                    underline: false
                    lines: 3
                    onChange: ceBody = value
                  }
                }
                Row {
                  fill: width
                  gap: 8
                  Box {
                    scale: tapBounce == "31" ? 0.9 : 1
                    offset: [0, tapBounce == "31" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "31"
                    onRelease: tapBounce = ""
                    weight: 1
                    height: 36
                    radius: 10
                    align: center
                    background: linear(0, 0, 1, 1, [alpha(cPri, 0.40), #000000, alpha(cSec, 0.30)])
                    border: 1
                    borderColor: cMid
                    onTap: {
                      if animHaptics { haptic() }
                      let nm = trim(ceName) != "" ? trim(ceName) : "UNTITLED CARD"
                      let rec = { id: cardEditId, name: nm, bank: trim(ceBank), net: trim(ceNet), holder: trim(ceHolder), num: trim(ceNum), exp: trim(ceExp), tint: ceTint, body: trim(ceBody) }
                      if cardEditId == 0 {
                        let nid = nextCardId
                        nextCardId = nid + 1
                        cardBook = cardBook + [{ id: nid, name: nm, bank: rec.bank, net: rec.net, holder: rec.holder, num: rec.num, exp: rec.exp, tint: ceTint, body: rec.body }]
                        cardOpen = nid
                        vaultToast = "ADDED · ${upper(nm)}"
                      } else {
                        cardBook = cardBook.map(c => c.id == cardEditId ? rec : c)
                        vaultToast = "SAVED · ${upper(nm)}"
                      }
                      cardEdit = false
                    }
                    Text { font: uiFont; text: "SAVE"; fontSize: 11; color: cInk; bold: true; letterSpacing: 1.2; align: center; fill: width }
                  }
                  Box {
                    scale: tapBounce == "32" ? 0.9 : 1
                    offset: [0, tapBounce == "32" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "32"
                    onRelease: tapBounce = ""
                    width: 86
                    height: 36
                    radius: 10
                    align: center
                    background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.9), #000000, alpha(cPri, 0.09)])
                    border: 1
                    borderColor: alpha(cDim, 0.7)
                    onTap: {
                      if animHaptics { haptic() }
                      cardEdit = false
                    }
                    Text { font: uiFont; text: "CANCEL"; fontSize: 11; color: cInk; bold: true; letterSpacing: 1.2; align: center; fill: width }
                  }
                  if cardEditId != 0 {
                    Box {
                      scale: tapBounce == "33" ? 0.9 : 1
                      offset: [0, tapBounce == "33" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "33"
                      onRelease: tapBounce = ""
                      width: 80
                      height: 36
                      radius: 10
                      align: center
                      background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), cDeep, #000000, alpha(cSec, 0.11)])
                      border: 1
                      borderColor: alpha(cPri, 0.75)
                      onTap: {
                        if animHaptics { haptic() }
                        cardBook = cardBook.filter(c => c.id != cardEditId)
                        cardOpen = 0
                        vaultToast = "REMOVED CARD"
                        cardEdit = false
                      }
                      Text { font: uiFont; text: "DELETE"; fontSize: 11; color: cMid; bold: true; letterSpacing: 1.2; align: center; fill: width }
                    }
                  }
                }
              }
            }

            if len(cardBook) == 0 && !cardEdit {
              // Ghost card: tap to add the first one
              Box {
                scale: tapBounce == "34" ? 0.9 : 1
                offset: [0, tapBounce == "34" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "34"
                onRelease: tapBounce = ""
                fill: width
                height: 210
                radius: 20
                clip: true
                background: linear(0, 0, 1, 1, [alpha(cPri, 0.18), alpha(cCard, 0.9), #000000])
                border: 1
                borderColor: alpha(cMid, 0.35 + 0.3 * sin(fxT * 1.6))
                onTap: {
                  if animHaptics { haptic() }
                    cardEditId = 0
                    ceName = ""
                    ceBank = ""
                    ceNet = ""
                    ceHolder = ""
                    ceNum = ""
                    ceExp = ""
                    ceTint = 0
                    ceBody = ""
                    cardEdit = true
                }
                Box { fill: true; background: linear(((fxT * 0.22) % 1.8) - 0.6, 0, ((fxT * 0.22) % 1.8) - 0.1, 1, [alpha(#ffffff, 0), alpha(#ffffff, 0.09), alpha(#ffffff, 0)]) }
                Column {
                  fill: true
                  align: center
                  justify: center
                  gap: 6
                  Text { font: uiFont; text: "+"; fontSize: 54; color: cHot; fontWeight: 200; align: center; fill: width }
                  Text { font: uiFont; text: "ADD YOUR FIRST CARD"; fontSize: 13; color: cInk; letterSpacing: 2.0; bold: true; align: center; fill: width }
                  Text { font: uiFont; text: "bank · number · expiry · notes"; fontSize: 11; color: cMuted; align: center; fill: width }
                }
              }
            }

            for c in cardBook key c.id {
              let tint = cardTints[c.tint % len(cardTints)]
              let digits = replace(replace(c.num, " ", ""), "-", "")
              let last4 = len(digits) >= 4 ? sub(digits, len(digits) - 4, len(digits)) : digits
              let shown = revealAll || cardReveal == c.id
              let open = cardOpen == c.id
              let ep = split(c.exp, "/")
              let em = len(ep) == 2 ? (2000 + num(ep[1], 0)) * 12 + num(ep[0], 0) : 0
              let expTag = em == 0 ? "" : em < curM ? "EXPIRED" : em - curM <= 3 ? "EXPIRES SOON" : ""
              let sh = ((fxT * 0.22 + c.id * 0.41) % 1.8) - 0.6
              Column {
                fill: width
                gap: 8
                Box {
                  fill: width
                  height: 210
                  radius: 20
                  clip: true
                  scale: open ? 1.0 : 0.975
                  animate scale: spring(0.55, 300)
                  background: linear(0, 0, 1, 1, [alpha(tint, 0.42), #000000, alpha(cSec, 0.16)])
                  border: 1
                  borderColor: alpha(tint, open ? 0.95 : 0.45 + 0.2 * sin(fxT * 1.5 + c.id))
                  onTap: {
                    if animHaptics { haptic() }
                    cardOpen = open ? 0 : c.id
                  }
                  Box { fill: true; background: radial(0.92, 0.08, 0.75, [alpha(tint, 0.22), alpha(#000000, 0)]) }
                  Box { fill: true; background: linear(sh, 0, sh + 0.5, 1, [alpha(#ffffff, 0), alpha(#ffffff, 0.06), alpha(#ffffff, 0)]) }
                  Column {
                    fill: true
                    padding: [20, 18]
                    gap: 4
                    Row {
                      fill: width
                      align: center
                      gap: 8
                      Text { font: uiFont; text: c.bank != "" ? upper(c.bank) : "CARD"; fontSize: 14; color: cInk; fontWeight: 800; letterSpacing: 2.0; weight: 1; maxLines: 1 }
                      Text { font: uiFont; text: upper(c.net); fontSize: 16; color: tint; fontWeight: 900; letterSpacing: 1.4; maxLines: 1 }
                    }
                    Row {
                      fill: width
                      gap: 8
                      align: center
                      Text { font: uiFont; text: c.name; fontSize: 11; color: cMuted; letterSpacing: 0.8; maxLines: 1; weight: 1 }
                      if expTag != "" {
                        Box {
                          padding: [8, 3]
                          radius: 99
                          background: alpha(expTag == "EXPIRED" ? cPri : cMid, 0.3)
                          border: 1
                          borderColor: expTag == "EXPIRED" ? cPri : cMid
                          Text { font: uiFont; text: expTag; fontSize: 9; color: cInk; bold: true; letterSpacing: 1.1 }
                        }
                      }
                    }
                    Box { weight: 1 }
                    Row {
                      gap: 10
                      align: center
                      Box { width: 42; height: 30; radius: 6; background: linear(0, 0, 1, 1, [#f7dc96, #b8913f, #7a5a1e]) }
                      Text { font: uiFont; text: ")))"; fontSize: 14; color: alpha(cInk, 0.6); bold: true }
                    }
                    Text { font: uiFont; text: shown ? (c.num != "" ? c.num : "NO NUMBER SAVED") : (last4 != "" ? "••••  ••••  ••••  ${last4}" : "••••  ••••  ••••  ••••"); fontSize: 20; color: cInk; bold: true; letterSpacing: 2.2; maxLines: 1; fill: width }
                    Row {
                      fill: width
                      align: center
                      Text { font: uiFont; text: upper(c.holder); fontSize: 11; color: cInk; letterSpacing: 1.5; weight: 1; maxLines: 1 }
                      Text { font: uiFont; text: c.exp != "" ? "EXP  ${shown ? c.exp : "••/••"}" : ""; fontSize: 11; color: cInk; letterSpacing: 1.2 }
                    }
                  }
                }
                if open {
                  Column {
                    fill: width
                    padding: [16, 14]
                    radius: 16
                    gap: 6
                    background: linear(0, 0, 0, 1, [alpha(tint, 0.14), alpha(cObs, 0.95)])
                    border: 1
                    borderColor: alpha(tint, 0.45)
                    Row {
                      scale: tapBounce == "35${c.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "35${c.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "35${c.id}"
                      onRelease: tapBounce = ""
                      fill: width
                      gap: 10
                      align: center
                      padding: [0, 3]
                      onTap: {
                        if animHaptics { haptic() }
                        copy(digits)
                        vaultToast = "COPIED · NUMBER"
                      }
                      Text { font: uiFont; text: "NUMBER"; fontSize: 10; color: cMuted; letterSpacing: 1.4; bold: true; width: 92 }
                      Text { font: uiFont; text: shown ? (c.num != "" ? c.num : "—") : "•••• " + last4; fontSize: 14; color: cInk; weight: 1; maxLines: 3 }
                    }
                    Row {
                      scale: tapBounce == "36${c.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "36${c.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "36${c.id}"
                      onRelease: tapBounce = ""
                      fill: width
                      gap: 10
                      align: center
                      padding: [0, 3]
                      onTap: {
                        if animHaptics { haptic() }
                        copy(c.exp)
                        vaultToast = "COPIED · EXPIRES"
                      }
                      Text { font: uiFont; text: "EXPIRES"; fontSize: 10; color: cMuted; letterSpacing: 1.4; bold: true; width: 92 }
                      Text { font: uiFont; text: c.exp != "" ? (shown ? c.exp : "••/••") : "—"; fontSize: 14; color: cInk; weight: 1; maxLines: 3 }
                    }
                    Row {
                      scale: tapBounce == "37${c.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "37${c.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "37${c.id}"
                      onRelease: tapBounce = ""
                      fill: width
                      gap: 10
                      align: center
                      padding: [0, 3]
                      onTap: {
                        if animHaptics { haptic() }
                        copy(c.holder)
                        vaultToast = "COPIED · HOLDER"
                      }
                      Text { font: uiFont; text: "HOLDER"; fontSize: 10; color: cMuted; letterSpacing: 1.4; bold: true; width: 92 }
                      Text { font: uiFont; text: c.holder != "" ? c.holder : "—"; fontSize: 14; color: cInk; weight: 1; maxLines: 3 }
                    }
                    if c.body != "" {
                      Row {
                        scale: tapBounce == "38${c.id}" ? 0.9 : 1
                        offset: [0, tapBounce == "38${c.id}" ? -4 : 0]
                        animate scale: spring(0.32, 520)
                        animate offset: spring(0.32, 520)
                        onPress: tapBounce = "38${c.id}"
                        onRelease: tapBounce = ""
                        fill: width
                        gap: 10
                        align: center
                        padding: [0, 3]
                        onTap: {
                          if animHaptics { haptic() }
                          copy(c.body)
                          vaultToast = "COPIED · NOTES"
                        }
                        Text { font: uiFont; text: "NOTES"; fontSize: 10; color: cMuted; letterSpacing: 1.4; bold: true; width: 92 }
                        Text { font: uiFont; text: c.body; fontSize: 14; color: cInk; weight: 1; maxLines: 3 }
                      }
                    }
                    Row {
                      fill: width
                      gap: 8
                      padding: [0, 6, 0, 0]
                      Box {
                        scale: tapBounce == "39${c.id}" ? 0.9 : 1
                        offset: [0, tapBounce == "39${c.id}" ? -4 : 0]
                        animate scale: spring(0.32, 520)
                        animate offset: spring(0.32, 520)
                        onPress: tapBounce = "39${c.id}"
                        onRelease: tapBounce = ""
                        weight: 1
                        height: 36
                        radius: 10
                        align: center
                        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cCard, 0.9), #000000, alpha(cSec, 0.10)])
                        border: 1
                        borderColor: alpha(cMid, 0.5)
                        onTap: {
                          if animHaptics { haptic() }
                          cardReveal = cardReveal == c.id ? 0 : c.id
                        }
                        Text { font: uiFont; text: shown ? "HIDE #" : "SHOW #"; fontSize: 11; color: cHot; bold: true; letterSpacing: 1.2; align: center; fill: width }
                      }
                      Box {
                        scale: tapBounce == "40${c.id}" ? 0.9 : 1
                        offset: [0, tapBounce == "40${c.id}" ? -4 : 0]
                        animate scale: spring(0.32, 520)
                        animate offset: spring(0.32, 520)
                        onPress: tapBounce = "40${c.id}"
                        onRelease: tapBounce = ""
                        weight: 1
                        height: 36
                        radius: 10
                        align: center
                        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.9), #000000, alpha(cPri, 0.09)])
                        border: 1
                        borderColor: alpha(cMid, 0.5)
                        onTap: {
                          if animHaptics { haptic() }
                          copy(digits)
                          vaultToast = "COPIED · ${upper(c.name)} NUMBER"
                        }
                        Text { font: uiFont; text: "COPY #"; fontSize: 11; color: cHot; bold: true; letterSpacing: 1.2; align: center; fill: width }
                      }
                      Box {
                        scale: tapBounce == "41${c.id}" ? 0.9 : 1
                        offset: [0, tapBounce == "41${c.id}" ? -4 : 0]
                        animate scale: spring(0.32, 520)
                        animate offset: spring(0.32, 520)
                        onPress: tapBounce = "41${c.id}"
                        onRelease: tapBounce = ""
                        weight: 1
                        height: 36
                        radius: 10
                        align: center
                        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cCard, 0.9), #000000, alpha(cSec, 0.11)])
                        border: 1
                        borderColor: alpha(cDim, 0.7)
                        onTap: {
                          if animHaptics { haptic() }
                          cardEditId = c.id
                          ceName = c.name
                          ceBank = c.bank
                          ceNet = c.net
                          ceHolder = c.holder
                          ceNum = c.num
                          ceExp = c.exp
                          ceTint = c.tint
                          ceBody = c.body
                          cardEdit = true
                        }
                        Text { font: uiFont; text: "EDIT"; fontSize: 11; color: cInk; bold: true; letterSpacing: 1.2; align: center; fill: width }
                      }
                    }
                  }
                }
              }
            }

            if len(cardBook) > 0 && !cardEdit {
              Box {
                scale: tapBounce == "42" ? 0.9 : 1
                offset: [0, tapBounce == "42" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "42"
                onRelease: tapBounce = ""
                fill: width
                height: 150
                radius: 20
                clip: true
                background: linear(0, 0, 1, 1, [alpha(cPri, 0.14), alpha(cCard, 0.85), alpha(#000000, 0.9)])
                border: 1
                borderColor: alpha(cMid, 0.3 + 0.3 * sin(fxT * 1.6))
                onTap: {
                  if animHaptics { haptic() }
                  cardEditId = 0
                  ceName = ""
                  ceBank = ""
                  ceNet = ""
                  ceHolder = ""
                  ceNum = ""
                  ceExp = ""
                  ceTint = 0
                  ceBody = ""
                  cardEdit = true
                }
                Box { fill: true; background: linear(((fxT * 0.22) % 1.8) - 0.6, 0, ((fxT * 0.22) % 1.8) - 0.1, 1, [alpha(#ffffff, 0), alpha(#ffffff, 0.08), alpha(#ffffff, 0)]) }
                Column {
                  fill: true
                  align: center
                  justify: center
                  gap: 4
                  Text { font: uiFont; text: "+"; fontSize: 40; color: cHot; fontWeight: 200; align: center; fill: width }
                  Text { font: uiFont; text: "ADD ANOTHER CARD"; fontSize: 12; color: cInk; letterSpacing: 2.0; bold: true; align: center; fill: width }
                }
              }
            }
            Box { height: 16 }
          }
        } else {
          // ✉ EMAIL DOSSIERS
          Row {
            fill: width
            gap: 8
            Column {
              weight: 1
              padding: [12, 10]
              radius: 14
              gap: 2
              background: linear(0, 0, 1, 1, [alpha(cPri, 0.16), #000000, alpha(cSec, 0.12)])
              border: 1
              borderColor: alpha(cPri, 0.35 + 0.15 * sin(fxT * 1.3))
              Text { font: uiFont; text: "${len(mailBook)}"; fontSize: 24; color: cInk; fontWeight: 800 }
              Text { font: uiFont; text: "INBOXES"; fontSize: 9; color: cMuted; letterSpacing: 1.3; bold: true; maxLines: 1 }
            }
            Column {
              weight: 1
              padding: [12, 10]
              radius: 14
              gap: 2
              background: linear(0, 0, 1, 1, [alpha(cMid, 0.16), #000000, alpha(cSec, 0.12)])
              border: 1
              borderColor: alpha(cMid, 0.35 + 0.15 * sin(fxT * 1.3))
              Text { font: uiFont; text: "${tfaN}"; fontSize: 24; color: cInk; fontWeight: 800 }
              Text { font: uiFont; text: "2FA ON"; fontSize: 9; color: cMuted; letterSpacing: 1.3; bold: true; maxLines: 1 }
            }
            Column {
              weight: 1
              padding: [12, 10]
              radius: 14
              gap: 2
              background: linear(0, 0, 1, 1, [alpha(cHot, 0.16), #000000, alpha(cSec, 0.12)])
              border: 1
              borderColor: alpha(cHot, 0.35 + 0.15 * sin(fxT * 1.3))
              Text { font: uiFont; text: "${recovN}"; fontSize: 24; color: cInk; fontWeight: 800 }
              Text { font: uiFont; text: "RECOVERY SET"; fontSize: 9; color: cMuted; letterSpacing: 1.3; bold: true; maxLines: 1 }
            }
          }
          Column {
            weight: 1
            fill: width
            scroll: true
            gap: 12

            if mailEdit {
              Column {
                fill: width
                padding: [16, 16]
                radius: 16
                gap: 10
                background: linear(0, 0, 1, 1, [alpha(cMid, 0.2), alpha(cCard, 0.95), alpha(#000000, 0.95)])
                border: 1
                borderColor: alpha(cMid, 0.7)
                Text { font: uiFont; text: mailEditId == 0 ? "✦  NEW EMAIL" : "✦  EDIT EMAIL"; fontSize: 12; color: cHot; letterSpacing: 1.8; bold: true }
                Box {
                  fill: width
                  padding: [12, 8]
                  radius: 10
                  background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cObs, 0.9), #000000, alpha(cSec, 0.10)])
                  border: 1
                  borderColor: alpha(cMid, 0.35)
                  Input {
                    text: meAddr
                    placeholder: "Email address"
                    color: cInk
                    fontSize: 14
                    underline: false
                    onChange: meAddr = value
                  }
                }
                Row {
                  fill: width
                  gap: 8
                  Column {
                    weight: 1
                    Box {
                      fill: width
                      padding: [12, 8]
                      radius: 10
                      background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cObs, 0.9), #000000, alpha(cPri, 0.09)])
                      border: 1
                      borderColor: alpha(cMid, 0.35)
                      Input {
                        text: meProv
                        placeholder: "Provider (Gmail, Proton…)"
                        color: cInk
                        fontSize: 14
                        underline: false
                        onChange: meProv = value
                      }
                    }
                  }
                  Column {
                    weight: 1
                    Box {
                      fill: width
                      padding: [12, 8]
                      radius: 10
                      background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cObs, 0.9), #000000, alpha(cSec, 0.11)])
                      border: 1
                      borderColor: alpha(cMid, 0.35)
                      Input {
                        text: mePurpose
                        placeholder: "Purpose (main, banking…)"
                        color: cInk
                        fontSize: 14
                        underline: false
                        onChange: mePurpose = value
                      }
                    }
                  }
                }
                Box {
                  fill: width
                  padding: [12, 8]
                  radius: 10
                  background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cObs, 0.9), #000000, alpha(cSec, 0.10)])
                  border: 1
                  borderColor: alpha(cMid, 0.35)
                  Input {
                    text: meRecov
                    placeholder: "Recovery email"
                    color: cInk
                    fontSize: 14
                    underline: false
                    onChange: meRecov = value
                  }
                }
                Box {
                  fill: width
                  padding: [12, 8]
                  radius: 10
                  background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cObs, 0.9), #000000, alpha(cPri, 0.09)])
                  border: 1
                  borderColor: alpha(cMid, 0.35)
                  Input {
                    text: mePhone
                    placeholder: "Recovery phone"
                    color: cInk
                    fontSize: 14
                    underline: false
                    onChange: mePhone = value
                  }
                }
                Box {
                  fill: width
                  padding: [12, 8]
                  radius: 10
                  background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cObs, 0.9), #000000, alpha(cSec, 0.11)])
                  border: 1
                  borderColor: alpha(cMid, 0.35)
                  Input {
                    text: me2fa
                    placeholder: "2FA method (authenticator, key, SMS)"
                    color: cInk
                    fontSize: 14
                    underline: false
                    onChange: me2fa = value
                  }
                }
                Box {
                  fill: width
                  padding: [12, 8]
                  radius: 10
                  background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cObs, 0.9), #000000, alpha(cSec, 0.10)])
                  border: 1
                  borderColor: alpha(cMid, 0.35)
                  Input {
                    text: meAlias
                    placeholder: "Aliases / forwarding addresses"
                    color: cInk
                    fontSize: 14
                    underline: false
                    onChange: meAlias = value
                  }
                }
                Box {
                  fill: width
                  padding: [12, 8]
                  radius: 10
                  background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cObs, 0.9), #000000, alpha(cPri, 0.09)])
                  border: 1
                  borderColor: alpha(cMid, 0.35)
                  Input {
                    text: meBody
                    placeholder: "Notes"
                    color: cInk
                    fontSize: 13
                    underline: false
                    lines: 3
                    onChange: meBody = value
                  }
                }
                Row {
                  fill: width
                  gap: 8
                  Box {
                    scale: tapBounce == "43" ? 0.9 : 1
                    offset: [0, tapBounce == "43" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "43"
                    onRelease: tapBounce = ""
                    weight: 1
                    height: 36
                    radius: 10
                    align: center
                    background: linear(0, 0, 1, 1, [alpha(cPri, 0.40), #000000, alpha(cSec, 0.30)])
                    border: 1
                    borderColor: cMid
                    onTap: {
                      if animHaptics { haptic() }
                      let ad = trim(meAddr)
                      let rec = { id: mailEditId, addr: ad, prov: trim(meProv), purpose: trim(mePurpose), recov: trim(meRecov), phone: trim(mePhone), tfa: trim(me2fa), alias: trim(meAlias), body: trim(meBody) }
                      if mailEditId == 0 {
                        let nid = nextMailId
                        nextMailId = nid + 1
                        mailBook = mailBook + [{ id: nid, addr: ad, prov: rec.prov, purpose: rec.purpose, recov: rec.recov, phone: rec.phone, tfa: rec.tfa, alias: rec.alias, body: rec.body }]
                        mailOpen = nid
                        vaultToast = "ADDED · ${ad}"
                      } else {
                        mailBook = mailBook.map(m => m.id == mailEditId ? rec : m)
                        vaultToast = "SAVED · ${ad}"
                      }
                      mailEdit = false
                    }
                    Text { font: uiFont; text: "SAVE"; fontSize: 11; color: cInk; bold: true; letterSpacing: 1.2; align: center; fill: width }
                  }
                  Box {
                    scale: tapBounce == "44" ? 0.9 : 1
                    offset: [0, tapBounce == "44" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "44"
                    onRelease: tapBounce = ""
                    width: 86
                    height: 36
                    radius: 10
                    align: center
                    background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cCard, 0.9), #000000, alpha(cSec, 0.11)])
                    border: 1
                    borderColor: alpha(cDim, 0.7)
                    onTap: {
                      if animHaptics { haptic() }
                      mailEdit = false
                    }
                    Text { font: uiFont; text: "CANCEL"; fontSize: 11; color: cInk; bold: true; letterSpacing: 1.2; align: center; fill: width }
                  }
                  if mailEditId != 0 {
                    Box {
                      scale: tapBounce == "45" ? 0.9 : 1
                      offset: [0, tapBounce == "45" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "45"
                      onRelease: tapBounce = ""
                      width: 80
                      height: 36
                      radius: 10
                      align: center
                      background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), cDeep, #000000, alpha(cSec, 0.10)])
                      border: 1
                      borderColor: alpha(cPri, 0.75)
                      onTap: {
                        if animHaptics { haptic() }
                        mailBook = mailBook.filter(m => m.id != mailEditId)
                        mailOpen = 0
                        vaultToast = "REMOVED EMAIL"
                        mailEdit = false
                      }
                      Text { font: uiFont; text: "DELETE"; fontSize: 11; color: cMid; bold: true; letterSpacing: 1.2; align: center; fill: width }
                    }
                  }
                }
              }
            }

            if len(mailBook) == 0 && !mailEdit {
              Box {
                scale: tapBounce == "46" ? 0.9 : 1
                offset: [0, tapBounce == "46" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "46"
                onRelease: tapBounce = ""
                fill: width
                height: 210
                radius: 20
                clip: true
                background: linear(0, 0, 1, 1, [alpha(cMid, 0.18), alpha(cCard, 0.9), #000000])
                border: 1
                borderColor: alpha(cMid, 0.35 + 0.3 * sin(fxT * 1.6))
                onTap: {
                  if animHaptics { haptic() }
                    mailEditId = 0
                    meAddr = ""
                    meProv = ""
                    mePurpose = ""
                    meRecov = ""
                    mePhone = ""
                    me2fa = ""
                    meAlias = ""
                    meBody = ""
                    mailEdit = true
                }
                Box { fill: true; background: linear(((fxT * 0.22) % 1.8) - 0.6, 0, ((fxT * 0.22) % 1.8) - 0.1, 1, [alpha(#ffffff, 0), alpha(#ffffff, 0.09), alpha(#ffffff, 0)]) }
                Column {
                  fill: true
                  align: center
                  justify: center
                  gap: 6
                  Text { font: uiFont; text: "✉"; fontSize: 46; color: cHot; align: center; fill: width }
                  Text { font: uiFont; text: "ADD YOUR FIRST INBOX"; fontSize: 13; color: cInk; letterSpacing: 2.0; bold: true; align: center; fill: width }
                  Text { font: uiFont; text: "address · recovery · 2FA · aliases"; fontSize: 11; color: cMuted; align: center; fill: width }
                }
              }
            }

            for m in mailBook key m.id {
              let at = split(m.addr, "@")
              let shown = revealAll || mailReveal == m.id
              let open = mailOpen == m.id
              let masked = len(at) > 1 && len(at[0]) > 0 ? sub(at[0], 0, 1) + "•••@" + at[1] : m.addr
              let ini = upper(sub(m.prov != "" ? m.prov : (m.addr != "" ? m.addr : "?"), 0, 1))
              let has2fa = m.tfa != ""
              Column {
                fill: width
                padding: [16, 14]
                radius: 18
                gap: 10
                background: linear(0, 0, 1, 1, [alpha(cPri, open ? 0.20 : 0.10), #000000, alpha(cSec, open ? 0.16 : 0.07)])
                animate background: tween(260ms, "ease")
                border: 1
                borderColor: open ? alpha(cHot, 0.6 + 0.25 * sin(fxT * 1.8)) : alpha(cDim, 0.6)
                scale: open ? 1.0 : 0.985
                animate scale: spring(0.6, 320)
                Row {
                  scale: tapBounce == "47${m.id}" ? 0.9 : 1
                  offset: [0, tapBounce == "47${m.id}" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "47${m.id}"
                  onRelease: tapBounce = ""
                  fill: width
                  align: center
                  gap: 12
                  onTap: {
                    if animHaptics { haptic() }
                    mailOpen = open ? 0 : m.id
                  }
                  Box {
                    width: 48
                    height: 48
                    radius: 99
                    align: center
                    background: radial(0.35 + 0.1 * sin(fxT + m.id), 0.3, 0.9, [alpha(cSec, 0.75), alpha(cPri, 0.35), alpha(#000000, 0.7)])
                    border: 1
                    borderColor: alpha(cHot, 0.7)
                    Text { font: uiFont; text: ini; fontSize: 20; color: cInk; fontWeight: 900; align: center; fill: width }
                  }
                  Column {
                    weight: 1
                    gap: 3
                    Text { font: uiFont; text: shown ? m.addr : masked; fontSize: 16; color: cInk; bold: true; maxLines: 1 }
                    Text { font: uiFont; text: upper(join([m.prov, m.purpose].filter(x => x != ""), "  ·  ")); fontSize: 10; color: cMuted; letterSpacing: 1.3; maxLines: 1 }
                  }
                  Box {
                    padding: [8, 4]
                    radius: 99
                    background: alpha(has2fa ? #2bff8c : cPri, 0.16)
                    border: 1
                    borderColor: alpha(has2fa ? #2bff8c : cPri, 0.6)
                    Text { font: uiFont; text: has2fa ? "✓ 2FA" : "NO 2FA"; fontSize: 9; color: has2fa ? #2bff8c : cHot; bold: true; letterSpacing: 1.0 }
                  }
                }
                if open {
                  Box { fill: width; height: 1; background: linear(0, 0, 1, 0, [alpha(cMid, 0), alpha(cMid, 0.6), alpha(cMid, 0)]) }
                  Row {
                    scale: tapBounce == "48${m.id}" ? 0.9 : 1
                    offset: [0, tapBounce == "48${m.id}" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "48${m.id}"
                    onRelease: tapBounce = ""
                    fill: width
                    gap: 10
                    align: center
                    padding: [0, 3]
                    onTap: {
                      if animHaptics { haptic() }
                      copy(m.addr)
                      vaultToast = "COPIED · ADDRESS"
                    }
                    Text { font: uiFont; text: "ADDRESS"; fontSize: 10; color: cMuted; letterSpacing: 1.4; bold: true; width: 92 }
                    Text { font: uiFont; text: shown ? m.addr : masked; fontSize: 14; color: cInk; weight: 1; maxLines: 3 }
                  }
                  if m.recov != "" {
                    Row {
                      scale: tapBounce == "49${m.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "49${m.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "49${m.id}"
                      onRelease: tapBounce = ""
                      fill: width
                      gap: 10
                      align: center
                      padding: [0, 3]
                      onTap: {
                        if animHaptics { haptic() }
                        copy(m.recov)
                        vaultToast = "COPIED · RECOVERY"
                      }
                      Text { font: uiFont; text: "RECOVERY"; fontSize: 10; color: cMuted; letterSpacing: 1.4; bold: true; width: 92 }
                      Text { font: uiFont; text: shown ? m.recov : "••••••••"; fontSize: 14; color: cInk; weight: 1; maxLines: 3 }
                    }
                  }
                  if m.phone != "" {
                    Row {
                      scale: tapBounce == "50${m.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "50${m.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "50${m.id}"
                      onRelease: tapBounce = ""
                      fill: width
                      gap: 10
                      align: center
                      padding: [0, 3]
                      onTap: {
                        if animHaptics { haptic() }
                        copy(m.phone)
                        vaultToast = "COPIED · PHONE"
                      }
                      Text { font: uiFont; text: "PHONE"; fontSize: 10; color: cMuted; letterSpacing: 1.4; bold: true; width: 92 }
                      Text { font: uiFont; text: shown ? m.phone : "••••••••"; fontSize: 14; color: cInk; weight: 1; maxLines: 3 }
                    }
                  }
                  if m.tfa != "" {
                    Row {
                      scale: tapBounce == "51${m.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "51${m.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "51${m.id}"
                      onRelease: tapBounce = ""
                      fill: width
                      gap: 10
                      align: center
                      padding: [0, 3]
                      onTap: {
                        if animHaptics { haptic() }
                        copy(m.tfa)
                        vaultToast = "COPIED · 2FA"
                      }
                      Text { font: uiFont; text: "2FA"; fontSize: 10; color: cMuted; letterSpacing: 1.4; bold: true; width: 92 }
                      Text { font: uiFont; text: m.tfa; fontSize: 14; color: cInk; weight: 1; maxLines: 3 }
                    }
                  }
                  if m.alias != "" {
                    Row {
                      scale: tapBounce == "52${m.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "52${m.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "52${m.id}"
                      onRelease: tapBounce = ""
                      fill: width
                      gap: 10
                      align: center
                      padding: [0, 3]
                      onTap: {
                        if animHaptics { haptic() }
                        copy(m.alias)
                        vaultToast = "COPIED · ALIASES"
                      }
                      Text { font: uiFont; text: "ALIASES"; fontSize: 10; color: cMuted; letterSpacing: 1.4; bold: true; width: 92 }
                      Text { font: uiFont; text: shown ? m.alias : "••••••••"; fontSize: 14; color: cInk; weight: 1; maxLines: 3 }
                    }
                  }
                  if m.body != "" {
                    Row {
                      scale: tapBounce == "53${m.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "53${m.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "53${m.id}"
                      onRelease: tapBounce = ""
                      fill: width
                      gap: 10
                      align: center
                      padding: [0, 3]
                      onTap: {
                        if animHaptics { haptic() }
                        copy(m.body)
                        vaultToast = "COPIED · NOTES"
                      }
                      Text { font: uiFont; text: "NOTES"; fontSize: 10; color: cMuted; letterSpacing: 1.4; bold: true; width: 92 }
                      Text { font: uiFont; text: m.body; fontSize: 14; color: cInk; weight: 1; maxLines: 3 }
                    }
                  }
                  Row {
                    fill: width
                    gap: 8
                    Box {
                      scale: tapBounce == "54${m.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "54${m.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "54${m.id}"
                      onRelease: tapBounce = ""
                      weight: 1
                      height: 36
                      radius: 10
                      align: center
                      background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.9), #000000, alpha(cPri, 0.09)])
                      border: 1
                      borderColor: alpha(cMid, 0.5)
                      onTap: {
                        if animHaptics { haptic() }
                        mailReveal = mailReveal == m.id ? 0 : m.id
                      }
                      Text { font: uiFont; text: shown ? "MASK" : "SHOW"; fontSize: 11; color: cHot; bold: true; letterSpacing: 1.2; align: center; fill: width }
                    }
                    Box {
                      scale: tapBounce == "55${m.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "55${m.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "55${m.id}"
                      onRelease: tapBounce = ""
                      weight: 1
                      height: 36
                      radius: 10
                      align: center
                      background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cCard, 0.9), #000000, alpha(cSec, 0.11)])
                      border: 1
                      borderColor: alpha(cMid, 0.5)
                      onTap: {
                        if animHaptics { haptic() }
                        copy(m.addr)
                        vaultToast = "COPIED · ${m.addr}"
                      }
                      Text { font: uiFont; text: "COPY"; fontSize: 11; color: cHot; bold: true; letterSpacing: 1.2; align: center; fill: width }
                    }
                    Box {
                      scale: tapBounce == "56${m.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "56${m.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "56${m.id}"
                      onRelease: tapBounce = ""
                      weight: 1
                      height: 36
                      radius: 10
                      align: center
                      background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cCard, 0.9), #000000, alpha(cSec, 0.10)])
                      border: 1
                      borderColor: alpha(cMid, 0.5)
                      onTap: {
                        if animHaptics { haptic() }
                        url("mailto:" + m.addr)
                      }
                      Text { font: uiFont; text: "✉ WRITE"; fontSize: 11; color: cHot; bold: true; letterSpacing: 1.2; align: center; fill: width }
                    }
                    Box {
                      scale: tapBounce == "57${m.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "57${m.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "57${m.id}"
                      onRelease: tapBounce = ""
                      weight: 1
                      height: 36
                      radius: 10
                      align: center
                      background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.9), #000000, alpha(cPri, 0.09)])
                      border: 1
                      borderColor: alpha(cDim, 0.7)
                      onTap: {
                        if animHaptics { haptic() }
                        mailEditId = m.id
                        meAddr = m.addr
                        meProv = m.prov
                        mePurpose = m.purpose
                        meRecov = m.recov
                        mePhone = m.phone
                        me2fa = m.tfa
                        meAlias = m.alias
                        meBody = m.body
                        mailEdit = true
                      }
                      Text { font: uiFont; text: "EDIT"; fontSize: 11; color: cInk; bold: true; letterSpacing: 1.2; align: center; fill: width }
                    }
                  }
                }
              }
            }

            if len(mailBook) > 0 && !mailEdit {
              Box {
                scale: tapBounce == "58" ? 0.9 : 1
                offset: [0, tapBounce == "58" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "58"
                onRelease: tapBounce = ""
                fill: width
                height: 150
                radius: 20
                clip: true
                background: linear(0, 0, 1, 1, [alpha(cPri, 0.14), alpha(cCard, 0.85), alpha(#000000, 0.9)])
                border: 1
                borderColor: alpha(cMid, 0.3 + 0.3 * sin(fxT * 1.6))
                onTap: {
                  if animHaptics { haptic() }
                  mailEditId = 0
                  meAddr = ""
                  meProv = ""
                  mePurpose = ""
                  meRecov = ""
                  mePhone = ""
                  me2fa = ""
                  meAlias = ""
                  meBody = ""
                  mailEdit = true
                }
                Box { fill: true; background: linear(((fxT * 0.22) % 1.8) - 0.6, 0, ((fxT * 0.22) % 1.8) - 0.1, 1, [alpha(#ffffff, 0), alpha(#ffffff, 0.08), alpha(#ffffff, 0)]) }
                Column {
                  fill: true
                  align: center
                  justify: center
                  gap: 4
                  Text { font: uiFont; text: "✉"; fontSize: 40; color: cHot; fontWeight: 200; align: center; fill: width }
                  Text { font: uiFont; text: "ADD ANOTHER INBOX"; fontSize: 12; color: cInk; letterSpacing: 2.0; bold: true; align: center; fill: width }
                }
              }
            }
            Box { height: 16 }
          }
        }
      }
    }
    }
  }
}
