          // Horizontal snarling bite seam (ignites arcane magenta on tap surge!)
          path([[cx - u * 0.28, cy + u * 0.45], [cx, cy + u * 0.49], [cx + u * 0.28, cy + u * 0.45]], stroke: mix(#05000a, #e82cff, surge * 0.78), width: 1.7 + surge * 0.9, cap: round)
          // 5 vertical inter-dental slits carving 6 distinct bone teeth
