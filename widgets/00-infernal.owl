face "infernal" {
  meta { owl: 22; description: "Sith Obsidian Sanctum: living AGSL dark-side void, interactive blood splatter, crimson tracers, Force lightning, and hidden Palpatine's Secrets vault." }
  page: 0
  statusBar: false
  padding: 0

  source now = clock every 30s
  source bat = android.battery every 2m
  source cgDrawer = android.drawer
  source ecoCfg = file("~/.config/omalauncher/eco-mode.json") json
  source animCfg = file("~/.config/omalauncher/animations.json") json

  asset icoFb = base64""
  asset icoFbF = base64""
  asset icoIg = base64""
  asset icoIgF = base64""
  asset icoX = base64""
  asset icoXF = base64""
  asset icoYt = base64""
  asset icoYtF = base64""
  asset icoSc = base64""
  asset icoScF = base64""
  asset icoTt = base64""
  asset icoTtF = base64""
  asset icoRd = base64""
  asset icoRdF = base64""
  asset icoDc = base64""
  asset icoDcF = base64""
  asset icoSn = base64""
  asset icoSnF = base64""
  asset icoChrome = base64""
  asset icoChromeF = base64""
  asset icoMsg = base64""
  asset icoMsgF = base64""
  asset icoMusic = base64""
  asset icoMusicF = base64""
  asset icoTerm = base64""
  asset icoTermF = base64""
  asset icoPhone = base64""
  asset icoPhoneF = base64""
  asset icoMail = base64""
  asset icoMailF = base64""
  asset icoEmpty = base64""
  asset icoEmptyF = base64""
  asset icoFrame = base64""
  asset icoFrameF = base64""

  // Crimson Glitch 5-slot occult app dock state
  state cgAnimated = true persist
  state cgAppSlots = ["", "", "", "", ""] persist
  state cgSlotsReady = false persist
  state cgEditMode = false
  state cgActiveSlot = 0
  state cgQuery = ""
  state cgSortByUse = true persist
  state cgFxT = 0
  state cgTapX = 0.5
  state cgTapY = 0.5
  state cgBurst = 0
  state cgGlitchSeed = 42
  state cgPulses = []

  // FX Mode: 1 = SITH (default live), 2 = OVERDRIVE (max tracers/lightning/splatter), 0 = ECO (1 fps)
  // Appearance only: "infernal" (occult crimson) or "future" (clean cyan future-OS)
  state uiMode = "infernal" persist
  state fxMode = 1 persist
  state fxT = 0
  state impSeq = 1
  state lastPad = -1
  state combo = ""

  // Purge Chamber (task + process manager) — shares this face's screen{} with the vault
  state scrMode = "vault"
  state killLog = ""
  source sysInfo = android.system every 15s
  source recentApps = android.recent
  source procs = cmd(scrMode == "tasks" ? "ps -eo pid,rss,pcpu,comm --no-headers --sort=-rss | awk 'BEGIN{printf \"[\"} {if(NR>1)printf \",\"; printf \"{\\\"pid\\\":%s,\\\"rss\\\":%s,\\\"cpu\\\":%s,\\\"name\\\":\\\"%s\\\"}\", $1,$2,$3,$4} END{print \"]\"}'" : "echo []") every 30s json optional

  // Ring buffer of 6 recent screen-press impacts (exact length 6 for AGSL float4[6] uniform)
  state impacts = [
    { x: -200, y: -200, t: -99, seed: 1.1, pwr: 1.0 },
    { x: -200, y: -200, t: -99, seed: 2.3, pwr: 1.0 },
    { x: -200, y: -200, t: -99, seed: 3.7, pwr: 1.0 },
    { x: -200, y: -200, t: -99, seed: 5.1, pwr: 1.0 },
    { x: -200, y: -200, t: -99, seed: 6.9, pwr: 1.0 },
    { x: -200, y: -200, t: -99, seed: 8.4, pwr: 1.0 }
  ]

  // Palpatine's Secrets — Personal Vault state (persisted locally on device, never hardcoded)
  state vaultTab = "ALL"
  state revealAll = false
  state revealId = 0
  state vaultToast = ""
  state editMode = false
  state editId = 0
  state editCat = "IDENTITY"
  state editLabel = ""
  state editValue = ""
  state editNote = ""
  state nextVaultId = 20 persist
  state vaultItems = [
    { id: 1,  cat: "IDENTITY", label: "FULL LEGAL NAME",     value: "", note: "DOB · Citizenship · Legal Name" },
    { id: 2,  cat: "IDENTITY", label: "HOME ADDRESS",        value: "", note: "Street · Apt · City · State · ZIP" },
    { id: 3,  cat: "IDENTITY", label: "SSN / GOV ID",        value: "", note: "SSN · Passport # · Driver License #" },
    { id: 4,  cat: "IDENTITY", label: "PHONE & EMERGENCY",   value: "", note: "Primary # · ICE Contact Name & #" },
    { id: 5,  cat: "EMAILS",   label: "PRIMARY EMAIL",       value: "", note: "Login · Recovery · 2FA Method" },
    { id: 6,  cat: "EMAILS",   label: "ALT / VAULT EMAIL",   value: "", note: "Private / Alias / Proton Account" },
    { id: 7,  cat: "EMAILS",   label: "RECOVERY & LOGINS",   value: "", note: "Backup Email · Master Account Hints" },
    { id: 8,  cat: "CARDS",    label: "PRIMARY CARD",        value: "", note: "Number · EXP ••/•• · CVV ••• · PIN ••••" },
    { id: 9,  cat: "CARDS",    label: "SECONDARY CARD",      value: "", note: "Number · EXP ••/•• · CVV ••• · ZIP" },
    { id: 10, cat: "CARDS",    label: "BANK ROUTING & ACCT", value: "", note: "Bank Name · Routing # · Account #" },
    { id: 11, cat: "VAULT",    label: "SEED PHRASES / KEYS", value: "", note: "Wallet Recovery · Passphrase" },
    { id: 12, cat: "VAULT",    label: "2FA BACKUP CODES",    value: "", note: "Emergency One-Time Recovery Codes" },
    { id: 13, cat: "VAULT",    label: "SAFE & LOCK COMBOS",  value: "", note: "Safe · Gate · Door · Locker PINs" },
    { id: 14, cat: "VAULT",    label: "MEDICAL & PRIVATE",   value: "", note: "Blood Type · Allergies · Rx · Notes" }
  ] persist

  let vaultTabs = ["ALL", "IDENTITY", "EMAILS", "CARDS", "VAULT"]
  let vaultCats = ["IDENTITY", "EMAILS", "CARDS", "VAULT"]
  let visibleVault = vaultTab == "ALL" ? vaultItems : vaultItems.filter(it => it.cat == vaultTab)
  let filledCount = len(vaultItems.filter(it => it.value != ""))

  let scrW = max(tileWidth ?? 360, 1)
  let scrH = max(tileHeight ?? 800, 1)
  let wide = scrW > scrH
  let level = bat.level ?? 0
  let low = level < 20

  let ecoOn = (ecoCfg.enabled ?? false) == true
  let animMaster = (animCfg.master ?? true) == true && !ecoOn
  let animHaptics = (animCfg.haptics ?? true) == true
  let animSpeed = clamp(num(animCfg.speed, 1.0), 0.25, 3.0)
  let infVoidOn = animMaster && (animCfg.infernal_void ?? true) == true
  let infFxOn = animMaster && (animCfg.infernal_fx ?? true) == true
  let infGlitchOn = animMaster && (animCfg.infernal_glitch_dock ?? true) == true
  let newestAge = fxT - impacts[0].t
  let burstActive = infFxOn && newestAge >= 0 && newestAge < 3.6
  let surge = infFxOn && newestAge >= 0 && newestAge < 1.1 ? clamp(1.0 - newestAge / 1.1, 0, 1) : 0
  let fxLive = infVoidOn
  let cgLive = infGlitchOn
  let fxBoost = animSpeed >= 1.5 ? 1.4 : 1.0
  let breathe = fxLive ? 0.5 + 0.5 * sin(fxT * 1.9) : 0.45

  source uiCfg = file("~/.config/omalauncher/ui-mode.json") json optional
  let futOn = (uiCfg.mode ?? "infernal") == "future"
  let uiFont = futOn ? "~/.local/share/fonts/RussoOne-Regular.ttf" : "~/.local/share/fonts/GrenzeGotisch.ttf"
  let gothicFont = futOn ? "~/.local/share/fonts/RussoOne-Regular.ttf" : "~/.local/share/fonts/PirataOne-Regular.ttf"
  let cgW = max(scrW - 36, 1)
  let cgH = 78
  let cgPadX = 7
  let cgPadY = 5
  let cgSlotGap = 5
  let cgSlotW = max(26, floor((cgW - cgPadX * 2 - cgSlotGap * 4) / 5))
  let cgIconSz = clamp(floor(min(cgSlotW - 12, cgH - 38)), 24, 34)
  let cgSlotH = clamp(cgIconSz + 10, 36, 44)

  let cgAllApps = cgDrawer.apps ?? []
  let cgSlotApps = range(5).map(i => cgAppSlots[i] != null && cgAppSlots[i] != "" ? cgAllApps.find(a => a.key == cgAppSlots[i]) : null)
  let cgActiveApp = cgSlotApps[cgActiveSlot]
  let cgQ = trim(cgQuery)
  let cgPickerAll = cgQ != "" ? rank(cgAllApps, cgQ) : (cgSortByUse ? cgAllApps.sortBy(a => -(a.score ?? 0)) : cgAllApps.sortBy(a => lower(a.name)))
  let cgPickerShown = cgPickerAll.take(60)

  when !cgSlotsReady && len(cgAllApps) > 0 {
    let s0 = cgAllApps.find(a => contains(lower(a.key), "facebook") || lower(a.name) == "lite")
    let s1 = cgAllApps.find(a => contains(lower(a.key), "instagram") || contains(lower(a.name), "instagram"))
    let s2 = cgAllApps.find(a => contains(lower(a.key), "twitter") || lower(a.name) == "x")
    let s3 = cgAllApps.find(a => contains(lower(a.key), "youtube") || contains(lower(a.name), "youtube"))
    let s4 = cgAllApps.find(a => contains(lower(a.key), "soundcloud") || contains(lower(a.name), "soundcloud") || contains(lower(a.key), "tiktok") || contains(lower(a.key), "reddit") || contains(lower(a.key), "discord") || contains(lower(a.name), "simpmusic"))
    cgAppSlots = [
      s0 != null ? s0.key : "",
      s1 != null ? s1.key : "",
      s2 != null ? s2.key : "",
      s3 != null ? s3.key : "",
      s4 != null ? s4.key : ""
    ]
    cgSlotsReady = true
  }

  fps: (!infVoidOn && !infFxOn && !infGlitchOn) ? 1 : (burstActive ? 40 : (infGlitchOn && (len(cgPulses) > 0 || cgBurst > 0) ? 30 : (infVoidOn || infFxOn ? 20 : 16)))

  every frame {
    if infVoidOn || infFxOn {
      fxT = fxT + dt * animSpeed
    }
    if infGlitchOn {
      cgFxT = cgFxT + dt * animSpeed
      if cgBurst > 0 {
        cgBurst = max(0, cgBurst - dt * 1.15 * animSpeed)
      }
      if len(cgPulses) > 0 {
        cgPulses = cgPulses.map(p => merge(p, { age: p.age + dt * animSpeed })).filter(p => p.age < 1.0)
      }
    }
  }

  let drumPads = [
    { idx: 0, num: "1", note: "C3",  col: (futOn ? #0b89a8 : #a80b1e), wav: "~/.local/share/omalauncher/synth-pads/pad-0.wav" },
    { idx: 1, num: "2", note: "Eb3", col: (futOn ? #12a7cc : #cc1228), wav: "~/.local/share/omalauncher/synth-pads/pad-1.wav" },
    { idx: 2, num: "3", note: "F3",  col: (futOn ? #1ad1ff : #ff1a34), wav: "~/.local/share/omalauncher/synth-pads/pad-2.wav" },
    { idx: 3, num: "4", note: "G3",  col: (futOn ? #00bce6 : #e60026), wav: "~/.local/share/omalauncher/synth-pads/pad-3.wav" },
    { idx: 4, num: "5", note: "Bb3", col: (futOn ? #3bd1ff : #ff3b4e), wav: "~/.local/share/omalauncher/synth-pads/pad-4.wav" }
  ]

  // Normalized impact uniforms for GPU AGSL shader: [nx, ny, age, seed]
  let shaderImpacts = impacts.map(imp => [
    clamp(imp.x / scrW, -1, 2),
    clamp(imp.y / scrH, -1, 2),
    imp.t < -50 ? 99.0 : max(0.0, fxT - imp.t),
    imp.seed
  ])

  background: #000000

  component DockApp(pkg, label, slotIdx) {
    Box {
      weight: 1
      fill: height
      align: center
      ripple: false
      onTap: {
        if infFxOn {
          let px = 18 + (scrW - 36) * ((slotIdx + 0.5) / 5.0)
          let py = scrH - (screenInset ?? 0) - 61
          impacts = [
            { x: px, y: py, t: fxT, seed: impSeq * 1.618 + 0.7, pwr: 1.1 },
            impacts[0], impacts[1], impacts[2], impacts[3], impacts[4]
          ]
          impSeq = impSeq + 1
        }
        if animHaptics { haptic() }
        androidApp(pkg)
      }
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) * 0.375
        let pulse = fxLive ? 0.5 + 0.5 * sin(fxT * 2.4 + slotIdx * 1.1) : 0.4
        let glowA = 0.20 + pulse * 0.14 + surge * 0.22
        circle(cx, cy, r * (1.10 + pulse * 0.08), fill: radial(cx, cy, r * 1.18, [alpha((futOn ? #1ad1ff : #ff1a34), glowA), alpha(#000000, 0)]))
        circle(cx, cy, r, stroke: alpha((futOn ? #24d1ff : #ff243c), 0.65 + pulse * 0.25 + surge * 0.1), width: 1.35)
        circle(cx, cy, r * 0.85, stroke: alpha((futOn ? #0e647a : #7a0e20), 0.55 + pulse * 0.2), width: 0.8)
        let rot = fxLive ? fxT * (slotIdx % 2 == 0 ? 14 : -14) : 0
        for i in range(4) {
          rotate(i * 90 + rot, cx, cy) {
            line(cx, cy - r * 1.11, cx, cy - r * 0.93, stroke: (futOn ? #38d1ff : #ff384e), width: 1.4, cap: round)
          }
        }
      }
      Image { src: "app:${pkg}"; size: 32; tint: (futOn ? #2ed1ff : #ff2e44); label: label }
    }
  }

  component DockCrown(pkg) {
    Box {
      weight: 1
      fill: height
      align: center
      ripple: false
      onTap: {
        if infFxOn {
          let px = scrW * 0.5
          let py = scrH - (screenInset ?? 0) - 61
          impacts = [
            { x: px, y: py, t: fxT, seed: impSeq * 1.618 + 0.9, pwr: 1.35 },
            impacts[0], impacts[1], impacts[2], impacts[3], impacts[4]
          ]
          impSeq = impSeq + 1
        }
        if animHaptics { haptic() }
        androidApp(pkg)
      }
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) * 0.345
        let pulse = fxLive ? 0.5 + 0.5 * sin(fxT * 3.1) : 0.5

        circle(cx, cy, r * (1.35 + pulse * 0.12), fill: radial(cx, cy, r * 1.48, [alpha((futOn ? #1ad1ff : #ff1a34), 0.34 + pulse * 0.16 + surge * 0.22), alpha((futOn ? #054b5c : #5c0514), 0.12), alpha(#000000, 0)]))
        circle(cx, cy, r * 1.12, stroke: alpha((futOn ? #26d1ff : #ff263f), 0.78 + pulse * 0.2), width: 1.45)
        circle(cx, cy, r * 0.98, stroke: alpha((futOn ? #12758f : #8f1224), 0.65), width: 0.9)
        let rot = fxLive ? -fxT * 18 : 0
        for i in range(8) {
          let cardinal = i % 2 == 0
          rotate(i * 45 + rot, cx, cy) {
            line(cx, cy - r * (cardinal ? 1.23 : 1.17), cx, cy - r * 1.04, stroke: cardinal ? (futOn ? #38d1ff : #ff384e) : alpha((futOn ? #26d1ff : #ff263f), 0.65), width: cardinal ? 1.5 : 1, cap: round)
          }
        }

        let pts = futOn ? range(7).map(k => [cx + cos(rad(k * 60 - 90)) * r * 0.80, cy + sin(rad(k * 60 - 90)) * r * 0.80]) : [0, 2, 4, 1, 3, 0].map(i => [
          cx + sin(3.14159265 + (i % 5) * 1.2566371) * r * 0.95,
          cy - cos(3.14159265 + (i % 5) * 1.2566371) * r * 0.95
        ])
        path(pts, closed: true, stroke: alpha((futOn ? #14d1ff : #ff142c), 0.22 + pulse * 0.14), width: 10)
        path(pts, closed: true, stroke: alpha((futOn ? #26d1ff : #ff263f), 0.90), width: 3.2)
        path(pts, closed: true, stroke: (futOn ? #70d1ff : #ff7080), width: 1.1)

        path([[cx, cy - 4.2], [cx + 3.2, cy], [cx, cy + 4.2], [cx - 3.2, cy]], closed: true, fill: (futOn ? #26d1ff : #ff263f), stroke: (futOn ? #7ad1ff : #ff7a88), width: 0.7)
      }
    }
  }

  // Infernal-tray style app icon: red glyph in a static sigil ring (no per-frame redraw)
  component TraySigil(src, sz, lbl = "", ini = "") {
    Box {
      size: sz
      align: center
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) * 0.42
        circle(cx, cy, r * 1.12, fill: radial(cx, cy, r * 1.2, [alpha((futOn ? #1ad1ff : #ff1a34), 0.26), alpha(#000000, 0)]))
        circle(cx, cy, r, stroke: alpha((futOn ? #24d1ff : #ff243c), 0.8), width: 1.35)
        circle(cx, cy, r * 0.85, stroke: alpha((futOn ? #0e647a : #7a0e20), 0.65), width: 0.8)
        for i in range(4) {
          rotate(i * 90, cx, cy) {
            line(cx, cy - r * 1.11, cx, cy - r * 0.93, stroke: (futOn ? #38d1ff : #ff384e), width: 1.4, cap: round)
          }
        }
      }
      if src != null {
        Image { src: src; size: round(sz * 0.5); tint: (futOn ? #2ed1ff : #ff2e44); label: lbl }
      } else {
        Text { font: uiFont; text: ini; fontSize: round(sz * 0.3); color: (futOn ? #2ed1ff : #ff2e44); bold: true; align: center }
      }
    }
  }

  component OccultIcon(app, sz) {
    let k = lower(app.key)
    let n = lower(app.name)
    let customSvg = (contains(k, "facebook") || n == "lite") ? (futOn ? icoFbF : icoFb)
      : (contains(k, "instagram") || contains(n, "instagram")) ? (futOn ? icoIgF : icoIg)
      : (contains(k, "twitter") || n == "x" || contains(n, "twitter")) ? (futOn ? icoXF : icoX)
      : (contains(k, "youtube") || contains(n, "youtube")) ? (futOn ? icoYtF : icoYt)
      : (contains(k, "soundcloud") || contains(n, "soundcloud")) ? (futOn ? icoScF : icoSc)
      : (contains(k, "tiktok") || contains(k, "musically") || contains(n, "tiktok")) ? (futOn ? icoTtF : icoTt)
      : (contains(k, "reddit") || contains(n, "reddit")) ? (futOn ? icoRdF : icoRd)
      : (contains(k, "discord") || contains(n, "discord")) ? (futOn ? icoDcF : icoDc)
      : (contains(k, "snapchat") || contains(n, "snapchat")) ? (futOn ? icoSnF : icoSn)
      : (contains(k, "chrome") || contains(n, "chrome") || contains(n, "browser")) ? (futOn ? icoChromeF : icoChrome)
      : (contains(k, "messag") || contains(n, "messag") || contains(k, "whatsapp") || contains(k, "telegram")) ? (futOn ? icoMsgF : icoMsg)
      : (contains(n, "music") || contains(k, "spotify") || contains(k, "music")) ? (futOn ? icoMusicF : icoMusic)
      : (contains(k, "foot") || contains(n, "terminal")) ? (futOn ? icoTermF : icoTerm)
      : (contains(k, "dialer") || contains(n, "phone")) ? (futOn ? icoPhoneF : icoPhone)
      : (contains(k, "android.gm") || contains(n, "gmail") || contains(n, "mail")) ? (futOn ? icoMailF : icoMail)
      : null

    Box {
      size: sz
      align: center
      if customSvg != null {
        Image { src: customSvg; size: sz; label: app.label }
      } else {
        Image { src: (futOn ? icoFrameF : icoFrame); size: sz }
        if app.hasIcon {
          Image {
            src: app.icon
            size: round(sz * 0.60)
            tint: cgDrawer.monochrome ? (futOn ? #24d1ff : #ff2442) : null
            label: app.label
          }
        } else {
          Text {
            font: uiFont
            text: app.initials
            fontSize: round(sz * 0.34)
            color: (futOn ? #2ed1ff : #ff2e4d)
            bold: true
            align: center
          }
        }
      }
    }
  }

  // Root layered container:
  // Layer 0: Living Sith AGSL GPU Shader (dark nebula, crimson lightning veins, GPU blood splatter & shockwaves)
  // Layer 1: Interactive Home Screen UI (with full-screen onPress capture for empty space)
  // Layer 2: Top-level Sith FX Overlay Canvas (vector crimson tracers, blood splatter drips, Force lightning, saber slashes)
  Box {
    fill: true
    repeats: true
    onPress: {
      if infFxOn {
        let pwr = repeat == 0 ? 1.25 : 0.78
        let jx = repeat == 0 ? 0 : (hash(impSeq, 13) - 0.5) * 34
        let jy = repeat == 0 ? 0 : (hash(impSeq, 29) - 0.5) * 34
        impacts = [
          { x: x + jx, y: y + jy, t: fxT, seed: impSeq * 1.732 + 0.41, pwr: pwr },
          impacts[0], impacts[1], impacts[2], impacts[3], impacts[4]
        ]
        impSeq = impSeq + 1
        if repeat == 0 && animHaptics {
          haptic()
        }
      }
    }

    // ==================== LAYER 0: GPU SITH ABYSS SHADER ====================
    if fxLive {
      Shader {
        fill: true
        fallback: #000000
        uniforms: {
          uT: fxT,
          uSurge: surge,
          uBoost: fxBoost,
          uImpacts: shaderImpacts,
          uFut: futOn ? 1.0 : 0.0
        }
        code: """
          uniform float uT;
          uniform float uSurge;
          uniform float uBoost;
          uniform float4 uImpacts[6];
          uniform float uFut;

          float hash21(float2 p) {
            p = fract(p * float2(123.34, 456.21));
            p += dot(p, p + 45.32);
            return fract(p.x * p.y);
          }

          float vnoise(float2 p) {
            float2 i = floor(p);
            float2 f = fract(p);
            f = f * f * (3.0 - 2.0 * f);
            float a = hash21(i);
            float b = hash21(i + float2(1.0, 0.0));
            float c = hash21(i + float2(0.0, 1.0));
            float d = hash21(i + float2(1.0, 1.0));
            return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
          }

          float fbm(float2 p) {
            float v = 0.0;
            float a = 0.5;
            for (int i = 0; i < 3; i++) {
              v += a * vnoise(p);
              p = p * 2.05 + float2(1.7, 9.2);
              a *= 0.5;
            }
            return v;
          }

          half4 main(float2 fragCoord) {
            float2 uv = fragCoord / max(size, float2(1.0));
            float aspect = size.x / max(size.y, 1.0);
            float2 p = float2((uv.x - 0.5) * aspect, uv.y - 0.5);

            // Pitch-black AMOLED obsidian base
            float3 col = float3(0.0);

            // 1. Living Sith dark-side nebula smoke drifting upward
            float2 q = float2(
              fbm(p * 2.6 + float2(0.0, uT * 0.14)),
              fbm(p * 2.6 + float2(5.2, -uT * 0.11))
            );
            float n = fbm(p * 3.1 + q * 1.4 + float2(0.0, uT * 0.18));
            float smoke = smoothstep(0.36, 0.86, n);

            // Keep center slightly darker for AMOLED contrast, stronger around edges & sigil aura
            float centerDist = length(p - float2(0.0, -0.07));
            float sigilGlow = exp(-centerDist * 3.2) * (0.28 + 0.12 * sin(uT * 2.1) + uSurge * 0.35);
            float edgeGlow = smoothstep(0.18, 0.78, length(p)) * (0.22 + uSurge * 0.25);

            col += float3(0.32, 0.015, 0.045) * smoke * (0.35 + edgeGlow * 1.4) * uBoost;
            col += float3(0.58, 0.02, 0.07) * sigilGlow * uBoost;

            // 2. Crackling dark-side crimson lightning veins in the void
            float veinBase = abs(fbm(p * 5.8 + q * 1.9 + float2(uT * 0.22, -uT * 0.35)) - 0.5);
            float vein = pow(clamp(1.0 - veinBase * 5.2, 0.0, 1.0), 5.0);
            float veinPulse = (0.14 + 0.14 * sin(uT * 3.7 + p.y * 5.0) + uSurge * 0.72) * uBoost;
            col += float3(1.0, 0.08, 0.18) * vein * veinPulse;

            // 3. GPU Organic Blood Splatter + Plasma Shockwave per touch impact
            for (int i = 0; i < 6; i++) {
              float4 imp = uImpacts[i];
              float age = imp.z;
              if (age >= 0.0 && age < 4.2) {
                float2 d = float2((uv.x - imp.x) * aspect, uv.y - imp.y);
                // Subtle gravity drip as the blood ages
                float dripWave = sin(d.x * 68.0 + imp.w * 7.0) * 0.5 + 0.5;
                float dripOffset = clamp(age - 0.12, 0.0, 3.8) * 0.018 * (0.3 + dripWave);
                float2 dDrip = float2(d.x, d.y - dripOffset * smoothstep(0.14, 0.0, abs(d.x)));

                float r = length(dDrip);
                float ang = atan(dDrip.y, dDrip.x);
                float seed = imp.w;

                // Jagged organic splatter boundary (multi-harmonic lobes + streaks)
                float expand = 1.0 - exp(-age * 16.0);
                float lobe = 0.042
                  + 0.024 * sin(ang * 5.0 + seed * 3.1)
                  + 0.017 * cos(ang * 9.0 - seed * 5.7)
                  + 0.012 * sin(ang * 15.0 + seed * 11.3)
                  + 0.008 * cos(ang * 23.0 - seed * 2.1);
                float splatRad = max(0.015, lobe * expand * (0.9 + 0.25 * uBoost));
                float fade = smoothstep(4.2, 0.65, age);

                // Main arterial blood blot
                float blot = smoothstep(splatRad, splatRad * 0.42, r);
                // Satellite splash droplets along radial spokes
                float spoke = pow(max(0.0, sin(ang * 13.0 + seed * 6.3)), 6.0);
                float satRing = smoothstep(0.022, 0.0, abs(r - splatRad * (1.28 + 0.35 * sin(ang * 7.0 + seed))));
                float droplets = spoke * satRing;

                float splatMask = clamp(blot + droplets * 0.9, 0.0, 1.0) * fade;
                // Hot searing magma flash on fresh press -> cools to deep wet arterial blood
                float hot = exp(-age * 6.5);
                float3 bloodCol = mix(float3(0.48, 0.01, 0.045), float3(1.0, 0.16, 0.24), hot);
                float rim = smoothstep(splatRad * 0.88, splatRad * 0.52, r) * (1.0 - smoothstep(splatRad * 0.52, splatRad * 0.18, r));
                bloodCol += float3(0.75, 0.04, 0.10) * rim * 0.65;

                col += bloodCol * splatMask * (0.95 + hot * 0.5);

                // Expanding crimson shockwave ring
                float waveR = age * 0.58;
                float waveFade = exp(-age * 4.2);
                float ring = smoothstep(0.018, 0.0, abs(length(d) - waveR)) * waveFade;
                col += float3(1.0, 0.14, 0.26) * ring * 0.85 * uBoost;

                // Impact core flash
                float core = exp(-length(d) * 14.0) * exp(-age * 7.5);
                col += float3(1.0, 0.28, 0.36) * core * 0.9;
              }
            }

            // 4. Subtle Holocron horizontal scanlines
            float scan = 0.94 + 0.06 * sin(fragCoord.y * 0.85 + uT * 4.0);
            col *= scan;

            // Clamp softly for clean OLED rendering
            col = mix(col, float3(min(col.g, col.b), max(col.g, col.r * 0.82), col.r), uFut);
            col = clamp(col, 0.0, 1.0);
            return half4(col, 1.0);
          }
        """
      }
    }

    // ==================== LAYER 1: MAIN HOME SCREEN UI ====================
    Column {
      fill: true
      padding: [18, 16, 18, 20]
      gap: 0

      // Top 5-Panel Synth/Drum Strip (secret sequence 1-3-5-1-3-5 opens the hidden vault screen)
      Row {
        fill: width
        height: 46
        gap: 6
        for p in drumPads key p.idx {
          let active = lastPad == p.idx
          Box {
            weight: 1
            fill: height
            radius: 7
            clip: true
            ripple: false
            background: linear(0, 0, 0, 1, [
              alpha(p.col, active ? 0.36 : 0.14),
              (futOn ? #000507 : #070003),
              alpha(p.col, active ? 0.24 : 0.08)
            ])
            border: 1
            borderColor: alpha(p.col, active ? 1.0 : (0.50 + breathe * 0.22))
            align: center
            onTap: {
              if infFxOn {
                let px = 18 + (scrW - 36) * ((p.idx + 0.5) / 5.0)
                let py = 39
                impacts = [
                  { x: px, y: py, t: fxT, seed: impSeq * 1.91 + p.idx * 0.7, pwr: 1.15 },
                  impacts[0], impacts[1], impacts[2], impacts[3], impacts[4]
                ]
                impSeq = impSeq + 1
              }
              lastPad = p.idx
              if animHaptics { haptic() }
              sound(p.wav)
              let next = combo + p.num
              let trimmed = len(next) > 6 ? sub(next, len(next) - 6, len(next)) : next
              if trimmed == "135135" {
                combo = ""
                scrMode = "vault"
                screen()
              } else {
                combo = trimmed
              }
            }
            Canvas {
              fill: true
              let w = width
              let h = height
              let padPulse = fxLive ? 0.5 + 0.5 * sin(fxT * 3.0 + p.idx * 0.9) : 0.5
              if active || surge > 0.1 {
                circle(w / 2, h / 2, max(w, h) * 0.68, fill: radial(w / 2, h / 2, max(w, h) * 0.68, [alpha(p.col, active ? 0.38 : surge * 0.22), alpha(#000000, 0)]))
              }
              // Top neon edge rail
              line(7, 2.2, w - 7, 2.2, stroke: alpha(p.col, active ? 1.0 : (0.68 + padPulse * 0.28)), width: active ? 2.6 : 1.7, cap: round)
              // Bottom subtle rail
              line(10, h - 2.2, w - 10, h - 2.2, stroke: alpha(p.col, active ? 0.72 : (0.24 + padPulse * 0.16)), width: 1, cap: round)
              // Center percussion pip
              circle(w / 2, h / 2, active ? 3.5 : (1.8 + padPulse * 0.8), fill: alpha(p.col, active ? 1.0 : (0.55 + padPulse * 0.35)))
              if active {
                circle(w / 2, h / 2, 8.0 + padPulse * 2.0, stroke: alpha(p.col, 0.55), width: 1.1)
              }
            }
          }
        }
      }

      Spacer { height: 12 }

      // Top liturgical Sith crest
      Row {
        fill: width
        align: center
        gap: 10
        Box { weight: 1; height: 1; background: linear(0, 0, 1, 0, [alpha((futOn ? #1ed1ff : #ff1e38), 0), alpha((futOn ? #1ed1ff : #ff1e38), 0.55 + breathe * 0.35 + surge * 0.1)]) }
        Text {
          font: uiFont
          text: "✦  THE CINDER CROWN  ✦"
          style: label
          color: mix((futOn ? #24d1ff : #ff243c), (futOn ? #66d1ff : #ff6678), surge * 0.55 + breathe * 0.15)
          letterSpacing: 2.6
          bold: true
        }
        Box { weight: 1; height: 1; background: linear(0, 0, 1, 0, [alpha((futOn ? #1ed1ff : #ff1e38), 0.55 + breathe * 0.35 + surge * 0.1), alpha((futOn ? #1ed1ff : #ff1e38), 0)]) }
      }
      Spacer { height: 5 }
      Text {
        font: uiFont
        text: ecoOn ? "CHILL SANCTUM  ·  SUPER FAST ECO" : "OBSIDIAN SANCTUM  ·  SITH ORDER"
        style: small
        color: ecoOn ? (futOn ? #24728c : #8c2434) : mix((futOn ? #3e647a : #7a3e48), (futOn ? #38d1ff : #ff384e), surge * 0.45)
        letterSpacing: 2.0
        align: center
        fill: width
      }

      Spacer { weight: 1 }

      // Centerpiece Living Sith Demon Sigil (or ultra-light static chill moon/crest in Eco mode)
      let sigilH = wide ? min(scrH * 0.58, 380) : min(scrH * 0.34, 275)
      if ecoOn {
        Canvas {
          width: wide ? min(scrW * 0.48, 360) : min(scrW - 28, 320)
          height: sigilH
          fill: width
          let cx = width / 2
          let cy = height / 2
          let r = min(width, height) * 0.34
          circle(cx, cy, r * 1.05, stroke: alpha((futOn ? #125366 : #661220), 0.55), width: 1.0)
          circle(cx, cy, r * 0.86, stroke: alpha((futOn ? #2696b8 : #b8263a), 0.72), width: 1.4)
          circle(cx, cy, r * 0.52, stroke: alpha((futOn ? #125366 : #661220), 0.45), width: 1.0)
          line(cx, cy - r * 1.22, cx, cy - r * 0.92, stroke: alpha((futOn ? #2696b8 : #b8263a), 0.75), width: 1.2)
          line(cx, cy + r * 0.92, cx, cy + r * 1.22, stroke: alpha((futOn ? #2696b8 : #b8263a), 0.75), width: 1.2)
          circle(cx, cy, r * 0.20, fill: (futOn ? #01080a : #0a0103), stroke: (futOn ? #2696b8 : #b8263a), width: 1.2)
          circle(cx + r * 0.08, cy - r * 0.04, r * 0.16, fill: #000000)
        }
      } else {
      Canvas {
        width: wide ? min(scrW * 0.48, 360) : min(scrW - 28, 320)
        height: sigilH
        fill: width
        onPress: {
          if infFxOn {
            let sx = 18 + x
            let sy = scrH * 0.38 - sigilH * 0.5 + y
            impacts = [
              { x: sx, y: sy, t: fxT, seed: impSeq * 2.13 + 0.19, pwr: 1.65 },
              impacts[0], impacts[1], impacts[2], impacts[3], impacts[4]
            ]
            impSeq = impSeq + 1
            if animHaptics { haptic() }
          }
        }

        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) * 0.38
        let p = fxLive ? 0.5 + 0.5 * sin(fxT * 2.2) : 0.4
        let fastP = fxLive ? 0.5 + 0.5 * sin(fxT * 7.5) : 0.5

        // Deep breathing crimson Kyber core aura (flares violently on touch surge)
        circle(cx, cy, r * (1.42 + p * 0.10 + surge * 0.24), fill: radial(cx, cy, r * (1.42 + p * 0.10 + surge * 0.24), [
          alpha((futOn ? #14d1ff : #ff1430), 0.28 + p * 0.14 + surge * 0.34),
          alpha((futOn ? #045a6e : #6e0414), 0.12 + surge * 0.15),
          alpha(#000000, 0)
        ]))

        // Vertical Sith saber-rift spear axis + glowing diamond finials
        let spearGlow = 0.72 + p * 0.28
        line(cx, cy - r * 1.33, cx, cy - r * 1.04, stroke: alpha((futOn ? #28d1ff : #ff2840), spearGlow), width: 1.5 + surge * 1.2)
        line(cx, cy + r * 1.04, cx, cy + r * 1.33, stroke: alpha((futOn ? #28d1ff : #ff2840), spearGlow), width: 1.5 + surge * 1.2)
        path([[cx, cy - r * 1.39], [cx + 4.5, cy - r * 1.33], [cx, cy - r * 1.27], [cx - 4.5, cy - r * 1.33]], closed: true, fill: mix((futOn ? #38d1ff : #ff384e), (futOn ? #7ad1ff : #ff7a88), surge * 0.6))
        path([[cx, cy + r * 1.27], [cx + 4.5, cy + r * 1.33], [cx, cy + r * 1.39], [cx - 4.5, cy + r * 1.33]], closed: true, fill: mix((futOn ? #38d1ff : #ff384e), (futOn ? #7ad1ff : #ff7a88), surge * 0.6))

        // Counter-rotating concentric Sith astrolabe rings
        circle(cx, cy, r * 1.11, stroke: alpha((futOn ? #0d647a : #7a0d1e), 0.58 + surge * 0.25), width: 1.0)
        circle(cx, cy, r * 1.02, stroke: alpha((futOn ? #24d1ff : #ff243c), 0.78 + p * 0.22), width: 1.6)
        circle(cx, cy, r * 0.94, stroke: alpha((futOn ? #0a4d5e : #5e0a17), 0.85), width: 1.0)
        circle(cx, cy, r * 0.62, stroke: alpha((futOn ? #24d1ff : #ff243c), 0.26 + p * 0.18 + surge * 0.3), width: 1.0)

        // Sweeping crimson Sith holocron radar arcs
        if fxLive {
          let arcA = (fxT * 42) % 360
          let arcB = (360 - (fxT * 28) % 360)
          arc(cx, cy, r * 1.11, arcA, 68, stroke: alpha((futOn ? #2ed1ff : #ff2e44), 0.72 + surge * 0.28), width: 2.0, cap: round)
          arc(cx, cy, r * 1.11, arcA + 180, 68, stroke: alpha((futOn ? #2ed1ff : #ff2e44), 0.72 + surge * 0.28), width: 2.0, cap: round)
          arc(cx, cy, r * 0.62, arcB, 95, stroke: alpha((futOn ? #4ad1ff : #ff4a5e), 0.45 + surge * 0.4), width: 1.4, cap: round)
        }

        // 36 precision astrolabe ticks (slow sinister rotation)
        let outerRot = fxLive ? fxT * 5.5 : 0
        for i in range(36) {
          let major = i % 3 == 0
          let cardinal = i % 9 == 0
          let outer = r * (cardinal ? 1.14 : major ? 1.07 : 1.02)
          let inner = r * (cardinal ? 0.91 : major ? 0.94 : 0.97)
          rotate(i * 10 + outerRot, cx, cy) {
            line(cx, cy - outer, cx, cy - inner, stroke: cardinal ? (futOn ? #38d1ff : #ff384e) : major ? alpha((futOn ? #28d1ff : #ff2840), 0.74) : alpha((futOn ? #18667d : #7d1826), 0.62), width: cardinal ? 2.1 : major ? 1.25 : 0.8, cap: round)
          }
        }

        if !futOn {
          // Multi-pass glowing inverted pentagram (vertex pointing straight down)
          let ppts = [0, 2, 4, 1, 3, 0].map(i => [
            cx + sin(3.14159265 + (i % 5) * 1.2566371) * r * 0.91,
            cy - cos(3.14159265 + (i % 5) * 1.2566371) * r * 0.91
          ])
          path(ppts, closed: true, stroke: alpha((futOn ? #14d1ff : #ff142c), 0.20 + p * 0.14 + surge * 0.25), width: 10 + surge * 5)
          path(ppts, closed: true, stroke: alpha((futOn ? #22d1ff : #ff223a), 0.84 + p * 0.16), width: 2.3 + surge * 0.9)
          path(ppts, closed: true, stroke: alpha((futOn ? #66d1ff : #ff6678), 0.85 + surge * 0.15), width: 0.9)

          // Crackling Sith Force-Lightning arcing along pentagram edges
          if fxLive {
            let boltStep = floor(fxT * 14)
            let boltCount = animSpeed >= 1.5 || surge > 0.15 ? 3 : 2
            for b in range(boltCount) {
              let idx = (boltStep + b * 2) % 5
              let a1 = 3.14159265 + idx * 1.2566371
              let a2 = 3.14159265 + ((idx + 2) % 5) * 1.2566371
              let x1 = cx + sin(a1) * r * 0.91
              let y1 = cy - cos(a1) * r * 0.91
              let x2 = cx + sin(a2) * r * 0.91
              let y2 = cy - cos(a2) * r * 0.91
              let j1 = (hash(boltStep + b * 17, 3) - 0.5) * 20
              let j2 = (hash(boltStep + b * 17, 7) - 0.5) * 20
              let j3 = (hash(boltStep + b * 17, 11) - 0.5) * 20
              let mx1 = x1 + (x2 - x1) * 0.33 + j1
              let my1 = y1 + (y2 - y1) * 0.33 + j2
              let mx2 = x1 + (x2 - x1) * 0.67 - j2
              let my2 = y1 + (y2 - y1) * 0.67 + j3
              let bAlpha = 0.28 + fastP * 0.35 + surge * 0.37
              path([[x1, y1], [mx1, my1], [mx2, my2], [x2, y2]], stroke: alpha((futOn ? #1ad1ff : #ff1a35), bAlpha * 0.55), width: 4.5, cap: round)
              path([[x1, y1], [mx1, my1], [mx2, my2], [x2, y2]], stroke: alpha((futOn ? #66d1ff : #ff6678), bAlpha), width: 1.1, cap: round)
            }
          }

          // Sculpted sweeping twin demon horns
          let h = r * 0.56
          path([[cx - h * 0.42, cy - h * 0.30], [cx - h * 0.96, cy - h * 1.06], [cx - h * 0.72, cy - h * 0.12], [cx - h * 0.38, cy + h * 0.04]], closed: true, fill: (futOn ? #032933 : #33030b), stroke: mix((futOn ? #26d1ff : #ff263f), (futOn ? #8ad1ff : #ff8a98), surge * 0.5), width: 1.4)
          path([[cx + h * 0.42, cy - h * 0.30], [cx + h * 0.96, cy - h * 1.06], [cx + h * 0.72, cy - h * 0.12], [cx + h * 0.38, cy + h * 0.04]], closed: true, fill: (futOn ? #032933 : #33030b), stroke: mix((futOn ? #26d1ff : #ff263f), (futOn ? #8ad1ff : #ff8a98), surge * 0.5), width: 1.4)

          // Angular obsidian demon visor crest
          path([[cx - h * 0.56, cy - h * 0.42], [cx, cy - h * 0.68], [cx + h * 0.56, cy - h * 0.42], [cx + h * 0.48, cy + h * 0.30], [cx, cy + h * 0.92], [cx - h * 0.48, cy + h * 0.30]], closed: true, fill: linear(cx, cy - h * 0.7, cx, cy + h * 0.9, [(futOn ? #021d24 : #240208), (futOn ? #000304 : #040001)]), stroke: mix((futOn ? #26d1ff : #ff263f), (futOn ? #99d1ff : #ff99a8), surge * 0.45), width: 1.6)

          // Forehead ruby third-eye diamond (pulses with Sith energy)
          circle(cx, cy - h * 0.32, h * (0.16 + p * 0.08 + surge * 0.14), fill: radial(cx, cy - h * 0.32, h * 0.32, [alpha((futOn ? #24d1ff : #ff243d), 0.45 + surge * 0.45), alpha(#000000, 0)]))
          path([[cx, cy - h * 0.46], [cx + h * 0.09, cy - h * 0.32], [cx, cy - h * 0.18], [cx - h * 0.09, cy - h * 0.32]], closed: true, fill: mix((futOn ? #2ed1ff : #ff2e44), (futOn ? #7ad1ff : #ff7a88), surge * 0.65), stroke: (futOn ? #66d1ff : #ff6678), width: 0.7)

          // Blazing twin demon slit eyes + hot core glint + surge glow
          circle(cx - h * 0.27, cy - h * 0.04, h * (0.22 + surge * 0.14), fill: radial(cx - h * 0.27, cy - h * 0.04, h * 0.34, [alpha((futOn ? #1ad1ff : #ff1a34), 0.32 + p * 0.18 + surge * 0.45), alpha(#000000, 0)]))
          circle(cx + h * 0.27, cy - h * 0.04, h * (0.22 + surge * 0.14), fill: radial(cx + h * 0.27, cy - h * 0.04, h * 0.34, [alpha((futOn ? #1ad1ff : #ff1a34), 0.32 + p * 0.18 + surge * 0.45), alpha(#000000, 0)]))
          path([[cx - h * 0.44, cy - h * 0.14], [cx - h * 0.09, cy - h * 0.02], [cx - h * 0.36, cy + h * 0.09]], closed: true, fill: (futOn ? #20d1ff : #ff2038))
          path([[cx + h * 0.44, cy - h * 0.14], [cx + h * 0.09, cy - h * 0.02], [cx + h * 0.36, cy + h * 0.09]], closed: true, fill: (futOn ? #20d1ff : #ff2038))
          path([[cx - h * 0.34, cy - h * 0.08], [cx - h * 0.16, cy - h * 0.02], [cx - h * 0.31, cy + h * 0.03]], closed: true, fill: mix((futOn ? #70d1ff : #ff7080), (futOn ? #7ad1ff : #ff7a88), p * 0.5 + surge * 0.5))
          path([[cx + h * 0.34, cy - h * 0.08], [cx + h * 0.16, cy - h * 0.02], [cx + h * 0.31, cy + h * 0.03]], closed: true, fill: mix((futOn ? #70d1ff : #ff7080), (futOn ? #7ad1ff : #ff7a88), p * 0.5 + surge * 0.5))

          // Sinister fanged maw
          path([[cx - h * 0.25, cy + h * 0.38], [cx, cy + h * 0.30], [cx + h * 0.25, cy + h * 0.38], [cx, cy + h * 0.53]], closed: true, stroke: (futOn ? #22bce6 : #e62238), width: 1.35)
          path([[cx - h * 0.19, cy + h * 0.39], [cx - h * 0.13, cy + h * 0.55], [cx - h * 0.07, cy + h * 0.41]], closed: true, fill: (futOn ? #70d1ff : #ff7080))
          path([[cx + h * 0.19, cy + h * 0.39], [cx + h * 0.13, cy + h * 0.55], [cx + h * 0.07, cy + h * 0.41]], closed: true, fill: (futOn ? #70d1ff : #ff7080))
        } else {
          // FUTURE: clean HUD core — hexagon, data rings, crosshair, pulsing node
          let hex = range(7).map(k => [cx + cos(rad(k * 60 - 90)) * r * 0.82, cy + sin(rad(k * 60 - 90)) * r * 0.82])
          let hexIn = range(7).map(k => [cx + cos(rad(k * 60 - 60)) * r * 0.48, cy + sin(rad(k * 60 - 60)) * r * 0.48])
          path(hex, closed: true, stroke: alpha(#18c8ff, 0.18 + p * 0.10 + surge * 0.25), width: 9 + surge * 4)
          path(hex, closed: true, stroke: alpha(#38d6ff, 0.85 + p * 0.15), width: 1.8)
          path(hexIn, closed: true, stroke: alpha(#9eeaff, 0.55 + surge * 0.3), width: 1.0)
          line(cx - r * 0.86, cy, cx - r * 0.30, cy, stroke: alpha(#38d6ff, 0.5), width: 1.0)
          line(cx + r * 0.30, cy, cx + r * 0.86, cy, stroke: alpha(#38d6ff, 0.5), width: 1.0)
          line(cx, cy - r * 0.30, cx, cy - r * 0.18, stroke: alpha(#38d6ff, 0.7), width: 1.2)
          line(cx, cy + r * 0.18, cx, cy + r * 0.30, stroke: alpha(#38d6ff, 0.7), width: 1.2)
          arc(cx, cy, r * 0.30, (fxLive ? fxT * -60 : 0), 250, stroke: alpha(#5fe0ff, 0.8), width: 2.2, cap: round)
          circle(cx, cy, r * (0.14 + p * 0.04 + surge * 0.08), fill: radial(cx, cy, r * 0.3, [alpha(#5fe0ff, 0.55 + surge * 0.4), alpha(#000000, 0)]))
          circle(cx, cy, r * 0.06, fill: #c8f6ff)
          for k in range(6) {
            circle(cx + cos(rad(k * 60 - 90)) * r * 0.82, cy + sin(rad(k * 60 - 90)) * r * 0.82, 2.6, fill: #9eeaff)
          }
        }

        // Orbiting Crimson Tracer Comets around the astrolabe
        let cometCount = fxLive ? 6 : 4
        for i in range(cometCount) {
          let dir = i % 2 == 0 ? 1 : -1
          let spd = 0.65 + (i % 3) * 0.35
          let a0 = i * 1.0472 + (fxLive ? fxT * spd * dir : 0.39)
          let d = r * (1.17 + hash(i, 7) * 0.11)
          let hx = cx + cos(a0) * d
          let hy = cy + sin(a0) * d
          if fxLive {
            // Fading multi-segment tracer tail
            for seg in range(4) {
              let tA = a0 - dir * (seg + 1) * 0.11
              let pA = a0 - dir * seg * 0.11
              let fade = 1.0 - seg * 0.24
              line(
                cx + cos(pA) * d, cy + sin(pA) * d,
                cx + cos(tA) * d, cy + sin(tA) * d,
                stroke: alpha((futOn ? #22d1ff : #ff223a), 0.72 * fade),
                width: (2.6 - seg * 0.5),
                cap: round
              )
            }
          }
          circle(hx, hy, i % 2 == 0 ? 2.4 : 1.7, fill: (futOn ? #5cd1ff : #ff5c70))
        }
      }
      }

      Spacer { height: 2 }

      // Blazing Neon Sith Clock (or clean chill AMOLED clock in Eco mode)
      Row {
        fill: width
        align: center
        Text { font: uiFont; text: ecoOn ? "☾" : "☩"; color: ecoOn ? (futOn ? #2696b8 : #b8263a) : mix((futOn ? #17647a : #7a1726), (futOn ? #2ed1ff : #ff2e44), breathe * 0.6 + surge * 0.4); fontSize: 16; weight: 1; align: center }
        Text {
          spans: [
            fmtTime(now, "HH"),
            { text: ":", color: ecoOn ? (futOn ? #2696b8 : #b8263a) : alpha((futOn ? #22d1ff : #ff223a), fxLive ? (0.45 + 0.55 * sin(fxT * 3.14)) : 1.0) },
            fmtTime(now, "mm")
          ]
          font: ecoOn ? "JetBrains Mono" : gothicFont
          fontSize: ecoOn ? 62 : 72
          letterSpacing: ecoOn ? 2 : 3
          color: ecoOn ? (futOn ? #33a7cc : #cc3344) : mix((futOn ? #2ed1ff : #ff2e44), (futOn ? #70d1ff : #ff7080), surge * 0.4)
          align: center
        }
        Text { font: uiFont; text: ecoOn ? "☾" : "☩"; color: ecoOn ? (futOn ? #2696b8 : #b8263a) : mix((futOn ? #17647a : #7a1726), (futOn ? #2ed1ff : #ff2e44), breathe * 0.6 + surge * 0.4); fontSize: 16; weight: 1; align: center }
      }
      Text { font: uiFont; text: upper(fmtTime(now, "EEEE  ·  d MMMM")); style: label; color: ecoOn ? (futOn ? #2e7d99 : #992e3e) : (futOn ? #6c96b8 : #b86c77); letterSpacing: 2.2; align: center; fill: width }

      Spacer { height: 10 }

      // Centered Battery & Unified FX Status Altar (controlled via Deck Forge animations.json)
      Row {
        fill: width
        align: center
        gap: 10
        Box { weight: 1; height: 1; background: ecoOn ? linear(0, 0, 1, 0, [alpha((futOn ? #2696b8 : #b8263a), 0), alpha((futOn ? #0c3f4d : #4d0c18), 0.85)]) : linear(0, 0, 1, 0, [alpha((futOn ? #1ed1ff : #ff1e38), 0), alpha((futOn ? #12758f : #8f1224), 0.85)]) }
        Row {
          gap: 8
          align: center
          padding: [13, 5]
          radius: 99
          background: ecoOn ? (futOn ? #000608 : #080002) : (futOn ? #01080a : #0a0104)
          border: 1
          borderColor: ecoOn ? (futOn ? #125366 : #661220) : (low || animSpeed >= 1.5 ? (futOn ? #1ed1ff : #ff1e38) : alpha((futOn ? #22d1ff : #ff2236), 0.45 + breathe * 0.25))
          Text {
            font: uiFont
            text: bat.charging ? "✦ ${level}%" : "◈ ${level}%"
            style: small
            color: low ? (ecoOn ? (futOn ? #24d1ff : #ff243c) : (futOn ? #38d1ff : #ff384e)) : (ecoOn ? (futOn ? #4cb1d9 : #d94c5e) : (futOn ? #6bd1ff : #ff6b7c))
            bold: low
            letterSpacing: 1
          }
          Text { font: uiFont; text: "·"; style: small; color: ecoOn ? (futOn ? #125366 : #661220) : (futOn ? #194b5c : #5c1924) }
          Text {
            font: uiFont
            text: ecoOn ? "SUPER FAST ECO" : (!animMaster ? "FX OFF" : (animSpeed >= 1.5 ? "OVERDRIVE" : "SITH"))
            style: small
            color: ecoOn ? (futOn ? #24a7cc : #cc243a) : (!animMaster ? (futOn ? #47758f : #8f4752) : (animSpeed >= 1.5 ? (futOn ? #5cd1ff : #ff5c70) : (futOn ? #38d1ff : #ff384e)))
            bold: ecoOn || animMaster
            letterSpacing: 1.3
          }
        }
        Row {
          gap: 5
          align: center
          padding: [11, 5]
          radius: 99
          background: ecoOn ? (futOn ? #000608 : #080002) : (futOn ? #01080a : #0a0104)
          border: 1
          borderColor: ecoOn ? (futOn ? #125366 : #661220) : alpha((futOn ? #22d1ff : #ff2236), 0.7)
          onTap: {
            if animHaptics { haptic() }
            run("owl-send 25-sith-command-deck.owl set forgeReq $(date +%s%N)")
          }
          Text { font: uiFont; text: "⚙"; style: small; color: ecoOn ? (futOn ? #4cb1d9 : #d94c5e) : (futOn ? #38d1ff : #ff384e); bold: true }
          Text { font: uiFont; text: "FORGE"; style: small; color: ecoOn ? (futOn ? #24a7cc : #cc243a) : (futOn ? #6bd1ff : #ff6b7c); bold: true; letterSpacing: 1.3 }
        }
        Row {
          gap: 5
          align: center
          padding: [11, 5]
          radius: 99
          background: futOn ? alpha(#04101a, 0.9) : #0a0104
          border: 1
          borderColor: futOn ? alpha(#38d6ff, 0.7) : alpha(#ff2236, 0.7)
          onTap: {
            if animHaptics { haptic() }
            run(futOn ? "echo '{\"mode\":\"infernal\"}' > ~/.config/omalauncher/ui-mode.json" : "echo '{\"mode\":\"future\"}' > ~/.config/omalauncher/ui-mode.json")
          }
          Text { font: uiFont; text: futOn ? "◐" : "⛧"; style: small; color: futOn ? #38d6ff : #ff384e; bold: true }
          Text { font: uiFont; text: futOn ? "FUTURE" : "INFERNAL"; style: small; color: futOn ? #9eeaff : #ff6b7c; bold: true; letterSpacing: 1.3 }
        }
        Box { weight: 1; height: 1; background: ecoOn ? linear(0, 0, 1, 0, [alpha((futOn ? #0c3f4d : #4d0c18), 0.85), alpha((futOn ? #2696b8 : #b8263a), 0)]) : linear(0, 0, 1, 0, [alpha((futOn ? #12758f : #8f1224), 0.85), alpha((futOn ? #1ed1ff : #ff1e38), 0)]) }
      }

      Spacer { height: 8 }
      Text {
        font: uiFont
        text: ecoOn ? "☾  CHILL BATTERY MODE  ·  ANIMATIONS OFF  ·  540P  ☾" : "✦  PEACE IS A LIE  ·  THROUGH PASSION, POWER  ✦"
        style: small
        color: ecoOn ? (futOn ? #1e647a : #7a1e2c) : mix((futOn ? #2a5a6e : #6e2a35), (futOn ? #38d1ff : #ff384e), surge * 0.55)
        letterSpacing: futOn ? 0 : 1.8
        align: center
        fill: width
      }

      Spacer { weight: 1 }

      // Embedded Crimson Glitch 5-Slot Occult App Dock
      Box {
        fill: width
        height: cgH
        radius: 11
        clip: true
        border: 1
        borderColor: ecoOn ? (futOn ? #09303b : #3b0912) : (cgEditMode ? (futOn ? #33d1ff : #ff3355) : alpha((futOn ? #22d1ff : #ff2244), 0.58))

        // Layer 1: Living deep-red gradient + glitch AGSL shader (or static chill/crimson card)
        if cgLive {
          Shader {
            fill: true
            fallback: (futOn ? #00080a : #0a0002)
            uniforms: {
              uT: cgFxT,
              uTap: [cgTapX, cgTapY],
              uBurst: cgBurst,
              uSeed: cgGlitchSeed,
              uFut: futOn ? 1.0 : 0.0
            }
            code: """
              uniform float uT;
              uniform float2 uTap;
              uniform float uBurst;
              uniform float uFut;
              uniform float uSeed;

              float hash11(float n) {
                return fract(sin(n * 127.1 + 311.7) * 43758.5453);
              }

              half3 redGrad(float2 uv, float t) {
                float w1 = sin(uv.x * 2.9 + uv.y * 3.7 + t * 0.45) * 0.5 + 0.5;
                float w2 = sin(uv.x * 2.2 - uv.y * 2.8 - t * 0.36 + w1 * 0.9) * 0.5 + 0.5;

                float2 c1 = float2(0.70 + 0.14 * sin(t * 0.33), 0.28 + 0.10 * cos(t * 0.27));
                float2 c2 = float2(0.25 + 0.14 * cos(t * 0.26), 0.55 + 0.11 * sin(t * 0.35));
                float2 c3 = float2(0.72 + 0.11 * sin(t * 0.24 + 1.7), 0.78 + 0.08 * cos(t * 0.30));

                float2 d1 = (uv - c1) * float2(1.15, 1.35);
                float2 d2 = (uv - c2) * float2(1.10, 1.30);
                float2 d3 = (uv - c3) * float2(1.15, 1.35);

                float g1 = exp(-dot(d1, d1) * 3.6);
                float g2 = exp(-dot(d2, d2) * 3.8);
                float g3 = exp(-dot(d3, d3) * 3.5);

                float fold = uv.x * 0.85 - uv.y * 0.65 + 0.06 + 0.07 * sin(uv.y * 4.8 + t * 0.48);
                float g4 = exp(-(fold * fold) * 20.0) * (0.45 + 0.55 * w2);

                float3 col = float3(0.02, 0.0, 0.005);
                col += g1 * float3(0.92 + 0.08 * w1, 0.03 + 0.04 * w2, 0.09 + 0.06 * w2);
                col += g2 * float3(0.98, 0.04 + 0.04 * w1, 0.07 + 0.04 * w1);
                col += g3 * float3(0.68 + 0.14 * w1, 0.015 + 0.02 * w2, 0.07 + 0.05 * w2);
                col += g4 * float3(0.88, 0.05 + 0.05 * w1, 0.09);

                float vig = smoothstep(0.0, 0.12, uv.x) * smoothstep(1.0, 0.88, uv.x)
                          * smoothstep(0.0, 0.14, uv.y) * smoothstep(1.0, 0.86, uv.y);
                col *= (0.35 + 0.65 * vig);
                col = col / (1.0 + 0.38 * col);
                return half3(col);
              }

              half4 main(float2 p) {
                float2 uv = p / size;
                float aspect = size.x / max(size.y, 1.0);

                float beat = floor(uT * 4.5);
                float ambientGate = step(0.85, hash11(beat * 1.41));
                float sliceId = floor(uv.y * 36.0);
                float sliceRand = hash11(sliceId + beat * 19.7 + uSeed * 0.01);
                float sliceActive = step(0.83, sliceRand) * ambientGate;

                float2 diff = uv - uTap;
                float2 diffA = float2(diff.x * aspect, diff.y);
                float distTap = length(diffA);
                float age = 1.0 - uBurst;
                float waveR = age * 0.82;
                float ring = exp(-pow((distTap - waveR) * 16.0, 2.0)) * uBurst;
                float coreGlow = exp(-distTap * 6.0) * uBurst * uBurst;

                float yBand = exp(-abs(uv.y - uTap.y) * 8.0);
                float pressSlice = step(0.60, hash11(floor(uv.y * 46.0) + floor(uT * 24.0) * 7.3 + uSeed * 0.13)) * uBurst * (0.35 + 0.95 * yBand);

                float glitchAmt = sliceActive * 0.025 + pressSlice * 0.06;
                float dir = (hash11(sliceId * 3.1 + uSeed * 0.07) - 0.5) * 2.0;

                float2 dirVec = distTap > 0.001 ? diff / distTap : float2(0.0, 0.0);
                float2 warpedUv = uv + dirVec * (ring * 0.036) + float2(dir * glitchAmt, 0.0);

                float chroma = 0.005 + glitchAmt * 0.9 + ring * 0.030;
                half3 colR = redGrad(warpedUv + float2(chroma, 0.0), uT);
                half3 colG = redGrad(warpedUv, uT);
                half3 colB = redGrad(warpedUv - float2(chroma, 0.0), uT);
                half3 col = half3(colR.r, colG.g, colB.b);

                col += half3(1.0, 0.12, 0.24) * half(ring * 0.62);
                col += half3(0.75, 0.03, 0.10) * half(exp(-pow((distTap - waveR + 0.024) * 22.0, 2.0)) * uBurst * 0.36);
                col += half3(1.0, 0.08, 0.16) * half(coreGlow * 0.72);

                float barFlash = pressSlice * step(0.76, hash11(floor(uv.y * 100.0) + uSeed * 0.29));
                col += mix(half3(1.0, 0.42, 0.48), half3(1.0, 0.12, 0.26), half(step(0.45, sliceRand))) * half(barFlash * 0.55);

                float scan = 1.0 - 0.075 * (0.5 + 0.5 * sin(p.y * 1.55));
                col *= half(scan);

                col = mix(col, half3(min(col.g, col.b), max(col.g, col.r * 0.82), col.r), half(uFut));
                return half4(clamp(col, 0.0, 1.0), 1.0);
              }
            """
          }
        } else if ecoOn {
          Box {
            fill: true
            background: (futOn ? #000507 : #070002)
          }
        } else {
          Box {
            fill: true
            background: linear(0, 0, 1, 1, [(futOn ? #000608 : #080002), (futOn ? #033f4d : #4d0311), (futOn ? #086278 : #780818), (futOn ? #011d24 : #240107), (futOn ? #000405 : #050001)])
            Canvas {
              fill: true
              circle(width * 0.70, height * 0.28, width * 0.65, fill: radial(width * 0.70, height * 0.28, width * 0.65, [alpha((futOn ? #10bce6 : #e61032), 0.52), alpha(#000000, 0)]))
              circle(width * 0.26, height * 0.58, width * 0.62, fill: radial(width * 0.26, height * 0.58, width * 0.62, [alpha((futOn ? #1ad1ff : #ff1a2e), 0.42), alpha(#000000, 0)]))
              line(width * 0.08, height * 0.32, width * 0.62, height * 0.32, stroke: alpha((futOn ? #22d1ff : #ff2244), 0.55), width: 1)
              line(width * 0.10, height * 0.325, width * 0.64, height * 0.325, stroke: alpha((futOn ? #70d1ff : #ff7080), 0.32), width: 1)
              line(width * 0.34, height * 0.58, width * 0.92, height * 0.58, stroke: alpha((futOn ? #1ed1ff : #ff1e34), 0.48), width: 1)
              line(width * 0.32, height * 0.585, width * 0.90, height * 0.585, stroke: alpha((futOn ? #0d96b8 : #b80d24), 0.28), width: 1)
            }
          }
        }

        // Layer 2: Crisp vector glitch shockwaves, tear slices & sparks on every press
        if cgLive && len(cgPulses) > 0 {
          Canvas {
            fill: true
            for p in cgPulses {
              let t = clamp(p.age / 1.0, 0, 1)
              let fade = (1 - t) * (1 - t)
              let r = 12 + t * 155
              let shift = (1 - t) * 10

              circle(p.x - shift, p.y, r, stroke: alpha((futOn ? #0c96b8 : #b80c22), fade * 0.62), width: 2.0 * (1 - t * 0.5))
              circle(p.x + shift, p.y, r * 0.97, stroke: alpha((futOn ? #1ad1ff : #ff1a3a), fade * 0.92), width: 2.5 * (1 - t * 0.5))
              circle(p.x, p.y, r * 0.72, stroke: alpha((futOn ? #80d1ff : #ff808e), fade * 0.62), width: 1.1)

              if t < 0.45 {
                let cf = 1 - t / 0.45
                circle(p.x, p.y, 40 * cf + 8, fill: radial(p.x, p.y, 48, [alpha((futOn ? #12bce6 : #e61228), cf * 0.48), alpha(#000000, 0)]))
              }

              for i in range(6) {
                let gy = p.y + (hash(p.seed, i * 3 + 1) - 0.5) * (50 + t * 125)
                let gw = 22 + hash(p.seed, i * 3 + 2) * 95
                let dir = i % 2 == 0 ? 1 : -1
                let gx = p.x + dir * (10 + t * (75 + hash(p.seed, i * 3 + 3) * 95)) - gw / 2
                let gh = i % 3 == 0 ? 2.5 : 1.5
                rect(gx, gy, gw, gh, fill: i % 3 == 0 ? alpha((futOn ? #10a7cc : #cc1028), fade * 0.68) : alpha((futOn ? #1fd1ff : #ff1f40), fade * 0.92))
                rect(gx + dir * 5, gy + 2, gw * 0.72, 1, fill: alpha((futOn ? #70d1ff : #ff7080), fade * 0.60))
              }

              for i in range(8) {
                let ang = hash(p.seed, i * 5 + 11) * 6.28318
                let spd = 48 + hash(p.seed, i * 5 + 12) * 115
                let sx = p.x + cos(ang) * (8 + t * spd)
                let sy = p.y + sin(ang) * (8 + t * spd)
                let sw = 6 + hash(p.seed, i * 5 + 13) * 12
                rect(sx - sw / 2, sy - 1, sw, 2.2, fill: i % 3 == 0 ? alpha((futOn ? #1fd1ff : #ff1f40), fade * 0.95) : i % 3 == 1 ? alpha((futOn ? #24d1ff : #ff2438), fade * 0.9) : alpha((futOn ? #85d1ff : #ff8594), fade * 0.85))
              }
            }
          }
        }

        // Layer 3: Full-card touch catcher (fires glitch shockwave at exact press point)
        Box {
          fill: true
          onPress: {
            if infGlitchOn {
              let nx = clamp(x / cgW, 0, 1)
              let ny = clamp(y / cgH, 0, 1)
              let s = random(1, 99999)
              cgTapX = nx
              cgTapY = ny
              cgBurst = 1.0
              cgGlitchSeed = s
              cgPulses = ([{ x: x, y: y, age: 0, seed: s }] + cgPulses).take(4)
              if animHaptics { haptic() }
            }
          }
        }

        // Layer 4: 5 Evenly Spaced Occult App Slots + Controls
        Column {
          fill: true
          padding: [cgPadX, cgPadY]
          gap: 0

          Spacer { weight: 1 }

          Row {
            fill: width
            gap: cgSlotGap
            align: center
            justify: center
            for idx in range(5) {
              let sa = cgSlotApps[idx]
              let filled = sa != null
              let nx = 0.12 + idx * 0.19
              Box {
                width: cgSlotW
                height: cgSlotH
                radius: 9 * corners
                background: cgEditMode ? alpha((futOn ? #031d24 : #24030a), 0.80) : (filled ? alpha((futOn ? #000405 : #050001), 0.72) : alpha((futOn ? #000608 : #080002), 0.48))
                border: cgEditMode ? 1.5 : 1
                borderColor: cgEditMode ? (futOn ? #33d1ff : #ff3355) : (filled ? alpha((futOn ? #22d1ff : #ff2244), 0.56) : alpha((futOn ? #22d1ff : #ff2244), 0.30))
                align: center
                onTap: {
                  if animHaptics { haptic() }
                  if infGlitchOn {
                    let s = random(1, 99999)
                    cgTapX = nx
                    cgTapY = 0.40
                    cgBurst = 1.0
                    cgGlitchSeed = s
                    cgPulses = ([{ x: nx * cgW, y: 0.40 * cgH, age: 0, seed: s }] + cgPulses).take(4)
                  }
                  if cgEditMode || !filled {
                    cgActiveSlot = idx
                    cgQuery = ""
                    scrMode = "glitch"
                    screen()
                  } else {
                    open(sa.key)
                  }
                }

                Box {
                  size: cgIconSz
                  align: topEnd
                  if filled {
                    OccultIcon { app: sa; sz: cgIconSz }
                    if sa.dot && !cgEditMode {
                      Box {
                        size: 8
                        radius: 4
                        offset: [2, -2]
                        background: (futOn ? #1ed1ff : #ff1e3c)
                        border: 1.5
                        borderColor: (futOn ? #000406 : #060002)
                      }
                    }
                  } else {
                    Image { src: (futOn ? icoEmptyF : icoEmpty); size: cgIconSz; label: "Empty slot" }
                  }
                }

                if cgEditMode {
                  Box {
                    fill: true
                    align: topEnd
                    padding: 3
                    Box {
                      size: 15
                      radius: 8
                      background: (futOn ? #1ed1ff : #ff1e3c)
                      align: center
                      Text {
                        font: uiFont
                        text: filled ? "✎" : "+"
                        fontSize: 8.5
                        color: (futOn ? #7ad1ff : #ff7a88)
                        bold: true
                        align: center
                      }
                    }
                  }
                }
              }
            }
          }

          Spacer { weight: 1 }

          Row {
            fill: width
            align: center
            gap: 6

            if cgEditMode {
              Text {
                font: uiFont
                text: "TAP SLOT TO SET"
                fontSize: 8.5
                color: (futOn ? #7ad1ff : #ff7a90)
                bold: true
                letterSpacing: 1.3
              }
            } else if infGlitchOn {
              Text {
                font: uiFont
                text: "TAP FOR GLITCH"
                fontSize: 8.5
                color: alpha((futOn ? #6bd1ff : #ff6b7c), 0.45)
                letterSpacing: 1.4
              }
            }

            Spacer { weight: 1 }

            Row {
              gap: 4
              align: center
              padding: [6, 2]
              radius: 99
              background: cgEditMode ? alpha((futOn ? #063f4d : #4d0614), 0.90) : alpha((futOn ? #010b0e : #0e0104), 0.72)
              border: 1
              borderColor: cgEditMode ? (futOn ? #33d1ff : #ff3355) : alpha((futOn ? #22d1ff : #ff2244), 0.50)
              onTap: {
                if animHaptics { haptic() }
                cgEditMode = !cgEditMode
              }
              Text {
                font: uiFont
                text: cgEditMode ? "✓" : "✎"
                fontSize: 8.5
                color: cgEditMode ? (futOn ? #7ad1ff : #ff7a88) : (futOn ? #47d1ff : #ff4766)
              }
              Text {
                font: uiFont
                text: cgEditMode ? "DONE" : "EDIT"
                fontSize: 8.5
                color: cgEditMode ? (futOn ? #7ad1ff : #ff7a88) : alpha((futOn ? #85d1ff : #ff8594), 0.84)
                bold: cgEditMode
                letterSpacing: 1.0
              }
            }
          }
        }
      }

      Spacer { height: 10 }

      Spacer { height: 8 }

      // Main Dock (synced with all home pages: Chrome, Messages, Pentagram/Spendwell, Gmail, Mini Apps)
      Box {
        fill: width
        height: 70
        radius: 10
        background: ecoOn ? (futOn ? #000507 : #070002) : linear(0, 0, 1, 0, [(futOn ? #010e12 : #120105), (futOn ? #000405 : #050002), (futOn ? #031f26 : #26030c), (futOn ? #000405 : #050002), (futOn ? #010e12 : #120105)])
        border: 1
        borderColor: ecoOn ? (futOn ? #09303b : #3b0912) : mix((futOn ? #12718a : #8a1224), (futOn ? #2ed1ff : #ff2e44), breathe * 0.35 + surge * 0.65)
        align: center

        if !ecoOn {
          Canvas {
            fill: true
            let w = width
            let h = height
            line(14, 2, w - 14, 2, stroke: linear(14, 0, w - 14, 0, [alpha((futOn ? #26d1ff : #ff263f), 0.25), alpha((futOn ? #26d1ff : #ff263f), 0.78), alpha((futOn ? #26d1ff : #ff263f), 0.25)]), width: 1.1)
            line(14, h - 2, w - 14, h - 2, stroke: linear(14, 0, w - 14, 0, [alpha((futOn ? #26d1ff : #ff263f), 0.18), alpha((futOn ? #26d1ff : #ff263f), 0.58), alpha((futOn ? #26d1ff : #ff263f), 0.18)]), width: 1.0)
            // Sweeping crimson lightsaber energy pulse along dock rails
            if fxLive {
              let sweep = ((fxT * 0.42) % 1.0) * (w - 60) + 30
              line(sweep - 26, 2, sweep + 26, 2, stroke: linear(sweep - 26, 0, sweep + 26, 0, [alpha((futOn ? #1ed1ff : #ff1e38), 0), (futOn ? #5cd1ff : #ff5c70), alpha((futOn ? #1ed1ff : #ff1e38), 0)]), width: 2.2, cap: round)
              let sweep2 = (1.0 - ((fxT * 0.42) % 1.0)) * (w - 60) + 30
              line(sweep2 - 22, h - 2, sweep2 + 22, h - 2, stroke: linear(sweep2 - 22, 0, sweep2 + 22, 0, [alpha((futOn ? #1ed1ff : #ff1e38), 0), (futOn ? #38d1ff : #ff384e), alpha((futOn ? #1ed1ff : #ff1e38), 0)]), width: 1.8, cap: round)
            }
            for i in [1, 2, 3, 4] {
              let sx = w * i / 5
              line(sx, h * 0.24, sx, h * 0.76, stroke: linear(sx, h * 0.24, sx, h * 0.76, [alpha((futOn ? #22d1ff : #ff2236), 0), alpha((futOn ? #12718a : #8a1224), 0.50), alpha((futOn ? #22d1ff : #ff2236), 0)]), width: 0.8)
            }
          }
        }

        Row {
          fill: true
          gap: 0
          align: center
          DockApp { pkg: "com.android.chrome"; label: "Chrome"; slotIdx: 0 }
          DockApp { pkg: "com.google.android.apps.messaging"; label: "Messages"; slotIdx: 1 }
          DockCrown { pkg: "com.incomm.spendwell" }
          DockApp { pkg: "com.google.android.gm"; label: "Gmail"; slotIdx: 3 }
          DockApp { pkg: "ai.miniapps.android"; label: "Mini Apps"; slotIdx: 4 }
        }
      }

      Spacer { height: 8 }

      // Purge Chamber launcher — opens the task + process manager
      Row {
        fill: width
        height: 40
        radius: 10
        align: center
        justify: center
        gap: 8
        background: ecoOn ? (futOn ? #000507 : #070002) : linear(0, 0, 1, 0, [(futOn ? #00080a : #0a0003), (futOn ? #02161c : #1c0208), (futOn ? #00080a : #0a0003)])
        border: 1
        borderColor: ecoOn ? (futOn ? #09303b : #3b0912) : alpha((futOn ? #22d1ff : #ff2244), 0.42)
        onTap: { if animHaptics { haptic() }; scrMode = "tasks"; screen() }
        Text { font: uiFont; text: ecoOn ? "◈" : (futOn ? "⬡" : "⛧"); fontSize: 15; color: ecoOn ? (futOn ? #2696b8 : #b8263a) : (futOn ? #2ad1ff : #ff2a44) }
        Text { font: uiFont; text: "PURGE CHAMBER  ·  TASKS & PROCESSES"; fontSize: 10.5; bold: true; color: ecoOn ? (futOn ? #4cb1d9 : #d94c5e) : (futOn ? #b3d1ff : #ffb3c0); letterSpacing: 1.6 }
      }

      Spacer { height: 6 }
      Spacer { height: screenInset }
    }

    // ==================== LAYER 2: SITH FX OVERLAY CANVAS ====================
    // Pass-through visual FX layer (no touch handlers): ambient crimson embers,
    // high-speed energy tracers, vector blood splatter drips, saber slashes & Force lightning!
    if infFxOn {
      Canvas {
        fill: true
        let w = width
        let h = height
        let sigCx = w * 0.5
        let sigCy = h * 0.37

        // 1. Ambient rising Sith embers & occasional diagonal crimson void tracers
        let emberCount = animSpeed >= 1.5 ? 14 : 9
        for e in range(emberCount) {
          let spd = 22 + hash(e, 3) * 38
          let ey = h - ((fxT * spd + hash(e, 11) * h) % (h + 40)) + 20
          let ex = hash(e, 5) * w + sin(fxT * (1.2 + hash(e, 7)) + e * 2.1) * 18
          let er = 1.0 + hash(e, 13) * 1.8
          let ea = 0.22 + 0.42 * sin(fxT * 2.5 + e * 1.7) * sin(fxT * 2.5 + e * 1.7)
          circle(ex, ey, er * 2.6, fill: alpha((futOn ? #1ad1ff : #ff1a34), ea * 0.28))
          circle(ex, ey, er, fill: alpha((futOn ? #5ad1ff : #ff5a6e), ea))
        }

        // Ambient slicing crimson tracers drifting across the dark void
        let ambTracers = animSpeed >= 1.5 ? 3 : 2
        for at in range(ambTracers) {
          let cycle = 4.6 + at * 1.9
          let phase = (fxT + at * 2.3) % cycle
          if phase < 0.75 {
            let prog = phase / 0.75
            let seed = floor((fxT + at * 2.3) / cycle) * 13 + at * 7
            let y0 = h * (0.12 + hash(seed, 2) * 0.72)
            let dir = at % 2 == 0 ? 1 : -1
            let xHead = dir > 0 ? (-40 + prog * (w + 140)) : (w + 40 - prog * (w + 140))
            let slope = (hash(seed, 5) - 0.5) * 110
            let yHead = y0 + prog * slope
            let tailLen = 85 + 45 * (1.0 - prog)
            let xTail = xHead - dir * tailLen
            let yTail = yHead - (slope / (w + 140)) * tailLen
            let aFade = sin(prog * 3.14159) * 0.62
            line(xTail, yTail, xHead, yHead, stroke: alpha((futOn ? #14d1ff : #ff1430), aFade * 0.45), width: 4.5, cap: round)
            line(xTail * 0.35 + xHead * 0.65, yTail * 0.35 + yHead * 0.65, xHead, yHead, stroke: alpha((futOn ? #5cd1ff : #ff5c70), aFade), width: 1.3, cap: round)
          }
        }

        // 2. Per-Press Interactive Sith Effects (Tracers + Red Splatter + Force Lightning + Saber Slash)
        for imp in impacts {
          let age = fxT - imp.t
          if imp.t > -50 && age >= 0 && age < 3.6 {
            let ix = imp.x
            let iy = imp.y
            let seed = imp.seed
            let pwr = imp.pwr

            // A) Expanding dual shockwave rings + impact core diamond flash (0.0 -> 0.65s)
            if age < 0.65 {
              let p0 = age / 0.65
              let easeOut = 1.0 - (1.0 - p0) * (1.0 - p0)
              let ringR = (14 + easeOut * 118) * pwr
              let ringA = (1.0 - p0) * 0.88
              circle(ix, iy, ringR, stroke: alpha((futOn ? #1ed1ff : #ff1e38), ringA * 0.55), width: (4.5 * (1.0 - p0) + 0.8))
              circle(ix, iy, ringR * 0.72, stroke: alpha((futOn ? #66d1ff : #ff6678), ringA * 0.85), width: (1.6 * (1.0 - p0) + 0.4))
              if age < 0.22 {
                let fA = 1.0 - age / 0.22
                let dR = (10 + age * 80) * pwr
                path([[ix, iy - dR], [ix + dR * 0.6, iy], [ix, iy + dR], [ix - dR * 0.6, iy]], closed: true, stroke: alpha((futOn ? #7ad1ff : #ff7a88), fA), width: 1.5)
              }
            }

            // B) Razor Crimson Lightsaber Slash across the impact point (0.0 -> 0.36s)
            if age < 0.36 {
              let sp = age / 0.36
              let slashAng = (hash(floor(seed * 10), 4) - 0.5) * 2.2 - 0.65
              let halfL = (52 + sp * 78) * pwr
              let sx1 = ix - cos(slashAng) * halfL
              let sy1 = iy - sin(slashAng) * halfL
              let sx2 = ix + cos(slashAng) * halfL
              let sy2 = iy + sin(slashAng) * halfL
              let sA = (1.0 - sp) * 0.92
              line(sx1, sy1, sx2, sy2, stroke: alpha((futOn ? #14d1ff : #ff1430), sA * 0.55), width: 8.5 * (1.0 - sp * 0.6), cap: round)
              line(sx1, sy1, sx2, sy2, stroke: alpha((futOn ? #38d1ff : #ff3850), sA * 0.9), width: 3.2 * (1.0 - sp * 0.5), cap: round)
              line(sx1, sy1, sx2, sy2, stroke: alpha((futOn ? #7ad1ff : #ff7a88), sA), width: 1.2, cap: round)
            }

            // C) High-Speed Curved Crimson Energy Tracers bursting outward (0.0 -> 1.15s)
            if age < 1.15 {
              let tp = age / 1.15
              let tracerN = animSpeed >= 1.5 ? 7 : 5
              for k in range(tracerN) {
                let baseAng = k * (6.28318 / tracerN) + hash(floor(seed * 17) + k, 9) * 1.4
                let curve = (hash(floor(seed * 13) + k, 15) - 0.5) * 1.8
                let speed = (185 + hash(floor(seed * 19) + k, 21) * 180) * pwr
                let headD = speed * (1.0 - pow(1.0 - tp, 2.2)) * 0.72
                let midD = max(0, headD - 34 * (1.0 - tp * 0.5))
                let tailD = max(0, headD - 76 * (1.0 - tp * 0.55))
                let aHead = baseAng + curve * tp
                let aMid = baseAng + curve * max(0, tp - 0.14)
                let aTail = baseAng + curve * max(0, tp - 0.28)
                let hx = ix + cos(aHead) * headD
                let hy = iy + sin(aHead) * headD
                let mx = ix + cos(aMid) * midD
                let my = iy + sin(aMid) * midD
                let tx = ix + cos(aTail) * tailD
                let ty = iy + sin(aTail) * tailD
                let tA = (1.0 - tp) * 0.95
                path([[tx, ty], [mx, my], [hx, hy]], stroke: alpha((futOn ? #14d1ff : #ff1430), tA * 0.42), width: 5.5 * (1.0 - tp * 0.5), cap: round)
                path([[tx, ty], [mx, my], [hx, hy]], stroke: alpha((futOn ? #2ed1ff : #ff2e48), tA * 0.88), width: 2.1 * (1.0 - tp * 0.4), cap: round)
                line(mx, my, hx, hy, stroke: alpha((futOn ? #70d1ff : #ff7080), tA), width: 1.0, cap: round)
                circle(hx, hy, 2.2 * (1.0 - tp * 0.5), fill: alpha((futOn ? #7ad1ff : #ff7a88), tA))
              }
            }

            // D) Vector Red Blood Splatter Droplets, Directional Splash Streaks & Gravity Drips (0.0 -> 3.6s)
            let dropN = animSpeed >= 1.5 ? 16 : 12
            let splatFade = clamp(1.0 - max(0, age - 0.8) / 2.8, 0, 1)
            let burstEase = 1.0 - pow(2.71828, -age * 13.0)
            let hotFlash = pow(2.71828, -age * 6.5)
            let bloodFill = mix((futOn ? #04819e : #9e0418), (futOn ? #24d1ff : #ff243d), hotFlash)
            let bloodDark = mix((futOn ? #013c4a : #4a010b), (futOn ? #0ca7cc : #cc0c24), hotFlash)

            for d in range(dropN) {
              let h1 = hash(floor(seed * 31) + d * 3, 5)
              let h2 = hash(floor(seed * 31) + d * 3, 11)
              let h3 = hash(floor(seed * 31) + d * 3, 19)
              let ang = h1 * 6.28318
              let maxDist = (16 + h2 * 78) * pwr
              let distNow = maxDist * burstEase
              // Gravity drip pulls larger droplets slowly down the glass
              let dripY = max(0, age - 0.14) * (4.0 + h3 * 13.0)
              let dx = ix + cos(ang) * distNow
              let dy = iy + sin(ang) * distNow + dripY
              let rad = (1.6 + h3 * 4.4) * pwr * (0.65 + 0.35 * splatFade)

              // Directional splash streak behind the droplet
              let sx0 = ix + cos(ang) * max(0, distNow - rad * 3.4)
              let sy0 = iy + sin(ang) * max(0, distNow - rad * 3.4) + dripY * 0.45
              line(sx0, sy0, dx, dy, stroke: alpha(bloodDark, splatFade * 0.68), width: rad * 0.85, cap: round)

              // Drip trail tail above heavy blood beads
              if dripY > 2.5 && d % 2 == 0 {
                line(dx, dy - min(dripY, 22), dx, dy, stroke: alpha(bloodDark, splatFade * 0.52), width: rad * 0.55, cap: round)
              }

              // Main blood bead + wet crimson highlight
              circle(dx, dy, rad, fill: alpha(bloodFill, splatFade * 0.92))
              if rad > 2.6 {
                circle(dx - rad * 0.25, dy - rad * 0.25, rad * 0.32, fill: alpha((futOn ? #8ad1ff : #ff8a98), splatFade * 0.55))
              }
            }

            // E) Sith Force-Lightning Fork arcing from press point toward the Demon Sigil (0.0 -> 0.44s)
            if age < 0.44 {
              let lp = age / 0.44
              let lA = (1.0 - lp) * 0.92
              let jitterKey = floor(fxT * 24) + floor(seed * 10)
              let bx1 = ix + (sigCx - ix) * 0.25 + (hash(jitterKey, 2) - 0.5) * 42
              let by1 = iy + (sigCy - iy) * 0.25 + (hash(jitterKey, 3) - 0.5) * 42
              let bx2 = ix + (sigCx - ix) * 0.55 + (hash(jitterKey, 5) - 0.5) * 48
              let by2 = iy + (sigCy - iy) * 0.55 + (hash(jitterKey, 7) - 0.5) * 48
              let bx3 = ix + (sigCx - ix) * 0.82 + (hash(jitterKey, 11) - 0.5) * 32
              let by3 = iy + (sigCy - iy) * 0.82 + (hash(jitterKey, 13) - 0.5) * 32
              let boltPts = [[ix, iy], [bx1, by1], [bx2, by2], [bx3, by3], [sigCx, sigCy]]
              path(boltPts, stroke: alpha((futOn ? #14d1ff : #ff1430), lA * 0.45), width: 6.0, cap: round)
              path(boltPts, stroke: alpha((futOn ? #38d1ff : #ff3850), lA * 0.9), width: 2.2, cap: round)
              path(boltPts, stroke: alpha((futOn ? #7ad1ff : #ff7a88), lA), width: 0.9, cap: round)

              // Secondary short branch off midpoint
              let fxB = bx2 + (hash(jitterKey, 17) - 0.5) * 75
              let fyB = by2 + (hash(jitterKey, 19) - 0.5) * 75
              line(bx2, by2, fxB, fyB, stroke: alpha((futOn ? #2ed1ff : #ff2e48), lA * 0.72), width: 1.4, cap: round)
            }
          }
        }
      }
    }
  }

  // Secret Menu: Palpatine's Secrets (unlocked via 1-3-5-1-3-5 on the top 5-panel drum strip)
  screen {
    title: scrMode == "tasks" ? "PURGE CHAMBER" : scrMode == "glitch" ? "crimson glitch · slots" : "PALPATINE'S SECRETS"

    if scrMode == "tasks" {
      let memTot = max(sysInfo.memory.total ?? 1, 1)
      let memUsed = sysInfo.memory.used ?? 0
      let memPct = clamp(memUsed / memTot, 0, 1)
      let procList = procs ?? []
      Column {
        fill: true
        scroll: true
        background: linear(0, 0, 0, 1, [(futOn ? #010c0f : #0f0106), #000000, (futOn ? #010709 : #090104)])
        padding: [16, 16, 16, 16]
        gap: 10

        // Header
        Row {
          fill: width
          align: center
          gap: 8
          Column {
            weight: 1
            gap: 2
            Text { font: uiFont; text: "◈ PURGE CHAMBER"; fontSize: 15; bold: true; color: (futOn ? #2ad1ff : #ff2a44); letterSpacing: 2 }
            Text { font: uiFont; text: "Cut the weak. Feed the strong."; fontSize: 10; color: alpha((futOn ? #8fd1ff : #ff8fa3), 0.6) }
          }
          Row {
            padding: [12, 7]
            radius: 99
            border: 1
            borderColor: alpha((futOn ? #22d1ff : #ff2244), 0.5)
            onTap: { close() }
            Text { font: uiFont; text: "CLOSE"; fontSize: 10; bold: true; color: (futOn ? #b3d1ff : #ffb3c0); letterSpacing: 1 }
          }
        }

        // Memory gauge
        Column {
          fill: width
          gap: 6
          padding: 12
          radius: 14
          background: alpha((futOn ? #010709 : #090103), 0.82)
          border: 1
          borderColor: alpha((futOn ? #22d1ff : #ff2244), 0.42)
          Row {
            fill: width
            Text { font: uiFont; text: "◈ RAM"; fontSize: 10; color: (futOn ? #6fd1ff : #ff6f85); letterSpacing: 2; weight: 1 }
            Text { font: uiFont; text: "${round(memUsed / 1048576)} / ${round(memTot / 1048576)} MB  ·  ${round(memPct * 100)}%"; fontSize: 10.5; bold: true; color: memPct > 0.85 ? (futOn ? #2ad1ff : #ff2a44) : (futOn ? #80d1ff : #ff808e) }
          }
          Box {
            fill: width
            height: 6
            radius: 99
            background: (futOn ? #04151a : #1a0408)
            Box { width: max(memPct, 0.02) * 300; height: 6; radius: 99; background: linear(0, 0, 1, 0, [(futOn ? #12718a : #8a1224), (futOn ? #2ad1ff : #ff2a44)]) }
          }
          // System battery settings shortcut (animation FX managed centrally in Deck Forge)
          Row {
            fill: width
            gap: 8
            Row {
              weight: 1
              height: 32
              radius: 10
              align: center
              justify: center
              background: (futOn ? #00080a : #0a0003)
              border: 1
              borderColor: alpha((futOn ? #22d1ff : #ff2244), 0.5)
              onTap: { if animHaptics { haptic() }; settings("battery") }
              Text { font: uiFont; text: "BATTERY SETTINGS"; fontSize: 10; bold: true; color: (futOn ? #b3d1ff : #ffb3c0); align: center }
            }
          }
        }

        // ---------- ANDROID TASKS ----------
        Text { font: uiFont; text: "◈ ANDROID TASKS"; fontSize: 10; color: (futOn ? #6fd1ff : #ff6f85); letterSpacing: 2 }
        Text { font: uiFont; text: "SEVER opens the app's info page — hit FORCE STOP there (Android forbids launchers from killing apps directly)."; fontSize: 9.5; color: alpha((futOn ? #8fd1ff : #ff8fa3), 0.6); fill: width }
        for a in sub(recentApps ?? [], 0, 15) key a.key {
          Row {
            fill: width
            gap: 10
            align: center
            padding: [10, 8]
            radius: 12
            background: alpha((futOn ? #010709 : #090103), 0.82)
            border: 1
            borderColor: alpha((futOn ? #22d1ff : #ff2244), 0.25)
            Box { size: 32; onTap: { open(a.key) }; TraySigil { src: a.icon; sz: 32; lbl: a.name } }
            Text { font: uiFont; text: a.name; fontSize: 12.5; color: (futOn ? #80d1ff : #ff808e); weight: 1; maxLines: 1 }
            Row {
              padding: [12, 7]
              radius: 99
              background: alpha((futOn ? #1ed1ff : #ff1e3c), 0.18)
              border: 1
              borderColor: (futOn ? #2ad1ff : #ff2a44)
              onTap: { if animHaptics { haptic() }; appAction("info", a.key) }
              Text { font: uiFont; text: "SEVER"; fontSize: 9.5; bold: true; color: (futOn ? #2ad1ff : #ff2a44); letterSpacing: 1 }
            }
          }
        }

        // ---------- LINUX PROCESSES ----------
        Row {
          fill: width
          align: center
          Text { font: uiFont; text: "◈ LINUX PROCESSES"; fontSize: 10; color: (futOn ? #6fd1ff : #ff6f85); letterSpacing: 2; weight: 1 }
          Text { font: uiFont; text: killLog; fontSize: 9.5; color: alpha((futOn ? #8fd1ff : #ff8fa3), 0.6) }
        }
        for pr in procList key pr.pid {
          let core = pr.name == "libproot.so" || pr.name == "ps" || pr.name == "awk"
          Row {
            fill: width
            gap: 8
            align: center
            padding: [10, 8]
            radius: 12
            background: alpha((futOn ? #010709 : #090103), 0.82)
            border: 1
            borderColor: alpha((futOn ? #22d1ff : #ff2244), 0.25)
            Column {
              weight: 1
              gap: 1
              Text { font: uiFont; text: pr.name; fontSize: 12.5; color: (futOn ? #80d1ff : #ff808e); maxLines: 1 }
              Text { font: uiFont; text: "PID ${pr.pid}  ·  ${round(pr.rss / 1024)} MB  ·  CPU ${pr.cpu}%"; fontSize: 9.5; color: alpha((futOn ? #8fd1ff : #ff8fa3), 0.6) }
            }
            if core {
              Text { font: uiFont; text: "CORE"; fontSize: 9; color: (futOn ? #355a6e : #6e3540); letterSpacing: 1 }
            } else {
              Row {
                padding: [12, 7]
                radius: 99
                background: alpha((futOn ? #1ed1ff : #ff1e3c), 0.18)
                border: 1
                borderColor: (futOn ? #2ad1ff : #ff2a44)
                onTap: { if animHaptics { haptic() }; killLog = "KILLED ${pr.name}"; run("kill ${pr.pid}") }
                Text { font: uiFont; text: "KILL"; fontSize: 9.5; bold: true; color: (futOn ? #2ad1ff : #ff2a44); letterSpacing: 1 }
              }
            }
          }
        }
        Spacer { height: 12 }
      }
    } else if scrMode == "glitch" {
      Column {
        fill: true
        background: (futOn ? #000406 : #060002)
        padding: 14
        gap: 12

        Row {
          fill: width
          align: center
          gap: 8
          Column {
            weight: 1
            gap: 2
            Text {
              font: uiFont
              text: "SLOT 0${cgActiveSlot + 1}"
              fontSize: 13
              color: (futOn ? #2ed1ff : #ff2e4d)
              bold: true
              letterSpacing: 1.8
            }
            Text {
              font: uiFont
              text: cgActiveApp != null ? cgActiveApp.name : "Empty — pick an app below"
              style: small
              color: alpha((futOn ? #70d1ff : #ff7080), 0.72)
              maxLines: 1
            }
          }

          if cgActiveApp != null {
            Text {
              font: uiFont
              text: "CLEAR"
              style: small
              color: (futOn ? #5cd1ff : #ff5c77)
              bold: true
              letterSpacing: 1.2
              padding: [10, 6]
              radius: 99
              background: alpha((futOn ? #04222a : #2a040c), 0.9)
              border: 1
              borderColor: alpha((futOn ? #2ed1ff : #ff2e4d), 0.65)
              onTap: {
                if animHaptics { haptic() }
                cgAppSlots = set(cgAppSlots, cgActiveSlot, "")
              }
            }
          }

          Text {
            font: uiFont
            text: "DONE"
            style: small
            color: (futOn ? #7ad1ff : #ff7a88)
            bold: true
            letterSpacing: 1.2
            padding: [12, 6]
            radius: 99
            background: (futOn ? #0c718a : #8a0c22)
            border: 1
            borderColor: (futOn ? #33d1ff : #ff3355)
            onTap: {
              if animHaptics { haptic() }
              cgEditMode = false
              close()
            }
          }
        }

        Row {
          fill: width
          gap: 8
          for i in range(5) {
            let sa = cgSlotApps[i]
            let isCur = i == cgActiveSlot
            Column {
              weight: 1
              align: center
              gap: 4
              padding: [4, 8]
              radius: 12 * corners
              background: isCur ? alpha((futOn ? #062d38 : #380611), 0.95) : alpha((futOn ? #010e12 : #120105), 0.88)
              border: isCur ? 1.5 : 1
              borderColor: isCur ? (futOn ? #33d1ff : #ff3355) : alpha((futOn ? #22d1ff : #ff2244), 0.25)
              onTap: {
                if animHaptics { haptic() }
                cgActiveSlot = i
              }
              if sa != null {
                OccultIcon { app: sa; sz: 34 }
              } else {
                Image { src: (futOn ? icoEmptyF : icoEmpty); size: 34 }
              }
              Text {
                font: uiFont
                text: "0${i + 1}"
                fontSize: 10
                color: isCur ? (futOn ? #7ad1ff : #ff7a88) : alpha((futOn ? #6bd1ff : #ff6b7c), 0.55)
                bold: isCur
                align: center
                fill: width
                letterSpacing: 1.0
              }
            }
          }
        }

        Row {
          fill: width
          align: center
          gap: 8
          Row {
            weight: 1
            align: center
            gap: 8
            padding: [10, 6]
            radius: 10 * corners
            background: (futOn ? #010e12 : #120105)
            border: 1
            borderColor: alpha((futOn ? #2ed1ff : #ff2e4d), 0.45)
            Text { font: uiFont; text: "⌕"; color: (futOn ? #44d1ff : #ff4460); fontSize: 16 }
            Input {
              weight: 1
              text: cgQuery
              placeholder: "Search apps…"
              underline: false
              color: (futOn ? #85d1ff : #ff8594)
              onChange: cgQuery = value
            }
            if cgQuery != "" {
              Text {
                font: uiFont
                text: "✕"
                color: alpha((futOn ? #6bd1ff : #ff6b7c), 0.7)
                padding: [4, 2]
                onTap: cgQuery = ""
              }
            }
          }

          Text {
            font: uiFont
            text: cgSortByUse ? "TOP" : "A–Z"
            style: small
            color: (futOn ? #66d1ff : #ff6680)
            bold: true
            letterSpacing: 1.0
            padding: [10, 9]
            radius: 10 * corners
            background: (futOn ? #010e12 : #120105)
            border: 1
            borderColor: alpha((futOn ? #2ed1ff : #ff2e4d), 0.45)
            onTap: {
              if animHaptics { haptic() }
              cgSortByUse = !cgSortByUse
            }
          }
        }

        Column {
          scroll: true
          weight: 1
          fill: width
          gap: 6

          for a in cgPickerShown key a.key {
            let assignedIdx = indexOf(cgAppSlots, a.key)
            let isThisSlot = assignedIdx == cgActiveSlot
            Row {
              fill: width
              align: center
              gap: 12
              padding: [10, 9]
              radius: 12 * corners
              background: isThisSlot ? alpha((futOn ? #062d38 : #380611), 0.92) : alpha((futOn ? #010e12 : #120105), 0.82)
              border: 1
              borderColor: isThisSlot ? (futOn ? #33d1ff : #ff3355) : alpha((futOn ? #22d1ff : #ff2244), 0.20)
              onTap: {
                if animHaptics { haptic() }
                cgAppSlots = set(cgAppSlots, cgActiveSlot, a.key)
                cgQuery = ""
                cgEditMode = false
                close()
              }

              OccultIcon { app: a; sz: 36 }

              Column {
                weight: 1
                gap: 1
                Text {
                  font: uiFont
                  text: a.name
                  color: (futOn ? #85d1ff : #ff8594)
                  fontSize: 14
                  bold: isThisSlot
                  maxLines: 1
                }
                if a.kind != "android" || a.profile != null {
                  Text {
                    font: uiFont
                    text: a.profile != null ? "${a.kind} · ${a.profile}" : a.kind
                    fontSize: 10.5
                    color: alpha((futOn ? #85d1ff : #ff8599), 0.65)
                    maxLines: 1
                  }
                }
              }

              if assignedIdx >= 0 {
                Text {
                  font: uiFont
                  text: "SLOT 0${assignedIdx + 1}"
                  fontSize: 10
                  color: isThisSlot ? (futOn ? #7ad1ff : #ff7a88) : (futOn ? #5cd1ff : #ff5c77)
                  bold: true
                  letterSpacing: 1.0
                  padding: [8, 4]
                  radius: 99
                  background: isThisSlot ? (futOn ? #1296b8 : #b8122e) : alpha((futOn ? #05242d : #2d050e), 0.95)
                  border: 1
                  borderColor: isThisSlot ? (futOn ? #44d1ff : #ff4466) : alpha((futOn ? #2ed1ff : #ff2e4d), 0.45)
                }
              }
            }
          }

          if len(cgPickerAll) == 0 {
            Text {
              font: uiFont
              text: "No matching apps"
              style: muted
              align: center
              fill: width
              padding: [0, 24]
            }
          } else if len(cgPickerAll) > 60 {
            Text {
              font: uiFont
              text: "Showing 60 of ${len(cgPickerAll)} apps — search to narrow"
              style: small
              color: alpha((futOn ? #6bd1ff : #ff6b7c), 0.5)
              align: center
              fill: width
              padding: [0, 10]
            }
          }
        }
      }
    } else {
    Column {
      fill: true
      background: linear(0, 0, 0, 1, [(futOn ? #010c0f : #0f0106), #000000, (futOn ? #010709 : #090104)])
      padding: [16, 16, 16, 16]
      gap: 12

      // Header bar
      Row {
        fill: width
        align: center
        gap: 8
        Column {
          weight: 1
          gap: 2
          Text { font: uiFont; text: "✦  PALPATINE'S SECRETS  ✦"; style: label; color: (futOn ? #2ed1ff : #ff2e44); letterSpacing: 2.0; bold: true }
          Text { font: uiFont; text: "${filledCount}/${len(vaultItems)} STORED  ·  ${revealAll ? "EXPOSED" : "MASKED"}"; style: small; color: (futOn ? #4d728c : #8c4d57); letterSpacing: 1.2 }
        }
        Box {
          width: 64
          height: 28
          radius: 99
          align: center
          background: revealAll ? alpha((futOn ? #26d1ff : #ff263f), 0.28) : (futOn ? #021014 : #140208)
          border: 1
          borderColor: revealAll ? (futOn ? #38d1ff : #ff384e) : alpha((futOn ? #26d1ff : #ff263f), 0.55)
          onTap: {
            if animHaptics { haptic() }
            revealAll = !revealAll
            if !revealAll { revealId = 0 }
          }
          Text { font: uiFont; text: revealAll ? "MASK" : "SHOW"; style: small; color: revealAll ? (futOn ? #7ad1ff : #ff7a88) : (futOn ? #66d1ff : #ff6678); letterSpacing: 1.2; bold: true; align: center }
        }
        Box {
          width: 58
          height: 28
          radius: 99
          align: center
          background: (futOn ? #021014 : #140208)
          border: 1
          borderColor: alpha((futOn ? #26d1ff : #ff263f), 0.65)
          onTap: {
            if animHaptics { haptic() }
            revealAll = false
            revealId = 0
            editMode = false
            vaultToast = ""
            close()
          }
          Text { font: uiFont; text: "LOCK"; style: small; color: (futOn ? #66d1ff : #ff6678); letterSpacing: 1.2; bold: true; align: center }
        }
      }

      Box { fill: width; height: 1; background: ecoOn ? linear(0, 0, 1, 0, [alpha((futOn ? #2696b8 : #b8263a), 0), alpha((futOn ? #2696b8 : #b8263a), 0.65), alpha((futOn ? #2696b8 : #b8263a), 0)]) : linear(0, 0, 1, 0, [alpha((futOn ? #1ed1ff : #ff1e38), 0), alpha((futOn ? #26d1ff : #ff263f), 0.72), alpha((futOn ? #1ed1ff : #ff1e38), 0)]) }

      // Super Fast Eco Mode Toggle (kills all animations, drops to 540p chill AMOLED battery-saver theme)
      Row {
        fill: width
        padding: [12, 10]
        radius: 10
        align: center
        gap: 10
        background: ecoOn ? (futOn ? #010a0d : #0d0104) : (futOn ? #021014 : #140208)
        border: 1
        borderColor: ecoOn ? (futOn ? #2696b8 : #b8263a) : alpha((futOn ? #26d1ff : #ff263f), 0.55)
        onTap: {
          if animHaptics { haptic() }
          run("python3 ~/.local/bin/omalauncher-eco.py toggle")
          vaultToast = ecoOn ? "RESTORING FULL INFERNAL MODE..." : "SUPER FAST ECO · CHILL BATTERY THEME ON"
        }
        Column {
          weight: 1
          gap: 2
          Text {
            font: uiFont
            text: ecoOn ? "☾  SUPER FAST ECO MODE  ·  ACTIVE" : "✦  SUPER FAST ECO MODE  ·  OFF"
            style: small
            color: ecoOn ? (futOn ? #36b7e0 : #e0364c) : (futOn ? #66d1ff : #ff6678)
            letterSpacing: 1.3
            bold: true
          }
          Text {
            font: uiFont
            text: ecoOn ? "All animations OFF · 540p Chill AMOLED Theme · Battery Saver" : "Kill all animations · 540p lower res · Chill battery theme"
            style: small
            color: ecoOn ? (futOn ? #3b89a8 : #a83b4a) : (futOn ? #5c819e : #9e5c66)
            letterSpacing: 0.4
          }
        }
        Box {
          width: 78
          height: 30
          radius: 99
          align: center
          background: ecoOn ? alpha((futOn ? #24a7cc : #cc243a), 0.25) : alpha((futOn ? #26d1ff : #ff263f), 0.22)
          border: 1
          borderColor: ecoOn ? (futOn ? #24a7cc : #cc243a) : (futOn ? #38d1ff : #ff384e)
          Text {
            font: uiFont
            text: ecoOn ? "ECO ON" : "ENABLE"
            style: small
            color: ecoOn ? (futOn ? #7ad1ff : #ff7a88) : (futOn ? #7ad1ff : #ff7a88)
            letterSpacing: 1.2
            bold: true
            align: center
          }
        }
      }

      // Category Tabs + Add button
      Row {
        fill: width
        align: center
        gap: 5
        for tab in vaultTabs key tab {
          let sel = vaultTab == tab
          Box {
            weight: 1
            height: 28
            radius: 6
            align: center
            background: sel ? alpha((futOn ? #26d1ff : #ff263f), 0.28) : (futOn ? #01090b : #0b0105)
            border: 1
            borderColor: sel ? (futOn ? #38d1ff : #ff384e) : alpha((futOn ? #12718a : #8a1224), 0.55)
            onTap: {
              if animHaptics { haptic() }
              vaultTab = tab
            }
            Text {
              font: uiFont
              text: tab == "IDENTITY" ? "ID" : tab
              style: small
              color: sel ? (futOn ? #7ad1ff : #ff7a88) : (futOn ? #7896b8 : #b87882)
              bold: sel
              letterSpacing: 1.0
              align: center
            }
          }
        }
        Box {
          width: 44
          height: 28
          radius: 6
          align: center
          background: editMode ? alpha((futOn ? #26d1ff : #ff263f), 0.35) : (futOn ? #02151a : #1a020a)
          border: 1
          borderColor: (futOn ? #38d1ff : #ff384e)
          onTap: {
            if animHaptics { haptic() }
            if editMode {
              editMode = false
            } else {
              editId = 0
              editCat = vaultTab == "ALL" ? "VAULT" : vaultTab
              editLabel = ""
              editValue = ""
              editNote = ""
              editMode = true
            }
          }
          Text { font: uiFont; text: editMode ? "✕" : "+"; style: label; color: (futOn ? #7ad1ff : #ff7a88); bold: true; align: center }
        }
      }

      // Status toast (copy / save feedback)
      if vaultToast != "" {
        Box {
          fill: width
          padding: [12, 6]
          radius: 6
          background: alpha((futOn ? #26d1ff : #ff263f), 0.16)
          border: 1
          borderColor: alpha((futOn ? #38d1ff : #ff384e), 0.55)
          onTap: vaultToast = ""
          Text { font: uiFont; text: "◈  ${vaultToast}"; style: small; color: (futOn ? #6bd1ff : #ff6b7c); letterSpacing: 1.2; bold: true; align: center; fill: width }
        }
      }

      // Inline Add / Edit Drawer
      if editMode {
        Box {
          fill: width
          padding: [14, 14]
          radius: 10
          background: (futOn ? #010a0d : #0d0106)
          border: 1
          borderColor: (futOn ? #38d1ff : #ff384e)
          Column {
            fill: width
            gap: 10

            Text {
              font: uiFont
              text: editId == 0 ? "✦  NEW SECRET ENTRY" : "✦  EDIT SECRET ENTRY"
              style: small
              color: (futOn ? #38d1ff : #ff384e)
              letterSpacing: 1.8
              bold: true
            }

            // Category picker
            Row {
              fill: width
              gap: 6
              for c in vaultCats key c {
                let csel = editCat == c
                Box {
                  weight: 1
                  height: 26
                  radius: 5
                  align: center
                  background: csel ? alpha((futOn ? #26d1ff : #ff263f), 0.32) : (futOn ? #010507 : #070103)
                  border: 1
                  borderColor: csel ? (futOn ? #38d1ff : #ff384e) : alpha((futOn ? #12718a : #8a1224), 0.5)
                  onTap: {
                    if animHaptics { haptic() }
                    editCat = c
                  }
                  Text { font: uiFont; text: c == "IDENTITY" ? "ID" : c; style: small; color: csel ? (futOn ? #7ad1ff : #ff7a88) : (futOn ? #62819e : #9e626c); bold: csel; align: center }
                }
              }
            }

            // Label field
            Box {
              fill: width
              padding: [10, 6]
              radius: 6
              background: (futOn ? #000406 : #060002)
              border: 1
              borderColor: alpha((futOn ? #26d1ff : #ff263f), 0.4)
              Input {
                text: editLabel
                placeholder: "Title (e.g. Primary Card, SSN, Email)"
                color: (futOn ? #85d1ff : #ff8594)
                fontSize: 13
                underline: false
                onChange: editLabel = value
              }
            }

            // Value field
            Box {
              fill: width
              padding: [10, 6]
              radius: 6
              background: (futOn ? #000406 : #060002)
              border: 1
              borderColor: alpha((futOn ? #26d1ff : #ff263f), 0.4)
              Input {
                text: editValue
                placeholder: "Secret value (card #, email, ID, code...)"
                color: (futOn ? #85d1ff : #ff8594)
                fontSize: 13
                underline: false
                lines: 3
                onChange: editValue = value
              }
            }

            // Note / Extra details field
            Box {
              fill: width
              padding: [10, 6]
              radius: 6
              background: (futOn ? #000406 : #060002)
              border: 1
              borderColor: alpha((futOn ? #12718a : #8a1224), 0.55)
              Input {
                text: editNote
                placeholder: "Extra details (EXP, CVV, PIN, recovery notes)"
                color: (futOn ? #a7b1d9 : #d9a7ae)
                fontSize: 12
                underline: false
                lines: 2
                onChange: editNote = value
              }
            }

            // Save / Cancel / Delete row
            Row {
              fill: width
              gap: 8
              Box {
                weight: 1
                height: 32
                radius: 6
                align: center
                background: alpha((futOn ? #26d1ff : #ff263f), 0.30)
                border: 1
                borderColor: (futOn ? #38d1ff : #ff384e)
                onTap: {
                  if animHaptics { haptic() }
                  let lbl = trim(editLabel) != "" ? upper(trim(editLabel)) : "UNTITLED SECRET"
                  let val = trim(editValue)
                  let nt = trim(editNote)
                  if editId == 0 {
                    let nid = nextVaultId
                    nextVaultId = nid + 1
                    vaultItems = vaultItems + [{ id: nid, cat: editCat, label: lbl, value: val, note: nt }]
                    vaultToast = "ADDED · ${lbl}"
                  } else {
                    vaultItems = vaultItems.map(it => it.id == editId ? { id: it.id, cat: editCat, label: lbl, value: val, note: nt } : it)
                    vaultToast = "SAVED · ${lbl}"
                  }
                  editMode = false
                }
                Text { font: uiFont; text: "SAVE"; style: small; color: (futOn ? #7ad1ff : #ff7a88); bold: true; letterSpacing: 1.4; align: center }
              }
              Box {
                width: 78
                height: 32
                radius: 6
                align: center
                background: (futOn ? #010d10 : #100106)
                border: 1
                borderColor: alpha((futOn ? #12718a : #8a1224), 0.7)
                onTap: {
                  if animHaptics { haptic() }
                  editMode = false
                }
                Text { font: uiFont; text: "CANCEL"; style: small; color: (futOn ? #a2a9cf : #cfa2a8); letterSpacing: 1.2; align: center }
              }
              if editId != 0 {
                Box {
                  width: 70
                  height: 32
                  radius: 6
                  align: center
                  background: (futOn ? #02191f : #1f0208)
                  border: 1
                  borderColor: alpha((futOn ? #1ed1ff : #ff1e38), 0.75)
                  onTap: {
                    if animHaptics { haptic() }
                    vaultItems = vaultItems.filter(it => it.id != editId)
                    vaultToast = "REMOVED ENTRY"
                    editMode = false
                  }
                  Text { font: uiFont; text: "DEL"; style: small; color: (futOn ? #4ad1ff : #ff4a5e); bold: true; letterSpacing: 1.2; align: center }
                }
              }
            }
          }
        }
      }

      // Scrollable Vault Cards
      Column {
        weight: 1
        fill: width
        scroll: true
        gap: 10

        for item in visibleVault key item.id {
          let isSet = item.value != ""
          let shown = revealAll || revealId == item.id
          let catCol = item.cat == "IDENTITY" ? (futOn ? #24d1ff : #ff243c) : item.cat == "EMAILS" ? (futOn ? #4dd1ff : #ff4d5e) : item.cat == "CARDS" ? (futOn ? #14a7cc : #cc1428) : (futOn ? #1ad1ff : #ff1a2e)
          Box {
            fill: width
            padding: [13, 12]
            radius: 10
            background: (futOn ? #010608 : #080104)
            border: 1
            borderColor: shown && isSet ? alpha(catCol, 0.78) : alpha((futOn ? #12718a : #8a1224), 0.55)
            Column {
              fill: width
              gap: 6

              // Card Header: Category pill + Label + Action pills
              Row {
                fill: width
                align: center
                gap: 6
                Box {
                  width: 54
                  height: 18
                  radius: 4
                  align: center
                  background: alpha(catCol, 0.16)
                  border: 1
                  borderColor: alpha(catCol, 0.55)
                  Text {
                    font: uiFont
                    text: item.cat == "IDENTITY" ? "ID" : item.cat
                    fontSize: 9
                    color: catCol
                    bold: true
                    letterSpacing: 0.9
                    align: center
                  }
                }
                Text {
                  font: uiFont
                  text: item.label
                  style: small
                  color: (futOn ? #80d1ff : #ff808e)
                  bold: true
                  letterSpacing: 1.2
                  weight: 1
                }
                if isSet {
                  Box {
                    width: 44
                    height: 22
                    radius: 5
                    align: center
                    background: shown ? alpha(catCol, 0.24) : (futOn ? #020e12 : #120207)
                    border: 1
                    borderColor: alpha(catCol, 0.5)
                    onTap: {
                      if animHaptics { haptic() }
                      revealId = revealId == item.id ? 0 : item.id
                    }
                    Text { font: uiFont; text: shown ? "HIDE" : "VIEW"; fontSize: 9; color: (futOn ? #80d1ff : #ff808e); bold: true; align: center }
                  }
                  Box {
                    width: 44
                    height: 22
                    radius: 5
                    align: center
                    background: (futOn ? #020e12 : #120207)
                    border: 1
                    borderColor: alpha((futOn ? #26d1ff : #ff263f), 0.5)
                    onTap: {
                      if animHaptics { haptic() }
                      copy(item.value)
                      vaultToast = "COPIED · ${item.label}"
                    }
                    Text { font: uiFont; text: "COPY"; fontSize: 9; color: (futOn ? #6bd1ff : #ff6b7c); bold: true; align: center }
                  }
                }
                Box {
                  width: 42
                  height: 22
                  radius: 5
                  align: center
                  background: (futOn ? #020e12 : #120207)
                  border: 1
                  borderColor: alpha((futOn ? #12718a : #8a1224), 0.7)
                  onTap: {
                    if animHaptics { haptic() }
                    editId = item.id
                    editCat = item.cat
                    editLabel = item.label
                    editValue = item.value
                    editNote = item.note
                    editMode = true
                  }
                  Text { font: uiFont; text: "EDIT"; fontSize: 9; color: (futOn ? #a2a9cf : #cfa2a8); bold: true; align: center }
                }
              }

              // Secret Value Line
              Text {
                font: uiFont
                text: !isSet ? "UNSET PLACEHOLDER  ·  TAP EDIT TO FILL" : shown ? item.value : "••••  ••••  ••••  ••••"
                style: isSet && shown ? "body" : "small"
                color: !isSet ? (futOn ? #355a6e : #6e3540) : shown ? (futOn ? #7ad1ff : #ff7a88) : (futOn ? #6c96b8 : #b86c77)
                letterSpacing: isSet && !shown ? 2.0 : 0.4
                fill: width
              }

              // Extra Note / Metadata Line
              if item.note != "" {
                Text {
                  font: uiFont
                  text: !isSet ? item.note : shown ? item.note : "NOTES MASKED  ·  TAP VIEW"
                  fontSize: 11
                  color: !isSet ? (futOn ? #274454 : #542730) : shown ? (futOn ? #8ba3c7 : #c78b94) : (futOn ? #2c4d5e : #5e2c36)
                  fill: width
                }
              }
            }
          }
        }
      }
    }
    }
  }
}
