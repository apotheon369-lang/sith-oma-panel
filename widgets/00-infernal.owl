          path([[cx, cy + u * 0.05], [cx + u * 0.085, cy + u * 0.26], [cx, cy + u * 0.21], [cx - u * 0.085, cy + u * 0.26]], closed: true, fill: #020005, stroke: #6e5d44, width: 0.9)
          line(cx, cy + u * 0.08, cx, cy + u * 0.22, stroke: alpha(#d4c08a, 0.65), width: 0.9)

          // 9. Snarling 6-Tooth Exposed Skull Jaw & Clenched Skeletal Grin
          path([
            [cx - u * 0.31, cy + u * 0.35],
            [cx - u * 0.16, cy + u * 0.39],
            [cx, cy + u * 0.37],
            [cx + u * 0.16, cy + u * 0.39],
            [cx + u * 0.31, cy + u * 0.35],
