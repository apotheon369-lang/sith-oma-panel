          path([[cx - u * 0.36, cy + u * 0.72], [cx, cy + u * 0.82], [cx + u * 0.36, cy + u * 0.72], [cx + u * 0.28, cy + u * 0.90], [cx, cy + u * 0.94], [cx - u * 0.28, cy + u * 0.90]], closed: true, fill: #152256, stroke: alpha(#4d75ff, 0.58), width: 0.95)

