          ], closed: true, fill: linear(cx - u * 0.65, cy - u * 0.14, cx - u * 0.50, cy + u * 0.18, [#24d95a, #0a6b26]), stroke: alpha(rimGreen, 0.75), width: 1.2)
          path([
            [cx + u * 0.52, cy - u * 0.18], [cx + u * 0.62, cy - u * 0.14], [cx + u * 0.65, cy - u * 0.02],
            [cx + u * 0.63, cy + u * 0.10], [cx + u * 0.56, cy + u * 0.18], [cx + u * 0.50, cy + u * 0.16]
          ], closed: true, fill: linear(cx + u * 0.65, cy - u * 0.14, cx + u * 0.50, cy + u * 0.18, [#24d95a, #0a6b26]), stroke: alpha(rimGreen, 0.75), width: 1.2)

          // 4. Smooth Organic Classic Green Mask Head (silky 22-pt curved silhouette, velvety shading, zero polygons!)
          path([
            [cx, cy - u * 0.62],
            [cx + u * 0.24, cy - u * 0.59],
            [cx + u * 0.44, cy - u * 0.48],
