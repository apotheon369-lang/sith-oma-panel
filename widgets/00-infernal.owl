face "infernal" {
  meta { owl: 22; description: "Obsidian Sanctum: 4-Theme AMOLED Home (Infernal Demon, Future Ultron, 90s Cyber-Mask & Royal Purple Skeletor) with unified hub.tok, 0-loop semantic AGSL shaders, Face-Tap Diagnosis HUD v2, and Palpatine's Secrets vault." }
  page: 0
  statusBar: false
  padding: 0

  source now = clock every 30s
  source bat = android.battery every 2m
  source osSaver = android.modes   // event-driven; Android Battery Saver freezes ambient FX
  source cgDrawer = android.drawer
  source hub = file("~/.config/omalauncher/hub.json") json optional
  source faceBrief = file("~/.config/omalauncher/face-brief.json") json optional
  source notifDiag = android.notifications
  let rzBusy = (hub.busy ?? false) == true
  let rzRes = rzBusy ? 0.34 : 1
  let gpuRes = clamp(num(hub.res, 1), 0.25, 1)   // full-screen shader resolution (hub.res); lower = faster

  // 17 single-source monochrome SVG glyphs tinted at draw time via cMid across all 4 themes
  asset icoFb = base64""
  asset icoIg = base64""
  asset icoX = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA2NCA2NCI+PHBhdGggZD0iTTExIDEwIEgyNC41IEwzNS4yIDI1LjUgTDQ4LjUgMTAgSDU1IEwzOC4yIDI5LjggTDU2IDU0IEg0Mi41IEwzMSAzNy41IEwxNi41IDU0IEgxMCBMMjggMzMuMiBaIE0xOC41IDE1IEw0NSA0OSBINDguNSBMMjIgMTUgWiIgZmlsbD0iI2ZmZmZmZiIvPjwvc3ZnPg=="
  asset icoYt = base64""
  asset icoSc = base64""
  asset icoTt = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA2NCA2NCI+PHBhdGggZD0iTTM3LjUgMTAgVjM5IEExMSAxMSAwIDEgMSAyNi41IDI4IFYzNC41IEE1IDUgMCAxIDAgMzEuNSAzOS41IFYxMCBIMzggQzQwIDE2LjUgNDUgMjAuNSA1MiAyMSBWMjcuNSBDNDYuNSAyNy4yIDQxLjUgMjQuOCAzNy41IDIxIFoiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4="
  asset icoRd = base64""
  asset icoDc = base64""
  asset icoSn = base64""
  asset icoChrome = base64""
  asset icoMsg = base64""
  asset icoMusic = base64""
  asset icoTerm = base64""
  asset icoPhone = base64""
  asset icoMail = base64""
  asset icoEmpty = base64""
  asset icoFrame = base64""

  // Crimson Glitch 5-slot occult app dock state
  state tapBounce = ""   // press-bounce: which tappable is held (springs back on release)
  state cgAnimated = true persist
  state cgAppSlots = ["", "", "", "", ""] persist
  state cgSlotsReady = false persist
  state cgEditMode = false
  state cgActiveSlot = 0
  state cgQuery = ""
  state cgSortByUse = true persist
  state cgFxT = 0
  state cgTapX = 0.5
  state cgTapY = 0.5
  state cgBurst = 0
  state cgGlitchSeed = 42
  state cgPulses = []

  // FX Mode: 1 = SITH (default live), 2 = OVERDRIVE (max tracers/lightning/splatter), 0 = ECO (1 fps)
  // Appearance only: "infernal" (occult crimson), "future" (clean cyan future-OS), or "mask" (futuristic 90s Cyber-Mask neon green/gold)
  state fxT = 0
  state impSeq = 1
  state lastPad = -1
  state combo = ""
  state briefOpen = false

  // Purge Chamber (task + process manager) — shares this face's screen{} with the vault
  state scrMode = "vault"
  state killLog = ""
  source sysInfo = android.system every 15s
  source recentApps = android.recent
  source procs = cmd(scrMode == "tasks" ? "ps -eo pid,rss,pcpu,comm --no-headers --sort=-rss | awk 'BEGIN{printf \"[\"} {if(NR>1)printf \",\"; printf \"{\\\"pid\\\":%s,\\\"rss\\\":%s,\\\"cpu\\\":%s,\\\"name\\\":\\\"%s\\\"}\", $1,$2,$3,$4} END{print \"]\"}'" : "echo []") every 30s json optional

  // Ring buffer of 6 recent screen-press impacts (exact length 6 for AGSL float4[6] uniform)
  state impacts = [
    { x: -200, y: -200, t: -99, seed: 1.1, pwr: 1.0 },
    { x: -200, y: -200, t: -99, seed: 2.3, pwr: 1.0 },
    { x: -200, y: -200, t: -99, seed: 3.7, pwr: 1.0 },
    { x: -200, y: -200, t: -99, seed: 5.1, pwr: 1.0 },
    { x: -200, y: -200, t: -99, seed: 6.9, pwr: 1.0 },
    { x: -200, y: -200, t: -99, seed: 8.4, pwr: 1.0 }
  ]

  // Palpatine's Secrets — Personal Vault state (persisted locally on device, never hardcoded)
  state revealAll = false
  state vaultToast = ""
  // Classic vault list was retired (cards + email only). Kept so anything saved there isn't wiped; delete to purge.
  state vaultItems = [
    { id: 1,  cat: "IDENTITY", label: "FULL LEGAL NAME",     value: "", note: "DOB · Citizenship · Legal Name" },
    { id: 2,  cat: "IDENTITY", label: "HOME ADDRESS",        value: "", note: "Street · Apt · City · State · ZIP" },
    { id: 3,  cat: "IDENTITY", label: "SSN / GOV ID",        value: "", note: "SSN · Passport # · Driver License #" },
    { id: 4,  cat: "IDENTITY", label: "PHONE & EMERGENCY",   value: "", note: "Primary # · ICE Contact Name & #" },
    { id: 5,  cat: "EMAILS",   label: "PRIMARY EMAIL",       value: "", note: "Login · Recovery · 2FA Method" },
    { id: 6,  cat: "EMAILS",   label: "ALT / VAULT EMAIL",   value: "", note: "Private / Alias / Proton Account" },
    { id: 7,  cat: "EMAILS",   label: "RECOVERY & LOGINS",   value: "", note: "Backup Email · Master Account Hints" },
    { id: 8,  cat: "CARDS",    label: "PRIMARY CARD",        value: "", note: "Number · EXP ••/•• · CVV ••• · PIN ••••" },
    { id: 9,  cat: "CARDS",    label: "SECONDARY CARD",      value: "", note: "Number · EXP ••/•• · CVV ••• · ZIP" },
    { id: 10, cat: "CARDS",    label: "BANK ROUTING & ACCT", value: "", note: "Bank Name · Routing # · Account #" },
    { id: 11, cat: "VAULT",    label: "SEED PHRASES / KEYS", value: "", note: "Wallet Recovery · Passphrase" },
    { id: 12, cat: "VAULT",    label: "2FA BACKUP CODES",    value: "", note: "Emergency One-Time Recovery Codes" },
    { id: 13, cat: "VAULT",    label: "SAFE & LOCK COMBOS",  value: "", note: "Safe · Gate · Door · Locker PINs" },
    { id: 14, cat: "VAULT",    label: "MEDICAL & PRIVATE",   value: "", note: "Blood Type · Allergies · Rx · Notes" }
  ] persist

  // Secret menu views: "cards" (card wallet) · "mail" (email dossiers)
  state vaultView = "cards" persist
  state cardBook = [] persist
  state nextCardId = 1 persist
  state cardOpen = 0
  state cardReveal = 0
  state cardEdit = false
  state cardEditId = 0
  state ceName = ""
  state ceBank = ""
  state ceNet = ""
  state ceHolder = ""
  state ceNum = ""
  state ceExp = ""
  state ceTint = 0
  state ceBody = ""
  state mailBook = [] persist
  state nextMailId = 1 persist
  state mailOpen = 0
  state mailReveal = 0
  state mailEdit = false
  state mailEditId = 0
  state meAddr = ""
  state meProv = ""
  state mePurpose = ""
  state meRecov = ""
  state mePhone = ""
  state me2fa = ""
  state meAlias = ""
  state meBody = ""
  let cardTints = [#ff1e3c, #ffe14a, #ff3df0, #3da8ff, #2bff8c, #b0b0b0]
  let curM = num(fmtTime(now ?? 0, "yyyy"), 0) * 12 + num(fmtTime(now ?? 0, "MM"), 0)
  let cardMonths = cardBook.map(c => len(split(c.exp, "/")) == 2 ? (2000 + num(split(c.exp, "/")[1], 0)) * 12 + num(split(c.exp, "/")[0], 0) : 0)
  let soonN = len(cardMonths.filter(m => m > 0 && m >= curM && m - curM <= 3))
  let expiredN = len(cardMonths.filter(m => m > 0 && m < curM))
  let tfaN = len(mailBook.filter(m => m.tfa != ""))
  let recovN = len(mailBook.filter(m => m.recov != "" || m.phone != ""))


  let scrW = max(tileWidth ?? 360, 1)
  let scrH = max(tileHeight ?? 800, 1)
  let wide = scrW > scrH
  let level = bat.level ?? 0
  let low = level < 20

  let ecoOn = (hub.eco ?? false) == true
  let animMaster = (hub.fx ?? true) == true && !ecoOn
  let animHaptics = (hub.haptics ?? true) == true
  let animSpeed = clamp(num(hub.speed, 1.0), 0.5, 2.0)
  let hubLvl = num(hub.fxLevel, 1)
  let hubGlow = num(hub.glow, 1)
  let infVoidOn = animMaster
  let infFxOn = animMaster && hubLvl >= 1
  let infGlitchOn = animMaster
  let newestAge = fxT - impacts[0].t
  let burstHot = infFxOn && newestAge >= 0 && newestAge < 1.25
  let burstActive = infFxOn && newestAge >= 0 && newestAge < 3.4
  let surge = infFxOn && newestAge >= 0 && newestAge < 1.1 ? clamp(1.0 - newestAge / 1.1, 0, 1) : 0
  // Battery saver (<20%, unplugged): ambient motion holds still instead of stuttering at a low frame rate;
  // taps still play their burst at full smoothness, then everything settles again.
  let saver = (low && !((bat.charging ?? false) == true)) || (osSaver.saver ?? false) == true   // + Android Battery Saver
  let fxLive = infVoidOn && !saver
  let cgLive = infGlitchOn && (!saver || len(cgPulses) > 0 || cgBurst > 0.005)
  let fxBoost = 0.55 + hubGlow * 0.2
  let breathe = fxLive ? 0.5 + 0.5 * sin(fxT * 1.9) : 0.48

  // Unified multi-theme token engine compiled by owl-hub -> hub.json
  let curMode   = hub.mode ?? "infernal"
  let futOn     = curMode == "future"
  let maskOn    = curMode == "mask"
  let skelOn    = curMode == "skeletor"
  let hulkOn    = curMode == "hulk-gamma"
  let faustOn   = curMode == "pluto-faust"
  let T         = hub.tok ?? {}
  let tc        = T.copy ?? {}
  let cPri      = ecoOn ? (T.ecoPri  != null ? rgb(T.ecoPri[0],  T.ecoPri[1],  T.ecoPri[2])  : #b8263a) : (T.pri != null ? rgb(T.pri[0], T.pri[1], T.pri[2]) : #ff1e3c)
  let cMid      = T.mid   != null ? rgb(T.mid[0],   T.mid[1],   T.mid[2])   : #ff3850
  let cHot      = ecoOn ? (T.ecoHot  != null ? rgb(T.ecoHot[0],  T.ecoHot[1],  T.ecoHot[2])  : #d94c5e) : (T.hot != null ? rgb(T.hot[0], T.hot[1], T.hot[2]) : #ff8596)
  let cSec      = T.sec   != null ? rgb(T.sec[0],   T.sec[1],   T.sec[2])   : #ff6a1a
  let cBone     = ecoOn ? (T.ecoBone != null ? rgb(T.ecoBone[0], T.ecoBone[1], T.ecoBone[2]) : #c7a3a8) : (T.bone != null ? rgb(T.bone[0], T.bone[1], T.bone[2]) : #fff0f2)
  let cDim      = ecoOn ? (T.ecoDim  != null ? rgb(T.ecoDim[0],  T.ecoDim[1],  T.ecoDim[2])  : #4d0c18) : (T.dim != null ? rgb(T.dim[0], T.dim[1], T.dim[2]) : #6b0918)
  let cDeep     = T.deep  != null ? rgb(T.deep[0],  T.deep[1],  T.deep[2])  : #170206
  let cCard     = T.card  != null ? rgb(T.card[0],  T.card[1],  T.card[2])  : #0c0104
  let cObs      = T.obs   != null ? rgb(T.obs[0],   T.obs[1],   T.obs[2])   : #050002
  let cInk      = T.ink   != null ? rgb(T.ink[0],   T.ink[1],   T.ink[2])   : #fff0f2
  let cMuted    = T.muted != null ? rgb(T.muted[0], T.muted[1], T.muted[2]) : #c77c88
  let cGold     = maskOn ? cSec : cBone
  let uiFont    = T.fontPath ?? "sans"
  let dispFont  = T.displayFontPath ?? uiFont
  let bodyFont  = T.bodyFont ?? (hub.font == "mono" ? "mono" : "sans")
  let modeIdx   = num(T.modeIdx, 0)
  // ---- GLOBAL THEME BACKDROP tokens (shared by every face; one panorama, low-res) ----
  let bgRes  = clamp(min(num(hub.res, 1), 0.5), 0.25, 0.5)   // backdrop always <= 50% res
  let bgGlow = 0.75 + 0.15 * clamp(num(hub.glow, 1), 0, 3)
  let bgPri  = T.pri  != null ? rgb(T.pri[0],  T.pri[1],  T.pri[2])  : #ff1e3c
  let bgHot  = T.hot  != null ? rgb(T.hot[0],  T.hot[1],  T.hot[2])  : #ff8596
  let bgSec  = T.sec  != null ? rgb(T.sec[0],  T.sec[1],  T.sec[2])  : #3d9bff
  let bgDim  = T.dim  != null ? rgb(T.dim[0],  T.dim[1],  T.dim[2])  : #6b0918
  let bgBone = T.bone != null ? rgb(T.bone[0], T.bone[1], T.bone[2]) : #fff0f2
  let hubRadius = clamp(num(hub.radius, 1.0), 0.5, 1.5)

  // Face-tap telemetry + live diagnosis & email brief derived state (HUD v2)
  let diagMemTot = max(sysInfo.memory.total ?? 1, 1)
  let diagMemUsed = sysInfo.memory.used ?? 0
  let diagRamPct = round((diagMemUsed / diagMemTot) * 100)
  let diagFreeGb = round((sysInfo.storage.free ?? 0) / 1073741824, 1)
  let diagNotifList = take(notifDiag.items ?? [], 12).map(n => ({
    app: n.app ?? "",
    pkg: n.package ?? "",
    title: n.title ?? "",
    text: n.text ?? ""
  }))
  let briefTelemetryJson = toJson({
    bat: bat.level ?? 0,
    charging: (bat.charging ?? false) == true,
    temp: bat.temp ?? 0,
    ramPct: diagRamPct,
    freeGb: diagFreeGb,
    notifCount: notifDiag.count ?? len(diagNotifList),
    notifs: diagNotifList
  })
  let fbBusy = (faceBrief.busy ?? false) == true
  let fbUnread = num(faceBrief.unread, 0)
  let fbDiag = faceBrief.diag ?? "BAT ${level}% · RAM ${diagRamPct}% · ${diagFreeGb}G FREE · SCANNING..."
  let fbMail = faceBrief.mail ?? "CHECKING EMAIL & NOTIFICATIONS..."
  let fbSummary = faceBrief.summary ?? ""
  let fbTs = faceBrief.ts ?? fmtTime(now, "HH:mm")
  let fbHeadline = faceBrief.headline ?? (tc.briefTitle ?? "DIAGNOSIS & MAIL BRIEFING")
  let fbVerdict = upper(faceBrief.verdict ?? (fbBusy ? "SCAN" : "NOMINAL"))
  let fbVerdictCol = fbVerdict == "ALERT" ? #ff3850 : fbVerdict == "WATCH" ? #ffb02e : fbVerdict == "NOMINAL" ? #2bff8c : cHot
  let fbItems = take(faceBrief.mailItems ?? [], 3)

  // ZOOM grid: one 5-column grid shared by BOTH app rows so their icons line up dead even
  let sidePad = 12
  let cgW = max(scrW - sidePad * 2, 1)
  let cgPadX = 12
  let cgPadY = 9
  let cgSlotGap = 8
  let cgSlotW = max(30, floor((cgW - cgPadX * 2 - cgSlotGap * 4) / 5))
  let cgIconSz = clamp(cgSlotW - 22, 28, 44)
  let cgSlotH = clamp(cgIconSz + 16, 44, 60)
  let cgFootH = 16
  let cgH = cgSlotH + cgFootH + cgPadY * 2 + 7
  let dockH = clamp(cgSlotW + 14, 68, 82)
  let sigilH = wide ? min(scrH * 0.58, 380) : min(scrH * 0.32, 278)

  let cgAllApps = cgDrawer.apps ?? []
  let cgSlotApps = range(5).map(i => cgAppSlots[i] != null && cgAppSlots[i] != "" ? cgAllApps.find(a => a.key == cgAppSlots[i]) : null)
  let cgActiveApp = cgSlotApps[cgActiveSlot]
  let cgPickerAll = cgQuery == "" ? cgAllApps : cgAllApps.filter(a => contains(lower(a.name), lower(cgQuery)))
  let cgPickerShown = take(cgPickerAll, 60)

  when !cgSlotsReady && len(cgAllApps) > 0 {
    let s0 = cgAllApps.find(a => contains(lower(a.key), "facebook") || lower(a.name) == "lite")
    let s1 = cgAllApps.find(a => contains(lower(a.key), "instagram") || contains(lower(a.name), "instagram"))
    let s2 = cgAllApps.find(a => contains(lower(a.key), "twitter") || lower(a.name) == "x")
    let s3 = cgAllApps.find(a => contains(lower(a.key), "youtube") || contains(lower(a.name), "youtube"))
    let s4 = cgAllApps.find(a => contains(lower(a.key), "soundcloud") || contains(lower(a.name), "soundcloud") || contains(lower(a.key), "tiktok") || contains(lower(a.key), "reddit") || contains(lower(a.key), "discord") || contains(lower(a.name), "simpmusic"))
    cgAppSlots = [
      s0 != null ? s0.key : "",
      s1 != null ? s1.key : "",
      s2 != null ? s2.key : "",
      s3 != null ? s3.key : "",
      s4 != null ? s4.key : ""
    ]
    cgSlotsReady = true
  }

  state portalT = 0
  state portalFired = false
  source m98Sys = cmd(scrMode == "matrix98" ? "python3 ~/.local/bin/matrix98-mode.py sysinfo" : "echo {}") every 15s json optional
  state m98Fx = true persist
  state m98Drac = true persist
  state m98Cmd = ""
  state m98LastCmd = "uname -a"
  state m98Hist = [
    { kind: "note", title: "ARCH98 MATRIX-OS v2.2", lang: "SYS", body: "KERNEL: ARCH LINUX AARCH64 · BASH READY.\nHINT: TAP [LIB] FOR COMMANDS, [PKG] FOR PACMAN.\n// CLUE 1: somewhere in the phosphor, a ghost listens for 42..." }
  ]
  state m98Code = 0
  state m98Raw = ""
  state m98Win = "term"
  state m98Cwd = "~"
  state m98CmdLog = ["uname -a", "free -h", "ls -la"]
  state m98LogIdx = -1
  state m98LibCat = "sys"
  state m98PkgQ = ""
  state m98EggFound = false persist
  state m98CopiedIdx = -1

  on m98Raw {
    if value != "" {
      let parsed = parseJson(value)
      if parsed != null {
        let out = parsed.out ?? ""
        let c = parsed.cmd ?? m98LastCmd
        m98Code = num(parsed.code, 0)
        if c != "" { m98LastCmd = c }
        let entry = { kind: "cmd", title: c, lang: "BASH", body: out }
        let next = m98Hist + [entry]
        m98Hist = len(next) > 24 ? next.filter((_, i) => i >= len(next) - 24) : next
      } else {
        m98Hist = m98Hist + [{ kind: "code", title: m98LastCmd, lang: "OUT", body: value }]
        m98Code = 0
      }
      m98CopiedIdx = -1
    }
  }

  // Smooth FPS ladder: never animate below 30 (choppy motion reads as lag) — when we can't afford 30, hold still at 1.
  // 60 tap burst · 30 idle motion · 1 static (FX off, eco, battery saver idle, hub rebuilding)
  fps: scrMode == "portal98" ? 60
    : scrMode == "matrix98" ? (m98Fx ? 24 : 1)
    : (!infVoidOn && !infFxOn && !infGlitchOn) ? 1
    : burstHot ? 60
    : (burstActive || (infGlitchOn && (len(cgPulses) > 0 || cgBurst > 0.005))) ? 30
    : (rzBusy || saver) ? 1
    : 30

  every frame {
    // cap dt so a 1fps static frame waking into a burst doesn't make everything jump
    let sdt = min(dt, 0.05)
    if scrMode == "portal98" {
      portalT = portalT + sdt
      if portalT >= 2.6 && !portalFired {
        portalFired = true
        scrMode = "matrix98"
        m98Win = "term"
        run("printf '{\"mode\":\"matrix98\"}\n' > ~/.config/omalauncher/ui-mode.json")
      }
    }
    if (infVoidOn || infFxOn) && (!saver || burstActive) {
      fxT = fxT + sdt * animSpeed
    }
    if infGlitchOn {
      if cgLive { cgFxT = cgFxT + sdt * animSpeed }
      if cgBurst > 0.001 {
        cgBurst = max(0, cgBurst - dt * 1.15 * animSpeed)
      } else if cgBurst > 0 {
        cgBurst = 0
      }
      if len(cgPulses) > 0 {
        cgPulses = cgPulses.map(p => merge(p, { age: p.age + dt * animSpeed })).filter(p => p.age < 1.0)
      }
    }
  }

  let padCols = T.pads ?? [#a80b1e, #cc1228, #ff1a34, #e60026, #ff3b4e]
  let drumPads = [
    { idx: 0, num: "1", note: "C3",  col: padCols[0] ?? cDim },
    { idx: 1, num: "2", note: "Eb3", col: padCols[1] ?? cPri },
    { idx: 2, num: "3", note: "F3",  col: padCols[2] ?? cPri },
    { idx: 3, num: "4", note: "G3",  col: padCols[3] ?? cMid },
    { idx: 4, num: "5", note: "Bb3", col: padCols[4] ?? cHot }
  ]

  // Normalized impact uniforms for GPU AGSL shader: [nx, ny, age, seed]
  // Skip per-frame mapping completely when FX are dormant
  let dormantImpacts = [[-1.0, -1.0, 99.0, 1.0], [-1.0, -1.0, 99.0, 2.0], [-1.0, -1.0, 99.0, 3.0], [-1.0, -1.0, 99.0, 4.0], [-1.0, -1.0, 99.0, 5.0], [-1.0, -1.0, 99.0, 6.0]]
  let shaderImpacts = burstActive ? impacts.map(imp => [
    clamp(imp.x / scrW, -1, 2),
    clamp(imp.y / scrH, -1, 2),
    imp.t < -50 ? 99.0 : max(0.0, fxT - imp.t),
    imp.seed
  ]) : dormantImpacts

  background: #000000

  component DockApp(pkg, label, slotIdx) {
    Box {
      scale: tapBounce == "1${hash(pkg, label, slotIdx)}" ? 0.9 : 1
      offset: [0, tapBounce == "1${hash(pkg, label, slotIdx)}" ? -4 : 0]
      animate scale: spring(0.32, 520)
      animate offset: spring(0.32, 520)
      onPress: tapBounce = "1${hash(pkg, label, slotIdx)}"
      onRelease: tapBounce = ""
      weight: 1
      fill: height
      align: center
      ripple: false
      onTap: {
        if infFxOn {
          let px = sidePad + cgPadX + (cgSlotW + cgSlotGap) * slotIdx + cgSlotW / 2
          let py = scrH - (screenInset ?? 0) - 72 - dockH / 2
          impacts = [
            { x: px, y: py, t: fxT, seed: impSeq * 1.618 + 0.7, pwr: 1.1 },
            impacts[0], impacts[1], impacts[2], impacts[3], impacts[4]
          ]
          impSeq = impSeq + 1
        }
        if animHaptics { haptic() }
        androidApp(pkg)
      }
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) * 0.41
        let pulse = fxLive ? 0.5 + 0.5 * sin(fxT * 2.4 + slotIdx * 1.1) : 0.48
        let glowA = 0.24 + pulse * 0.14 + surge * 0.22
        // Outer obsidian glow aura
        circle(cx, cy, r * (1.16 + pulse * 0.06), fill: radial(cx, cy, r * 1.24, [alpha(cPri, glowA), alpha(cDim, glowA * 0.35), alpha(#000000, 0)]))
        // Recessed sculpted obsidian lens disc
        circle(cx, cy, r * 0.96, fill: linear(cx, cy - r, cx, cy + r, [alpha(cDeep, 0.95), #000000, alpha(cDim, 0.24)]))
        // Specular top bevel arc (gives real 3D glass-metal depth)
        arc(cx, cy, r * 0.92, -62, 124, stroke: alpha(cHot, 0.32 + pulse * 0.16), width: 1.0, cap: round)
        // Primary & inner sigil rings
        circle(cx, cy, r, stroke: alpha(cPri, 0.72 + pulse * 0.22 + surge * 0.1), width: 1.4)
        circle(cx, cy, r * 0.83, stroke: alpha(cDim, 0.65 + pulse * 0.2), width: 0.85)
        let rot = fxLive ? rad(fxT * (slotIdx % 2 == 0 ? 14 : -14)) : 0
        let ca = cos(rot)
        let sa = sin(rot)
        let rIn = r * 0.93
        let rOut = r * 1.13
        line(cx + sa * rOut, cy - ca * rOut, cx + sa * rIn, cy - ca * rIn, stroke: cHot, width: 1.5, cap: round)
        line(cx + ca * rOut, cy + sa * rOut, cx + ca * rIn, cy + sa * rIn, stroke: cHot, width: 1.5, cap: round)
        line(cx - sa * rOut, cy + ca * rOut, cx - sa * rIn, cy + ca * rIn, stroke: cHot, width: 1.5, cap: round)
        line(cx - ca * rOut, cy - sa * rOut, cx - ca * rIn, cy - sa * rIn, stroke: cHot, width: 1.5, cap: round)
      }
      Image { src: "app:${pkg}"; size: clamp(round(cgSlotW * 0.5), 28, 36); tint: cMid; label: label }
    }
  }

  component DockCrown(pkg) {
    Box {
      scale: tapBounce == "2${hash(pkg)}" ? 0.9 : 1
      offset: [0, tapBounce == "2${hash(pkg)}" ? -4 : 0]
      animate scale: spring(0.32, 520)
      animate offset: spring(0.32, 520)
      onPress: tapBounce = "2${hash(pkg)}"
      onRelease: tapBounce = ""
      weight: 1
      fill: height
      align: center
      ripple: false
      onTap: {
        if infFxOn {
          let px = scrW * 0.5
          let py = scrH - (screenInset ?? 0) - 72 - dockH / 2
          impacts = [
            { x: px, y: py, t: fxT, seed: impSeq * 1.618 + 0.9, pwr: 1.35 },
            impacts[0], impacts[1], impacts[2], impacts[3], impacts[4]
          ]
          impSeq = impSeq + 1
        }
        if animHaptics { haptic() }
        androidApp(pkg)
      }
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) * 0.35
        let pulse = fxLive ? 0.5 + 0.5 * sin(fxT * 3.1) : 0.54

        // Deep double Kyber halo
        circle(cx, cy, r * (1.42 + pulse * 0.10), fill: radial(cx, cy, r * 1.54, [alpha(cPri, 0.42 + pulse * 0.18 + surge * 0.22), alpha(cDim, 0.18), alpha(#000000, 0)]))
        // Recessed obsidian medallion core
        circle(cx, cy, r * 1.08, fill: linear(cx, cy - r, cx, cy + r, [alpha(cDeep, 0.94), #000000, alpha(cDim, 0.30)]))
        circle(cx, cy, r * 1.13, stroke: alpha(cPri, 0.84 + pulse * 0.16), width: 1.55)
        circle(cx, cy, r * 0.97, stroke: alpha(cDim, 0.72), width: 0.95)
        // Specular bevel highlight arcs
        arc(cx, cy, r * 1.05, -55, 110, stroke: alpha(cHot, 0.42 + pulse * 0.18), width: 1.1, cap: round)
        let rot = fxLive ? -fxT * 18 : 0
        for i in range(8) {
          let cardinal = i % 2 == 0
          rotate(i * 45 + rot, cx, cy) {
            line(cx, cy - r * (cardinal ? 1.25 : 1.18), cx, cy - r * 1.04, stroke: cardinal ? cHot : alpha(cPri, 0.68), width: cardinal ? 1.6 : 1.0, cap: round)
          }
        }

        if skelOn {
          // Havoc Ram-Skull inside 6-Point Violet Hex-Rune Medallion
          let triA = [0, 1, 2].map(k => [cx + cos(rad(k * 120 - 90)) * r * 0.86, cy + sin(rad(k * 120 - 90)) * r * 0.86])
          let triB = [0, 1, 2].map(k => [cx + cos(rad(k * 120 + 90)) * r * 0.86, cy + sin(rad(k * 120 + 90)) * r * 0.86])
          path(triA, closed: true, stroke: alpha(#b44aff, 0.34 + pulse * 0.16), width: 5.5)
          path(triB, closed: true, stroke: alpha(#b44aff, 0.34 + pulse * 0.16), width: 5.5)
          path(triA, closed: true, stroke: #c85cff, width: 1.6)
          path(triB, closed: true, stroke: #c85cff, width: 1.6)
          let s = r * 0.56
          // Curled Havoc Ram Horns (left & right)
          path([[cx - s * 0.28, cy - s * 0.34], [cx - s * 0.82, cy - s * 0.62], [cx - s * 1.15, cy - s * 0.12], [cx - s * 0.96, cy + s * 0.32], [cx - s * 0.64, cy + s * 0.12], [cx - s * 0.80, cy - s * 0.18], [cx - s * 0.42, cy - s * 0.12]], closed: true, fill: #4d127a, stroke: #eb9eff, width: 1.2)
          path([[cx + s * 0.28, cy - s * 0.34], [cx + s * 0.82, cy - s * 0.62], [cx + s * 1.15, cy - s * 0.12], [cx + s * 0.96, cy + s * 0.32], [cx + s * 0.64, cy + s * 0.12], [cx + s * 0.80, cy - s * 0.18], [cx + s * 0.42, cy - s * 0.12]], closed: true, fill: #4d127a, stroke: #eb9eff, width: 1.2)
          // Angular Spectral Bone-Ivory Ram Skull Shield
          path([[cx, cy - s * 0.52], [cx + s * 0.44, cy - s * 0.22], [cx + s * 0.34, cy + s * 0.34], [cx, cy + s * 0.72], [cx - s * 0.34, cy + s * 0.34], [cx - s * 0.44, cy - s * 0.22]], closed: true, fill: #f4e6be, stroke: #06010d, width: 1.1)
          // Twin eye voids & blazing forehead amethyst crystal
          circle(cx - s * 0.18, cy + s * 0.05, s * 0.10, fill: #05000a)
          circle(cx + s * 0.18, cy + s * 0.05, s * 0.10, fill: #05000a)
          circle(cx, cy - s * 0.16, s * 0.16, fill: #e82cff)
          circle(cx, cy - s * 0.16, s * 0.06, fill: #ffffff)
        } else if maskOn {
          // Cyber-Mask Tornado Vortex & Mini Zoot-Grin Emblem
          let vRot = fxLive ? fxT * 64 : 20
          arc(cx, cy, r * 0.84, vRot, 118, stroke: alpha(#1aff5c, 0.34 + pulse * 0.2), width: 6.5, cap: round)
          arc(cx, cy, r * 0.84, vRot, 118, stroke: #c6ff3d, width: 1.8, cap: round)
          arc(cx, cy, r * 0.84, vRot + 180, 118, stroke: alpha(#ffe135, 0.34 + pulse * 0.2), width: 6.0, cap: round)
          arc(cx, cy, r * 0.84, vRot + 180, 118, stroke: #ffe135, width: 1.7, cap: round)
          // Mini sculpted green mask shield + gold fedora brim + pearlescent grin
          path([[cx - r * 0.44, cy - r * 0.24], [cx + r * 0.44, cy - r * 0.24], [cx + r * 0.34, cy + r * 0.32], [cx, cy + r * 0.56], [cx - r * 0.34, cy + r * 0.32]], closed: true, fill: linear(cx, cy - r * 0.3, cx, cy + r * 0.55, [#1aff5c, #073d17]), stroke: #c6ff3d, width: 1.1)
          path([[cx - r * 0.62, cy - r * 0.26], [cx, cy - r * 0.42], [cx + r * 0.62, cy - r * 0.26]], stroke: #ffe135, width: 2.0, cap: round)
          path([[cx - r * 0.30, cy - r * 0.34], [cx - r * 0.16, cy - r * 0.60], [cx + r * 0.16, cy - r * 0.60], [cx + r * 0.30, cy - r * 0.34]], closed: true, fill: #ffe135)
          circle(cx - r * 0.17, cy - r * 0.05, r * 0.09, fill: #ffe135)
          circle(cx + r * 0.17, cy - r * 0.05, r * 0.09, fill: #ffe135)
          path([[cx - r * 0.28, cy + r * 0.16], [cx, cy + r * 0.34], [cx + r * 0.28, cy + r * 0.16], [cx, cy + r * 0.22]], closed: true, fill: #f6ffe8, stroke: #c6ff3d, width: 0.7)
        } else if hulkOn {
          // Hulk Gamma Radiation Triad & Smash Ring
          circle(cx, cy, r * 0.86, stroke: alpha(#2bff4a, 0.36 + pulse * 0.20), width: 4.5)
          circle(cx, cy, r * 0.86, stroke: #c8ff2e, width: 1.5)
          for k in range(3) {
            arc(cx, cy, r * 0.56, k * 120 - 30 + (fxLive ? fxT * 24 : 0), 60, stroke: #2bff4a, width: 5.5, cap: round)
          }
          circle(cx, cy, r * 0.22, fill: #9b30ff, stroke: #c8ff2e, width: 1.4)
        } else if faustOn {
          // Pluto · Doktor Faust Outrun Sliced Sun + Cyan Horizon + Cyber Visor
          let fRot = fxLive ? fxT * 28 : 0
          arc(cx, cy, r * 0.88, fRot, 140, stroke: alpha(#ff2ae6, 0.55 + pulse * 0.22), width: 2.2, cap: round)
          arc(cx, cy, r * 0.88, fRot + 180, 140, stroke: alpha(#00f0ff, 0.55 + pulse * 0.22), width: 2.0, cap: round)
          circle(cx, cy - r * 0.04, r * 0.62, fill: linear(cx, cy - r * 0.66, cx, cy + r * 0.58, [#ffaa00, #ff2ae6, #5c1076]))
          line(cx - r * 0.58, cy + r * 0.14, cx + r * 0.58, cy + r * 0.14, stroke: #05000e, width: 2.2)
          line(cx - r * 0.50, cy + r * 0.30, cx + r * 0.50, cy + r * 0.30, stroke: #05000e, width: 2.8)
          line(cx - r * 0.68, cy + r * 0.44, cx + r * 0.68, cy + r * 0.44, stroke: #00f0ff, width: 1.6, cap: round)
          line(cx - r * 0.48, cy + r * 0.58, cx + r * 0.48, cy + r * 0.58, stroke: alpha(#00f0ff, 0.65), width: 1.2, cap: round)
          path([[cx - r * 0.52, cy - r * 0.16], [cx + r * 0.52, cy - r * 0.16], [cx + r * 0.44, cy + r * 0.10], [cx + r * 0.12, cy + r * 0.10], [cx, cy + r * 0.01], [cx - r * 0.12, cy + r * 0.10], [cx - r * 0.44, cy + r * 0.10]], closed: true, fill: linear(cx - r * 0.5, cy - r * 0.16, cx + r * 0.5, cy + r * 0.10, [#00f0ff, #ff2ae6, #ffaa00]), stroke: #f7e8ff, width: 1.2)
          line(cx - r * 0.34, cy - r * 0.12, cx - r * 0.24, cy + r * 0.06, stroke: #ffffff, width: 1.3, cap: round)
          line(cx + r * 0.14, cy - r * 0.12, cx + r * 0.24, cy + r * 0.06, stroke: #ffffff, width: 1.3, cap: round)
        } else {
          let pts = futOn ? range(7).map(k => [cx + cos(rad(k * 60 - 90)) * r * 0.80, cy + sin(rad(k * 60 - 90)) * r * 0.80]) : [0, 2, 4, 1, 3, 0].map(i => [
            cx + sin(3.14159265 + (i % 5) * 1.2566371) * r * 0.95,
            cy - cos(3.14159265 + (i % 5) * 1.2566371) * r * 0.95
          ])
          path(pts, closed: true, stroke: alpha(cPri, 0.28 + pulse * 0.14), width: 10)
          path(pts, closed: true, stroke: alpha(cMid, 0.94), width: 3.1)
          path(pts, closed: true, stroke: cHot, width: 1.15)

          path([[cx, cy - 4.4], [cx + 3.4, cy], [cx, cy + 4.4], [cx - 3.4, cy]], closed: true, fill: cPri, stroke: cHot, width: 0.8)
        }
      }
    }
  }

  // Infernal-tray style app icon: sculpted glyph in a static sigil ring (no per-frame redraw)
  component TraySigil(src, sz, lbl = "", ini = "") {
    Box {
      size: sz
      align: center
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) * 0.42
        circle(cx, cy, r * 1.14, fill: radial(cx, cy, r * 1.22, [alpha(cPri, 0.30), alpha(#000000, 0)]))
        circle(cx, cy, r * 0.94, fill: linear(cx, cy - r, cx, cy + r, [cDeep, #000000]))
        circle(cx, cy, r, stroke: alpha(cPri, 0.84), width: 1.35)
        circle(cx, cy, r * 0.84, stroke: alpha(cDim, 0.65), width: 0.8)
        arc(cx, cy, r * 0.92, -55, 110, stroke: alpha(cHot, 0.35), width: 0.9, cap: round)
        line(cx, cy - r * 1.12, cx, cy - r * 0.93, stroke: cHot, width: 1.4, cap: round)
        line(cx + r * 0.93, cy, cx + r * 1.12, cy, stroke: cHot, width: 1.4, cap: round)
        line(cx, cy + r * 0.93, cx, cy + r * 1.12, stroke: cHot, width: 1.4, cap: round)
        line(cx - r * 1.12, cy, cx - r * 0.93, cy, stroke: cHot, width: 1.4, cap: round)
      }
      if src != null {
        Image { src: src; size: round(sz * 0.5); tint: cMid; label: lbl }
      } else {
        Text { font: uiFont; text: ini; fontSize: round(sz * 0.3); color: cMid; bold: true; align: center }
      }
    }
  }

  component OccultIcon(app, sz) {
    let k = lower(app.key)
    let n = lower(app.name)
    let customSvg = (contains(k, "facebook") || n == "lite") ? icoFb
      : (contains(k, "instagram") || contains(n, "instagram")) ? icoIg
      : (contains(k, "twitter") || n == "x" || contains(n, "twitter")) ? icoX
      : (contains(k, "youtube") || contains(n, "youtube")) ? icoYt
      : (contains(k, "soundcloud") || contains(n, "soundcloud")) ? icoSc
      : (contains(k, "tiktok") || contains(k, "musically") || contains(n, "tiktok")) ? icoTt
      : (contains(k, "reddit") || contains(n, "reddit")) ? icoRd
      : (contains(k, "discord") || contains(n, "discord")) ? icoDc
      : (contains(k, "snapchat") || contains(n, "snapchat")) ? icoSn
      : (contains(k, "chrome") || contains(n, "chrome") || contains(n, "browser")) ? icoChrome
      : (contains(k, "messag") || contains(n, "messag") || contains(k, "whatsapp") || contains(k, "telegram")) ? icoMsg
      : (contains(n, "music") || contains(k, "spotify") || contains(k, "music")) ? icoMusic
      : (contains(k, "foot") || contains(n, "terminal")) ? icoTerm
      : (contains(k, "dialer") || contains(n, "phone")) ? icoPhone
      : (contains(k, "android.gm") || contains(n, "gmail") || contains(n, "mail")) ? icoMail
      : null

    Box {
      size: sz
      radius: 10 * corners * hubRadius
      background: linear(0, 0, 0, 1, [alpha(cPri, 0.16), cObs, #000000])
      border: 1.25
      borderColor: alpha(cPri, 0.72)
      align: center
      Image { src: icoFrame; size: sz; tint: alpha(cHot, 0.42) }
      if customSvg != null {
        Image { src: customSvg; size: round(sz * 0.64); tint: cMid; label: app.label }
      } else if app.hasIcon {
        Image {
          src: app.icon
          size: round(sz * 0.60)
          tint: cgDrawer.monochrome ? cMid : null
          label: app.label
        }
      } else {
        Text {
          font: dispFont
          text: app.initials
          fontSize: round(sz * 0.34)
          color: cHot
          bold: true
          align: center
        }
      }
    }
  }

  // Root layered container:
  // Layer 0: Living Sith AGSL GPU Shader (dark nebula, crimson lightning veins, GPU blood splatter & shockwaves)
  // Layer 1: Interactive Home Screen UI (with full-screen onPress capture for empty space)
  // Layer 2: Top-level Sith FX Overlay Canvas (vector crimson tracers, blood splatter drips, Force lightning, saber slashes)
  Box {
    fill: true
    repeats: true
    onPress: {
      // screen-press electric burst removed on request — app taps keep their own effects
      if infFxOn {
        if repeat == 0 && animHaptics {
          haptic()
        }
      }
    }

    // ==================== LAYER 0: PURE AMOLED 0-mW BLACK BACKDROP ====================
    // Pure black AMOLED (#000000 / #050002) with high contrast texture & precision tactical lattice
    Box {
      fill: true
      align: center
      clip: true
      background: #000000
      Shader {
        width: scrW
        height: scrH
        fallback: linear(0, 0, 0, 1, [#050002, #000000, #000000, #050002])
        uniforms: {
          uCol: cPri,
          uHot: cHot,
          uObs: cObs
        }
        code: """
          uniform half4 uCol;
          uniform half4 uHot;
          uniform half4 uObs;

          float hexEdge(float2 p) {
            const float2 s = float2(1.0, 1.7320508);
            float2 a = mod(p, s) - s * 0.5;
            float2 b = mod(p - s * 0.5, s) - s * 0.5;
            float2 g = dot(a, a) < dot(b, b) ? a : b;
            float2 ag = abs(g);
            float d = max(dot(ag, normalize(s)), ag.x);
            return 0.5 - d;
          }

          half4 main(float2 p) {
            // 1. Pure AMOLED #000000 zero floor (0 mW base)
            half3 col = half3(0.0);
            float2 safe = max(size, float2(1.0));
            float2 uv = p / safe;
            float dpr = max(1.0, safe.x / 380.0);

            // 2. High contrast obsidian #050002 depth gradient along top & bottom edges
            float edgeV = exp(-uv.y * 3.8) * 0.65 + exp(-(1.0 - uv.y) * 4.2) * 0.75;
            col += uObs.rgb * half(edgeV * 0.95);

            // 3. Precision tactical dot-grid (24px) + major 4x4 intersection crosses
            float stepPx = 24.0 * dpr;
            float2 cell = mod(p + stepPx * 0.5, stepPx) - stepPx * 0.5;
            float r = 0.95 * dpr;
            float dotM = 1.0 - smoothstep(r - 0.5, r + 0.5, length(cell));

            float2 idx = floor((p + stepPx * 0.5) / stepPx);
            float isMaj = step(mod(abs(idx.x) + 0.5, 4.0), 1.0)
                        * step(mod(abs(idx.y) + 0.5, 4.0), 1.0);
            float cross = (1.0 - smoothstep(0.0, 1.0 * dpr, abs(cell.x))) * (1.0 - smoothstep(2.5 * dpr, 4.0 * dpr, abs(cell.y)))
                        + (1.0 - smoothstep(0.0, 1.0 * dpr, abs(cell.y))) * (1.0 - smoothstep(2.5 * dpr, 4.0 * dpr, abs(cell.x)));

            // 4. Analytical obsidian hex lattice (32px)
            float he = hexEdge(p / (32.0 * dpr));
            float hexLine = 1.0 - smoothstep(0.015, 0.055, he);

            // 5. Crisp high-contrast tactical composition
            half3 acc = mix(uCol.rgb, uHot.rgb, half(0.35));
            col += acc * half(dotM * (0.045 + isMaj * 0.08) + isMaj * min(cross, 1.0) * 0.04 + hexLine * 0.038);

            // 6. Left and right edge subtle high-contrast energy rails
            float edgeDist = min(p.x, safe.x - p.x) / dpr;
            float rimLine = exp(-edgeDist * 0.65);
            col += uCol.rgb * half(rimLine * 0.12);

            return half4(col, 1.0);
          }
        """
      }
    }

    // ==================== LAYER 1: MAIN HOME SCREEN UI ====================
    Column {
      fill: true
      padding: [sidePad, 12, sidePad, 56]
      gap: 0

      // Top 5-Panel Sculpted Obsidian Synth/Drum Strip (secret sequence 1-3-5-1-3-5 opens the hidden vault screen)
      Row {
        fill: width
        height: 54
        gap: cgSlotGap
        for p in drumPads key p.idx {
          let active = lastPad == p.idx
          Box {
            scale: tapBounce == "3${p.idx}" ? 0.9 : 1
            offset: [0, tapBounce == "3${p.idx}" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "3${p.idx}"
            onRelease: tapBounce = ""
            weight: 1
            fill: height
            radius: hulkOn ? 3 * corners : (skelOn ? 4 * corners : (maskOn ? 22 * corners : (faustOn ? 6 * corners : (futOn ? 2 * corners : 10 * corners * hubRadius))))
            clip: true
            ripple: false
            background: linear(0, 0, 0, 1, [
              alpha(p.col, active ? 0.42 : 0.19),
              cObs,
              cDeep,
              alpha(p.col, active ? 0.28 : 0.10)
            ])
            border: active ? 1.35 : 1
            borderColor: alpha(p.col, active ? 1.0 : (0.56 + breathe * 0.24))
            align: center
            onTap: {
              if infFxOn {
                let px = sidePad + (cgW - cgSlotGap * 4) / 5 * (p.idx + 0.5) + cgSlotGap * p.idx
                let py = 39
                impacts = [
                  { x: px, y: py, t: fxT, seed: impSeq * 1.91 + p.idx * 0.7, pwr: 1.15 },
                  impacts[0], impacts[1], impacts[2], impacts[3], impacts[4]
                ]
                impSeq = impSeq + 1
              }
              lastPad = p.idx
              if animHaptics { haptic() }
              let next = combo + p.num
              let trimmed = len(next) > 6 ? sub(next, len(next) - 6, len(next)) : next
              if trimmed == "135135" {
                combo = ""
                scrMode = "vault"
                screen()
              } else if trimmed == "234234" {
                combo = ""
                portalT = 0
                portalFired = false
                scrMode = "portal98"
                screen()
              } else {
                combo = trimmed
              }
            }
            Canvas {
              fill: true
              let w = width
              let h = height
              let padPulse = fxLive ? 0.5 + 0.5 * sin(fxT * 3.0 + p.idx * 0.9) : 0.52
              // Ambient recessed obsidian pad glow
              circle(w / 2, h / 2, max(w, h) * (active ? 0.74 : 0.52), fill: radial(w / 2, h / 2, max(w, h) * 0.72, [
                alpha(p.col, active ? 0.46 : (0.14 + padPulse * 0.08 + surge * 0.20)),
                alpha(#000000, 0)
              ]))
              // Sculpted recessed inner bevel frame
              rect(3.5, 4.5, w - 7, h - 9, radius: 5, stroke: alpha(p.col, active ? 0.48 : 0.18), width: 0.8)
              // Top luminous specular energy rail + hot core
              line(8, 2.2, w - 8, 2.2, stroke: alpha(p.col, active ? 1.0 : (0.72 + padPulse * 0.26)), width: active ? 2.6 : 1.8, cap: round)
              line(w * 0.3, 2.2, w * 0.7, 2.2, stroke: alpha(cHot, active ? 0.92 : 0.48), width: 1.0, cap: round)
              // Bottom counter-rail
              line(12, h - 2.2, w - 12, h - 2.2, stroke: alpha(p.col, active ? 0.78 : (0.28 + padPulse * 0.16)), width: 1.0, cap: round)
              // Center sculpted diamond percussion node
              let dr = active ? 4.4 : (2.6 + padPulse * 0.7)
              path([[w / 2, h / 2 - dr], [w / 2 + dr, h / 2], [w / 2, h / 2 + dr], [w / 2 - dr, h / 2]], closed: true, fill: active ? cHot : alpha(p.col, 0.85 + padPulse * 0.15))
              if active {
                circle(w / 2, h / 2, 10.0 + padPulse * 2.5, stroke: alpha(cHot, 0.62), width: 1.1)
              }
            }
          }
        }
      }

      Spacer { height: 12 }

      // Top liturgical 4-Theme crest with tapered diamond filigree
      Row {
        fill: width
        align: center
        gap: 10
        Box { weight: 1; height: 1.2; background: linear(0, 0, 1, 0, [alpha(cPri, 0), alpha(cDim, 0.55), alpha(cHot, 0.65 + breathe * 0.25 + surge * 0.1)]) }
        Text {
          font: dispFont
          text: tc.crown ?? (skelOn ? "☩  THE HAVOC CROWN  ☩" : maskOn ? "✦  THE MASK  ✦" : futOn ? "◈  THE AETHER CROWN  ◈" : "✦  THE CINDER CROWN  ✦")
          fontSize: 11.5
          maxLines: 1
          color: skelOn ? mix(cHot, cBone, 0.35 + surge * 0.45) : maskOn ? mix(#24ff68, #ffe135, 0.32 + surge * 0.45 + breathe * 0.15) : mix(cMid, cHot, surge * 0.55 + breathe * 0.22)
          letterSpacing: 2.2
          bold: true
        }
        Box { weight: 1; height: 1.2; background: linear(0, 0, 1, 0, [alpha(cHot, 0.65 + breathe * 0.25 + surge * 0.1), alpha(cDim, 0.55), alpha(cPri, 0)]) }
      }
      Spacer { height: 4 }
      Text {
        font: uiFont
        text: ecoOn ? (tc.ecoSub ?? "CHILL SANCTUM  ·  SUPER FAST ECO") : (tc.sub ?? "OBSIDIAN SANCTUM  ·  SITH ORDER")
        fontSize: 9.5
        maxLines: 1
        color: ecoOn ? cMuted : mix(cMuted, cHot, surge * 0.45)
        letterSpacing: 1.8
        align: center
        fill: width
      }

      Spacer { weight: 1 }

      // Hulk Brutalist Split Gamma Reactor Top Block (clock + controls live at top above the Titan)
      if hulkOn {
        Box {
          fill: width
          radius: 4 * corners
          padding: [12, 10]
          border: 1.8
          borderColor: alpha(#2bff4a, 0.85)
          background: linear(0, 0, 1, 1, [#0a1f0e, #030804])
          Row {
            fill: width
            align: center
            gap: 10
            Column {
              weight: 1.25
              gap: 2
              Text {
                spans: [
                  fmtTime(now, "HH"),
                  { text: ":", color: ecoOn ? #2bff4a : alpha(#c8ff2e, fxLive ? (0.58 + 0.42 * (0.5 + 0.5 * sin(fxT * 3.14))) : 0.95) },
                  fmtTime(now, "mm")
                ]
                font: dispFont
                fontSize: 44
                bold: true
                letterSpacing: 1.5
                color: ecoOn ? #2bff4a : #c8ff2e
                maxLines: 1
              }
              Text {
                font: uiFont
                text: upper(fmtTime(now, "EEEE  ·  d MMM"))
                fontSize: 9.5
                maxLines: 1
                color: #9cf5aa
                letterSpacing: 1.3
              }
              Text {
                font: uiFont
                text: ecoOn ? "☢ GAMMA OVERLOAD · ECO" : "☢ GAMMA OVERLOAD"
                fontSize: 9.5
                maxLines: 1
                bold: true
                color: #9b30ff
                letterSpacing: 1.5
              }
            }
            Column {
              weight: 1
              gap: 5
              Row {
                scale: tapBounce == "6" ? 0.92 : 1
                offset: [0, tapBounce == "6" ? -3 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "6"
                onRelease: tapBounce = ""
                fill: width
                align: center
                justify: center
                padding: [8, 5]
                radius: 4 * corners
                background: ecoOn ? #030804 : linear(0, 0, 1, 0, [alpha(#2bff4a, 0.22), #051408])
                border: 1.2
                borderColor: low ? #ff3850 : alpha(#2bff4a, 0.85)
                onTap: {
                  if animHaptics { haptic() }
                  run("owl-hub eco ${ecoOn ? 'false' : 'true'}")
                }
                Text {
                  font: uiFont
                  text: ecoOn ? "${level}% · ECO" : "${level}% · SMASH"
                  fontSize: 9.5
                  bold: true
                  maxLines: 1
                  align: center
                  color: low ? #ff3850 : (ecoOn ? #2bff4a : #c8ff2e)
                  letterSpacing: 1.0
                }
              }
              Row {
                scale: tapBounce == "4" ? 0.92 : 1
                offset: [0, tapBounce == "4" ? -3 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "4"
                onRelease: tapBounce = ""
                fill: width
                align: center
                justify: center
                padding: [8, 5]
                radius: 4 * corners
                background: ecoOn ? #030804 : linear(0, 0, 1, 0, [alpha(#9b30ff, 0.28), #0d0418])
                border: 1.2
                borderColor: alpha(#9b30ff, 0.88)
                onTap: {
                  if animHaptics { haptic() }
                  open("o:abaddon-ultron.owl")
                }
                Text {
                  font: uiFont
                  text: "☢ BANNER"
                  fontSize: 9.5
                  bold: true
                  maxLines: 1
                  align: center
                  color: #e4baff
                  letterSpacing: 1.2
                }
              }
              Row {
                scale: tapBounce == "5" ? 0.92 : 1
                offset: [0, tapBounce == "5" ? -3 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "5"
                onRelease: tapBounce = ""
                fill: width
                align: center
                justify: center
                padding: [8, 5]
                radius: 4 * corners
                background: ecoOn ? #030804 : linear(0, 0, 1, 0, [alpha(#2bff4a, 0.16), #040d06])
                border: 1.2
                borderColor: alpha(#c8ff2e, 0.78)
                onTap: {
                  if animHaptics { haptic() }
                  run("owl-send 25-sith-command-deck.owl set forgeReq $(date +%s%N)")
                  launcher("page:0")
                }
                Text {
                  font: uiFont
                  text: "◈ HUB"
                  fontSize: 9.5
                  bold: true
                  maxLines: 1
                  align: center
                  color: #c8ff2e
                  letterSpacing: 1.2
                }
              }
            }
          }
        }
        Spacer { height: 6 }
      }

      // Centerpiece Living Sith Demon / Ultron / Mask / Royal Purple Skeletor (or ultra-light static crest in Eco mode)
      if ecoOn {
        Canvas {
          width: wide ? min(scrW * 0.48, 380) : cgW
          height: sigilH
          fill: width
          ripple: false
          onTap: {
            if animHaptics { haptic() }
            if !briefOpen && !fbBusy {
              run("python3 ~/.local/bin/abaddon-brief.py ${sh(curMode)} ${sh(briefTelemetryJson)}")
            }
            briefOpen = true
          }
          let cx = width / 2
          let cy = height / 2
          let r = min(width, height) * 0.34
          circle(cx, cy, r * 1.05, stroke: alpha(cDim, 0.62), width: 1.0)
          circle(cx, cy, r * 0.88, stroke: alpha(cPri, 0.78), width: 1.4)
          if !maskOn {
            line(cx, cy - r * 1.22, cx, cy - r * 0.92, stroke: alpha(cPri, 0.75), width: 1.2)
            line(cx, cy + r * 0.92, cx, cy + r * 1.22, stroke: alpha(cPri, 0.75), width: 1.2)
          }
          if skelOn {
            // Ultra-light 10-call static Royal Purple Skeletor Eco Crest (0 blurs, pure #000000 OLED)
            let u = r * 0.72
            // Peaked Royal-Purple Hood polygon
            path([[cx, cy - u * 1.04], [cx + u * 0.70, cy - u * 0.42], [cx + u * 0.80, cy + u * 0.16], [cx + u * 0.50, cy + u * 0.90], [cx, cy + u * 0.96], [cx - u * 0.50, cy + u * 0.90], [cx - u * 0.80, cy + u * 0.16], [cx - u * 0.70, cy - u * 0.42]], closed: true, fill: #0d021a, stroke: #9d4edd, width: 1.35)
            // Crisp Bone-Ivory Skull silhouette
            path([[cx, cy - u * 0.66], [cx + u * 0.44, cy - u * 0.36], [cx + u * 0.52, cy + u * 0.08], [cx + u * 0.30, cy + u * 0.34], [cx + u * 0.32, cy + u * 0.56], [cx, cy + u * 0.80], [cx - u * 0.32, cy + u * 0.56], [cx - u * 0.30, cy + u * 0.34], [cx - u * 0.52, cy + u * 0.08], [cx - u * 0.44, cy - u * 0.36]], closed: true, fill: #05010a, stroke: #b8aa82, width: 1.3)
            // Twin V-pitched ocular fire triangles
            path([[cx - u * 0.38, cy - u * 0.10], [cx - u * 0.12, cy - u * 0.01], [cx - u * 0.24, cy + u * 0.10]], closed: true, fill: #c85cff)
            path([[cx + u * 0.38, cy - u * 0.10], [cx + u * 0.12, cy - u * 0.01], [cx + u * 0.24, cy + u * 0.10]], closed: true, fill: #c85cff)
            // Inverted-spade nasal void
            path([[cx, cy + u * 0.06], [cx + u * 0.08, cy + u * 0.24], [cx - u * 0.08, cy + u * 0.24]], closed: true, stroke: #b8aa82, width: 0.95)
            // Horizontal skeletal grin + 3 vertical tooth slits
            line(cx - u * 0.28, cy + u * 0.46, cx + u * 0.28, cy + u * 0.46, stroke: #b8aa82, width: 1.15, cap: round)
            line(cx, cy + u * 0.38, cx, cy + u * 0.56, stroke: #b8aa82, width: 1.05)
            line(cx - u * 0.14, cy + u * 0.39, cx - u * 0.14, cy + u * 0.55, stroke: #b8aa82, width: 1.0)
            line(cx + u * 0.14, cy + u * 0.39, cx + u * 0.14, cy + u * 0.55, stroke: #b8aa82, width: 1.0)
          } else if maskOn {
            // Ultra-light smooth classic The Mask face in Eco mode
            let u = r * 0.74
            path([
              [cx, cy - u * 0.56], [cx + u * 0.36, cy - u * 0.50], [cx + u * 0.54, cy - u * 0.24],
              [cx + u * 0.58, cy + u * 0.06], [cx + u * 0.52, cy + u * 0.38], [cx + u * 0.38, cy + u * 0.66],
              [cx + u * 0.20, cy + u * 0.85], [cx, cy + u * 0.90], [cx - u * 0.20, cy + u * 0.85],
              [cx - u * 0.38, cy + u * 0.66], [cx - u * 0.52, cy + u * 0.38], [cx - u * 0.58, cy + u * 0.06],
              [cx - u * 0.54, cy - u * 0.24], [cx - u * 0.36, cy - u * 0.50]
            ], closed: true, fill: #063815, stroke: #1aff5c, width: 1.5)
            path([[cx - u * 0.44, cy - u * 0.22], [cx - u * 0.27, cy - u * 0.34], [cx - u * 0.10, cy - u * 0.20]], stroke: #b8ff66, width: 1.7, cap: round)
            path([[cx + u * 0.10, cy - u * 0.21], [cx + u * 0.28, cy - u * 0.37], [cx + u * 0.46, cy - u * 0.23]], stroke: #b8ff66, width: 1.7, cap: round)
            circle(cx - u * 0.26, cy - u * 0.10, u * 0.10, fill: #f4fff4)
            circle(cx + u * 0.26, cy - u * 0.10, u * 0.10, fill: #f4fff4)
            circle(cx - u * 0.26, cy - u * 0.10, u * 0.045, fill: #021206)
            circle(cx + u * 0.26, cy - u * 0.10, u * 0.045, fill: #021206)
            path([
              [cx - u * 0.46, cy + u * 0.22], [cx - u * 0.24, cy + u * 0.34], [cx, cy + u * 0.38],
              [cx + u * 0.24, cy + u * 0.34], [cx + u * 0.46, cy + u * 0.22], [cx + u * 0.38, cy + u * 0.50],
              [cx + u * 0.18, cy + u * 0.62], [cx, cy + u * 0.65], [cx - u * 0.18, cy + u * 0.62], [cx - u * 0.38, cy + u * 0.50]
            ], closed: true, fill: #f6fff4, stroke: #1aff5c, width: 1.2)
            path([[cx - u * 0.40, cy + u * 0.39], [cx, cy + u * 0.50], [cx + u * 0.40, cy + u * 0.39]], stroke: #04240d, width: 1.2, cap: round)
            rotate(-6, cx, cy - u * 0.50) {
              path([[cx - u * 0.90, cy - u * 0.42], [cx - u * 0.46, cy - u * 0.54], [cx, cy - u * 0.57], [cx + u * 0.46, cy - u * 0.54], [cx + u * 0.90, cy - u * 0.42], [cx + u * 0.60, cy - u * 0.36], [cx, cy - u * 0.42], [cx - u * 0.60, cy - u * 0.36]], closed: true, fill: #3b2d03, stroke: #ffe135, width: 1.5)
              path([[cx - u * 0.50, cy - u * 0.50], [cx - u * 0.42, cy - u * 0.88], [cx - u * 0.24, cy - u * 1.05], [cx, cy - u * 0.97], [cx + u * 0.24, cy - u * 1.05], [cx + u * 0.42, cy - u * 0.88], [cx + u * 0.50, cy - u * 0.50]], closed: true, fill: #292002, stroke: #ffe135, width: 1.5)
              line(cx - u * 0.49, cy - u * 0.56, cx + u * 0.49, cy - u * 0.56, stroke: #071209, width: 4.5, cap: round)
            }
          } else if hulkOn {
            let u = r * 0.72
            path([[cx - u * 0.62, cy - u * 0.54], [cx + u * 0.62, cy - u * 0.54], [cx + u * 0.72, cy + u * 0.14], [cx + u * 0.48, cy + u * 0.76], [cx - u * 0.48, cy + u * 0.76], [cx - u * 0.72, cy + u * 0.14]], closed: true, fill: #030804, stroke: #2bff4a, width: 1.5)
            path([[cx - u * 0.46, cy - u * 0.14], [cx - u * 0.12, cy - u * 0.06], [cx - u * 0.18, cy + u * 0.04], [cx - u * 0.42, cy - u * 0.02]], closed: true, fill: #c8ff2e)
            path([[cx + u * 0.46, cy - u * 0.14], [cx + u * 0.12, cy - u * 0.06], [cx + u * 0.18, cy + u * 0.04], [cx + u * 0.42, cy - u * 0.02]], closed: true, fill: #c8ff2e)
          } else if faustOn {
            // Ultra-light static Outrun sliced sun + cyber visor silhouette in Eco mode (7 draw calls)
            let u = r * 0.74
            circle(cx, cy - u * 0.06, u * 0.82, fill: linear(cx, cy - u * 0.88, cx, cy + u * 0.76, [#d99218, #c424b2, #420c56]))
            line(cx - u * 0.78, cy + u * 0.16, cx + u * 0.78, cy + u * 0.16, stroke: #05000e, width: 3.0)
            line(cx - u * 0.68, cy + u * 0.36, cx + u * 0.68, cy + u * 0.36, stroke: #05000e, width: 4.0)
            line(cx - u * 0.88, cy + u * 0.56, cx + u * 0.88, cy + u * 0.56, stroke: #00f0ff, width: 1.5, cap: round)
            path([[cx - u * 0.66, cy - u * 0.18], [cx + u * 0.66, cy - u * 0.18], [cx + u * 0.56, cy + u * 0.14], [cx + u * 0.14, cy + u * 0.14], [cx, cy + u * 0.03], [cx - u * 0.14, cy + u * 0.14], [cx - u * 0.56, cy + u * 0.14]], closed: true, fill: #070012, stroke: #00f0ff, width: 1.7)
            line(cx - u * 0.44, cy - u * 0.12, cx - u * 0.30, cy + u * 0.08, stroke: #ffaa00, width: 1.8, cap: round)
            line(cx + u * 0.22, cy - u * 0.12, cx + u * 0.36, cy + u * 0.08, stroke: #ff2ae6, width: 1.8, cap: round)
          } else if !futOn {
            circle(cx, cy, r * 0.52, stroke: alpha(#661220, 0.45), width: 1.0)
            circle(cx, cy, r * 0.20, fill: #0a0103, stroke: #b8263a, width: 1.2)
            circle(cx + r * 0.08, cy - r * 0.04, r * 0.16, fill: #000000)
          } else {
            // Ultra-light static Ultron visor crest in Eco mode
            let u = r * 0.70
            path([[cx - u * 0.50, cy - u * 0.34], [cx - u * 0.68, cy - u * 0.44], [cx - u * 0.78, cy - u * 0.66], [cx - u * 0.70, cy + u * 0.12], [cx - u * 0.52, cy + u * 0.22]], closed: true, fill: #020c12, stroke: #2696b8, width: 1.05)
            path([[cx + u * 0.50, cy - u * 0.34], [cx + u * 0.68, cy - u * 0.44], [cx + u * 0.78, cy - u * 0.66], [cx + u * 0.70, cy + u * 0.12], [cx + u * 0.52, cy + u * 0.22]], closed: true, fill: #020c12, stroke: #2696b8, width: 1.05)
            path([[cx, cy - u * 0.94], [cx + u * 0.30, cy - u * 0.87], [cx + u * 0.52, cy - u * 0.60], [cx + u * 0.58, cy + u * 0.04], [cx + u * 0.38, cy + u * 0.68], [cx, cy + u * 0.94], [cx - u * 0.38, cy + u * 0.68], [cx - u * 0.58, cy + u * 0.04], [cx - u * 0.52, cy - u * 0.60], [cx - u * 0.30, cy - u * 0.87]], closed: true, fill: #01080c, stroke: #2696b8, width: 1.3)
            path([[cx - u * 0.48, cy - u * 0.16], [cx - u * 0.11, cy - u * 0.05], [cx - u * 0.16, cy + u * 0.05], [cx - u * 0.43, cy - u * 0.03]], closed: true, fill: #38d6ff)
            path([[cx + u * 0.48, cy - u * 0.16], [cx + u * 0.11, cy - u * 0.05], [cx + u * 0.16, cy + u * 0.05], [cx + u * 0.43, cy - u * 0.03]], closed: true, fill: #38d6ff)
            path([[cx - u * 0.42, cy + u * 0.32], [cx - u * 0.20, cy + u * 0.40], [cx, cy + u * 0.35], [cx + u * 0.20, cy + u * 0.40], [cx + u * 0.42, cy + u * 0.32], [cx + u * 0.34, cy + u * 0.52], [cx, cy + u * 0.49], [cx - u * 0.34, cy + u * 0.52]], closed: true, fill: alpha(#22d1ff, 0.50), stroke: #38d6ff, width: 1.0)
            line(cx, cy + u * 0.34, cx, cy + u * 0.50, stroke: #01080c, width: 2.0)
            line(cx - u * 0.18, cy + u * 0.38, cx - u * 0.16, cy + u * 0.52, stroke: #01080c, width: 1.8)
            line(cx + u * 0.18, cy + u * 0.38, cx + u * 0.16, cy + u * 0.52, stroke: #01080c, width: 1.8)
          }
        }
      } else {
      Canvas {
        width: wide ? min(scrW * 0.48, 380) : cgW
        height: sigilH
        fill: width
        ripple: false
        onTap: {
          // face tap: no electric impact burst (removed on request) — haptic + brief only
          if animHaptics { haptic() }
          if !briefOpen && !fbBusy {
            run("python3 ~/.local/bin/abaddon-brief.py ${sh(curMode)} ${sh(briefTelemetryJson)}")
          }
          briefOpen = true
        }

        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) * 0.40
        let p = fxLive ? 0.5 + 0.5 * sin(fxT * 2.2) : 0.48
        let fastP = fxLive ? 0.5 + 0.5 * sin(fxT * 7.5) : 0.5

        if !maskOn {
          // Layered volumetric Kyber core aura (broad velvet bloom + focused hot center)
          circle(cx, cy, r * (1.46 + p * 0.10 + surge * 0.22), fill: radial(cx, cy, r * (1.46 + p * 0.10 + surge * 0.22), [
            alpha(cPri, 0.34 + p * 0.14 + surge * 0.34),
            alpha(cDim, 0.16 + surge * 0.16),
            alpha(#000000, 0)
          ]))
          // Recessed sculpted obsidian temple medallion plate (adds real 3D relief over hex wall)
          circle(cx, cy, r * 1.02, fill: radial(cx, cy - r * 0.22, r * 1.15, [
            alpha(cDeep, 0.72),
            alpha(#000000, 0.86),
            alpha(cDim, 0.18)
          ]))
          // Top-left specular glass-metal bezel glint on the medallion rim
          arc(cx, cy, r * 1.02, -55, 110, stroke: alpha(cHot, 0.45 + p * 0.15 + surge * 0.25), width: 1.4, cap: round)

          // Vertical axis: Havoc Staff ram-horn finial in Skeletor mode, saber-rift spear in Infernal/Future
          let spearGlow = 0.76 + p * 0.24
          line(cx, cy - r * 1.33, cx, cy - r * 1.04, stroke: alpha(cPri, spearGlow * 0.45), width: 4.2 + surge * 1.8, cap: round)
          line(cx, cy + r * 1.04, cx, cy + r * 1.33, stroke: alpha(cPri, spearGlow * 0.45), width: 4.2 + surge * 1.8, cap: round)
          line(cx, cy - r * 1.33, cx, cy - r * 1.04, stroke: alpha(cHot, spearGlow), width: 1.5 + surge * 0.9, cap: round)
          line(cx, cy + r * 1.04, cx, cy + r * 1.33, stroke: alpha(cHot, spearGlow), width: 1.5 + surge * 0.9, cap: round)
          if skelOn {
            // Upper Havoc Staff Orb cradled by twin bone-ivory ram-horn prongs
            circle(cx, cy - r * 1.33, 9.5 + surge * 3.5, fill: radial(cx, cy - r * 1.33, 12, [alpha(#e82cff, 0.75 + p * 0.20), alpha(#b44aff, 0.25), alpha(#000000, 0)]))
            path([[cx - 12, cy - r * 1.38], [cx - 6, cy - r * 1.29], [cx, cy - r * 1.26], [cx + 6, cy - r * 1.29], [cx + 12, cy - r * 1.38]], stroke: #f4e6be, width: 1.9, cap: round)
            circle(cx, cy - r * 1.33, 4.2, fill: #e82cff, stroke: #f4e6be, width: 0.9)
            circle(cx - 1.0, cy - r * 1.34, 1.5, fill: #fff6ff)
            // Lower spiked violet lance pommel with bone-ivory diamond
            path([[cx, cy + r * 1.24], [cx + 5.6, cy + r * 1.33], [cx, cy + r * 1.43], [cx - 5.6, cy + r * 1.33]], closed: true, fill: #4d127a, stroke: #eb9eff, width: 1.2)
            path([[cx, cy + r * 1.29], [cx + 2.5, cy + r * 1.33], [cx, cy + r * 1.37], [cx - 2.5, cy + r * 1.33]], closed: true, fill: #f4e6be)
          } else {
            path([[cx, cy - r * 1.40], [cx + 4.8, cy - r * 1.33], [cx, cy - r * 1.26], [cx - 4.8, cy - r * 1.33]], closed: true, fill: mix(cMid, cHot, 0.4 + surge * 0.6))
            path([[cx, cy + r * 1.26], [cx + 4.8, cy + r * 1.33], [cx, cy + r * 1.40], [cx - 4.8, cy + r * 1.33]], closed: true, fill: mix(cMid, cHot, 0.4 + surge * 0.6))
          }

          // Counter-rotating concentric Sith astrolabe rings
          circle(cx, cy, r * 1.15, stroke: alpha(cDim, 0.42 + surge * 0.22), width: 0.85)
          circle(cx, cy, r * 1.11, stroke: alpha(cDim, 0.68 + surge * 0.25), width: 1.1)
          circle(cx, cy, r * 1.02, stroke: alpha(cPri, 0.82 + p * 0.18), width: 1.65)
          circle(cx, cy, r * 0.94, stroke: alpha(cDim, 0.85), width: 1.0)
          circle(cx, cy, r * 0.62, stroke: alpha(cPri, 0.30 + p * 0.18 + surge * 0.3), width: 1.05)

          // Sweeping luminous holocron radar arcs (static sculptural arcs when FX OFF, animated when ON)
          let arcA = fxLive ? (fxT * 42) % 360 : 32
          let arcB = fxLive ? (360 - (fxT * 28) % 360) : 210
          arc(cx, cy, r * 1.11, arcA, 68, stroke: alpha(cMid, (fxLive ? 0.76 : 0.48) + surge * 0.24), width: 2.2, cap: round)
          arc(cx, cy, r * 1.11, arcA + 180, 68, stroke: alpha(cMid, (fxLive ? 0.76 : 0.48) + surge * 0.24), width: 2.2, cap: round)
          arc(cx, cy, r * 0.62, arcB, 95, stroke: alpha(cHot, (fxLive ? 0.52 : 0.34) + surge * 0.4), width: 1.5, cap: round)

          // 36 precision astrolabe ticks (slow sinister rotation)
          let outerRot = fxLive ? fxT * 5.5 : 0
          for i in range(36) {
            let major = i % 3 == 0
            let cardinal = i % 9 == 0
            let outer = r * (cardinal ? 1.15 : major ? 1.07 : 1.02)
            let inner = r * (cardinal ? 0.91 : major ? 0.94 : 0.97)
            rotate(i * 10 + outerRot, cx, cy) {
              line(cx, cy - outer, cx, cy - inner, stroke: cardinal ? cHot : major ? alpha(cMid, 0.78) : alpha(cDim, 0.66), width: cardinal ? 2.2 : major ? 1.3 : 0.85, cap: round)
            }
          }
        }

        if hulkOn {
          // ==================== HULK GAMMA OVERLOAD (SCULPTED GAMMA TITAN & RADIATION FISSURES) ====================
          let u = r * 0.78
          let gRot = fxLive ? fxT * 18 : 0
          let gGlow = alpha(#2bff4a, 0.24 + p * 0.16 + surge * 0.26)

          // 1. Multi-Ring Gamma Containment Halo & Rotating Bio-Radiation Arcs
          circle(cx, cy, r * 0.93, stroke: gGlow, width: 10.0 + surge * 4)
          circle(cx, cy, r * 0.93, stroke: #2bff4a, width: 1.8)
          circle(cx, cy, r * 0.85, stroke: alpha(#c8ff2e, 0.35), width: 1.0)
          for k in range(3) {
            arc(cx, cy, r * 0.89, k * 120 + gRot, 54, stroke: alpha(#c8ff2e, 0.78), width: 2.8, cap: round)
            arc(cx, cy, r * 0.78, k * 120 + 60 - gRot * 0.7, 42, stroke: alpha(#9b30ff, 0.65), width: 2.2, cap: round)
          }
          // Jagged Bruised-Purple & Lime Gamma Fissure Cracks
          for k in range(6) {
            let a = rad(k * 60 + 22)
            let midA = rad(k * 60 + 28)
            path([
              [cx + cos(a) * r * 0.62, cy + sin(a) * r * 0.62],
              [cx + cos(midA) * r * 0.78, cy + sin(midA) * r * 0.78],
              [cx + cos(a) * r * 0.96, cy + sin(a) * r * 0.96]
            ], stroke: k % 2 == 0 ? #9b30ff : #c8ff2e, width: 2.0, cap: round)
          }

          // 2. Massive Trapezius / Neck Collar Silhouette
          path([[cx - u * 0.72, cy + u * 0.84], [cx - u * 0.44, cy + u * 0.52], [cx + u * 0.44, cy + u * 0.52], [cx + u * 0.72, cy + u * 0.84]], closed: true, fill: linear(cx, cy + u * 0.5, cx, cy + u * 0.88, [#0d2912, #030804]), stroke: alpha(#2bff4a, 0.65), width: 1.4)

          // 3. Sculpted Hulk Head & Broad Chiseled Jaw
          path([
            [cx - u * 0.60, cy - u * 0.44], [cx - u * 0.68, cy - u * 0.08], [cx - u * 0.72, cy + u * 0.24],
            [cx - u * 0.56, cy + u * 0.64], [cx - u * 0.24, cy + u * 0.82], [cx, cy + u * 0.86],
            [cx + u * 0.24, cy + u * 0.82], [cx + u * 0.56, cy + u * 0.64], [cx + u * 0.72, cy + u * 0.24],
            [cx + u * 0.68, cy - u * 0.08], [cx + u * 0.60, cy - u * 0.44]
          ], closed: true, fill: linear(cx, cy - u * 0.5, cx, cy + u * 0.88, [#123819, #07170a, #030804]), stroke: #2bff4a, width: 2.2)

          // 4. Layered Wild Craggy Hair Crown (Obsidian-Emerald with Lime Rim)
          path([
            [cx - u * 0.64, cy - u * 0.34], [cx - u * 0.68, cy - u * 0.62], [cx - u * 0.48, cy - u * 0.84],
            [cx - u * 0.26, cy - u * 0.76], [cx - u * 0.08, cy - u * 0.92], [cx + u * 0.14, cy - u * 0.80],
            [cx + u * 0.36, cy - u * 0.90], [cx + u * 0.58, cy - u * 0.72], [cx + u * 0.66, cy - u * 0.46],
            [cx + u * 0.56, cy - u * 0.30], [cx + u * 0.30, cy - u * 0.46], [cx, cy - u * 0.36],
            [cx - u * 0.30, cy - u * 0.46]
          ], closed: true, fill: #040d06, stroke: #2bff4a, width: 1.8)
          // Hair lock highlights
          path([[cx - u * 0.44, cy - u * 0.78], [cx - u * 0.30, cy - u * 0.50]], stroke: alpha(#c8ff2e, 0.55), width: 1.4, cap: round)
          path([[cx + u * 0.32, cy - u * 0.84], [cx + u * 0.24, cy - u * 0.50]], stroke: alpha(#c8ff2e, 0.55), width: 1.4, cap: round)

          // 5. Cheekbone & Temple Sculpting Facets
          path([[cx - u * 0.62, cy + u * 0.08], [cx - u * 0.40, cy + u * 0.22], [cx - u * 0.50, cy + u * 0.56]], stroke: alpha(#2bff4a, 0.45), width: 1.4)
          path([[cx + u * 0.62, cy + u * 0.08], [cx + u * 0.40, cy + u * 0.22], [cx + u * 0.50, cy + u * 0.56]], stroke: alpha(#2bff4a, 0.45), width: 1.4)

          // 6. Heavy Furrowed Brow Ridge & Nose Bridge
          path([[cx - u * 0.56, cy - u * 0.24], [cx - u * 0.14, cy - u * 0.08], [cx, cy - u * 0.18], [cx + u * 0.14, cy - u * 0.08], [cx + u * 0.56, cy - u * 0.24]], stroke: #c8ff2e, width: 3.4, cap: round)
          path([[cx - u * 0.10, cy - u * 0.06], [cx - u * 0.14, cy + u * 0.16], [cx, cy + u * 0.22], [cx + u * 0.14, cy + u * 0.16], [cx + u * 0.10, cy - u * 0.06]], stroke: alpha(#2bff4a, 0.80), width: 1.6)
          // Flared nostrils
          circle(cx - u * 0.08, cy + u * 0.17, 2.2, fill: #020503)
          circle(cx + u * 0.08, cy + u * 0.17, 2.2, fill: #020503)

          // 7. Blazing Radioactive Lime Eyes (Outer Aura + Iris + White-Hot Core)
          path([[cx - u * 0.48, cy - u * 0.13], [cx - u * 0.13, cy - u * 0.03], [cx - u * 0.18, cy + u * 0.08], [cx - u * 0.44, cy + u * 0.02]], closed: true, fill: alpha(#2bff4a, 0.35), stroke: #2bff4a, width: 2.8)
          path([[cx - u * 0.45, cy - u * 0.10], [cx - u * 0.16, cy - u * 0.02], [cx - u * 0.20, cy + u * 0.06], [cx - u * 0.41, cy + u * 0.01]], closed: true, fill: #c8ff2e)
          circle(cx - u * 0.28, cy - u * 0.02, 2.6, fill: #ffffff)

          path([[cx + u * 0.48, cy - u * 0.13], [cx + u * 0.13, cy - u * 0.03], [cx + u * 0.18, cy + u * 0.08], [cx + u * 0.44, cy + u * 0.02]], closed: true, fill: alpha(#2bff4a, 0.35), stroke: #2bff4a, width: 2.8)
          path([[cx + u * 0.45, cy - u * 0.10], [cx + u * 0.16, cy - u * 0.02], [cx + u * 0.20, cy + u * 0.06], [cx + u * 0.41, cy + u * 0.01]], closed: true, fill: #c8ff2e)
          circle(cx + u * 0.28, cy - u * 0.02, 2.6, fill: #ffffff)

          // 8. Roaring Clenched Jaw & Detailed Teeth
          path([[cx - u * 0.44, cy + u * 0.32], [cx, cy + u * 0.28], [cx + u * 0.44, cy + u * 0.32], [cx + u * 0.38, cy + u * 0.60], [cx, cy + u * 0.64], [cx - u * 0.38, cy + u * 0.60]], closed: true, fill: #030804, stroke: #2bff4a, width: 2.0)
          path([[cx - u * 0.38, cy + u * 0.36], [cx + u * 0.38, cy + u * 0.36], [cx + u * 0.34, cy + u * 0.56], [cx - u * 0.34, cy + u * 0.56]], closed: true, fill: #e8ffe8)
          line(cx - u * 0.38, cy + u * 0.46, cx + u * 0.38, cy + u * 0.46, stroke: #030804, width: 2.4)
          for t in range(5) {
            let tx = cx + (t - 2) * u * 0.14
            line(tx, cy + u * 0.35, tx, cy + u * 0.57, stroke: #07170a, width: 1.6)
          }
          // Chin cleft
          line(cx, cy + u * 0.68, cx, cy + u * 0.80, stroke: alpha(#c8ff2e, 0.55), width: 1.6, cap: round)
        } else if faustOn {
          // ==================== PLUTO · DOKTOR FAUST (OUTRUN SLICED SUN & CYBER-VISOR PORTRAIT) ====================
          let u = r * 0.78
          let fRot = fxLive ? fxT * 22 : 0

          // 1. Rotating Concentric Magenta/Cyan Outrun Chrome Rings
          circle(cx, cy, r * 0.94, stroke: alpha(#ff2ae6, 0.26 + p * 0.16 + surge * 0.26), width: 9.0 + surge * 4)
          arc(cx, cy, r * 0.94, fRot, 145, stroke: #ff2ae6, width: 2.4, cap: round)
          arc(cx, cy, r * 0.94, fRot + 180, 145, stroke: #00f0ff, width: 2.2, cap: round)
          arc(cx, cy, r * 0.85, -fRot * 1.35, 110, stroke: alpha(#ffaa00, 0.85), width: 1.8, cap: round)
          arc(cx, cy, r * 0.85, 180 - fRot * 1.35, 110, stroke: alpha(#00f0ff, 0.72), width: 1.6, cap: round)
          circle(cx, cy, r * 0.79, stroke: alpha(#f7e8ff, 0.20), width: 0.9)

          // 2. Sliced Solar-Gold Outrun Sunset Disc behind Portrait
          circle(cx, cy - u * 0.08, u * 0.84, fill: linear(cx, cy - u * 0.92, cx, cy + u * 0.76, [#ffe47a, #ffaa00, #ff2ae6, #5c1076]))
          line(cx - u * 0.82, cy + u * 0.08, cx + u * 0.82, cy + u * 0.08, stroke: #05000e, width: 2.6)
          line(cx - u * 0.78, cy + u * 0.22, cx + u * 0.78, cy + u * 0.22, stroke: #05000e, width: 3.6)
          line(cx - u * 0.69, cy + u * 0.37, cx + u * 0.69, cy + u * 0.37, stroke: #05000e, width: 4.8)
          line(cx - u * 0.54, cy + u * 0.52, cx + u * 0.54, cy + u * 0.52, stroke: #05000e, width: 6.0)

          // 3. Perspective Cyan Laser Grid along the Lower Arc
          line(cx - u * 0.86, cy + u * 0.62, cx + u * 0.86, cy + u * 0.62, stroke: #00f0ff, width: 2.0, cap: round)
          line(cx - u * 0.76, cy + u * 0.75, cx + u * 0.76, cy + u * 0.75, stroke: alpha(#00f0ff, 0.68), width: 1.4, cap: round)
          line(cx - u * 0.56, cy + u * 0.88, cx + u * 0.56, cy + u * 0.88, stroke: alpha(#00f0ff, 0.50), width: 1.2, cap: round)
          for k in range(5) {
            let tx = cx + (k - 2) * u * 0.26
            let bx = cx + (k - 2) * u * 0.42
            line(tx, cy + u * 0.62, bx, cy + u * 0.90, stroke: alpha(#00f0ff, 0.58), width: 1.2)
          }

          // 4. Popped-Collar Synth Jacket & Neck Silhouette with Neon Cyan Lapels
          path([
            [cx - u * 0.74, cy + u * 0.86], [cx - u * 0.54, cy + u * 0.60], [cx - u * 0.44, cy + u * 0.34],
            [cx - u * 0.26, cy + u * 0.54], [cx + u * 0.26, cy + u * 0.54], [cx + u * 0.44, cy + u * 0.34],
            [cx + u * 0.54, cy + u * 0.60], [cx + u * 0.74, cy + u * 0.86], [cx, cy + u * 0.96]
          ], closed: true, fill: linear(cx, cy + u * 0.34, cx, cy + u * 0.96, [#1c0638, #090118, #05000e]), stroke: #ff2ae6, width: 1.9)
          path([[cx - u * 0.42, cy + u * 0.38], [cx - u * 0.22, cy + u * 0.54], [cx - u * 0.08, cy + u * 0.86], [cx - u * 0.22, cy + u * 0.88], [cx - u * 0.46, cy + u * 0.62]], closed: true, fill: #0d0422, stroke: #00f0ff, width: 1.8)
          path([[cx + u * 0.42, cy + u * 0.38], [cx + u * 0.22, cy + u * 0.54], [cx + u * 0.08, cy + u * 0.86], [cx + u * 0.22, cy + u * 0.88], [cx + u * 0.46, cy + u * 0.62]], closed: true, fill: #0d0422, stroke: #00f0ff, width: 1.8)
          path([[cx - u * 0.17, cy + u * 0.34], [cx + u * 0.17, cy + u * 0.34], [cx + u * 0.20, cy + u * 0.58], [cx, cy + u * 0.72], [cx - u * 0.20, cy + u * 0.58]], closed: true, fill: #120424)
          line(cx - u * 0.09, cy + u * 0.76, cx + u * 0.09, cy + u * 0.76, stroke: #ffaa00, width: 1.8, cap: round)

          // 5. Sculpted Doktor Faust Angular Head & Windswept Hair with Magenta Rim-Light
          path([
            [cx - u * 0.39, cy - u * 0.26], [cx - u * 0.41, cy + u * 0.04], [cx - u * 0.33, cy + u * 0.28],
            [cx - u * 0.14, cy + u * 0.48], [cx, cy + u * 0.53], [cx + u * 0.14, cy + u * 0.48],
            [cx + u * 0.33, cy + u * 0.28], [cx + u * 0.41, cy + u * 0.04], [cx + u * 0.39, cy - u * 0.26],
            [cx + u * 0.24, cy - u * 0.46], [cx - u * 0.24, cy - u * 0.46]
          ], closed: true, fill: linear(cx - u * 0.4, cy - u * 0.4, cx + u * 0.4, cy + u * 0.5, [#2a0b4a, #120426, #080114]), stroke: #ff2ae6, width: 1.8)
          path([[cx + u * 0.41, cy + u * 0.04], [cx + u * 0.33, cy + u * 0.28], [cx + u * 0.14, cy + u * 0.48], [cx + u * 0.01, cy + u * 0.53]], stroke: #00f0ff, width: 2.0, cap: round)
          path([
            [cx - u * 0.44, cy - u * 0.14], [cx - u * 0.46, cy - u * 0.44], [cx - u * 0.30, cy - u * 0.68],
            [cx - u * 0.04, cy - u * 0.78], [cx + u * 0.28, cy - u * 0.74], [cx + u * 0.54, cy - u * 0.56],
            [cx + u * 0.41, cy - u * 0.46], [cx + u * 0.56, cy - u * 0.35], [cx + u * 0.43, cy - u * 0.22],
            [cx + u * 0.42, cy - u * 0.08], [cx + u * 0.34, cy - u * 0.24], [cx + u * 0.14, cy - u * 0.38],
            [cx - u * 0.06, cy - u * 0.31], [cx - u * 0.24, cy - u * 0.38], [cx - u * 0.38, cy - u * 0.22]
          ], closed: true, fill: linear(cx, cy - u * 0.78, cx, cy - u * 0.10, [#2c074a, #100221, #05000e]), stroke: #ff2ae6, width: 2.2)
          path([[cx - u * 0.30, cy - u * 0.56], [cx - u * 0.04, cy - u * 0.68], [cx + u * 0.26, cy - u * 0.62], [cx + u * 0.42, cy - u * 0.53]], stroke: #ff9af5, width: 1.9, cap: round)
          path([[cx - u * 0.20, cy - u * 0.46], [cx + u * 0.06, cy - u * 0.54], [cx + u * 0.34, cy - u * 0.42]], stroke: alpha(#ff2ae6, 0.85), width: 1.5, cap: round)
          path([[cx, cy + u * 0.04], [cx - u * 0.04, cy + u * 0.19], [cx + u * 0.05, cy + u * 0.20]], stroke: alpha(#ff5cee, 0.75), width: 1.5, cap: round)

          // 6. Iconic Reflective Cyber-Visor Shades (Cyan-to-Gold Glints) & Confident Smirk
          path([
            [cx - u * 0.49, cy - u * 0.16], [cx - u * 0.20, cy - u * 0.19], [cx, cy - u * 0.16],
            [cx + u * 0.20, cy - u * 0.19], [cx + u * 0.49, cy - u * 0.16], [cx + u * 0.43, cy + u * 0.05],
            [cx + u * 0.30, cy + u * 0.10], [cx + u * 0.12, cy + u * 0.08], [cx, cy + u * 0.01],
            [cx - u * 0.12, cy + u * 0.08], [cx - u * 0.30, cy + u * 0.10], [cx - u * 0.43, cy + u * 0.05]
          ], closed: true, fill: linear(cx - u * 0.48, cy - u * 0.18, cx + u * 0.48, cy + u * 0.10, [#00f0ff, #1d0845, #ff2ae6, #ffaa00]), stroke: #f7e8ff, width: 2.0)
          path([[cx - u * 0.49, cy - u * 0.16], [cx - u * 0.20, cy - u * 0.19], [cx, cy - u * 0.16], [cx + u * 0.20, cy - u * 0.19], [cx + u * 0.49, cy - u * 0.16]], stroke: #00f0ff, width: 2.4, cap: round)
          line(cx - u * 0.36, cy - u * 0.14, cx - u * 0.42, cy + u * 0.04, stroke: alpha(#e8ffff, 0.90), width: 4.0, cap: round)
          line(cx - u * 0.21, cy - u * 0.14, cx - u * 0.27, cy + u * 0.05, stroke: alpha(#ffdd55, 0.85), width: 2.4, cap: round)
          line(cx + u * 0.14, cy - u * 0.14, cx + u * 0.08, cy + u * 0.04, stroke: alpha(#00f0ff, 0.88), width: 3.6, cap: round)
          line(cx + u * 0.30, cy - u * 0.14, cx + u * 0.24, cy + u * 0.05, stroke: alpha(#ffaa00, 0.85), width: 2.2, cap: round)
          path([[cx - u * 0.11, cy + u * 0.32], [cx + u * 0.02, cy + u * 0.33], [cx + u * 0.15, cy + u * 0.27]], stroke: #ffaa00, width: 2.2, cap: round)
          line(cx - u * 0.03, cy + u * 0.38, cx + u * 0.06, cy + u * 0.37, stroke: alpha(#ff2ae6, 0.72), width: 1.3, cap: round)
        } else if skelOn {
          // ==================== ROYAL PURPLE SKELETOR (SNAKE MOUNTAIN HAVOC OVERLORD) ====================
          let u = r * 0.72
          let cowlRim = mix(#b44aff, #eb9eff, 0.28 + surge * 0.52)

          // 1. 8-Point Arcane Octagram Halo (two interlaced squares — distinct from pentagram/hexagon/vortex)
          let sqA = range(5).map(k => [cx + cos(rad(k * 90 - 90)) * r * 0.92, cy + sin(rad(k * 90 - 90)) * r * 0.92])
          let sqB = range(5).map(k => [cx + cos(rad(k * 90 - 45)) * r * 0.92, cy + sin(rad(k * 90 - 45)) * r * 0.92])
          path(sqA, closed: true, stroke: alpha(#b44aff, 0.22 + p * 0.12 + surge * 0.25), width: 9.0 + surge * 4)
          path(sqB, closed: true, stroke: alpha(#b44aff, 0.22 + p * 0.12 + surge * 0.25), width: 9.0 + surge * 4)
          path(sqA, closed: true, stroke: alpha(#c85cff, 0.84 + p * 0.14), width: 1.8)
          path(sqB, closed: true, stroke: alpha(#c85cff, 0.84 + p * 0.14), width: 1.8)
          path(sqA, closed: true, stroke: alpha(#eb9eff, 0.70 + surge * 0.25), width: 0.8)
          path(sqB, closed: true, stroke: alpha(#eb9eff, 0.70 + surge * 0.25), width: 0.8)
          for k in range(8) {
            let vx = cx + cos(rad(k * 45 - 90)) * r * 0.92
            let vy = cy + sin(rad(k * 45 - 90)) * r * 0.92
            circle(vx, vy, 4.2, fill: alpha(#e82cff, 0.28 + surge * 0.24))
            circle(vx, vy, 1.9, fill: #f4e6be)
          }

          // 2. Crackling Amethyst-Magenta Necromancy Lightning along Octagram
          if fxLive {
            let boltStep = floor(fxT * 14)
            let boltCount = animSpeed >= 1.5 || surge > 0.15 ? 3 : 2
            for b in range(boltCount) {
              let idx = (boltStep + b * 3) % 8
              let a1 = rad(idx * 45 - 90)
              let a2 = rad(((idx + 2) % 8) * 45 - 90)
              let x1 = cx + cos(a1) * r * 0.92
              let y1 = cy + sin(a1) * r * 0.92
              let x2 = cx + cos(a2) * r * 0.92
              let y2 = cy + sin(a2) * r * 0.92
              let j1 = (hash(boltStep + b * 17, 3) - 0.5) * 18
              let j2 = (hash(boltStep + b * 17, 7) - 0.5) * 18
              let j3 = (hash(boltStep + b * 17, 11) - 0.5) * 18
              let mx1 = x1 + (x2 - x1) * 0.33 + j1
              let my1 = y1 + (y2 - y1) * 0.33 + j2
              let mx2 = x1 + (x2 - x1) * 0.67 - j2
              let my2 = y1 + (y2 - y1) * 0.67 + j3
              let bAlpha = 0.30 + fastP * 0.35 + surge * 0.35
              path([[x1, y1], [mx1, my1], [mx2, my2], [x2, y2]], stroke: alpha(#b44aff, bAlpha * 0.58), width: 4.4, cap: round)
              path([[x1, y1], [mx1, my1], [mx2, my2], [x2, y2]], stroke: alpha(#f5d6ff, bAlpha), width: 1.1, cap: round)
            }
          }

          // 3. Havoc Ram-Horn Arcane Energy Crest arcing above the peaked cowl
          path([[cx - u * 0.24, cy - u * 0.92], [cx - u * 0.68, cy - u * 1.02], [cx - u * 0.94, cy - u * 0.64], [cx - u * 0.80, cy - u * 0.34]], stroke: alpha(#e82cff, 0.30 + p * 0.16 + surge * 0.25), width: 5.5, cap: round)
          path([[cx + u * 0.24, cy - u * 0.92], [cx + u * 0.68, cy - u * 1.02], [cx + u * 0.94, cy - u * 0.64], [cx + u * 0.80, cy - u * 0.34]], stroke: alpha(#e82cff, 0.30 + p * 0.16 + surge * 0.25), width: 5.5, cap: round)
          path([[cx - u * 0.24, cy - u * 0.92], [cx - u * 0.68, cy - u * 1.02], [cx - u * 0.94, cy - u * 0.64], [cx - u * 0.80, cy - u * 0.34]], stroke: alpha(#eb9eff, 0.72 + p * 0.20), width: 1.35, cap: round)
          path([[cx + u * 0.24, cy - u * 0.92], [cx + u * 0.68, cy - u * 1.02], [cx + u * 0.94, cy - u * 0.64], [cx + u * 0.80, cy - u * 0.34]], stroke: alpha(#eb9eff, 0.72 + p * 0.20), width: 1.35, cap: round)

          // 4. Peaked Draped Royal-Purple Sorcerer Cowl / Hood Silhouette
