          path([[cx - u * 0.16, cy - u * 0.92], [cx - u * 0.56, cy - u * 0.38], [cx - u * 0.68, cy + u * 0.24], [cx - u * 0.46, cy + u * 0.80]], stroke: alpha(#d88cff, 0.48), width: 1.25, cap: round)
          path([[cx + u * 0.16, cy - u * 0.92], [cx + u * 0.56, cy - u * 0.38], [cx + u * 0.68, cy + u * 0.24], [cx + u * 0.46, cy + u * 0.80]], stroke: alpha(#d88cff, 0.48), width: 1.25, cap: round)

          // 5. Cavernous Inner Hood Shadow Cavity (high-contrast pitch-black frame around bone skull)
          path([
