          line(cx - u * 0.105, cy + u * 0.38, cx - u * 0.095, cy + u * 0.58, stroke: #05000a, width: 1.55)
          line(cx + u * 0.105, cy + u * 0.38, cx + u * 0.095, cy + u * 0.58, stroke: #05000a, width: 1.55)
          line(cx - u * 0.21, cy + u * 0.37, cx - u * 0.19, cy + u * 0.56, stroke: #05000a, width: 1.4)
          line(cx + u * 0.21, cy + u * 0.37, cx + u * 0.19, cy + u * 0.56, stroke: #05000a, width: 1.4)
          // Angular lower mandible chin cleft
          line(cx, cy + u * 0.65, cx, cy + u * 0.78, stroke: alpha(#5e4e36, 0.72), width: 1.2, cap: round)
        } else if maskOn {
          // ==================== CLASSIC SMOOTH 1994 JIM CARREY "THE MASK" ====================
          let u = r * 0.76
          let rimGreen = mix(#26ff6a, #b8ff6e, 0.22 + surge * 0.38)
          let rimGold = mix(#ffe135, #fff6a8, 0.28 + p * 0.20 + surge * 0.35)

