          ], closed: true, fill: linear(cx, cy - u * 0.68, cx, cy + u * 0.81, [#fff7de, #e8d5a2, #9e8a60]), stroke: #fff8e2, width: 1.4)

          // Shadowed Hood Brow Falloff + Chiseled Brow Ridge + Gaunt Cheek Hollows
          path([[cx - u * 0.44, cy - u * 0.38], [cx, cy - u * 0.68], [cx + u * 0.44, cy - u * 0.38], [cx, cy - u * 0.48]], closed: true, fill: alpha(#1b0530, 0.50))
          path([[cx - u * 0.48, cy - u * 0.16], [cx - u * 0.22, cy - u * 0.24], [cx, cy - u * 0.07], [cx + u * 0.22, cy - u * 0.24], [cx + u * 0.48, cy - u * 0.16]], stroke: #fff9e8, width: 1.7, cap: round)
          path([[cx - u * 0.48, cy + u * 0.12], [cx - u * 0.30, cy + u * 0.26], [cx - u * 0.34, cy + u * 0.44], [cx - u * 0.42, cy + u * 0.24]], closed: true, fill: #12041f)
          path([[cx + u * 0.48, cy + u * 0.12], [cx + u * 0.30, cy + u * 0.26], [cx + u * 0.34, cy + u * 0.44], [cx + u * 0.42, cy + u * 0.24]], closed: true, fill: #12041f)

          // 7. Deep V-Pitched Cavernous Eye Sockets & Blazing Twin Arcane Ocular Fires
          path([[cx - u * 0.44, cy - u * 0.15], [cx - u * 0.08, cy - u * 0.02], [cx - u * 0.14, cy + u * 0.15], [cx - u * 0.40, cy + u * 0.09]], closed: true, fill: #020005, stroke: #5e4f38, width: 1.05)
          path([[cx + u * 0.44, cy - u * 0.15], [cx + u * 0.08, cy - u * 0.02], [cx + u * 0.14, cy + u * 0.15], [cx + u * 0.40, cy + u * 0.09]], closed: true, fill: #020005, stroke: #5e4f38, width: 1.05)
          circle(cx - u * 0.25, cy + u * 0.02, u * (0.25 + surge * 0.14), fill: radial(cx - u * 0.25, cy + u * 0.02, u * 0.34, [alpha(#e82cff, 0.56 + p * 0.20 + surge * 0.24), alpha(#000000, 0)]))
          circle(cx + u * 0.25, cy + u * 0.02, u * (0.25 + surge * 0.14), fill: radial(cx + u * 0.25, cy + u * 0.02, u * 0.34, [alpha(#e82cff, 0.56 + p * 0.20 + surge * 0.24), alpha(#000000, 0)]))
          path([[cx - u * 0.34, cy - u * 0.04], [cx - u * 0.15, cy + u * 0.02], [cx - u * 0.24, cy + u * 0.09]], closed: true, fill: #e82cff)
          path([[cx + u * 0.34, cy - u * 0.04], [cx + u * 0.15, cy + u * 0.02], [cx + u * 0.24, cy + u * 0.09]], closed: true, fill: #e82cff)
          circle(cx - u * 0.24, cy + u * 0.02, u * (0.048 + p * 0.012 + surge * 0.022), fill: #fff6ff)
          circle(cx + u * 0.24, cy + u * 0.02, u * (0.048 + p * 0.012 + surge * 0.022), fill: #fff6ff)

