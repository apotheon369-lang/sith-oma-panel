            alpha(#1aff5c, 0.30 + p * 0.10 + surge * 0.22),
            alpha(#ffe135, 0.08 + p * 0.04),
            alpha(#000000, 0)
          ]))
          circle(cx, cy, r * 1.05, fill: radial(cx, cy - r * 0.18, r * 1.12, [
            alpha(#062610, 0.82),
            alpha(#010803, 0.94),
            alpha(#000000, 0.98)
          ]))
          circle(cx, cy, r * 1.05, stroke: alpha(#1aff5c, 0.55 + p * 0.20 + surge * 0.25), width: 1.8)
          circle(cx, cy, r * 0.97, stroke: alpha(#ffe135, 0.28 + p * 0.14 + surge * 0.24), width: 1.0)
          let glideA = fxLive ? (fxT * 26) % 360 : -40
          arc(cx, cy, r * 1.05, glideA, 85, stroke: alpha(#9eff7a, 0.72 + surge * 0.24), width: 2.2, cap: round)
          arc(cx, cy, r * 0.97, 360 - glideA, 64, stroke: alpha(#ffe135, 0.64 + surge * 0.28), width: 1.6, cap: round)

          // 2. Smooth Classic Canary Zoot-Suit Collar Lapels & Silk Tie Knot beneath chin
          path([
            [cx - u * 0.50, cy + u * 0.76], [cx - u * 0.30, cy + u * 0.71],
            [cx, cy + u * 0.92], [cx - u * 0.16, cy + u * 1.04], [cx - u * 0.38, cy + u * 0.98], [cx - u * 0.48, cy + u * 0.88]
          ], closed: true, fill: linear(cx - u * 0.48, cy + u * 0.72, cx, cy + u * 1.04, [#ffe84d, #cca000, #594400]), stroke: alpha(rimGold, 0.85), width: 1.2)
          path([
            [cx + u * 0.50, cy + u * 0.76], [cx + u * 0.30, cy + u * 0.71],
            [cx, cy + u * 0.92], [cx + u * 0.16, cy + u * 1.04], [cx + u * 0.38, cy + u * 0.98], [cx + u * 0.48, cy + u * 0.88]
          ], closed: true, fill: linear(cx + u * 0.48, cy + u * 0.72, cx, cy + u * 1.04, [#ffe84d, #cca000, #594400]), stroke: alpha(rimGold, 0.85), width: 1.2)
          // Classic sleek black satin tie knot with subtle gold trim
