            [cx - u * 0.07, cy + u * 0.91],
            [cx - u * 0.18, cy + u * 0.86],
            [cx - u * 0.32, cy + u * 0.73],
            [cx - u * 0.44, cy + u * 0.56],
            [cx - u * 0.52, cy + u * 0.36],
            [cx - u * 0.58, cy + u * 0.16],
            [cx - u * 0.59, cy - u * 0.04],
            [cx - u * 0.54, cy - u * 0.28],
