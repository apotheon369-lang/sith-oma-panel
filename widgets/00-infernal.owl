            [cx + u * 0.45, cy - u * 0.18], [cx + u * 0.35, cy - u * 0.29], [cx + u * 0.23, cy - u * 0.30], [cx + u * 0.11, cy - u * 0.19]
          ], closed: true, fill: #03210c)

          // 6. Smooth Expressive Classic Jim Carrey Eyes (bright glossy white sclera + lively emerald iris + sparkle)
          circle(cx - u * 0.26, cy - u * 0.09, u * 0.18, fill: radial(cx - u * 0.26, cy - u * 0.09, u * 0.18, [alpha(#021f0b, 0.55), alpha(#021f0b, 0)]))
          circle(cx + u * 0.26, cy - u * 0.09, u * 0.18, fill: radial(cx + u * 0.26, cy - u * 0.09, u * 0.18, [alpha(#021f0b, 0.55), alpha(#021f0b, 0)]))
          path([
