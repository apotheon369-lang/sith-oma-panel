panel "sith music" {
  // Swipe down: a calm, professional crimson music deck. Phone media (any app) and the local mpv vault,
  // with a working 3-band EQ (applied live to mpv via chaos-media.py).
  meta { owl: 22; description: "Smooth crimson music panel: now playing, transport, volume, live 3-band EQ with presets"; category: "media" }
  requires { pacman: ["mpv", "python"] }
  opacity: 0.96
  fps: fxOn ? (playing ? 24 : 10) : 1

  source m = android.media
  source v = android.volume
  source lib = cmd("python3 ~/.local/bin/chaos-media.py status") every 6s json

  state fxOn = true persist
  state mode369 = false persist
  state eqB = 0 persist
  state eqM = 0 persist
  state eqT = 0 persist
  state preset = "flat" persist

  let localOn = lib != null && lib.active == true
  let phoneOn = m != null && m.available != false && (m.title ?? "") != ""
  let useLocal = localOn && !(phoneOn && m.playing == true)
  let playing = useLocal ? lib.playing == true : (m.playing == true)
  let title = useLocal ? (lib.title ?? "vault") : (phoneOn ? m.title : "nothing playing")
  let artist = useLocal ? "local vault · mpv" : (phoneOn ? (m.artist ?? m.app ?? "") : "start music in any app")
  let pos = useLocal ? num(lib.pos, 0) : num(m.position, 0)
  let dur = useLocal ? num(lib.dur, 0) : num(m.duration, 0)
  let pct = dur > 0 ? clamp(pos / dur * 100, 0, 100) : 0
  let presets = [
      {n: "flat", b: 0, m: 0, t: 0},
      {n: "bass", b: 8, m: 0, t: -1},
      {n: "warm", b: 4, m: 2, t: -4},
      {n: "vocal", b: -3, m: 5, t: 2},
      {n: "bright", b: -2, m: 1, t: 7},
      {n: "loud", b: 6, m: -2, t: 5}
    ]

  component Ctl(kind, d) {
    Box {
      size: d
      onTap: {
        haptic()
        if useLocal {
          run("python3 ~/.local/bin/chaos-media.py ${kind == "toggle" ? "toggle" : (kind == "next" ? "next" : "prev")}")
        } else {
          media(kind)
        }
      }
      if kind == "toggle" {
        Box { size: d + 28; offset: [-14, -14]; radius: 999; background: radial(0.5, 0.5, 0.5, [alpha(#ff1e3c, playing ? 0.45 : 0.25), alpha(#ff1e3c, 0)]) }
      }
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let s = min(width, height)
        if kind == "toggle" {
          circle(cx, cy, s / 2, fill: radial(cx - s * 0.15, cy - s * 0.15, s * 0.7, [#ff5a6e, #c8102e]))
          circle(cx, cy, s / 2 - 4, stroke: alpha(#0a0002, 0.35), width: 1)
          circle(cx, cy, s / 2 - 1, color: alpha(#ffe8ec, 0.25), stroke: 1)
          if playing {
            rect(cx - s * 0.14, cy - s * 0.17, s * 0.1, s * 0.34, radius: s * 0.03, fill: #0a0002)
            rect(cx + s * 0.04, cy - s * 0.17, s * 0.1, s * 0.34, radius: s * 0.03, fill: #0a0002)
          } else {
            path([[cx - s * 0.11, cy - s * 0.19], [cx + s * 0.2, cy], [cx - s * 0.11, cy + s * 0.19]], closed: true, fill: #0a0002)
          }
        } else {
          let dir = kind == "next" ? 1 : -1
          path([[cx - s * 0.17 * dir, cy - s * 0.18], [cx + s * 0.09 * dir, cy], [cx - s * 0.17 * dir, cy + s * 0.18]], closed: true, fill: #ffe8ec)
          rect(dir > 0 ? cx + s * 0.09 : cx - s * 0.16, cy - s * 0.18, s * 0.07, s * 0.36, radius: s * 0.02, fill: #ffe8ec)
        }
      }
    }
  }

  component Band(label, val, band) {
    Column {
      weight: 1
      gap: 6
      align: center
      Text { text: "${val > 0 ? "+" : ""}${int(val)} dB"; align: center; font: mono; fontSize: 12; color: val == 0 ? alpha(#ff8fa3, 0.6) : #ffe8ec }
      Box {
        height: 120
        width: 44
        radius: 14 * corners
        background: alpha(#140205, 0.9)
        border: 1
        borderColor: alpha(#ff2244, 0.4)
        onDrag: {
          let nv = clamp(round(val - dy * 0.12), -12, 12)
          if band == "b" { eqB = nv } else if band == "m" { eqM = nv } else { eqT = nv }
          preset = "custom"
        }
        onDragEnd: { haptic(); run("python3 ~/.local/bin/chaos-media.py eq ${int(eqB)} ${int(eqM)} ${int(eqT)}") }
        Canvas {
          fill: true
          let cy = height / 2
          let y = cy - val / 12 * (height / 2 - 10)
          line(width / 2, 10, width / 2, height - 10, color: alpha(#ff8fa3, 0.18), width: 2)
          line(10, cy, width - 10, cy, color: alpha(#ff8fa3, 0.3), width: 1)
          line(width / 2, cy, width / 2, y, color: #ff2a44, width: 4)
          circle(width / 2, y, 9, fill: #ff2a44)
          circle(width / 2, y, 4, fill: #ffe8ec)
        }
      }
      Text { text: label; align: center; fontSize: 11; color: #ff6f85; letterSpacing: 2 }
    }
  }

  Column {
    scroll: true
    padding: [18, 16, 24, 16]
    gap: 14

    // ═══ MUSIC BANNER: spinning vinyl, tonearm, live spectrum ═══
    Box {
      fill: width
      height: 196
      radius: 20 * corners
      clip: true
      border: 1
      borderColor: alpha(#ff2244, playing ? 0.7 : 0.4)
      background: #050001
      onTap: { haptic(); media("open") }

      Shader {
        fill: true
        fallback: #050001
        uniforms: { anim: fxOn ? 1 : 0, energy: playing ? 1 : 0.5 }
        code: """
          uniform float anim;
          uniform float energy;
          float h(float2 q) { return fract(sin(dot(q, float2(127.1, 311.7))) * 43758.5453); }
          float n(float2 q) {
            float2 i = floor(q); float2 f = fract(q); f = f * f * (3.0 - 2.0 * f);
            return mix(mix(h(i), h(i + float2(1, 0)), f.x), mix(h(i + float2(0, 1)), h(i + float2(1, 1)), f.x), f.y);
          }
          half4 main(float2 p) {
            float2 uv = p / size.y;
            float t = time * anim;
            float2 q = uv * 3.0 + float2(t * 0.06, -t * 0.09);
            float smoke = n(q) * 0.55 + n(q * 2.1 + 4.0) * 0.3 + n(q * 4.3 - t * 0.2) * 0.15;
            float2 c = float2(size.x - 92.0, 92.0) / size.y;
            float halo = exp(-length(uv - c) * 2.6) * (0.55 + 0.15 * sin(t * 2.0)) * energy;
            float vig = smoothstep(1.35, 0.25, length((p / size - 0.5) * float2(1.6, 1.2)));
            float grain = (h(p + floor(t * 12.0)) - 0.5) * 0.05;
            float scan = 0.94 + 0.06 * sin(p.y * 1.6);
            float3 base = float3(0.02, 0.0, 0.006);
            float3 col = base + float3(0.55, 0.03, 0.09) * smoke * smoke * 0.55 + float3(1.0, 0.12, 0.2) * halo * 0.45;
            col = (col * vig + grain) * scan;
            return half4(half3(max(col, 0.0)), 1.0);
          }
        """
      }

      Canvas {
        fill: true
        let t = fxOn ? time : 0
        let energy = playing ? 1 : 0.5
        let R = 74
        let cx = width - R - 18
        let cy = 92
        let pulse = fxOn && playing ? (mode369 ? 0.6 + 0.4 * max(0, sin(t * 3)) * (0.5 + 0.5 * sin(t * 6)) * (0.6 + 0.4 * sin(t * 9)) + 0.15 : 0.75 + 0.25 * sin(t * 4)) : 0.7
        // record with a crimson rim light
        circle(cx, cy, R + 6, stroke: alpha(#ff1e3c, 0.18 * energy * pulse), width: 10)
        circle(cx, cy, R + 1, stroke: alpha(#ff2a44, 0.55 * energy), width: 1.5)
        circle(cx, cy, R, fill: radial(cx - 20, cy - 20, R * 1.3, [#1a1418, #060507]))
        for g in range(7) {
          circle(cx, cy, R - 6 - g * 6.5, stroke: alpha(#ffffff, 0.05 + (g % 2) * 0.04), width: 1)
        }
        // light sheen that rotates with the disc
        rotate(playing ? t * 200 : 0, cx, cy) {
          arc(cx, cy, R - 10, -30, 40, stroke: alpha(#ffe8ec, 0.14), width: 5)
          arc(cx, cy, R - 10, 150, 40, stroke: alpha(#ffe8ec, 0.08), width: 5)
          circle(cx, cy, 40, fill: radial(cx, cy, 40, [alpha(#ff1e3c, 0.45 * pulse), alpha(#ff1e3c, 0)]))
          circle(cx, cy, 24, fill: radial(cx - 6, cy - 6, 26, [#ff5a6e, #a8102a]))
          circle(cx, cy, 24, stroke: alpha(#ffe8ec, 0.25), width: 1)
          if mode369 {
            // 3-6-9 vortex: 9 points, the 1-2-4-8-7-5 loop, and the 3-6-9 triangle
            for k in [[1, 2], [2, 4], [4, 8], [8, 7], [7, 5], [5, 1]] {
              let a1 = rad(k[0] * 40 - 90)
              let a2 = rad(k[1] * 40 - 90)
              line(cx + cos(a1) * 18, cy + sin(a1) * 18, cx + cos(a2) * 18, cy + sin(a2) * 18, stroke: alpha(#2a0008, 0.6), width: 1)
            }
            for k in [[3, 6], [6, 9], [9, 3]] {
              let a1 = rad(k[0] * 40 - 90)
              let a2 = rad(k[1] * 40 - 90)
              line(cx + cos(a1) * 18, cy + sin(a1) * 18, cx + cos(a2) * 18, cy + sin(a2) * 18, stroke: alpha(#fff1f3, 0.85), width: 1.3)
            }
            for k in range(9) {
              circle(cx + cos(rad(k * 40 - 50)) * 18, cy + sin(rad(k * 40 - 50)) * 18, (k + 1) % 3 == 0 ? 2 : 1.2, fill: (k + 1) % 3 == 0 ? #fff1f3 : #2a0008)
            }
          } else {
            for k in range(5) {
              let a1 = rad(k * 144 - 90)
              let a2 = rad((k + 1) * 144 - 90)
              line(cx + cos(a1) * 17, cy + sin(a1) * 17, cx + cos(a2) * 17, cy + sin(a2) * 17, stroke: alpha(#2a0008, 0.55), width: 1)
            }
          }
          circle(cx, cy, 19, stroke: alpha(#2a0008, 0.5), width: 0.8)
          circle(cx, cy, 3, fill: #050001)
        }
        // tonearm: rests off the disc when paused, swings in when playing
        let px = width - 14
        let py = 16
        rotate(playing ? 24 : 6, px, py) {
          line(px, py, px - 8, py + 96, color: #8a8a92, width: 3, cap: round)
          rect(px - 15, py + 92, 14, 9, radius: 2, fill: #c9c9cf)
          circle(px, py, 7, fill: #26262b, stroke: #8a8a92, width: 1)
        }
        // spectrum along the bottom
        let n = mode369 ? 18 : 30
        let bw = width / n
        for i in range(n) {
          if mode369 && (i == 3 || i == 9) {
            line(i * bw, height - 44, i * bw, height, stroke: alpha(#ffe8ec, 0.18), width: 1)
          }
          let lvl = playing && fxOn ? (sin(t * (2 + hash(i) * 3) + i * 0.7) * 0.5 + 0.5) * (0.5 + hash(i, 1) * 0.5) : 0.08
          let h = 4 + lvl * 34
          rect(i * bw - 1, height - h - 3, bw + 2, h + 3, radius: 3, fill: alpha(#ff1e3c, 0.08 + lvl * 0.12))
          rect(i * bw + 1, height - h, bw - 2, h, radius: 1.5, fill: linear(0, height - h, 0, height, [alpha(#ffb3c0, 0.35 + lvl * 0.5), alpha(#ff1e3c, 0.3 + lvl * 0.5)]))
        }
      }

      Column {
        fill: true
        padding: [16, 16, 14, 16]
        gap: 4
        align: start
        Text { text: "◈ MUSIC"; fontSize: 11; color: #ff6f85; letterSpacing: 2 }
        Box {
          Text { text: playing ? "Now playing" : (phoneOn || localOn ? "Paused" : "Idle"); fontSize: 26; bold: true; color: alpha(#ff1e3c, 0.55); offset: [0, 1]; scale: 1.04; maxLines: 1; width: tileWidth - 220 }
          Text { text: playing ? "Now playing" : (phoneOn || localOn ? "Paused" : "Idle"); fontSize: 26; bold: true; color: #ffe8ec; maxLines: 1; width: tileWidth - 220 }
        }
        Text { text: useLocal ? "source · local vault" : (phoneOn ? "source · ${m.app ?? "phone"}" : "source · none"); fontSize: 11; color: alpha(#ff8fa3, 0.7); maxLines: 1; width: tileWidth - 220 }
        Text { text: v.output != null ? "out · ${v.output.name ?? v.output.type}" : ""; fontSize: 11; color: alpha(#ff8fa3, 0.7); maxLines: 1; width: tileWidth - 220 }
        Spacer { weight: 1 }
        Row {
          gap: 8
          Box {
            width: 74
            padding: [4, 10]
            radius: 10 * corners
            background: alpha(#050001, 0.85)
            border: 1
            borderColor: alpha(#ff2244, fxOn ? 0.7 : 0.25)
            onTap: fxOn = !fxOn
            Text { text: fxOn ? "FX ON" : "FX OFF"; align: center; fontSize: 10; letterSpacing: 1.5; color: fxOn ? #ffb3c0 : alpha(#ff8fa3, 0.5) }
          }
          Box {
            width: 56
            padding: [4, 8]
            radius: 10 * corners
            background: mode369 ? alpha(#ff2a44, 0.85) : alpha(#050001, 0.85)
            border: 1
            borderColor: alpha(#ff2244, mode369 ? 0.9 : 0.25)
            animate background: tween(250ms, "ease")
            onTap: { haptic(); mode369 = !mode369 }
            Text { text: "369"; align: center; fontSize: 10; letterSpacing: 1.5; color: mode369 ? #0a0002 : alpha(#ff8fa3, 0.6) }
          }
        }
        Spacer { height: 34 }
      }
    }

    // hero card
    Column {
      padding: 16
      gap: 14
      radius: 20 * corners
      background: radial(0.15, 0.0, 1.2, [alpha(#38060f, 0.94), alpha(#070002, 0.92)])
      border: 1
      borderColor: alpha(#ff2244, 0.38)
      Row {
        gap: 14
        align: center
        Box {
          size: 92
          radius: 14 * corners
          clip: true
          background: radial(0.5, 0.5, 0.8, [alpha(#ff1e3c, 0.35), #0a0002])
          onTap: media("open")
          if !useLocal && phoneOn && m.art != null {
            Image { src: m.art; fit: cover; fill: true }
          } else {
            Column { fill: true; justify: center; Text { text: "♪"; align: center; fontSize: 40; color: #ff2e4d } }
          }
        }
        Column {
          weight: 1
          gap: 4
          Text { text: title; fontSize: 18; bold: true; color: #ffe8ec; maxLines: 2 }
          Text { text: artist; fontSize: 13; color: #ffb3c0; maxLines: 1 }
          if fxOn && playing {
            Canvas {
              height: 22
              fill: width
              for i in range(18) {
                let h = 3 + (sin(time * (2.2 + hash(i) * 2.5) + i * 0.9) * 0.5 + 0.5) * (height - 3) * (0.55 + (i < 6 ? eqB : (i < 12 ? eqM : eqT)) / 30)
                rect(i * (width / 18), height - h, width / 18 - 3, h, radius: 1.5, fill: alpha(#ff2a44, 0.55 + hash(i) * 0.4))
              }
            }
          }
        }
      }
      Column {
        gap: 4
        Progress { value: pct; color: #ff2a44; animate value: tween(900ms, "linear") }
        Row {
          Text { text: dur > 0 ? "${int(pos / 60)}:${pad(int(pos % 60), 2)}" : ""; font: mono; fontSize: 10; color: alpha(#ff8fa3, 0.6); weight: 1 }
          Text { text: dur > 0 ? "${int(dur / 60)}:${pad(int(dur % 60), 2)}" : ""; font: mono; fontSize: 10; color: alpha(#ff8fa3, 0.6) }
        }
      }
      Row {
        align: center
        Spacer { weight: 1 }
        Ctl { kind: "previous"; d: 40 }
        Spacer { width: 34 }
        Ctl { kind: "toggle"; d: 62 }
        Spacer { width: 34 }
        Ctl { kind: "next"; d: 40 }
        Spacer { weight: 1 }
      }
    }

    // track details
    Column {
      padding: 16
      gap: 10
      radius: 18 * corners
      background: radial(0.0, 0.0, 1.3, [alpha(#2a050d, 0.92), alpha(#070002, 0.9)])
      border: 1
      borderColor: alpha(#ff2244, 0.4)
      Text { text: "◈ TRACK DETAILS"; fontSize: 11; color: #ff6f85; letterSpacing: 2 }
      for row in [
          ["ALBUM", !useLocal && phoneOn ? (m.album ?? "—") : "—"],
          ["APP", useLocal ? "mpv · vault" : (phoneOn ? (m.app ?? m.package ?? "—") : "—")],
          ["OUTPUT", v.output != null ? (v.output.name ?? v.output.type) : "speaker"],
          ["LENGTH", dur > 0 ? "${int(dur / 60)}:${pad(int(dur % 60), 2)}" : "—"],
          ["REMAINING", dur > 0 ? "-${int((dur - pos) / 60)}:${pad(int((dur - pos) % 60), 2)}" : "—"],
          ["EQ", "${upper(preset)} · ${int(eqB)}/${int(eqM)}/${int(eqT)} dB"],
          ["VAULT", lib != null ? "${lib.count ?? 0} tracks${lib.shuffle == true ? " · shuffle" : ""}${lib.loop == true ? " · loop" : ""}" : "offline"]
        ] {
        Row {
          align: center
          Text { text: row[0]; fontSize: 10; letterSpacing: 1.5; color: alpha(#ff8fa3, 0.6); width: 96 }
          Text { text: row[1]; fontSize: 13; color: #ffe8ec; maxLines: 1; weight: 1 }
        }
      }
    }

    // volume
    Column {
      padding: [12, 16]
      gap: 6
      radius: 18 * corners
      background: radial(0.0, 0.0, 1.3, [alpha(#2a050d, 0.92), alpha(#070002, 0.9)])
      border: 1
      borderColor: alpha(#ff2244, 0.4)
      Row {
        Text { text: "◈ VOLUME"; fontSize: 11; color: #ff6f85; letterSpacing: 2; weight: 1 }
        Text { text: v.muted ? "muted" : "${v.level}%"; font: mono; fontSize: 11; color: #ffb3c0 }
      }
      Slider { value: v.level ?? 0; color: #ff2a44; track: alpha(#ff8fa3, 0.15); live: true; onChange: volume(value) }
    }

    // EQ
    Column {
      padding: 16
      gap: 12
      radius: 18 * corners
      background: radial(0.0, 0.0, 1.3, [alpha(#2a050d, 0.92), alpha(#070002, 0.9)])
      border: 1
      borderColor: alpha(#ff2244, 0.4)
      Row {
        Text { text: "◈ EQUALIZER"; fontSize: 11; color: #ff6f85; letterSpacing: 2; weight: 1 }
        Text { text: localOn ? "live · mpv" : "applies to vault"; fontSize: 10; color: alpha(#ff8fa3, 0.6) }
      }
      Row {
        gap: 8
        Band { label: "BASS"; val: eqB; band: "b" }
        Band { label: "MID"; val: eqM; band: "m" }
        Band { label: "TREBLE"; val: eqT; band: "t" }
      }
      Grid {
        columns: 3
        gap: 8
        for p in presets key p.n {
          Box {
            padding: [6, 12]
            radius: 12 * corners
            background: preset == p.n ? alpha(#ff2a44, 0.85) : alpha(#1a0307, 0.9)
            border: 1
            borderColor: alpha(#ff2244, preset == p.n ? 0.9 : 0.3)
            animate background: tween(250ms, "ease")
            onTap: {
              haptic()
              eqB = p.b
              eqM = p.m
              eqT = p.t
              preset = p.n
              run("python3 ~/.local/bin/chaos-media.py eq-preset ${p.n}")
            }
            Text { text: upper(p.n); align: center; fontSize: 10; letterSpacing: 1.5; color: preset == p.n ? #0a0002 : #ffb3c0 }
          }
        }
      }
    }
  }
}
