app "downloads" {
  meta {
    owl: 22
    description: "Every file in /sdcard/Download (+ ~/Downloads) — 4-theme adaptive, APK quick-install, search, type filters, and safe two-tap .trash with restore."
    category: "tools"
  }
  requires { pacman: ["python"] }
  title: ""
  back: kind == "trash" || data.up != null
  onBack: {
    armPath = ""
    if kind == "trash" { kind = "all" } else { cwd = data.up ?? "" }
  }
  edge: true

  source hub = file("~/.config/omalauncher/hub.json") json optional
  let curMode     = hub.mode ?? "infernal"
  let ecoOn       = (hub.eco ?? false) == true
  let T           = hub.tok ?? {}
  let tc          = T.copy ?? {}
  let cPri        = ecoOn ? (T.ecoPri  != null ? rgb(T.ecoPri[0],  T.ecoPri[1],  T.ecoPri[2])  : #b8263a) : (T.pri != null ? rgb(T.pri[0], T.pri[1], T.pri[2]) : #ff1e3c)
  let cMid        = T.mid   != null ? rgb(T.mid[0],   T.mid[1],   T.mid[2])   : #ff3850
  let cHot        = ecoOn ? (T.ecoHot  != null ? rgb(T.ecoHot[0],  T.ecoHot[1],  T.ecoHot[2])  : #d94c5e) : (T.hot != null ? rgb(T.hot[0], T.hot[1], T.hot[2]) : #ff8596)
  let cSec        = T.sec   != null ? rgb(T.sec[0],   T.sec[1],   T.sec[2])   : #3d9bff
  let cBone       = ecoOn ? (T.ecoBone != null ? rgb(T.ecoBone[0], T.ecoBone[1], T.ecoBone[2]) : #c7a3a8) : (T.bone != null ? rgb(T.bone[0], T.bone[1], T.bone[2]) : #fff0f2)
  let cDim        = ecoOn ? (T.ecoDim  != null ? rgb(T.ecoDim[0],  T.ecoDim[1],  T.ecoDim[2])  : #4d0c18) : (T.dim != null ? rgb(T.dim[0], T.dim[1], T.dim[2]) : #6b0918)
  let cDeep       = T.deep  != null ? rgb(T.deep[0],  T.deep[1],  T.deep[2])  : #170206
  let cCard       = T.card  != null ? rgb(T.card[0],  T.card[1],  T.card[2])  : #0c0104
  let cObs        = T.obs   != null ? rgb(T.obs[0],   T.obs[1],   T.obs[2])   : #050002
  let cInk        = T.ink   != null ? rgb(T.ink[0],   T.ink[1],   T.ink[2])   : #fff0f2
  let cMuted      = T.muted != null ? rgb(T.muted[0], T.muted[1], T.muted[2]) : #c77c88
  let uiFont      = T.fontPath ?? "sans"
  let dispFont    = T.displayFontPath ?? uiFont
  let bodyFont    = T.bodyFont ?? (hub.font == "mono" ? "mono" : "sans")
  let hubRadius   = clamp(num(hub.radius, 1.0), 0.6, 1.4)
  let animHaptics = (hub.haptics ?? true) != false

  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#080206"/>
    <circle cx="128" cy="120" r="92" fill="#140610"/>
    <path d="M58 168h140v36a14 14 0 0 1-14 14H72a14 14 0 0 1-14-14z" fill="currentColor" fill-opacity="0.38"/>
    <path d="M58 168h40l10 18h40l10-18h40v12H58z" fill="currentColor"/>
    <rect x="110" y="40" width="36" height="78" rx="8" fill="#ffffff"/>
    <path d="M78 108h100l-50 58z" fill="currentColor"/>
    <circle cx="196" cy="62" r="10" fill="#ffffff"/>
  </svg>"""

  state cwd     = ""
  state kind    = "all"
  state q       = ""
  state flash   = ""
  state armPath = ""

  let listArg = kind == "trash" ? "__trash__" : cwd
  source data = cmd("sith-downloads.py list ${sh(listArg)}") every 20s json timeout 20s

  let items = (data.items ?? []).filter(f => (kind == "all" || kind == "trash" || f.kind == kind || f.isDir) && (q == "" || contains(lower(f.name), lower(q))))
  let kinds = ["all", "apk", "image", "video", "audio", "doc", "archive"]
  let trashCnt = num(data.trashCount, 0)

  component Chip(k, lbl = "") {
    Row {
      padding: [11, 6]
      radius: 14 * corners * hubRadius
      border: 1
      borderColor: kind == k ? cPri : alpha(cPri, 0.28)
      background: kind == k ? alpha(cPri, 0.22) : alpha(cCard, 0.88)
      onTap: { kind = k; armPath = ""; if animHaptics { haptic() } }
      Text { font: bodyFont; text: lbl != "" ? lbl : upper(k); color: kind == k ? cInk : cMuted; fontSize: 10.5; letterSpacing: 1.4; fontWeight: 800 }
    }
  }

  Box {
    fill: true
    background: ecoOn ? #000000 : radial(0.5, 0, 1.15, [cDeep, cObs, #000000])
    Column {
      fill: true
      padding: [12, 8, 12, 0]
      gap: 9

      // Header: back + folder + totals + open-in-Files
      Row {
        align: center
        gap: 10
        if kind == "trash" || data.up != null {
          Row {
            padding: [11, 6]
            radius: 14 * corners * hubRadius
            border: 1
            borderColor: alpha(cHot, 0.5)
            background: alpha(cCard, 0.88)
            onTap: {
              armPath = ""
              if kind == "trash" { kind = "all" } else { cwd = data.up ?? "" }
              if animHaptics { haptic() }
            }
            Text { font: bodyFont; text: "‹ BACK"; color: cHot; fontSize: 10.5; letterSpacing: 1.2; fontWeight: 800 }
          }
        }
        Column {
          weight: 1
          gap: 2
          Text { font: dispFont; text: "${tc.glyph ?? "◈"} ${upper(data.rel ?? "DOWNLOADS")}"; color: cPri; fontSize: 15; letterSpacing: 2; fontWeight: 900; maxLines: 1 }
          Text { font: bodyFont; text: "${data.count ?? 0} items · ${data.bytes ?? "…"} · ${upper(curMode)}"; color: cMuted; fontSize: 10.5 }
        }
        Row {
          padding: [12, 7]
          radius: 14 * corners * hubRadius
          border: 1
          borderColor: alpha(cPri, 0.45)
          background: alpha(cCard, 0.88)
          onTap: { if animHaptics { haptic() }; run("sith-downloads.py files ${sh(data.dir ?? "")}") }
          Text { font: bodyFont; text: "FILES ↗"; color: cHot; fontSize: 10.5; letterSpacing: 1.4; fontWeight: 800 }
        }
      }

      // Search bar
      Box {
        padding: [12, 4]
        radius: 14 * corners * hubRadius
        border: 1
        borderColor: alpha(cPri, 0.32)
        background: alpha(cCard, 0.88)
        Input { text: q; placeholder: "search downloads…"; color: cInk; fontSize: 14; underline: false; clear: true; onChange: q = value }
      }

      // Filter chips + Safe .trash view
      Flow {
        gap: 6
        for k in kinds { Chip { k: k } }
        Chip { k: "trash"; lbl: trashCnt > 0 ? "TRASH (${trashCnt})" : "TRASH" }
      }

      if flash != "" {
        Text { font: bodyFont; text: flash; color: cHot; fontSize: 11 }
      }

      // File list with APK quick-install & two-tap safe .trash rail
      Column {
        weight: 1
        lazy: true
        gap: 6
        onPull: refresh()
        for f in items key f.path {
          let armed = armPath == f.path
          Row {
            align: center
            gap: 10
            padding: [11, 9]
            radius: 16 * corners * hubRadius
            border: 1
            borderColor: armed ? cHot : alpha(cPri, f.isDir ? 0.44 : 0.24)
            background: armed ? alpha(cPri, 0.16) : alpha(cCard, 0.88)
            onTap: {
              armPath = ""
              if f.inTrash {
                run("sith-downloads.py restore ${sh(f.path)}")
                flash = "restored: ${f.name}"
              } else if f.isDir {
                cwd = f.path
                q = ""
              } else {
                run("sith-downloads.py share ${sh(f.path)}")
                flash = f.kind == "apk" ? "install / open APK: ${f.name}" : "open with… ${f.name}"
              }
              if animHaptics { haptic() }
            }
            onLongPress: { copy(f.path); flash = "copied path: ${f.name}"; if animHaptics { haptic() } }

            Box {
              width: 42
              height: 42
              radius: 12 * corners * hubRadius
              clip: true
              align: center
              background: alpha(cPri, f.kind == "apk" ? 0.26 : 0.14)
              if f.kind == "image" {
                Image { src: f.path; fit: cover; width: 42; height: 42 }
              } else {
                Text {
                  font: bodyFont
                  align: center
                  text: f.kind == "folder" ? "▣" : f.kind == "apk" ? "⬢" : f.kind == "video" ? "▶" : f.kind == "audio" ? "♫" : f.kind == "doc" ? "≣" : f.kind == "archive" ? "▤" : f.kind == "code" ? "‹›" : "◇"
                  color: f.kind == "apk" ? #2bff8c : f.kind == "audio" ? #ff3df0 : f.kind == "video" ? #3da8ff : f.kind == "doc" ? #ffe14a : cHot
                  fontSize: 19
                  fontWeight: 900
                }
              }
            }

            Column {
              weight: 1
              gap: 2
              Text { font: bodyFont; text: f.name; color: cInk; fontSize: 13.5; fontWeight: 700; maxLines: 1 }
              Text {
                font: bodyFont
                text: f.isDir ? "${f.count} ${f.count == 1 ? "item" : "items"} · ${f.sz} · ${f.ago}" : "${f.kind == "apk" ? "APK PACKAGE" : upper(f.kind)} · ${f.sz} · ${f.ago}"
                color: f.kind == "apk" ? #2bff8c : cMuted
                fontSize: 10.5
              }
            }

            // Right-side action rail: APK INSTALL / OPEN + Two-Tap Safe .trash (or RESTORE in trash)
            Row {
              align: center
              gap: 6
              if !f.inTrash && f.kind == "apk" {
                Row {
                  padding: [8, 5]
                  radius: 10 * corners * hubRadius
                  border: 1
                  borderColor: alpha(#2bff8c, 0.55)
                  background: alpha(#2bff8c, 0.14)
                  onTap: {
                    armPath = ""
                    run("sith-downloads.py share ${sh(f.path)}")
                    flash = "installing / opening ${f.name}"
                    if animHaptics { haptic() }
                  }
                  Text { font: bodyFont; text: "APK ↗"; color: #2bff8c; fontSize: 9.5; fontWeight: 900; letterSpacing: 0.8 }
                }
              }
              Row {
                padding: [armed ? 9 : 8, 5]
                radius: 10 * corners * hubRadius
                border: 1
                borderColor: f.inTrash ? alpha(#2bff8c, 0.55) : (armed ? cHot : alpha(cMuted, 0.32))
                background: f.inTrash ? alpha(#2bff8c, 0.14) : (armed ? cPri : alpha(cObs, 0.9))
                onTap: {
                  if animHaptics { haptic() }
                  if f.inTrash {
                    run("sith-downloads.py restore ${sh(f.path)}")
                    flash = "restored ${f.name}"
                    armPath = ""
                  } else if armed {
                    run("sith-downloads.py trash ${sh(f.path)}")
                    flash = "moved to .trash: ${f.name}"
                    armPath = ""
                  } else {
                    armPath = f.path
                    flash = "tap TRASH? again to move ${f.name} to .trash"
                  }
                }
                Text {
                  font: bodyFont
                  text: f.inTrash ? "RESTORE ↩" : (armed ? "TRASH?" : "✕")
                  color: f.inTrash ? #2bff8c : (armed ? #ffffff : cMuted)
                  fontSize: 9.5
                  fontWeight: 800
                }
              }
            }
          }
        }
        if len(items) == 0 {
          Text { font: bodyFont; text: data == null ? "scanning downloads…" : (kind == "trash" ? ".trash is empty" : "nothing here"); color: cMuted; fontSize: 13; align: center; fill: width; padding: [0, 40] }
        }
        Spacer { height: screenInset + 8 }
      }
    }
  }
}
