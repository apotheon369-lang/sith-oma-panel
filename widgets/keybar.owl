keybar "terminal key bar" {
  // Obsidian Terminal Keybar — procedural 0-loop GPU textures,
  // layered kyber/cyber glow, smoked-glass 3D beveled keycaps, precision tactile
  // spring response, 3-deck quick-action bar, look driven by the HUB (hub.json),
  // and 0 FPS idle power draw (<1ms active).
  // .stock-keybar.owl next to this file is the launcher's stock reference.
  meta {
    description: "Obsidian terminal key bar with procedural AGSL textures, layered neon glow, tactile spring press, 3 quick-action decks (CORE/SYM/OPS/MD), and 0-FPS idle efficiency"
    version: "2.1"
    license: "MIT"
    category: "system"
    owl: 22
  }

  // Unified single-source config (hub.json + live Android modifier latches)
  source hub = file("~/.config/omalauncher/hub.json") json optional
  let curMode  = hub.mode ?? "infernal"
  let ecoOn    = (hub.eco ?? false) == true
  let T        = hub.tok ?? {}
  let tc       = T.copy ?? {}
  let cPri     = ecoOn ? (T.ecoPri != null ? rgb(T.ecoPri[0], T.ecoPri[1], T.ecoPri[2]) : #b8263a) : (T.pri != null ? rgb(T.pri[0], T.pri[1], T.pri[2]) : #ff1e3c)
  let cMid     = T.mid   != null ? rgb(T.mid[0],   T.mid[1],   T.mid[2])   : #ff3850
  let cHot     = ecoOn ? (T.ecoHot != null ? rgb(T.ecoHot[0], T.ecoHot[1], T.ecoHot[2]) : #d94c5e) : (T.hot != null ? rgb(T.hot[0], T.hot[1], T.hot[2]) : #ff8596)
  let cSec     = T.sec   != null ? rgb(T.sec[0],   T.sec[1],   T.sec[2])   : #ff6a1a
  let cBone    = ecoOn ? (T.ecoBone != null ? rgb(T.ecoBone[0], T.ecoBone[1], T.ecoBone[2]) : #c7a3a8) : (T.bone != null ? rgb(T.bone[0], T.bone[1], T.bone[2]) : #fff0f2)
  let cDim     = ecoOn ? (T.ecoDim != null ? rgb(T.ecoDim[0], T.ecoDim[1], T.ecoDim[2]) : #4d0c18) : (T.dim != null ? rgb(T.dim[0], T.dim[1], T.dim[2]) : #6b0918)
  let cDeep    = T.deep  != null ? rgb(T.deep[0],  T.deep[1],  T.deep[2])  : #170206
  let cCard    = T.card  != null ? rgb(T.card[0],  T.card[1],  T.card[2])  : #0c0104
  let cObs     = T.obs   != null ? rgb(T.obs[0],   T.obs[1],   T.obs[2])   : #050002
  let cInk     = T.ink   != null ? rgb(T.ink[0],   T.ink[1],   T.ink[2])   : #fff0f2
  let cMuted   = T.muted != null ? rgb(T.muted[0], T.muted[1], T.muted[2]) : #c77c88
  let uiFont   = T.fontPath ?? "sans"
  let dispFont = T.displayFontPath ?? uiFont
  let bodyFont = T.bodyFont ?? (hub.font == "mono" ? "mono" : "sans")
  let modeIdx  = num(T.modeIdx, 0)
  let rzBusy   = (hub.busy ?? false) == true
  let rzRes    = rzBusy ? 0.34 : 1

  // Modifier latch state from Android: "off", "once", or "locked"
  source kb = android.modifiers

  // Crisp vector assets (currentColor inherits Image tint)
  asset chevron   = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iY3VycmVudENvbG9yIiBkPSJNNy40MSwxNS40MUwxMiwxMC44M2w0LjU5LDQuNThMMTgsMTRsLTYsLTYgLTYsNnoiLz48L3N2Zz4="
  asset copyIcon  = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iY3VycmVudENvbG9yIiBkPSJNMTksMjFIOFY3SDE5TTE5LDVIOEEyLDIgMCAwLDAgNiw3VjIxQTIsMiAwIDAsMCA4LDIzSDE5QTIsMiAwIDAsMCAyMSwyMVY3QTIsMiAwIDAsMCAxOSw1TTE2LDFINEEyLDIgMCAwLDAgMiwzVjE3SDRWM0gxNlYxWiIvPjwvc3ZnPg=="
  asset pasteIcon = base64""
  asset photo     = base64""

  // TalkBack accessibility strings across locales
  strings {
    en { copy: "copy"; paste: "paste"; photos: "photos" }
    id { copy: "salin"; paste: "tempel"; photos: "foto" }
    es { copy: "copiar"; paste: "pegar"; photos: "fotos" }
    pt { copy: "copiar"; paste: "colar"; photos: "fotos" }
    de { copy: "kopieren"; paste: "einfügen"; photos: "fotos" }
    zh { copy: "复制"; paste: "粘贴"; photos: "照片" }
  }

  // Interactive & persisted customization state
  state down       = ""          // Active pressed key id ("r:c")
  state hitCol     = 4           // Last pressed key column (0..8) for GPU impact halo
  state hitRow     = 0           // Last pressed key row (0..1)
  state deck       = 0           // 0 = CORE (stock 18), 1 = SYM (coding), 2 = OPS (signals/macros)

  // Theme, radius, & optimization flags (100% from hub.json -> hub.tok)
  let hapticsOn = (hub.haptics ?? true) != false
  let hubRadius = clamp(num(hub.radius, 1.0), 0.6, 1.4)
  let radMul    = corners * hubRadius

  // Semantic 4-theme palette mapped directly from hub.tok
  let priCol  = cPri
  let hotCol  = cHot
  let dimCol  = cDim
  let inkCol  = cObs
  let boneCol = cInk

  // Look from the HUB: surface oled = flat; texture grid/hex/none; glow 0..2
  let hubKb      = hub.keybar ?? {}
  let compactBar = (hubKb.compact ?? false) == true
  let hubSurf    = hub.surface ?? "obsidian"
  let hubTex     = hub.texture ?? "none"
  let glowIdx    = hub.glow ?? 2
  let effSkin    = hubSurf == "oled" ? 3 : hubTex == "hex" ? 1 : hubTex == "grid" ? 0 : 2
  let glowMul    = glowIdx == 0 ? 0.38 : glowIdx == 1 ? 0.70 : 1.0
  let useShader  = !ecoOn && effSkin != 3

  // Live modifier states
  let ctrlSt = get(kb ?? {}, "ctrl",  "off")
  let altSt  = get(kb ?? {}, "alt",   "off")
  let shftSt = get(kb ?? {}, "shift", "off")
  let ctrlLv = ctrlSt == "locked" ? 1.0 : ctrlSt == "once" ? 0.55 : 0.0
  let altLv  = altSt  == "locked" ? 1.0 : altSt  == "once" ? 0.55 : 0.0
  let shftLv = shftSt == "locked" ? 1.0 : shftSt == "once" ? 0.55 : 0.0
  let anyMod = ctrlSt != "off" || altSt != "off" || shftSt != "off"

  let modBadge = join(
    [
      ctrlSt == "locked" ? "◆C" : ctrlSt == "once" ? "●C" : "",
      altSt  == "locked" ? "◆A" : altSt  == "once" ? "●A" : "",
      shftSt == "locked" ? "◆S" : shftSt == "once" ? "●S" : ""
    ].filter(s => s != ""),
    " "
  )
  let brandTag = tc.keybarTag ?? "SITH"

  // Exact deterministic geometry in dp so the GPU shader aligns 1:1 at any screen DPI
  let headerH = 26
  let rowH    = compactBar ? 34 : 40
  let padTop  = 4
  let padBot  = 4
  let barH    = padTop + headerH + 4 + (rowH * 2) + padBot

  // Smoked obsidian-glass keycap gradient stops using semantic hub.tok surfaces (zero crimson bleed)
  let capAlpha = useShader ? 0.78 : 0.98
  let capTop   = useShader ? alpha(mix(cCard, cDim, 0.28), capAlpha) : mix(cObs, cDim, 0.16)
  let capBot   = useShader ? alpha(mix(cObs,  cDim, 0.10), 0.86)     : #000000
  let navTop   = useShader ? alpha(mix(cDeep, cDim, 0.54), capAlpha) : mix(cCard, cDim, 0.28)
  let navBot   = useShader ? alpha(mix(cObs,  cDim, 0.20), 0.84)     : #000000
  let actTop   = useShader ? alpha(mix(cDeep, cDim, 0.40), capAlpha) : mix(cCard, cDim, 0.22)
  let actBot   = useShader ? alpha(mix(cObs,  cDim, 0.15), 0.86)     : #000000
  let modTop   = useShader ? alpha(mix(cDeep, cDim, 0.46), capAlpha) : mix(cCard, cDim, 0.24)
  let modBot   = useShader ? alpha(mix(cObs,  cDim, 0.18), 0.86)     : #000000

  // Dynamic Deck 3 (MD) color macro chip tokens (slot 8 inserts active theme primary hex from T.hex.pri)
  let mdHexMap = T.hex ?? {}
  let mdPriHex = mdHexMap.pri ?? "#ff1e3c"
  let mdPriLbl = curMode == "skeletor" ? "PRP" : curMode == "mask" ? "GRN" : curMode == "future" ? "CYN" : "RED"
  let mdAltHex = curMode == "skeletor" ? (mdHexMap.bone ?? "#f4e6be") : "#3da8ff"
  let mdAltLbl = curMode == "skeletor" ? "BON" : "ICE"
  let mdAltCol = curMode == "skeletor" ? cBone : #3da8ff

  // Deck 0: CORE — all 18 stock keys preserved in exact muscle-memory positions
  let coreRows = [
    [
      {label: "esc",       key: "esc",         kind: "act"},
      {label: "/",         key: "/",           kind: "sym"},
      {label: "-",         key: "-",           kind: "sym"},
      {label: "home",      key: "home",        kind: "std"},
      {label: "up",        key: "up",          kind: "nav", repeats: true, arrow: 0},
      {label: "end",       key: "end",         kind: "std"},
      {label: "pgup",      key: "pgup",        kind: "std", repeats: true},
      {label: str.copy,    key: "ctrl+insert", kind: "act", icon: copyIcon},
      {label: "|",         key: "|",           kind: "sym"}
    ],
    [
      {label: "tab",       key: "tab",          kind: "act"},
      {label: "ctrl",      latch: "ctrl",       kind: "mod"},
      {label: "alt",       latch: "alt",        kind: "mod"},
      {label: "left",      key: "left",         kind: "nav", repeats: true, arrow: -90},
      {label: "down",      key: "down",         kind: "nav", repeats: true, arrow: 180},
      {label: "right",     key: "right",        kind: "nav", repeats: true, arrow: 90},
      {label: "pgdn",      key: "pgdn",         kind: "std", repeats: true},
      {label: str.paste,   key: "shift+insert", kind: "act", icon: pasteIcon},
      {label: str.photos,  images: true,        kind: "act", icon: photo}
    ]
  ]

  // Deck 1: SYM — high-velocity coding brackets, operators, shift latch, and enter
  let symRows = [
    [
      {label: '`',  key: '`',  kind: "sym"},
      {label: '~',  key: '~',  kind: "sym"},
      {label: '!',  key: '!',  kind: "sym"},
      {label: '(',  key: '(',  kind: "nav"},
      {label: ')',  key: ')',  kind: "nav"},
      {label: '[',  key: '[',  kind: "nav"},
      {label: ']',  key: ']',  kind: "nav"},
      {label: '{',  key: '{',  kind: "act"},
      {label: '}',  key: '}',  kind: "act"}
    ],
    [
      {label: "shft", latch: "shift", kind: "mod"},
      {label: '\\',   key: '\\',      kind: "sym"},
      {label: '_',    key: '_',       kind: "sym"},
      {label: '=',    key: '=',       kind: "std"},
      {label: '+',    key: '+',       kind: "std"},
      {label: '<',    key: '<',       kind: "nav"},
      {label: '>',    key: '>',       kind: "nav"},
      {label: '$',    key: '$',       kind: "act"},
      {label: "ret",  key: "enter",   kind: "act"}
    ]
  ]

  // Deck 2: OPS — terminal signals (^C/^D/^Z/^L/^R/^A/^E/^W), tmux ^B, F-keys, & shell macros
  let opsRows = [
    [
      {label: "^C",  key: "ctrl+c", kind: "act"},
      {label: "^D",  key: "ctrl+d", kind: "act"},
      {label: "^Z",  key: "ctrl+z", kind: "std"},
      {label: "^L",  key: "ctrl+l", kind: "std"},
      {label: "^R",  key: "ctrl+r", kind: "nav"},
      {label: "^A",  key: "ctrl+a", kind: "std"},
      {label: "^E",  key: "ctrl+e", kind: "std"},
      {label: "^W",  key: "ctrl+w", kind: "std"},
      {label: "del", key: "delete", kind: "act", repeats: true}
    ],
    [
      {label: "^B",  key: "ctrl+b",        kind: "mod"},
      {label: "F1",  key: "f1",            kind: "std"},
      {label: "F2",  key: "f2",            kind: "std"},
      {label: "F5",  key: "f5",            kind: "std"},
      {label: "gs",  type: "git status\n", kind: "nav"},
      {label: "gd",  type: "git diff\n",   kind: "nav"},
      {label: "ll",  type: "ls -la\n",     kind: "std"},
      {label: "..",  type: "cd ..\n",      kind: "std"},
      {label: "cls", type: "clear\n",      kind: "act"}
    ]
  ]

  // Deck 3: MD — markdown formatting; wraps place the cursor between the marks (back = lefts)
  let mdRows = [
    [
      {label: "B",   type: "****",     back: 2, kind: "act"},
      {label: "I",   type: "**",       back: 1, kind: "act"},
      {label: "BI",  type: "******",   back: 3, kind: "act"},
      {label: "S",   type: "~~~~",     back: 2, kind: "std"},
      {label: "`",   type: "``",       back: 1, kind: "sym"},
      {label: "H1",  type: "# ",       kind: "nav"},
      {label: "H2",  type: "## ",      kind: "nav"},
      {label: ">",   type: "> ",       kind: "sym"},
      {label: "del", key: "backspace", kind: "act", repeats: true}
    ],
    [
      {label: "•",   type: "- ",       kind: "std"},
      {label: "1.",  type: "1. ",      kind: "std"},
      {label: "☐",   type: "- [ ] ",   kind: "std"},
      {label: "lnk", type: "[]()",     back: 3, kind: "nav"},
      {label: "```", type: "```\n\n```", back: 4, kind: "sym"},
      {label: "―",   type: "\n---\n", kind: "std"},
      {label: "GLD",      type: "<span style=\"color:#ffe14a\"></span>", back: 7, kind: "act", tint: #ffe14a},
      {label: mdAltLbl,   type: "<span style=\"color:${mdAltHex}\"></span>", back: 7, kind: "act", tint: mdAltCol},
      {label: mdPriLbl,   type: "<span style=\"color:${mdPriHex}\"></span>", back: 7, kind: "act", tint: priCol}
    ]
  ]

  let activeRows = deck == 1 ? symRows : deck == 2 ? opsRows : deck == 3 ? mdRows : coreRows

  // Standard & repeating keycap with instant press response + tactile spring depression
  component Plain(k, ri, ci) {
    let kid    = "${ri}:${ci}"
    let isDown = down == kid
    let isNav  = k.kind == "nav"
    let isAct  = k.kind == "act"
    let isSym  = k.kind == "sym"
    let kTop   = isNav ? navTop : isAct ? actTop : capTop
    let kBot   = isNav ? navBot : isAct ? actBot : capBot
    let kEdge  = isDown ? hotCol
      : isNav ? alpha(priCol, 0.54 * glowMul + 0.14)
      : isAct ? alpha(priCol, 0.42 * glowMul + 0.12)
      : alpha(priCol, 0.24 * glowMul + 0.10)
    let lipCol = isDown ? #ffffff
      : isNav ? alpha(hotCol, 0.72 * glowMul)
      : isAct ? alpha(priCol, 0.58 * glowMul)
      : alpha(hotCol, 0.26 * glowMul)
    let txtSize = compactBar
      ? (len(k.label) >= 4 ? 9.5 : len(k.label) == 1 ? 14 : 11.5)
      : (len(k.label) >= 4 ? 10.5 : len(k.label) == 1 ? 15.5 : 12.5)

    Box {
      weight: 1
      fill: height
      align: top
      padding: [2, 0, 2, 0]
      radius: 7 * radMul
      clip: true
      scale: isDown ? 0.90 : 1.0
      animate scale: spring(0.72, 1150)
      background: isDown
        ? linear(0, 0, 0, 1, [hotCol, priCol])
        : linear(0, 0, 0, 1, [kTop, kBot])
      border: isDown ? 1.4 : (isNav ? 1.15 : 0.9)
      borderColor: kEdge
      repeats: k.repeats ?? false
      onPress: {
        if repeat == 0 {
          down = kid
          hitCol = ci
          hitRow = ri
          if hapticsOn { haptic() }
        }
        if k.type != null {
          typeText(k.type)
          if (k.back ?? 0) >= 1 { pressKey("left") }
          if (k.back ?? 0) >= 2 { pressKey("left") }
          if (k.back ?? 0) >= 3 { pressKey("left") }
          if (k.back ?? 0) >= 4 { pressKey("left") }
          if (k.back ?? 0) >= 5 { pressKey("left") }
          if (k.back ?? 0) >= 6 { pressKey("left") }
          if (k.back ?? 0) >= 7 { pressKey("left") }
        } else {
          pressKey(k.key)
        }
      }
      onRelease: down = ""

      // Top 3D machined specular bevel highlight rail (pinned cleanly to top edge)
      Box {
        fill: width
        height: isDown ? 2.2 : 1.6
        padding: [3, 0, 3, 0]
        Box {
          fill: true
          radius: 1
          background: lipCol
        }
      }

      // Centered keycap legend or icon
      Box {
        fill: true
        align: center
        if k.arrow != null {
          Image {
            src: chevron
            size: compactBar ? 18 : 20
            rotation: k.arrow
            tint: isDown ? inkCol : hotCol
            label: k.label
          }
        } else if k.icon != null {
          Image {
            src: k.icon
            size: compactBar ? 17 : 19
            tint: isDown ? inkCol : hotCol
            label: k.label
          }
        } else {
          Text {
            text: k.label
            font: bodyFont
            fontWeight: deck == 3 && (k.label == "B" || k.label == "BI") ? 900 : 700
            italic: deck == 3 && (k.label == "I" || k.label == "BI")
            fontSize: txtSize
            maxLines: 1
            align: center
            color: isDown ? inkCol : (k.tint ?? (isSym ? hotCol : boneCol))
          }
        }
      }
    }
  }

  // Photo picker keycap — strictly fires pickImages() in onTap so the picker never interrupts onPress
  component Images(k, ri, ci) {
    let kid    = "${ri}:${ci}"
    let isDown = down == kid
    Box {
      weight: 1
      fill: height
      align: top
      padding: [5, 0, 5, 0]
      radius: 7 * radMul
      clip: true
      scale: isDown ? 0.90 : 1.0
      animate scale: spring(0.72, 1150)
      background: isDown
        ? linear(0, 0, 0, 1, [hotCol, priCol])
        : linear(0, 0, 0, 1, [actTop, actBot])
      border: isDown ? 1.4 : 0.95
      borderColor: isDown ? hotCol : alpha(priCol, 0.44 * glowMul + 0.12)
      onPress: {
        down = kid
        hitCol = ci
        hitRow = ri
        if hapticsOn { haptic() }
      }
      onRelease: down = ""
      onTap: {
        down = ""
        pickImages()
      }

      Box {
        fill: width
        height: isDown ? 2.2 : 1.6
        radius: 1
        background: isDown ? #ffffff : alpha(priCol, 0.62 * glowMul)
      }

      Box {
        fill: true
        align: center
        Image {
          src: k.icon
          size: compactBar ? 17 : 19
          tint: isDown ? inkCol : hotCol
          label: k.label
        }
      }
    }
  }

  // Modifier keycap (ctrl / alt / shift): tap latches once (neon ring + glowing LED), long-press locks (incandescent fill)
  component Latched(k, ri, ci) {
    let kid      = "${ri}:${ci}"
    let isDown   = down == kid
    let held     = get(kb ?? {}, k.latch, "off")
    let isLocked = held == "locked"
    let isOnce   = held == "once"
    let txtSize  = compactBar ? 10.5 : 11.5

    Box {
      weight: 1
      fill: height
      align: top
      padding: [6, 1, 6, 0]
      radius: 7 * radMul
      clip: true
      scale: isDown ? 0.90 : 1.0
      animate scale: spring(0.72, 1150)
      background: (isLocked || isDown)
        ? linear(0, 0, 0, 1, [hotCol, priCol])
        : isOnce
        ? linear(0, 0, 0, 1, [alpha(cSec, 0.34), alpha(priCol, 0.14)])
        : linear(0, 0, 0, 1, [modTop, modBot])
      border: isLocked ? 1.5 : isOnce ? 1.7 : 1.0
      borderColor: (isLocked || isOnce) ? cSec : isDown ? hotCol : alpha(priCol, 0.40 * glowMul + 0.12)
      onPress: {
        down = kid
        hitCol = ci
        hitRow = ri
        if hapticsOn { haptic() }
      }
      onRelease: down = ""
      onTap: latch(k.latch)
      onLongPress: {
        down = ""
        latch(k.latch, "locked")
      }

      // Top LED indicator rail (off = subtle dim, once = cSec conduit glow, locked = white-hot)
      Box {
        fill: width
        height: (isLocked || isOnce) ? 3.2 : 2.2
        radius: 2
        background: (isLocked || isDown) ? #ffffff : isOnce ? cSec : alpha(priCol, 0.42 * glowMul)
      }

      Box {
        fill: true
        align: center
        Text {
          text: k.label
          font: bodyFont
          fontWeight: 800
          fontSize: txtSize
          maxLines: 1
          align: center
          color: (isLocked || isDown) ? inkCol : isOnce ? hotCol : boneCol
        }
      }
    }
  }

  // Deck tab pill (Row auto-sizes to content inside parent Row!)
  component DeckPill(label, idx) {
    let active = deck == idx
    Row {
      height: 20
      padding: [8, 0]
      align: center
      justify: center
      radius: 5 * radMul
      background: active
        ? linear(0, 0, 0, 1, [alpha(priCol, 0.42), alpha(priCol, 0.16)])
        : alpha(cObs, 0.78)
      border: active ? 1.1 : 0.75
      borderColor: active ? hotCol : alpha(priCol, 0.28)
      onPress: {
        deck = idx
        down = ""
        if hapticsOn { haptic() }
      }
      Text {
        text: label
        font: bodyFont
        fontWeight: active ? 800 : 600
        fontSize: 9.5
        letterSpacing: 0.7
        maxLines: 1
        color: active ? #ffffff : alpha(hotCol, 0.78)
      }
    }
  }

  // Outer launcher-aligned wrapper following settings › style (gapsOut, borderWidth, corners)
  Column {
    padding: [gapsOut, 0, gapsOut, gapsOut]
    gap: 0

    // Obsidian Chassis with exact dp height for 1:1 GPU shader alignment
    Box {
      fill: width
      height: barH
      radius: 13 * radMul
      clip: true
      border: max(borderWidth, 1.5)
      borderColor: down != "" ? hotCol : anyMod ? cSec : alpha(priCol, 0.85)
      background: #000000

      // 0-loop, 0-FPS-idle AGSL procedural material + layered kyber glow + tactile impact burst.
      // Intentionally omits `time` so idle CPU/GPU draw is literally 0 frames/sec!
      if useShader {
        Shader {
          fill: true
          fallback: cObs
          uniforms: { uRes: rzRes,
            uPri:  priCol,
            uHot:  hotCol,
            uSec:  cSec,
            uBar:  [barH, rowH, headerH, glowMul],
            uSkin: [effSkin, deck, padTop, compactBar ? 1.0 : 0.0],
            uHit:  [(hitCol + 0.5) / 9.0, hitRow, down != "" ? 1.0 : 0.0, 0.0],
            uMod:  [ctrlLv, altLv, shftLv, anyMod ? 1.0 : 0.0]
          }
          code: """
          uniform float uRes;
            uniform half4  uPri;
            uniform half4  uHot;
            uniform half4  uSec;
            uniform float4 uBar;   // [barH, rowH, headerH, glowMul]
            uniform float4 uSkin;  // [skinIdx, deck, padTop, compact]
            uniform float4 uHit;   // [hitNormX, hitRow, hitOn, unused]
            uniform float4 uMod;   // [ctrlLv, altLv, shftLv, anyMod]

            float hash12(float2 p) {
              float3 p3 = fract(float3(p.xyx) * 0.1031);
              p3 += dot(p3, p3.yzx + 33.33);
              return fract((p3.x + p3.y) * p3.z);
            }

            float hexDist(float2 p) {
              p = abs(p);
              return max(dot(p, float2(0.5, 0.8660254)), p.x);
            }

            half4 main(float2 p) {
            p = (floor(p * uRes) + 0.5) / uRes;
              float2 safeSize = max(size, float2(1.0));
              float2 uv = p / safeSize;
              float barH = max(uBar.x, 1.0);
              float dpr = safeSize.y / barH;
              float2 dp = p / max(dpr, 0.5);
              float wDp = safeSize.x / max(dpr, 0.5);
              float glow = uBar.w;
              float skin = uSkin.x;

              // True AMOLED #000000 base floor
              half3 col = half3(0.0);
              half3 pri = uPri.rgb;
              half3 hot = uHot.rgb;
              half3 sec = uSec.rgb;

              // 1. Procedural micro-texture (0 loops, resolution-locked via dpr)
              if (skin < 0.5) {
                // GRID: diagonal woven micro-twill + ridge sheen
                float2 cP = dp * 0.68;
                float wA = sin((cP.x + cP.y) * 3.14159) * 0.5 + 0.5;
                float wB = sin((cP.x - cP.y) * 3.14159) * 0.5 + 0.5;
                float cell = smoothstep(-0.30, 0.30, sin(cP.x * 1.5708) * sin(cP.y * 1.5708));
                float twill = mix(wA, wB, cell);
                float ridge = twill * twill;
                col += pri * half(0.115 * ridge * glow) + half3(0.036 * twill);
              } else if (skin < 1.5) {
                // HEX: Analytical 0-loop cyber-hex armor lattice + scanline luster
                float2 r = float2(1.0, 1.7320508);
                float2 h = r * 0.5;
                float2 hp = dp / 10.0;
                float2 a = mod(hp, r) - h;
                float2 b = mod(hp - h, r) - h;
                float2 gv = dot(a, a) < dot(b, b) ? a : b;
                float edgeD = 0.5 - hexDist(gv);
                float hexLine = 1.0 - smoothstep(0.02, 0.13, edgeD);
                float scan = 0.70 + 0.30 * sin(dp.y * 2.4);
                col += pri * half(0.19 * hexLine * scan * glow) + hot * half(0.065 * hexLine * glow);
              } else {
                // BRUSH: Anodized brushed dark beskar / titanium grain + dual sheen
                float grain = hash12(float2(floor(dp.x * 0.15), floor(p.y * 0.85)));
                float sheen = 0.5 + 0.5 * sin(uv.x * 7.5 + uv.y * 2.0);
                float sheen2 = 0.5 + 0.5 * cos(uv.x * 3.2 - uv.y * 1.4);
                col += pri * half((0.085 * grain + 0.065 * sheen) * glow) + half3(0.045 * sheen * sheen2 * grain);
              }

              // 2. Command header recessed wash + razor-sharp laser-etched neon divider
              float divY = uSkin.z + uBar.z + 2.0;
              float inHeader = 1.0 - smoothstep(divY - 1.0, divY + 1.0, dp.y);
              col += pri * half(0.065 * inHeader * glow);

              float dDiv = abs(dp.y - divY);
              float centerFade = 1.0 - smoothstep(0.16, 0.52, abs(uv.x - 0.5));
              float divCore = exp(-dDiv * 2.8) * (0.30 + 0.70 * centerFade);
              float divHalo = exp(-dDiv * 0.36) * 0.24 * (0.35 + 0.65 * centerFade);
              col += hot * half(divCore * 0.62 * glow) + pri * half(divHalo * glow);

              // 3. Layered obsidian perimeter bloom + top glass specular chamfer
              float topEdge = exp(-dp.y * 0.45);
              float botEdge = exp(-(barH - dp.y) * 0.42);
              float sideD = min(dp.x, wDp - dp.x);
              float sideEdge = exp(-sideD * 0.32);

              col += hot * half(exp(-dp.y * 2.0) * 0.34 * glow);
              col += pri * half((topEdge * 0.26 + botEdge * 0.22 + sideEdge * 0.20) * glow);

              // Crisp corner telemetry L-brackets (4 corners, 0 loops)
              float cCornerX = 1.0 - smoothstep(11.0, 15.0, sideD);
              float cCornerY = 1.0 - smoothstep(11.0, 15.0, min(dp.y, barH - dp.y));
              float cEdge = 1.0 - smoothstep(1.2, 2.5, min(sideD, min(dp.y, barH - dp.y)));
              col += hot * half(cCornerX * cCornerY * cEdge * 0.68 * glow);

              // 4. Focused inverted-T D-pad navigation underglow on CORE deck (cols 3..5)
              if (uSkin.y < 0.5) {
                float2 navC = float2(0.50 * wDp, divY + uBar.y * 1.18);
                float2 nd = (dp - navC) / float2(wDp * 0.19, uBar.y * 1.02);
                float navAura = exp(-dot(nd, nd) * 1.65) * (1.0 - inHeader);
                col += pri * half(navAura * 0.26 * glow) + hot * half(navAura * 0.06 * glow);
              }

              // 5. Live modifier plasma conduit along bottom rail in cSec when ctrl/alt/shift latched
              float modPwr = max(uMod.x, max(uMod.y, uMod.z));
              if (modPwr > 0.05) {
                float rail = exp(-(barH - dp.y) * 0.80) * (0.45 + 0.55 * (1.0 - abs(uv.x - 0.5) * 1.3));
                col += mix(sec, hot, half(modPwr * 0.40)) * half(rail * 0.72 * modPwr);
              }

              // 6. Instantaneous tactile plasma bloom + energy ring under the pressed keycap
              if (uHit.z > 0.5) {
                float hitX = uHit.x * wDp;
                float hitY = divY + 2.0 + (uHit.y + 0.5) * uBar.y;
                float2 hd = (dp - float2(hitX, hitY)) / float2(wDp * 0.11, uBar.y * 0.85);
                float d2 = dot(hd, hd);
                float bloom = exp(-d2 * 1.30);
                float ringD = (sqrt(d2) - 0.88) * 5.0;
                float ring = exp(-(ringD * ringD)) * 0.50;
                col += pri * half(bloom * 0.82) + hot * half((bloom * 0.40 + ring) * max(glow, 0.55));
              }

              // Soft filmic Reinhard tonemap + 1-ALU OLED anti-banding hash dither
              col = col / (half3(1.0) + half(0.40) * col);
              half dither = half((hash12(p) - 0.5) * 0.004);
              col = clamp(col + dither, half3(0.0), half3(1.0));
              col *= half(0.45);
              col = max(col - half3(0.012), half3(0.0));
              return half4(col, half(1.0));
            }
          """
        }
      }

      // Crisp 1dp top specular glass-obsidian rim highlight (0-FPS idle)
      Box {
        fill: width
        height: 1
        background: linear(0, 0, 1, 0, [alpha(cPri, 0.08), cPri, cHot, cBone, cHot, cPri, alpha(cPri, 0.08)])
      }

      // Foreground command strip + sculpted 2x9 key matrix
      Column {
        fill: true
        padding: [3, padTop, 3, padBot]
        gap: 0

        // ---- 26dp Command, Telemetry & Live Customization Micro-Header ----
        Row {
          fill: width
          height: headerH
          padding: [4, 0, 4, 0]
          align: center
          gap: 4

          // Left: Brand Sigil OR Live Modifier Status Pill (tap clears active latches)
          Row {
            height: 20
            padding: [7, 0]
            align: center
            justify: center
            radius: 5 * radMul
            background: anyMod
              ? linear(0, 0, 0, 1, [alpha(cSec, 0.36), alpha(priCol, 0.14)])
              : alpha(cObs, 0.78)
            border: anyMod ? 1.1 : 0.8
            borderColor: anyMod ? cSec : alpha(priCol, 0.42)
            onPress: {
              if anyMod {
                latch("ctrl", "off")
                latch("alt", "off")
                latch("shift", "off")
                if hapticsOn { haptic() }
              }
            }
            Text {
              text: anyMod ? modBadge : "${tc.sigilGlyph ?? "◈"} ${brandTag}"
              font: anyMod ? bodyFont : dispFont
              fontWeight: 800
              fontSize: anyMod ? 9.5 : 10.5
              letterSpacing: anyMod ? 0.6 : 1.1
              maxLines: 1
              color: anyMod ? #ffffff : (curMode == "mask" ? cSec : curMode == "skeletor" ? cBone : hotCol)
            }
          }

          Spacer { weight: 1 }

          // Center: 4-Deck Switcher (CORE / SYM / OPS / MD)
          Row {
            gap: 3
            align: center
            DeckPill { label: "CORE"; idx: 0 }
            DeckPill { label: "SYM";  idx: 1 }
            DeckPill { label: "OPS";  idx: 2 }
            DeckPill { label: "MD";   idx: 3 }
          }

          Spacer { weight: 1 }

          // Right: open the HUB (all customization lives there)
          Row {
            height: 20
            padding: [6, 0]
            align: center
            justify: center
            radius: 5 * radMul
            background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cObs, 0.80), #000000, alpha(cSec, 0.11)])
            border: 0.85
            borderColor: alpha(priCol, 0.48)
            onPress: {
              if hapticsOn { haptic() }
              run("owl-send 25-sith-command-deck.owl set forgeReq $(date +%s%N)")
              launcher("page:0")
            }
            Text { text: "◈ HUB"; font: bodyFont; fontWeight: 700; fontSize: 9.5; maxLines: 1; color: hotCol }
          }
        }

        if useShader {
          Spacer { height: 4 }
        } else {
          Box {
            fill: width
            height: 4
            align: center
            padding: [6, 0, 6, 0]
            Box {
              fill: width
              height: 1
              background: anyMod ? cSec : alpha(priCol, 0.42 * glowMul)
            }
          }
        }

        // ---- 2x9 Tactile Keycap Matrix ----
        for row, ri in activeRows {
          Row {
            height: rowH
            gap: 5
            padding: 2.5
            for k, ci in row key "${ri}:${ci}" {
              if k.latch != null {
                Latched { k: k; ri: ri; ci: ci }
              } else if k.images ?? false {
                Images { k: k; ri: ri; ci: ci }
              } else {
                Plain { k: k; ri: ri; ci: ci }
              }
            }
          }
        }
      }

      // Latched modifier bottom plasma conduit rail (visible even in OLED / no-shader mode!)
      if anyMod && !useShader {
        Box {
          fill: width
          height: 2
          align: bottom
          background: linear(0, 0, 1, 0, [alpha(cSec, 0.15), cSec, hotCol, cSec, alpha(cSec, 0.15)])
        }
      }
    }
  }
}
