app "cardboard" {
  meta {
    owl: 22
    description: "Sith Command Deck & Cardboard: AMOLED standalone card engine with S/M/L cards, Markdown, interactive tables, obsidian vault sync & terminal launcher."
    category: "tools"
  }
  requires { pacman: ["python", "btop"] }
  title: ""
  edge: true
  statusBar: false
  back: screenMode != "deck"
  onBack: {
    screenMode = "deck"
  }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#050002"/>
    <circle cx="128" cy="128" r="104" fill="#0d0005" stroke="#ff1e3c" stroke-width="3" stroke-opacity="0.35"/>
    <circle cx="128" cy="128" r="92" fill="#140108" stroke="#ff1e3c" stroke-width="1.5" stroke-opacity="0.6"/>
    <!-- Outer Sith Star / Crest Radiants -->
    <path d="M128 28 L138 72 L164 44 L152 86 L188 72 L162 104 L204 104 L168 128 L204 152 L162 152 L188 184 L152 170 L164 212 L138 184 L128 228 L118 184 L92 212 L104 170 L68 184 L94 152 L52 152 L88 128 L52 104 L94 104 L68 72 L104 86 L92 44 L118 72 Z" fill="#ff1e3c" fill-opacity="0.18"/>
    <!-- Central Sith Hex Blade -->
    <polygon points="128,42 192,84 192,172 128,214 64,172 64,84" fill="#1f020a" stroke="#ff1e3c" stroke-width="4"/>
    <polygon points="128,58 178,92 178,164 128,198 78,164 78,92" fill="#080003" stroke="#ff3850" stroke-width="2"/>
    <!-- Core Crimson Saber Crystal / Omen Rune -->
    <polygon points="128,74 156,128 128,182 100,128" fill="#ff1e3c"/>
    <polygon points="128,90 146,128 128,166 110,128" fill="#ff8596"/>
    <polygon points="128,106 136,128 128,150 120,128" fill="#ffffff"/>
    <circle cx="128" cy="128" r="5" fill="#ffffff"/>
  </svg>"""

  // ---------------- SOURCES ----------------
  // Shared theme switch (set from the infernal face pill): "infernal" or "future"
  // THE HUB: one settings file for every page (written only via run("owl-hub key value"))
  source hub = file("~/.config/omalauncher/hub.json") json optional
  let rzBusy = (hub.busy ?? false) == true
  let rzRes = rzBusy ? 0.5 : 1
  let gpuRes = clamp(num(hub.res, 1), 0.25, 1)   // full-screen shader resolution (hub.res); lower = faster
  let hubTheme   = hub.theme ?? "vader"
  let curMode    = hub.mode ?? "infernal"
  let T          = hub.tok ?? {}
  let tc         = T.copy ?? {}
  let modeIdx    = num(T.modeIdx, 0)
  // ---- GLOBAL THEME BACKDROP tokens (shared by every face; one panorama, low-res) ----
  let bgRes  = clamp(min(num(hub.res, 1), 0.5), 0.25, 0.5)   // backdrop always <= 50% res
  let bgGlow = 0.75 + 0.15 * clamp(num(hub.glow, 1), 0, 3)
  let bgPri  = T.pri  != null ? rgb(T.pri[0],  T.pri[1],  T.pri[2])  : #ff1e3c
  let bgHot  = T.hot  != null ? rgb(T.hot[0],  T.hot[1],  T.hot[2])  : #ff8596
  let bgSec  = T.sec  != null ? rgb(T.sec[0],  T.sec[1],  T.sec[2])  : #3d9bff
  let bgDim  = T.dim  != null ? rgb(T.dim[0],  T.dim[1],  T.dim[2])  : #6b0918
  let bgBone = T.bone != null ? rgb(T.bone[0], T.bone[1], T.bone[2]) : #fff0f2
  let hubFx      = (hub.fx ?? true) == true
  let hubFxLevel = num(hub.fxLevel, 1)
  let hubSpeed   = num(hub.speed, 1.0)
  let hubGlow    = num(hub.glow, 1)
  let hubSurface = hub.surface ?? "obsidian"
  let hubTexture = hub.texture ?? "grid"
  let hubFont    = hub.font ?? "sith"
  let hubRadius  = clamp(num(hub.radius, 1.0), 0.6, 1.4)
  let hubHaptics = (hub.haptics ?? true) == true
  let hubEco     = (hub.eco ?? false) == true
  let hubDeck    = hub.deck ?? {}
  let hubDrawer  = hub.drawer ?? {}
  let hubKeybar  = hub.keybar ?? {}
  // ---- IMAGES: Android photo picker → Terminal inbox (deck-img.py) → crop → card / canvas ----
  source imgInbox = file("~/.local/state/deck-img.json") json optional
  state tapBounce = ""   // press-bounce: which tappable is held (springs back on release)
  state imgTarget = "card"     // "card" (insert into editor body) | "canvas" (new image card)
  state imgSrc    = null       // picked inbox item {path, w, h}
  state imgAspect = "1:1" persist
  state imgZ      = 1.0
  state imgOX     = 0
  state imgOY     = 0
  state imgG      = ""
  state imgT0     = [0, 0, 0, 1, 1.0]   // x, y (or pinch distance), ox0, oy0, z0
  state imgRes    = ""
  state imgBusy   = false
  on imgRes {
    if value != "" {
      let r = parseJson(value)
      imgBusy = false
      if r != null && r.ok == true {
        if imgTarget == "card" {
          noteBody = trim(noteBody) == "" ? "![[${r.path}]]" : "${noteBody}\n![[${r.path}]]"
          screenMode = "noteEditor"
        } else {
          let nid = nextNoteId
          nextNoteId = nextNoteId + 1
          holocronNotes = holocronNotes + [{ id: nid, pg: cvPg, fld: max(cvFolder, 0), title: "", text: "", img: r.path, imgAr: r.w / max(1, r.h), colorIdx: 0, time: timeHm, tw: 2, th: clamp(round(2 * max(1, r.h) / max(1, r.w)), 1, 6) }]
          cvSel = nid
          imgSrc = null
          close()
        }
      } else {
        statusMsg = "image: ${r.error ?? value}"
        statusOk = false
      }
    }
  }
  state cvPage = 0 persist   // canvas page (0-based)
  // Canvas folders: picker first (-1), 0 = UNSORTED, else a folder id. Cards carry `fld`.
  state cvFolder   = -1
  state cvFolders  = [] persist
  state nextFldId  = 1 persist
  state fldEdit    = false
  state fldEditId  = 0
  state fldName    = ""
  state fldCol     = 0
  // Drop slot: `owl-send 25-sith-command-deck.owl set cardDrop '{"text":"## Hi"}'` appends a card
  // (feed + canvas; the auto-placer gives it the first free spot from page 1)
  state cardDrop = null
  on cardDrop {
    if value != null && trim(value.text ?? "") != "" {
      let nid = nextNoteId
      nextNoteId = nextNoteId + 1
      holocronNotes = holocronNotes + [merge({ title: "", colorIdx: 0, fontWeight: 600, align: "start", time: timeHm, pg: 0 }, merge(value, { id: nid }))]
      cardDrop = null
    }
  }
  state cvDel = 0   // card whose ✕ was pressed (canvas)
  state viewLocal = ""   // instant view switch; hub.json is written in the background
  let deckView   = "feed"   // canvas retired: the deck is a foldered feed
  let hubCardFont = hubDeck.cardFont ?? "sans"
  let hubCardSize = hubDeck.cardSize ?? "md"
  let hubBodySz  = num(hubDeck.bodySz, 14)
  let edFont     = num(hubDeck.editorFont, 14.5)
  let hubCvGrid  = (hubDeck.canvasGrid ?? true) == true
  let uiFont   = T.fontPath ?? "sans"
  let dispFont = T.displayFontPath ?? uiFont
  let bodyFont = T.bodyFont ?? (hub.font == "mono" ? "mono" : "sans")
  source now   = clock every 30s
  source bat   = android.battery
  source sys   = android.system every 30s
  source modes = android.modes
  source vol   = android.volume
  source d     = android.drawer
  source panel = cmd("python3 ~/.local/share/omalauncher/synth-pads/sith_panel.py scan") every 10m json timeout 20s
  source forgeData = cmd("python3 ~/.local/bin/theme-forge.py list") every 12s json
  // ---------------- UNIFIED 4-THEME TOKEN PALETTE (owl-hub -> hub.tok) ----------------
  let cPri    = (hub.eco ?? false) == true ? (T.ecoPri  != null ? rgb(T.ecoPri[0],  T.ecoPri[1],  T.ecoPri[2])  : #b8263a) : (T.pri  != null ? rgb(T.pri[0],  T.pri[1],  T.pri[2])  : #ff1e3c)
  let cMid    = T.mid   != null ? rgb(T.mid[0],   T.mid[1],   T.mid[2])   : #ff3850
  let cHot    = (hub.eco ?? false) == true ? (T.ecoHot  != null ? rgb(T.ecoHot[0],  T.ecoHot[1],  T.ecoHot[2])  : #d94c5e) : (T.hot  != null ? rgb(T.hot[0],  T.hot[1],  T.hot[2])  : #ff8596)
  let cSec    = T.sec   != null ? rgb(T.sec[0],   T.sec[1],   T.sec[2])   : #ff6a1a
  let cBone   = (hub.eco ?? false) == true ? (T.ecoBone != null ? rgb(T.ecoBone[0], T.ecoBone[1], T.ecoBone[2]) : #c7a3a8) : (T.bone != null ? rgb(T.bone[0], T.bone[1], T.bone[2]) : #fff0f2)
  let cDim    = (hub.eco ?? false) == true ? (T.ecoDim  != null ? rgb(T.ecoDim[0],  T.ecoDim[1],  T.ecoDim[2])  : #4d0c18) : (T.dim  != null ? rgb(T.dim[0],  T.dim[1],  T.dim[2])  : #6b0918)
  let cDeep   = T.deep  != null ? rgb(T.deep[0],  T.deep[1],  T.deep[2])  : #170206
  let cCard   = T.card  != null ? rgb(T.card[0],  T.card[1],  T.card[2])  : #0c0104
  let cObs    = T.obs   != null ? rgb(T.obs[0],   T.obs[1],   T.obs[2])   : #050002
  let cInk    = T.ink   != null ? rgb(T.ink[0],   T.ink[1],   T.ink[2])   : #fff0f2
  let cMuted  = T.muted != null ? rgb(T.muted[0], T.muted[1], T.muted[2]) : #c77c88
  let cFlair  = curMode == "skeletor" ? cBone : cSec

  // ---------------- STATE ----------------
  // Global look comes from the HUB (hub.json); old per-deck states are now derived from it
  let shaderMode  = hubSurface == "oled" ? "oled" : hubFxLevel >= 2 ? "plasma" : "obsidian"
  let deckTexture = hubTexture == "none" ? "smooth" : hubTexture
  let deckGlow    = hubGlow <= 0 ? 0.55 : hubGlow >= 2 ? 1.55 : 1.0
  let cardSkin    = hubSurface == "glass" ? "glass" : hubSurface == "oled" ? "minimal" : "obsidian"
  state hubResetArm = false
  state hubPend = ""
  state quickThemeIn = ""
  state forgeMsg = ""
  state forgeRes = ""
  on hub { hubPend = "" }
  on forgeRes {
    if value != "" {
      let r = parseJson(value)
      forgeMsg = r != null && r.ok == true ? (r.msg ?? "FORGED & APPLIED") : (r != null && r.error != null ? r.error : value)
    }
  }

  // Simple Card Editor State
  state editId          = 0
  state noteTitle       = ""
  state noteBody        = ""
  state noteSize        = "md" persist   // "sm" | "md" | "lg"
  state noteSkin        = "obsidian" persist
  state noteFont        = "sans" persist // "sans" | "mono" | "serif"
  state noteBodySz      = 14 persist
  state noteWeight      = 600 persist
  state noteAlign       = "start" persist
  state noteColorIdx    = 0 persist
  state noteFld         = 0   // folder the card being edited goes to
  state notePinned      = false
  state noteAccentBar   = true persist
  state noteBorderStyle = "hairline" persist // "hairline" | "bold" | "none"
  state nextNoteId      = 4 persist

  // Table Builder State
  state tblTargetMode   = "newCard"
  state tblCardTitle    = "Task Tracker"
  state tblPresetId     = "tasks"
  state tblHeaders      = ["Task", "Status", "Priority"]
  state tblRows         = [
    ["Design UI", "Done", "High"],
    ["Build Tables", "WIP", "High"],
    ["Polish Perf", "Todo", "Med"]
  ]
  state tblEditRow      = -1
  state tblEditCol      = 0
  state tblCellDraft    = "Task"

  // Card-After-Card Feed Notes
  state holocronNotes   = [
    {
      id: 1,
      size: "md",
      title: "SITH COMMAND DECK",
      text: "Clean **card-after-card** deck with ==S / M / L== cards and tables.\n- [x] Simple vertical feed\n- [ ] Tap checkboxes directly\n- [ ] Tap ✎ to edit or resize",
      font: uiFont
      bodySz: 14,
      fontWeight: 600,
      align: "start",
      colorIdx: 0,
      pinned: true,
      accentBar: true,
      borderStyle: "hairline",
      time: "NOW"
    },
    {
      id: 2,
      size: "md",
      title: "SYSTEM BENCHMARKS",
      text: "| Module | Frame | Status |\n| --- | --- | --- |\n| Feed UI | 1.1ms | READY |\n| Tables | 0.3ms | LIVE |\n| Shader | 0.3ms | OPT |",
      font: uiFont
      bodySz: 13.5,
      fontWeight: 600,
      align: "start",
      colorIdx: 8,
      pinned: false,
      accentBar: true,
      borderStyle: "hairline",
      time: "TABLE"
    }
  ] persist

  // Screen Multiplexing & Sith Lyfe Control
  state screenMode      = "deck"
  state tab             = "customize" persist
  state forgeReq        = 0   // legacy trigger (owl-send … set forgeReq) → opens the HUB
  state hubReq          = 0   // owl-send … set hubReq → opens the HUB
  // Obsidian Markdown editor + Canvas board (tiles as card markers)
  state mdCopied   = ""
  state mdFold     = []
  state mdInk      = {} persist   // global Markdown ink: element -> swatch index (0 = card palette)
  state edMode     = "live"
  // LIVE editor: one rendered block at a time is edited as plain text (markup hidden)
  state edBlkS     = -1
  state edBlkE     = -1
  state edBlkPre   = ""
  state edBlkPost  = ""
  state edBlkTxt   = ""
  state edBlkKind  = ""
  state edFmt      = "text"   // selected composer style (color-coded)
  state edPrev     = ""
  state edQuick    = ""
  state qcText     = ""
  state edCanUndo  = false
  state edCallMenu = false
  state edClearArm = false
  state cvZoom     = 1.0 persist
  state cvPanX     = 0 persist
  state cvPanY     = 0 persist
  state cvSel      = 0
  state expandId   = 0
  state cvGest     = ""
  state cvHit      = 0
  state cvOnHandle = false
  state cvSX       = 0
  state cvSY       = 0
  state cvP0X      = 0
  state cvP0Y      = 0
  state cvZ0       = 1.0
  state cvD0       = 1
  state cvM0X      = 0
  state cvM0Y      = 0
  state cvDX       = 0
  state cvDY       = 0
  state cvEditReq  = 0
  state owlView         = "active"
  state appFilter       = "all"
  state linuxView       = "pkgs"
  state pkgSort         = "size"
  state query           = ""
  state confirmKey      = ""
  state busy            = false
  state cmdOut          = ""
  state statusMsg       = ""
  state statusOk        = true

  // Shader Animation Clock & Tactile Burst Ripple
  state fxT             = 0
  state burstT          = 0
  state burstX          = 0.5
  state burstY          = 0.14

  // ---------------- DERIVED DATA (ULTRA-LEAN) ----------------
  let ecoOn         = hubEco
  let animMasterRaw = hubFx
  let saver = ((bat.level ?? 100) < 20 && !((bat.charging ?? false) == true)) || (modes.saver ?? false) == true   // low battery or Android Battery Saver: hold still instead of stutter
  let animMaster    = animMasterRaw && !ecoOn && !saver
  let hapticsOn     = hubHaptics
  let animSpeed     = clamp(hubSpeed, 0.5, 2.0) * (hubFxLevel <= 0 ? 0.6 : 1.0)

  let effFxOn       = animMaster
  let deckScanOn    = animMaster && hubFxLevel >= 1
  let isOledMode    = shaderMode == "oled" || shaderMode == "amoled"
  let accentCol     = cPri
  let accentDark    = cDeep
  let accentHot     = cHot
  let accentGhost   = cDim
  let accentEmber   = cFlair
  let hiInk         = cInk
  let amberInk      = cBone
  let titleCol      = accentHot
  let timeHm        = fmtTime(now, "HH:mm")
  let deckMemPct    = round((sys.memory.used ?? 0) / max(sys.memory.total ?? 1, 1) * 100)

  let uModeVal = shaderMode == "plasma"   ? 0.0
               : shaderMode == "obsidian" ? 1.0
               : shaderMode == "glitch"   ? 2.0
               : shaderMode == "void"     ? 3.0
               : shaderMode == "aurora"   ? 4.0
               : 5.0

  let uTexVal  = deckTexture == "hex"    ? 1.0
               : deckTexture == "grid"   ? 2.0
               : 3.0

  let cardSkins = [
    { id: "obsidian", label: "OBSIDIAN", desc: "Machined pitch-black bevel" },
    { id: "amber",    label: "AMBER",    desc: "Warm gilded obsidian frame" },
    { id: "glass",    label: "GLASS",    desc: "Frosted translucent glass" },
    { id: "cyber",    label: "CYBER",    desc: "Sharp chamfered HUD edge" },
    { id: "minimal",  label: "MINIMAL",  desc: "Quiet ultra-clean slate" }
  ]

  // 12 Curated Obsidian · Crimson · Molten Amber Palettes (indices 0..11 persist-compatible)
  let notePalettes = [
    { id: "crimson",   name: "Primary",  bg: cCard,                      bg2: cDeep,                      border: cPri,                      tag: cHot,                      text: cInk  },
    { id: "obsidian",  name: "Obsidian", bg: cObs,                       bg2: cCard,                      border: cDim,                      tag: cHot,                      text: cInk  },
    { id: "blood",     name: "Deep",     bg: cDeep,                      bg2: mix(cDeep, cDim, 0.35),    border: cMid,                      tag: cHot,                      text: cInk  },
    { id: "void",      name: "Void",     bg: #000000,                    bg2: cObs,                       border: cDim,                      tag: cPri,                      text: cInk  },
    { id: "scarlet",   name: "Radiant",  bg: cCard,                      bg2: mix(cDeep, cPri, 0.14),    border: cHot,                      tag: cHot,                      text: cInk  },
    { id: "ember",     name: "Relic",    bg: cCard,                      bg2: mix(cDeep, cFlair, 0.14),  border: cFlair,                    tag: cBone,                     text: cInk  },
    { id: "cinder",    name: "Gilded",   bg: cObs,                       bg2: mix(cCard, cBone, 0.12),   border: mix(cFlair, cDim, 0.30),   tag: cFlair,                    text: cInk  },
    { id: "vampire",   name: "Arcane",   bg: mix(cCard, cSec, 0.08),     bg2: mix(cDeep, cSec, 0.18),    border: cSec,                      tag: cHot,                      text: cInk  },
    { id: "sith",      name: "Sovereign",bg: cObs,                       bg2: cDeep,                      border: cPri,                      tag: cFlair,                    text: cInk  },
    { id: "abyss",     name: "Abyss",    bg: #000000,                    bg2: cCard,                      border: mix(cDim, cPri, 0.35),     tag: cMuted,                    text: cInk  },
    { id: "garnet",    name: "Flare",    bg: cDeep,                      bg2: mix(cDeep, cSec, 0.22),    border: cFlair,                    tag: cBone,                     text: cInk  },
    { id: "eclipse",   name: "Eclipse",  bg: cObs,                       bg2: mix(cDeep, cBone, 0.10),   border: mix(cBone, cDim, 0.45),    tag: cBone,                     text: cInk  }
  ]

  let quickSwatches = [
    { idx: 1,  label: "Obsidian" },
    { idx: 0,  label: "Crimson"  },
    { idx: 8,  label: "Sith"     },
    { idx: 5,  label: "Ember"    },
    { idx: 4,  label: "Scarlet"  },
    { idx: 10, label: "Garnet"   },
    { idx: 11, label: "Eclipse"  },
    { idx: 3,  label: "Void"     },
    { idx: 2,  label: "Blood"    },
    { idx: 6,  label: "Cinder"   },
    { idx: 7,  label: "Vampire"  },
    { idx: 9,  label: "Abyss"    }
  ]

  let cardTemplates = [
    { id: "blank",     label: "Blank",     title: "",            body: "",                                                                                                          font: uiFont },
    { id: "checklist", label: "Checklist", title: "CHECKLIST",   body: "- [ ] Priority task\n- [ ] Second step\n- [ ] Final review",                                                font: uiFont },
    { id: "table",     label: "Table",     title: "QUICK TABLE", body: "| Item | Status | Notes |\n| --- | --- | --- |\n| Alpha | Active | Core |\n| Beta | Next | Queue |",         font: uiFont },
    { id: "callout",   label: "Callout",   title: "KEY INSIGHT", body: "> [!tip] Highlight\nCore takeaway or note here.\n---\n- [ ] Follow up",                                       font: uiFont },
    { id: "code",      label: "Code",      title: "SNIPPET",     body: "# Command\n`pacman -Syu`\n---\n- Notes or flags here",                                                        font: uiFont }
  ]

  let tablePresets = [
    {
      id: "grid2x2",
      label: "⊞ 2×2 Grid",
      title: "2×2 Grid",
      headers: ["Col A", "Col B"],
      rows: [["Item 1", "Value 1"], ["Item 2", "Value 2"]]
    },
    {
      id: "matrix3x3",
      label: "▦ 3×3 Matrix",
      title: "3×3 Matrix",
      headers: ["Item", "Col 1", "Col 2"],
      rows: [["Row 1", "A1", "B1"], ["Row 2", "A2", "B2"], ["Row 3", "A3", "B3"]]
    },
    {
      id: "tasks",
      label: "☑ Task Tracker",
      title: "Task Tracker",
      headers: ["Task", "Status", "Priority"],
      rows: [["Design UI", "Done", "High"], ["Build Tables", "WIP", "High"], ["Polish Perf", "Todo", "Med"]]
    },
    {
      id: "schedule",
      label: "◷ Schedule",
      title: "Daily Schedule",
      headers: ["Time", "Block", "Notes"],
      rows: [["09:00", "Deep Work", "Core focus"], ["12:00", "Break", "Recharge"], ["14:00", "Review", "Ship & QA"]]
    },
    {
      id: "kv",
      label: "◈ Key-Value",
      title: "Spec Sheet",
      headers: ["Field", "Value"],
      rows: [["Status", "Active"], ["Owner", "Sith Deck"], ["Target", "< 2ms"]]
    }
  ]

  let tblMdHead = "| " + join(
    tblHeaders.map(h => replace(trim(h ?? ""), "|", "/") == "" ? "—" : replace(trim(h ?? ""), "|", "/")),
    " | "
  ) + " |"
  let tblMdSep  = "| " + join(tblHeaders.map(h => "---"), " | ") + " |"
  let tblMdBody = join(
    tblRows.map(r =>
      "| " + join(
        range(len(tblHeaders)).map(ci => replace(trim(r[ci] ?? ""), "|", "/") == "" ? " " : replace(trim(r[ci] ?? ""), "|", "/")),
        " | "
      ) + " |"
    ),
    "\n"
  )
  let tblMarkdown = tblMdHead + "\n" + tblMdSep + "\n" + tblMdBody

  // ---------------- OBSIDIAN TOKENS (see ~/.claude/skills/obsidian-css) ----------------
  // Heading scale = Obsidian default app.css (--h1-size … --h6-size, in em of --font-text-size)
  let obsH = [1.618, 1.462, 1.318, 1.188, 1.076, 1.0]
  // ---- MARKDOWN INK: one global color per Markdown element, applied to every card ----
  let inkSw   = [#000000, #ffe8ec, #ffb3c0, #ff2a44, #ff6f85, #ff8c1a, #ffe14a, #2bff8c, #3da8ff, #ff3df0, #b48cff, #ffffff]
  let inkN    = len(inkSw)
  let inkBody  = clamp(num(mdInk.body, 0), 0, inkN - 1) > 0 ? inkSw[clamp(num(mdInk.body, 0), 0, inkN - 1)] : null
  let inkH1    = clamp(num(mdInk.h1, 0), 0, inkN - 1) > 0 ? inkSw[clamp(num(mdInk.h1, 0), 0, inkN - 1)] : null
  let inkH2    = clamp(num(mdInk.h2, 0), 0, inkN - 1) > 0 ? inkSw[clamp(num(mdInk.h2, 0), 0, inkN - 1)] : null
  let inkH3    = clamp(num(mdInk.h3, 0), 0, inkN - 1) > 0 ? inkSw[clamp(num(mdInk.h3, 0), 0, inkN - 1)] : null
  let inkBold  = clamp(num(mdInk.bold, 0), 0, inkN - 1) > 0 ? inkSw[clamp(num(mdInk.bold, 0), 0, inkN - 1)] : null
  let inkItal  = clamp(num(mdInk.ital, 0), 0, inkN - 1) > 0 ? inkSw[clamp(num(mdInk.ital, 0), 0, inkN - 1)] : null
  let inkLink  = clamp(num(mdInk.link, 0), 0, inkN - 1) > 0 ? inkSw[clamp(num(mdInk.link, 0), 0, inkN - 1)] : null
  let inkCode  = clamp(num(mdInk.code, 0), 0, inkN - 1) > 0 ? inkSw[clamp(num(mdInk.code, 0), 0, inkN - 1)] : null
  let inkQuote = clamp(num(mdInk.quote, 0), 0, inkN - 1) > 0 ? inkSw[clamp(num(mdInk.quote, 0), 0, inkN - 1)] : null
  let inkTitle = clamp(num(mdInk.title, 0), 0, inkN - 1) > 0 ? inkSw[clamp(num(mdInk.title, 0), 0, inkN - 1)] : null
  let inkKeys = [
    { k: "title", l: "card titles" }, { k: "body", l: "body text" },
    { k: "h1", l: "# heading 1" }, { k: "h2", l: "## heading 2" }, { k: "h3", l: "### heading 3-6" },
    { k: "bold", l: "**bold**" }, { k: "ital", l: "*italic*" }, { k: "link", l: "links" },
    { k: "code", l: "`code`" }, { k: "quote", l: "> quotes" }
  ]
  // COLOR-CODED MARKDOWN STYLES: one color per block type, used by the composer chips,
  // the block stripes in LIVE view and the "change type" chips while editing a block.
  let edFmts = [
    { id: "text",   l: "¶ TEXT",    tag: "TEXT",  c: #ffe8ec, pre: "",       post: "",       line: true  },
    { id: "h1",     l: "H1",        tag: "H1",    c: #ff2a44, pre: "# ",     post: "",       line: true  },
    { id: "h2",     l: "H2",        tag: "H2",    c: #ff8c1a, pre: "## ",    post: "",       line: true  },
    { id: "h3",     l: "H3",        tag: "H3",    c: #ffe14a, pre: "### ",   post: "",       line: true  },
    { id: "bullet", l: "• LIST",    tag: "LIST",  c: #3da8ff, pre: "- ",     post: "",       line: true  },
    { id: "num",    l: "1. LIST",   tag: "1.",    c: #22d1ff, pre: "1. ",    post: "",       line: true  },
    { id: "task",   l: "☐ TASK",    tag: "TASK",  c: #2bff8c, pre: "- [ ] ", post: "",       line: true  },
    { id: "quote",  l: "❝ QUOTE",   tag: "QUOTE", c: #b48cff, pre: "> ",     post: "",       line: true  },
    { id: "code",   l: "</> CODE",  tag: "CODE",  c: #00e5c0, pre: "```\n",  post: "\n```",  line: false },
    { id: "bold",   l: "B BOLD",    tag: "TEXT",  c: #ff3df0, pre: "**",     post: "**",     line: false },
    { id: "div",    l: "— LINE",    tag: "LINE",  c: #8a8a8a, pre: "---",    post: "",       line: false }
  ]
  // code-block syntax keywords per detected language
  let codeKw = {
    python: ["def", "class", "import", "from", "return", "if", "elif", "else", "for", "while", "in", "not", "and", "or", "with", "as", "try", "except", "None", "True", "False", "lambda", "yield", "pass", "break", "continue"],
    js: ["function", "const", "let", "var", "return", "if", "else", "for", "while", "import", "export", "from", "class", "new", "async", "await", "true", "false", "null", "undefined", "=>"],
    bash: ["if", "then", "else", "fi", "for", "do", "done", "while", "case", "esac", "function", "export", "sudo", "echo", "in", "&&", "||", "|"],
    owl: ["widget", "face", "panel", "component", "state", "let", "source", "for", "in", "if", "else", "when", "on", "every", "persist", "true", "false", "null"],
    sql: ["select", "from", "where", "and", "or", "insert", "into", "update", "set", "delete", "join", "on", "group", "by", "order", "limit", "as", "SELECT", "FROM", "WHERE", "JOIN", "ORDER", "GROUP", "BY", "LIMIT"],
    json: ["true", "false", "null"]
  }
  // Callout types + aliases → glyph (stand-in for the Lucide icon) and Obsidian dark-theme hue.
  // Unknown types fall back to note, as in Obsidian. Rendered hue = mix(c, pal.tag, 0.3).
  let obsCallouts = {
    note:      { g: "✎", c: cPri },
    abstract:  { g: "☰", c: cHot },
    summary:   { g: "☰", c: cHot },
    tldr:      { g: "☰", c: cHot },
    info:      { g: "ⓘ", c: cMid },
    todo:      { g: "◉", c: cPri },
    tip:       { g: "✦", c: cHot },
    hint:      { g: "✦", c: cHot },
    important: { g: "✦", c: cFlair },
    success:   { g: "✓", c: #2bff8c },
    check:     { g: "✓", c: #2bff8c },
    done:      { g: "✓", c: #2bff8c },
    question:  { g: "?", c: cBone },
    help:      { g: "?", c: cBone },
    faq:       { g: "?", c: cBone },
    warning:   { g: "⚠", c: #ffb02e },
    caution:   { g: "⚠", c: #ffb02e },
    attention: { g: "⚠", c: #ffb02e },
    failure:   { g: "✕", c: #ff3850 },
    fail:      { g: "✕", c: #ff3850 },
    missing:   { g: "✕", c: #ff3850 },
    danger:    { g: "⚡", c: #ff3850 },
    error:     { g: "⚡", c: #ff3850 },
    bug:       { g: "☣", c: #ff3850 },
    example:   { g: "☷", c: cSec },
    quote:     { g: "❝", c: cMuted },
    cite:      { g: "❝", c: cMuted }
  }

  // ---------------- CANVAS BOARD GEOMETRY (gated on canvas view — 0ms in Feed mode) ----------------
  // The board is full width (face padding 0) and sits under fixed-height rows: header plate,
  // telemetry, actions, toolbar (≈220dp above) and the page bar (72dp + screenInset below).
  // The page IS the board: 4 columns fill its width, cvRows rows fill its height (cells may be
  // slightly taller than wide), so cards can be sized right up to the border on every side.
  let cvPageW    = max(240, (screenWidth ?? tileWidth ?? 400) ?? 400)
  let cvPageH    = max(240, ((screenHeight ?? tileHeight ?? 800) ?? 800) - 301 - screenInset)
  let cvCell     = cvPageW / 4
  let cvRows     = max(3, round(cvPageH / cvCell))
  let cvCellY    = cvPageH / cvRows
  let cvCx       = cvPageW / 2
  let cvCy       = cvPageH / 2
  let cvPages    = clamp(round(num(hubDeck.canvasPages, 10)), 1, 50)
  let cvPg       = clamp(cvPage, 0, cvPages - 1)
  let fldCols    = [#ff1e3c, #ff8a00, #ffd21a, #2bff8c, #17e0c0, #3d9bff, #a24bff, #ff2fa8]
  let fldNames   = ["CRIMSON", "EMBER", "GOLD", "TOXIN", "TEAL", "ICE", "VIOLET", "NEON"]
  let cvFld      = cvFolders.find(f => f.id == cvFolder)
  let cvFldCol   = cvFld != null ? fldCols[cvFld.col % len(fldCols)] : accentCol
  let cvOnPage   = (deckView != "canvas" || cvFolder < 0) ? [] : holocronNotes.filter(c => (c.fld ?? 0) == cvFolder && clamp(c.pg ?? 0, 0, cvPages - 1) == cvPg)
  // one pass per card: size clamped to the page, then position clamped (old oversized cards come back in);
  // the card itself rides along so the board never searches holocronNotes per card
  let cvRaw      = deckView != "canvas" ? [] : cvOnPage.map(c => merge({}, {
    id: c.id,
    card: c,
    tx: c.tx ?? 0,
    ty: c.ty ?? 0,
    tw: clamp(c.tw ?? 2, 1, 4),
    th: clamp(c.th ?? 3, 1, cvRows)
  }))
  let cvRects    = cvRaw.map(r => merge(r, { tx: clamp(r.tx, 0, 4 - r.tw), ty: clamp(r.ty, 0, cvRows - r.th) }))
  let cvBoxes    = deckView != "canvas" ? [] : cvRects.map(r => merge(r, { x: r.tx * cvCell + 5, y: r.ty * cvCellY + 5, w: r.tw * cvCell - 10, h: r.th * cvCellY - 10 }))
  let cvSelR     = deckView != "canvas" ? null : cvBoxes.find(r => r.id == cvSel)
  let cvTgt      = cvSelR == null ? null
                 : cvGest == "resize" ? { tx: cvSelR.tx, ty: cvSelR.ty, tw: clamp(round(cvSelR.tw + cvDX / cvCell), 1, max(1, 4 - cvSelR.tx)), th: clamp(round(cvSelR.th + cvDY / cvCellY), 1, max(1, cvRows - cvSelR.ty)) }
                 : { tx: clamp(round(cvSelR.tx + cvDX / cvCell), 0, max(0, 4 - cvSelR.tw)), ty: clamp(round(cvSelR.ty + cvDY / cvCellY), 0, max(0, cvRows - cvSelR.th)), tw: cvSelR.tw, th: cvSelR.th }

  // ---------------- CANVAS AUTO-PLACE ----------------
  // Every card without a canvas spot (added on the feed, duplicated, a table, an image, or SENT to a page)
  // takes the first free 2×3 slot on its page, starting at page 1 for the feed; a full page spills to the next.
  let cvSlotRows = max(1, floor(cvRows / 3))
  let cvPerPage  = cvSlotRows * 2
  let cvSlots    = range(cvPages * cvPerPage).map(i => merge({}, { pg: floor(i / cvPerPage), tx: ((i % cvPerPage) % 2) * 2, ty: floor((i % cvPerPage) / 2) * 3 }))
  when (screenHeight ?? tileHeight ?? 800) != null && holocronNotes.any(c => c.tx == null) {
    holocronNotes = reduce(range(len(holocronNotes)), (acc, i) => acc[i].tx != null ? acc : set(acc, i, merge(
      merge(acc[i], { pg: clamp(acc[i].pg ?? 0, 0, cvPages - 1), tx: 0, ty: 0, tw: 2, th: clamp(acc[i].th ?? 3, 1, 3) }),
      cvSlots.find(sl => sl.pg >= clamp(acc[i].pg ?? 0, 0, cvPages - 1) && !acc.any(c => c.tx != null && clamp(c.pg ?? 0, 0, cvPages - 1) == sl.pg && sl.tx < c.tx + clamp(c.tw ?? 2, 1, 4) && sl.tx + 2 > c.tx && sl.ty < (c.ty ?? 0) + (c.th ?? 3) && sl.ty + 3 > (c.ty ?? 0))) ?? {}
    )), holocronNotes)
  }

  // ---------------- LISTENERS ----------------
  on forgeReq {
    screenMode = "sith"
    tab = "customize"
    confirmKey = ""
    query = ""
    statusMsg = ""
    // screen()
  }
  on hubReq {
    screenMode = "sith"
    tab = "customize"
    confirmKey = ""
    query = ""
    statusMsg = ""
    // screen()
  }

  on cvEditReq {
    let c = holocronNotes.find(x => x.id == cvSel)
    if c != null {
      editId = c.id
      noteTitle = c.title ?? ""
      noteBody = c.text ?? ""
      noteSize = c.size ?? "md"
      noteSkin = c.skin ?? cardSkin
      noteFont = c.font ?? "sans"
      noteBodySz = c.bodySz ?? 14
      noteWeight = c.fontWeight ?? 600
      noteAlign = c.align ?? "start"
      noteColorIdx = c.colorIdx ?? 0
      noteFld = c.fld ?? 0
      notePinned = c.pinned == true
      noteAccentBar = c.accentBar ?? true
      noteBorderStyle = c.borderStyle ?? "hairline"
      edMode = "live"
      edBlkS = -1
      edCanUndo = false
      screenMode = "noteEditor"
      // screen()
    }
  }

  on cmdOut {
    if value != "" {
      let parsed = parseJson(value)
      if parsed != null {
        statusOk = parsed.ok == true
        statusMsg = parsed.msg ?? value
      } else {
        statusOk = true
        statusMsg = value
      }
      busy = false
      confirmKey = ""
      refresh()
    }
  }

  on tblCellDraft {
    let sc = clamp(tblEditCol, 0, max(0, len(tblHeaders) - 1))
    if tblEditRow < 0 {
      tblHeaders = range(len(tblHeaders)).map(i => i == sc ? value : tblHeaders[i])
    } else if tblEditRow < len(tblRows) {
      let sr = tblEditRow
      tblRows = range(len(tblRows)).map(ri =>
        ri == sr
          ? range(len(tblRows[ri])).map(ci => ci == sc ? value : tblRows[ri][ci])
          : tblRows[ri]
      )
    }
  }

  // ---------------- ADAPTIVE FPS (<1.5ms TARGET) ----------------
  // smooth ladder: 60 burst · 30 ambient · 1 still. Canvas board holds the backdrop still (was a choppy 8fps).
  fps: (!effFxOn || isOledMode) ? 1 : burstT > 0.01 ? 60 : (deckView == "canvas" || rzBusy) ? 1 : 30
  every frame {
    if effFxOn && !isOledMode {
      if burstT > 0.001 {
        burstT = max(0, burstT - dt * 2.4)
      }
    }
  }

  // ---------------- REUSABLE COMPONENTS ----------------
  // Infernal-tray style app icon: crimson-amber glyph in a static sigil ring (0ms idle redraw)
  component TraySigil(src, sz, lbl = "", ini = "") {
    Box {
      size: sz
      align: center
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) * 0.42
        circle(cx, cy, r * 1.14, fill: radial(cx, cy, r * 1.24, [alpha(accentCol, 0.30), alpha(accentEmber, 0.10), alpha(#000000, 0)]))
        circle(cx, cy, r, stroke: alpha(accentCol, 0.85), width: 1.35)
        circle(cx, cy, r * 0.84, stroke: alpha(accentEmber, 0.55), width: 0.75)
        for i in range(4) {
          rotate(i * 90, cx, cy) {
            line(cx, cy - r * 1.12, cx, cy - r * 0.92, stroke: accentEmber, width: 1.35, cap: round)
          }
        }
      }
      if src != null {
        Image { src: src; size: round(sz * 0.5); tint: accentHot; label: lbl }
      } else {
        Text { font: uiFont; text: ini; fontSize: round(sz * 0.3); color: accentHot; bold: true; align: center }
      }
    }
  }

  // Obsidian-Crimson-Amber Command Sigil (static Canvas, 0ms per-frame cost)
  component Sigil(size) {
    Box {
      size: size
      align: center
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) * 0.44
        circle(cx, cy, r * 1.12, fill: radial(cx, cy, r * 1.15, [alpha(accentCol, 0.48), alpha(accentEmber, 0.16), alpha(#000000, 0)]))
        circle(cx, cy, r, fill: alpha(accentDark, 0.96), stroke: alpha(accentCol, 0.92), width: 1.45)
        circle(cx, cy, r * 0.76, stroke: alpha(accentEmber, 0.62), width: 0.85)
        for i in range(4) {
          rotate(i * 90, cx, cy) {
            line(cx, cy - r * 1.06, cx, cy - r * 0.82, stroke: accentEmber, width: 1.4, cap: round)
          }
        }
        let d = r * 0.46
        path([[cx, cy - d], [cx + d, cy], [cx, cy + d], [cx - d, cy]], closed: true, fill: accentCol, stroke: accentEmber, width: 1.05)
        circle(cx, cy, r * 0.14, fill: hiInk)
      }
    }
  }

  // hub: section header (◈ tiny caps + molten amber separator + right-aligned hint)
  component SectionHeader(label, hint = "") {
    Row {
      fill: width
      align: center
      gap: 8
      Text { font: uiFont; text: "◈ ${upper(label)}"; fontSize: 11; bold: true; color: accentHot; letterSpacing: 1.8; weight: 1; maxLines: 1 }
      Text { text: hint; fontSize: 10; font: uiFont; letterSpacing: 0.9; color: alpha(accentEmber, 0.85); maxLines: 1 }
    }
  }

  // hub: bordered pill switch with luminous ember-ivory spring knob. Zero cost when settled.
  component Toggle(on, wait = false) {
    Row {
      width: 48
      height: 28
      padding: 4
      radius: 99
      align: center
      background: on ? alpha(accentCol, 0.94) : (wait ? alpha(accentEmber, 0.20) : alpha(cDeep, 0.96))
      border: 1.25
      borderColor: on ? accentEmber : (wait ? alpha(accentEmber, 0.72) : alpha(accentCol, 0.42))
      animate background: tween(200ms, "ease")
      Box {
        size: 18
        radius: 99
        offset: [on || wait ? 20 : 0, 0]
        animate offset: spring(0.75, 420)
        background: on ? hiInk : (wait ? accentEmber : alpha(accentHot, 0.55))
      }
    }
  }

  // HUB chip: segmented 44dp choice; writes one hub key via owl-hub
  component HubChip(label, on, cmd) {
    let lit = hubPend == cmd || (on && (hubPend == "" || split(hubPend, " ")[0] != split(cmd, " ")[0]))
    Box {
      scale: tapBounce == "1${hash(label, on, cmd)}" ? 0.9 : 1
      offset: [0, tapBounce == "1${hash(label, on, cmd)}" ? -4 : 0]
      animate scale: spring(0.32, 520)
      animate offset: spring(0.32, 520)
      onPress: tapBounce = "1${hash(label, on, cmd)}"
      onRelease: tapBounce = ""
      weight: 1
      height: 44
      radius: 12 * hubRadius
      align: center
      background: lit ? linear(0, 0, 1, 1, [alpha(accentCol, 0.42), alpha(accentDark, 0.98)]) : alpha(cObs, 0.96)
      border: lit ? 1.5 : 1
      borderColor: lit ? accentHot : alpha(accentCol, 0.24)
      animate background: tween(90ms, "out")
      onTap: {
        if hapticsOn { haptic() }
        hubPend = cmd
        if split(cmd, " ")[0] == "deck.view" { viewLocal = split(cmd, " ")[1] }
        run("owl-hub ${cmd}")
      }
      Text { font: uiFont; text: label; fontSize: 10.5; fontWeight: 800; letterSpacing: 0.8; align: center; color: lit ? hiInk : alpha(hiInk, 0.55); maxLines: 1 }
    }
  }

  // HUB switch row: label + hint + pill toggle; whole row is the 44dp tap target
  component HubSwitch(label, hint, on, key) {
    let shown = hubPend == "${key} true" ? true : (hubPend == "${key} false" ? false : on)
    Row {
      scale: tapBounce == "2${hash(label, hint, on, key)}" ? 0.9 : 1
      offset: [0, tapBounce == "2${hash(label, hint, on, key)}" ? -4 : 0]
      animate scale: spring(0.32, 520)
      animate offset: spring(0.32, 520)
      onPress: tapBounce = "2${hash(label, hint, on, key)}"
      onRelease: tapBounce = ""
      fill: width
      height: 48
      align: center
      gap: 10
      onTap: {
        if hapticsOn { haptic() }
        hubPend = on ? "${key} false" : "${key} true"
        run("owl-hub ${hubPend}")
      }
      Column {
        weight: 1
        gap: 1
        Text { font: uiFont; text: label; fontSize: 13; fontWeight: 700; color: hiInk; maxLines: 1 }
        Text { text: hint; fontSize: 9.5; font: uiFont; color: alpha(accentHot, 0.5); maxLines: 1 }
      }
      Toggle { on: shown }
    }
  }

  // HUB section header: tiny caps
  component HubHead(label, hint = "") {
    Row {
      fill: width
      align: center
      gap: 8
      Text { text: "◈ ${upper(label)}"; font: uiFont; fontSize: 10; fontWeight: 800; color: alpha(accentHot, 0.9); letterSpacing: 2; weight: 1; maxLines: 1 }
      Text { text: hint; fontSize: 9.5; font: uiFont; letterSpacing: 0.8; color: alpha(hiInk, 0.4); maxLines: 1 }
    }
  }

  // HUB ink row: pick one global color for a Markdown element (index 0 = card's own palette)
  component InkRow(label, key) {
    let cur = clamp(num(get(mdInk, key, 0), 0), 0, inkN - 1)
    Column {
      fill: width
      gap: 6
      Row {
        fill: width
        align: center
        Text { text: label; font: uiFont; fontSize: 11; fontWeight: 800; color: cur > 0 ? inkSw[cur] : alpha(hiInk, 0.7); weight: 1; maxLines: 1 }
        Text { text: cur == 0 ? "AUTO" : "SET"; font: uiFont; fontSize: 9; fontWeight: 800; letterSpacing: 1.2; color: alpha(hiInk, 0.4) }
      }
      Flow {
        fill: width
        gap: 7
        for i in range(inkN) {
          Box {
            scale: tapBounce == "3${hash(label, key)}" ? 0.9 : 1
            offset: [0, tapBounce == "3${hash(label, key)}" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "3${hash(label, key)}"
            onRelease: tapBounce = ""
            size: 26
            radius: 99
            align: center
            background: i == 0 ? #000000 : inkSw[i]
            border: cur == i ? 2.5 : 1
            borderColor: cur == i ? hiInk : alpha(accentCol, 0.4)
            onTap: {
              if hapticsOn { haptic() }
              mdInk = set(mdInk, key, i)
            }
            if i == 0 {
              Text { text: "A"; font: uiFont; fontSize: 10; fontWeight: 900; color: alpha(hiInk, 0.75); align: center; fill: width }
            }
          }
        }
      }
    }
  }

  // HUB sub-label above a chip row
  component HubLabel(label) {
    Text { text: upper(label); font: uiFont; fontSize: 9; fontWeight: 700; letterSpacing: 1.4; color: alpha(hiInk, 0.42); maxLines: 1 }
  }

  // Fast-Path Inline Markdown Span Renderer (0 allocations on plain text)
  component MdSpanText(lineStr, sz, textCol, tagCol, fnt, wt, ital, algn) {
    let rawLine = lineStr ?? ""
    let hasMarkup = contains(rawLine, "**") || contains(rawLine, "*") || contains(rawLine, "`")
                 || contains(rawLine, "==") || contains(rawLine, "[[") || contains(rawLine, "~~")
                 || contains(rawLine, "#") || contains(rawLine, "](")

    if !hasMarkup {
      Text {
        text: rawLine
        fontSize: sz
        color: textCol
        font: uiFont
        fontWeight: wt
        italic: ital
        align: algn
        fill: width
      }
    } else {
      let boldCol   = inkBold != null ? inkBold : mix(textCol, cHot, 0.85)
      let italCol   = inkItal != null ? inkItal : fnt == "mono" ? mix(textCol, tagCol, 0.38) : mix(textCol, cHot, 0.25)
      let hiCol     = cMid
      let linkCol   = inkLink != null ? inkLink : cPri
      let icodeCol  = inkCode != null ? inkCode : cHot
      let strikeCol = alpha(textCol, 0.45)
      let hashCol   = cHot

      let cParts = contains(rawLine, "`") ? split(rawLine, "`") : [rawLine]
      let s1 = len(cParts) <= 1 ? [{ text: rawLine, locked: false }] : range(len(cParts)).map(i =>
        (i % 2 == 1 && i < len(cParts) - 1)
          ? { text: " " + cParts[i] + " ", font: "mono", color: icodeCol, locked: true }
          : { text: (i % 2 == 1 ? "`" : "") + cParts[i], locked: false }
      )

      let s2 = !contains(rawLine, "==") ? s1 : flatten(s1.map(tok =>
        (tok.locked || !contains(tok.text, "==")) ? [tok] : range(len(split(tok.text, "=="))).map(i =>
          (i % 2 == 1 && i < len(split(tok.text, "==")) - 1)
            ? { text: split(tok.text, "==")[i], bold: true, color: hiCol, locked: true }
            : { text: (i % 2 == 1 ? "==" : "") + split(tok.text, "==")[i], locked: false }
        )
      ))

      let s3 = !contains(rawLine, "[[") ? s2 : flatten(s2.map(tok =>
        (tok.locked || !contains(tok.text, "[[")) ? [tok] : flatten(range(len(split(tok.text, "[["))).map(i =>
          (i > 0 && contains(split(tok.text, "[[")[i], "]]"))
            ? [
                {
                  text: "◈ " + (contains(split(split(tok.text, "[[")[i], "]]")[0], "|")
                    ? split(split(split(tok.text, "[[")[i], "]]")[0], "|")[1]
                    : replace(split(split(tok.text, "[[")[i], "]]")[0], "#", " › ")),
                  bold: true,
                  color: linkCol,
                  locked: true
                },
                { text: split(split(tok.text, "[[")[i], "]]")[1] ?? "", locked: false }
              ]
            : [{ text: (i > 0 ? "[[" : "") + split(tok.text, "[[")[i], locked: false }]
        ))
      ))

      // [text](url) Markdown links
      let sL = !contains(rawLine, "](") ? s3 : flatten(s3.map(tok =>
        (tok.locked || !contains(tok.text, "](")) ? [tok] : flatten(range(len(split(tok.text, "["))).map(i =>
          (i > 0 && contains(split(tok.text, "[")[i], "](") && contains(split(split(tok.text, "[")[i], "](")[1] ?? "", ")"))
            ? [
                { text: "↗ " + split(split(tok.text, "[")[i], "](")[0], bold: true, color: linkCol, locked: true },
                { text: sub(split(split(tok.text, "[")[i], "](")[1], len(split(split(split(tok.text, "[")[i], "](")[1], ")")[0]) + 1, len(split(split(tok.text, "[")[i], "](")[1])), locked: false }
              ]
            : [{ text: (i > 0 ? "[" : "") + split(tok.text, "[")[i], locked: false }]
        ))
      ))

      let s4 = !contains(rawLine, "~~") ? sL : flatten(sL.map(tok =>
        (tok.locked || !contains(tok.text, "~~")) ? [tok] : range(len(split(tok.text, "~~"))).map(i =>
          (i % 2 == 1 && i < len(split(tok.text, "~~")) - 1)
            ? { text: "⊘ " + split(tok.text, "~~")[i], italic: true, color: strikeCol, locked: true }
            : { text: (i % 2 == 1 ? "~~" : "") + split(tok.text, "~~")[i], locked: false }
        )
      ))

      let s5 = !contains(rawLine, "**") ? s4 : flatten(s4.map(tok =>
        (tok.locked || !contains(tok.text, "**")) ? [tok] : range(len(split(tok.text, "**"))).map(i =>
          (i % 2 == 1 && i < len(split(tok.text, "**")) - 1)
            ? { text: split(tok.text, "**")[i], bold: true, fontWeight: 800, color: boldCol, locked: true }
            : { text: (i % 2 == 1 ? "**" : "") + split(tok.text, "**")[i], locked: false }
        )
      ))

      let s6 = !contains(rawLine, "*") ? s5 : flatten(s5.map(tok =>
        (tok.locked || !contains(tok.text, "*")) ? [tok] : range(len(split(tok.text, "*"))).map(i =>
          (i % 2 == 1 && i < len(split(tok.text, "*")) - 1)
            ? { text: split(tok.text, "*")[i], italic: true, color: italCol, locked: true }
            : { text: (i % 2 == 1 ? "*" : "") + split(tok.text, "*")[i], locked: false }
        )
      ))

      let s7 = !contains(rawLine, "#") ? s6 : flatten(s6.map(tok =>
        (tok.locked || !contains(tok.text, "#")) ? [tok] : range(len(split(tok.text, " "))).map(i =>
          (startsWith(split(tok.text, " ")[i], "#") && len(split(tok.text, " ")[i]) > 1 && !startsWith(split(tok.text, " ")[i], "##"))
            ? { text: (i > 0 ? " " : "") + split(tok.text, " ")[i], font: uiFont }
            : { text: (i > 0 ? " " : "") + split(tok.text, " ")[i] }
        )
      ))

      let cleanSpans = s7.filter(s => (s.text ?? "") != "")
      Text {
        spans: len(cleanSpans) > 0 ? cleanSpans : [{ text: "" }]
        fontSize: sz
        color: textCol
        font: uiFont
        fontWeight: wt
        italic: ital
        align: algn
        fill: width
      }
    }
  }

  component MdTable(headers, rows, bSz, col, tagCol, fnt) {
    let safeHeaders = (headers ?? []).take(6)
    let colCount    = max(1, len(safeHeaders))
    let safeRows    = (rows ?? []).take(12)
    let cellFontSz  = max(9.5, bSz * 0.9)
    let headFontSz  = max(9.5, bSz * 0.92)

    Column {
      fill: width
      radius: 8
      background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cObs, 0.78), #000000, alpha(cSec, 0.10)])
      border: 0.9
      borderColor: alpha(tagCol, 0.45)
      gap: 0

      // Header Row
      Row {
        fill: width
        align: center
        background: alpha(tagCol, 0.22)
        for ci in range(colCount) {
          if ci > 0 {
            Box { width: 0.7; height: 26; background: alpha(tagCol, 0.35) }
          }
          Box {
            weight: 1
            padding: [7, 6]
            align: start
            Text {
              text: safeHeaders[ci] ?? ""
              fontSize: headFontSz
              font: uiFont
              fontWeight: 800
              color: mix(tagCol, cHot, 0.48)
              maxLines: 1
              fill: width
            }
          }
        }
      }

      // Header / Body Accent Divider
      Box { fill: width; height: 1.2; background: alpha(tagCol, 0.55) }

      // Body Rows with Zebra Tint & Subtle Gridlines
      for ri in range(len(safeRows)) {
        let rCells = safeRows[ri] ?? []
        if ri > 0 {
          Box { fill: width; height: 0.6; background: alpha(tagCol, 0.18) }
        }
        Row {
          fill: width
          align: center
          background: ri % 2 == 1 ? alpha(tagCol, 0.08) : alpha(cObs, 0.45)
          for ci in range(colCount) {
            if ci > 0 {
              Box { width: 0.6; height: 24; background: alpha(tagCol, 0.18) }
            }
            Box {
              weight: 1
              padding: [7, 6]
              align: start
              Text {
                text: rCells[ci] ?? ""
                fontSize: cellFontSz
                font: uiFont
                color: alpha(col, 0.92)
                maxLines: 2
                fill: width
              }
            }
          }
        }
      }
    }
  }

  // ================= OBSIDIAN MARKDOWN ENGINE (obsidian-css tokens → OWL) =================
  // Fenced code block: verbatim text (indentation kept), language chip, 1-tap COPY to clipboard.
  component CodeBlock(code, lang, bSz, pal, live = true) {
    let cl   = lower(code)
    let ct   = trim(code)
    let det  = lang != "" ? lower(lang)
      : (startsWith(ct, "{") || startsWith(ct, "[")) && contains(ct, "\"") ? "json"
      : contains(cl, "def ") || (contains(cl, "import ") && !contains(cl, "from '")) || contains(cl, "print(") ? "python"
      : contains(cl, "widget \"") || contains(cl, "face \"") || contains(cl, "component ") || contains(cl, "onTap") ? "owl"
      : contains(cl, "function ") || contains(cl, "const ") || contains(cl, "=>") || contains(cl, "console.") ? "js"
      : contains(cl, "select ") && contains(cl, " from ") ? "sql"
      : contains(cl, "</") ? "html"
      : contains(cl, "sudo ") || contains(cl, "pacman") || contains(cl, "apt ") || contains(cl, "cd ") || contains(cl, "| ") || contains(cl, "git ") || contains(cl, "pip ") || startsWith(ct, "$") || startsWith(ct, "#!") ? "bash"
      : "text"
    let dl   = det == "sh" || det == "shell" || det == "zsh" ? "bash" : det == "py" ? "python" : det == "javascript" || det == "ts" || det == "typescript" ? "js" : det
    let kws  = get(codeKw, dl, [])
    let cBase = inkCode != null ? inkCode : cInk
    let cKw   = cPri
    let cStr  = #ffe14a
    let cNum  = #ff8c1a
    let cCmd  = #2bff8c
    let cFlag = cFlair
    let cCom  = alpha(cBase, 0.42)
    let comTok = dl == "python" || dl == "bash" ? "#" : dl == "sql" ? "--" : "//"
    let cLines = lines(code).take(80)
    let langCol = dl == "python" ? #3da8ff : dl == "js" ? #ffe14a : dl == "bash" ? #2bff8c : dl == "owl" ? #ff2a44 : dl == "json" ? #ff8c1a : dl == "sql" ? #ff3df0 : dl == "html" ? #ff6f85 : alpha(pal.tag, 0.9)
    Column {
      fill: width
      gap: 0
      radius: 8 * corners
      clip: true
      background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), cObs, #000000, alpha(cPri, 0.09)])
      border: 1
      borderColor: alpha(langCol, 0.45)
      Row {
        fill: width
        align: center
        padding: [12, 5, 6, 5]
        gap: 8
        background: alpha(langCol, 0.10)
        Box { size: 8; radius: 99; background: langCol }
        Text { text: upper(dl); fontSize: 11; font: uiFont; fontWeight: 900; color: langCol; letterSpacing: 1.2; maxLines: 1 }
        Text { text: (lang == "" && dl != "text" ? "auto · " : "") + "${len(lines(code))} ln"; fontSize: 10; font: uiFont; fontWeight: 700; color: alpha(pal.tag, 0.55); weight: 1; maxLines: 1 }
        if live {
          Row {
            scale: tapBounce == "4${hash(code, lang, bSz, pal, live)}" ? 0.9 : 1
            offset: [0, tapBounce == "4${hash(code, lang, bSz, pal, live)}" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "4${hash(code, lang, bSz, pal, live)}"
            onRelease: tapBounce = ""
            height: 32
            padding: [12, 0]
            radius: 8
            align: center
            background: mdCopied == code ? alpha(langCol, 0.34) : alpha(langCol, 0.14)
            border: 1
            borderColor: alpha(langCol, 0.6)
            animate background: tween(180ms, "ease")
            onTap: {
              if hapticsOn { haptic() }
              copy(code)
              mdCopied = code
            }
            Text { text: mdCopied == code ? "✓ COPIED" : "⧉ COPY"; fontSize: 11.5; font: uiFont; fontWeight: 800; color: cBase }
          }
        }
      }
      Column {
        fill: width
        padding: [12, 10]
        gap: 1
        for ci in range(len(cLines)) {
          let cln = cLines[ci]
          let ctr = trim(cln)
          let isCom = dl != "text" && dl != "json" && startsWith(ctr, comTok) && !startsWith(ctr, "#!")
          let ws  = split(cln, " ")
          let qs  = scan(ws, (st, w) => ((len(split(w, "\"")) - 1) % 2 == 1) ? !st : st, false)
          let firstWord = range(len(ws)).find(k => ws[k] != "") ?? 0
          Text {
            font: "mono"
            fontSize: max(11, bSz - 1.5)
            fill: width
            color: cBase
            spans: (dl == "text" || cln == "") ? [cln == "" ? " " : cln]
              : isCom ? [{ text: cln, color: cCom, italic: true }]
              : range(len(ws)).map(k => {
                  text: (k > 0 ? " " : "") + ws[k],
                  color: ((k > 0 && qs[k - 1]) || startsWith(ws[k], "\"") || startsWith(ws[k], "'")) ? cStr
                    : kws.any(x => x == ws[k] || x + ":" == ws[k] || x + "(" == sub(ws[k], 0, len(x) + 1)) ? cKw
                    : match(ws[k], "^-?[0-9][0-9.,]*$") != null ? cNum
                    : (dl == "bash" && startsWith(ws[k], "-")) ? cFlag
                    : (dl == "bash" && k == firstWord) ? cCmd
                    : cBase,
                  bold: kws.any(x => x == ws[k])
                })
          }
        }
      }
    }
  }

  // Full Markdown body, Obsidian semantics. live=false → no tap targets (canvas cards hand every
  // touch to the board's onTouch). cid=0 → task taps edit the editor draft (noteBody).
  component MdView(raw, pal, bSz, fnt = "sans", wt = 600, algn = "start", maxLn = 400, cid = 0, live = true) {
    let mLines  = lines(raw ?? "")
    let mFmEnd  = len(mLines) > 1 && trim(mLines[0]) == "---" ? (range(1, len(mLines)).find(j => trim(mLines[j]) == "---") ?? -1) : -1
    let mInside = scan(mLines, (st, l) => startsWith(trim(l), "```") ? !st : st, false)
    let mCall   = scan(range(len(mLines)), (st, i) =>
      !startsWith(trim(mLines[i]), ">") ? { t: "", f: "", h: -1 }
      : contains(mLines[i], "[!") && match(trim(mLines[i]), "^>\\s*\\[!([A-Za-z-]+)\\]([+-]?)") != null
        ? { t: lower(match(trim(mLines[i]), "^>\\s*\\[!([A-Za-z-]+)\\]([+-]?)")[0]), f: match(trim(mLines[i]), "^>\\s*\\[!([A-Za-z-]+)\\]([+-]?)")[1], h: i }
        : st,
      { t: "", f: "", h: -1 })

    let bodyCol = inkBody != null ? inkBody : pal.text
    Column {
      fill: width
      gap: bSz < 14 ? 4 : 6

      for li in range(min(len(mLines), maxLn)) {
        let ln     = mLines[li]
        let tr     = trim(ln)
        let isFnc  = startsWith(tr, "```")
        let inCode = mInside[li] == true
        // hidden lines: frontmatter body (drawn as Properties at line 0) and single-line %% comments %%
        let mSkip  = (mFmEnd > 0 && li <= mFmEnd) || (startsWith(tr, "%%") && endsWith(tr, "%%") && len(tr) >= 4)

        if mFmEnd > 0 && li == 0 {
          // YAML frontmatter → Obsidian "Properties" block
          Column {
            fill: width
            gap: 3
            padding: [10, 8]
            radius: 6
            background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(pal.tag, 0.07), #000000, alpha(cSec, 0.11)])
            border: 1
            borderColor: alpha(pal.tag, 0.25)
            for fl in mLines.take(mFmEnd).drop(1).take(8) {
              Row {
                fill: width
                gap: 8
                Text { text: trim(split(fl, ":")[0] ?? ""); fontSize: max(11, bSz - 2); font: uiFont; fontWeight: 800; color: alpha(pal.tag, 0.85); maxLines: 1 }
                Text { text: trim(sub(fl, len(split(fl, ":")[0] ?? "") + 1, len(fl))); fontSize: max(11, bSz - 2); font: uiFont; color: alpha(bodyCol, 0.8); weight: 1; maxLines: 2 }
              }
            }
          }
        } else if !mSkip && isFnc && inCode {
          let cEnd = range(li + 1, len(mLines)).find(j => startsWith(trim(mLines[j]), "```")) ?? len(mLines)
          CodeBlock {
            code: join(mLines.take(cEnd).drop(li + 1), "\n")
            lang: trim(sub(tr, 3, len(tr)))
            bSz: bSz
            pal: pal
            live: live
          }
        } else if !mSkip && !isFnc && !inCode {
          let hasLead = startsWith(ln, " ") || startsWith(ln, "\t")
          let ind   = !hasLead ? 0 : min(4, floor(len(replace((match(ln, "^(\\s*)") ?? [""])[0], "\t", "  ")) / 2))
          let hm    = startsWith(tr, "#") ? match(tr, "^(#{1,6}) (.*)$") : null
          let nm    = (len(tr) >= 3 && (contains(tr, ". ") || contains(tr, ") "))) ? match(tr, "^(\\d+)[.)] (.*)$") : null
          let isTO  = startsWith(tr, "- [ ] ") || startsWith(tr, "* [ ] ") || startsWith(tr, "+ [ ] ")
          let isTD  = startsWith(lower(tr), "- [x] ") || startsWith(lower(tr), "* [x] ")
          let isTW  = startsWith(tr, "- [/] ")
          let isBul = startsWith(tr, "- ") || startsWith(tr, "* ") || startsWith(tr, "+ ")
          let isPip = startsWith(tr, "|") && len(tr) >= 3 && contains(sub(tr, 1, len(tr)), "|")
          let isSep = isPip && contains(tr, "---")
          let cs    = mCall[li]
          let cTyp  = cs.t
          let cDef  = get(obsCallouts, cTyp, obsCallouts.note)
          let cCol  = mix(cDef.c, pal.tag, 0.3)
          let fKey  = "${cid}:${cs.h}"
          let cOpen = cs.f == "-" ? mdFold.any(k => k == fKey) : !mdFold.any(k => k == fKey)

          if tr == "" {
            Spacer { height: 3 }
          } else if startsWith(tr, "![") && (match(tr, "^!\\[\\[(.+)\\]\\]$") != null || match(tr, "^!\\[[^\\]]*\\]\\((.+)\\)$") != null) {
            let mImg = (match(tr, "^!\\[\\[(.+)\\]\\]$") ?? match(tr, "^!\\[[^\\]]*\\]\\((.+)\\)$"))[0]
            let mSrc = split(mImg, "|")[0]
            Image { src: trim(mSrc); fill: width; fit: "contain"; radius: 8 * corners; label: "card image" }
          } else if hm != null {
            let hl = len(hm[0])
            Column {
              fill: width
              gap: 3
              padding: [0, hl <= 2 ? 6 : 3, 0, 1]
              MdSpanText {
                lineStr: hm[1]
                sz: bSz * obsH[hl - 1]
                textCol: hl == 1 ? (inkH1 != null ? inkH1 : pal.tag) : hl == 2 ? (inkH2 != null ? inkH2 : bodyCol) : (inkH3 != null ? inkH3 : bodyCol)
                tagCol: pal.tag
                fnt: fnt
                wt: hl <= 2 ? 900 : 800
                ital: false
                algn: algn
              }
              if hl <= 2 {
                Box { fill: width; height: 1; background: alpha(pal.tag, hl == 1 ? 0.45 : 0.25) }
              }
            }
          } else if isTO || isTD || isTW {
            let tIcon   = isTD ? "☑" : isTW ? "◐" : "☐"
            let tCol    = isTD ? cPri : isTW ? cPri : pal.tag
            let flipped = isTD
              ? replace(replace(replace(replace(ln, "- [x] ", "- [ ] "), "- [X] ", "- [ ] "), "* [x] ", "* [ ] "), "* [X] ", "* [ ] ")
              : replace(replace(replace(ln, "- [ ] ", "- [x] "), "- [/] ", "- [x] "), "* [ ] ", "* [x] ")
            if live {
              Row {
                scale: tapBounce == "5${hash(raw, pal, bSz, fnt, wt, algn, maxLn, cid, live)}" ? 0.9 : 1
                offset: [0, tapBounce == "5${hash(raw, pal, bSz, fnt, wt, algn, maxLn, cid, live)}" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "5${hash(raw, pal, bSz, fnt, wt, algn, maxLn, cid, live)}"
                onRelease: tapBounce = ""
                fill: width
                gap: 8
                align: center
                padding: [ind * 16, 0, 0, 0]
                onTap: {
                  if hapticsOn { haptic() }
                  if cid > 0 {
                    holocronNotes = holocronNotes.map(c => c.id != cid ? c : merge(c, { text: join(set(lines(c.text ?? ""), li, flipped), "\n") }))
                  } else {
                    noteBody = join(set(lines(noteBody ?? ""), li, flipped), "\n")
                  }
                }
                Row {
                  width: 32; height: 32; radius: 8; align: center; justify: center
                  background: alpha(tCol, 0.18); border: 1.2; borderColor: alpha(tCol, 0.72)
                  Text { font: uiFont; text: tIcon; fontSize: 16; bold: true; color: tCol }
                }
                Column {
                  weight: 1
                  MdSpanText { lineStr: sub(tr, 6, len(tr)); sz: bSz; textCol: isTD ? alpha(bodyCol, 0.45) : bodyCol; tagCol: pal.tag; fnt: fnt; wt: isTD ? 400 : wt; ital: isTD; algn: algn }
                }
              }
            } else {
              Row {
                fill: width
                gap: 6
                align: center
                padding: [ind * 16, 0, 0, 0]
                Text { font: uiFont; text: tIcon; fontSize: bSz; bold: true; color: tCol }
                Column {
                  weight: 1
                  MdSpanText { lineStr: sub(tr, 6, len(tr)); sz: bSz; textCol: isTD ? alpha(bodyCol, 0.45) : bodyCol; tagCol: pal.tag; fnt: fnt; wt: isTD ? 400 : wt; ital: isTD; algn: algn }
                }
              }
            }
          } else if isSep {
            Box { fill: width; height: 1.5; radius: 1; background: alpha(pal.tag, 0.6) }
          } else if isPip {
            let stripped = endsWith(tr, "|") ? sub(tr, 1, len(tr) - 1) : sub(tr, 1, len(tr))
            let cells = split(stripped, "|").map(x => trim(x)).take(6)
            let isHdr = li + 1 < len(mLines) && contains(mLines[li + 1], "---") && startsWith(trim(mLines[li + 1]), "|")
            Row {
              fill: width
              align: center
              radius: isHdr ? 7 : 4
              background: isHdr ? alpha(pal.tag, 0.24) : (li % 2 == 0 ? alpha(pal.tag, 0.09) : alpha(cObs, 0.62))
              border: isHdr ? 1.0 : 0.7
              borderColor: isHdr ? alpha(pal.tag, 0.62) : alpha(pal.border, 0.28)
              for ci in range(len(cells)) {
                if ci > 0 {
                  Box { width: 0.7; height: 22; background: alpha(pal.tag, isHdr ? 0.4 : 0.22) }
                }
                Box {
                  weight: 1
                  padding: [7, 6]
                  Text { text: cells[ci]; fontSize: max(12, bSz - 0.5); font: uiFont; fontWeight: isHdr ? 800 : 600; color: isHdr ? cHot : alpha(bodyCol, 0.94); maxLines: 2; fill: width }
                }
              }
            }
          } else if cTyp != "" && cs.h == li {
            // Callout title row (Obsidian: > [!type]+/- Title). Tap folds/unfolds.
            let cTitle = trim((match(tr, "^>\\s*\\[![A-Za-z-]+\\][+-]?\\s*(.*)$") ?? [""])[0])
            let cHead  = cTitle != "" ? cTitle : capitalize(cTyp)
            if live {
              Row {
                scale: tapBounce == "6${hash(raw, pal, bSz, fnt, wt, algn, maxLn, cid, live)}" ? 0.9 : 1
                offset: [0, tapBounce == "6${hash(raw, pal, bSz, fnt, wt, algn, maxLn, cid, live)}" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "6${hash(raw, pal, bSz, fnt, wt, algn, maxLn, cid, live)}"
                onRelease: tapBounce = ""
                fill: width
                gap: 8
                align: center
                padding: [10, 7]
                radius: 6
                background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cCol, 0.16), #000000, alpha(cSec, 0.10)])
                border: 1
                borderColor: alpha(cCol, 0.5)
                onTap: {
                  if cs.f != "" {
                    if hapticsOn { haptic() }
                    mdFold = mdFold.any(k => k == fKey) ? mdFold.filter(k => k != fKey) : mdFold + [fKey]
                  }
                }
                Text { font: uiFont; text: cDef.g; fontSize: bSz; fontWeight: 900; color: cCol }
                Text { font: uiFont; text: cHead; fontSize: bSz; fontWeight: 800; color: mix(cCol, #ffffff, 0.35); weight: 1; maxLines: 2 }
                if cs.f != "" {
                  Text { font: uiFont; text: cOpen ? "▾" : "▸"; fontSize: bSz; fontWeight: 900; color: cCol }
                }
              }
            } else {
              Row {
                fill: width
                gap: 8
                align: center
                padding: [10, 7]
                radius: 6
                background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCol, 0.16), #000000, alpha(cPri, 0.09)])
                border: 1
                borderColor: alpha(cCol, 0.5)
                Text { font: uiFont; text: cDef.g; fontSize: bSz; fontWeight: 900; color: cCol }
                Text { font: uiFont; text: cHead; fontSize: bSz; fontWeight: 800; color: mix(cCol, #ffffff, 0.35); weight: 1; maxLines: 2 }
              }
            }
          } else if cTyp != "" {
            // Callout body line (hidden while folded)
            if cOpen {
              Row {
                fill: width
                gap: 8
                padding: [10, 3]
                background: alpha(cCol, 0.07)
                Box { width: 2.5; height: bSz + 6; radius: 2; background: alpha(cCol, 0.7) }
                Column {
                  weight: 1
                  MdSpanText { lineStr: trim(sub(tr, 1, len(tr))); sz: bSz; textCol: alpha(bodyCol, 0.94); tagCol: cCol; fnt: fnt; wt: wt; ital: false; algn: algn }
                }
              }
            }
          } else if startsWith(tr, ">") {
            Row {
              fill: width
              gap: 10
              padding: [4, 3]
              Box { width: 3; height: bSz + 8; radius: 2; background: alpha(pal.tag, 0.75) }
              Column {
                weight: 1
                MdSpanText { lineStr: trim(sub(tr, 1, len(tr))); sz: bSz; textCol: inkQuote != null ? inkQuote : alpha(bodyCol, 0.8); tagCol: pal.tag; fnt: fnt; wt: wt; ital: true; algn: algn }
              }
            }
          } else if tr == "---" || tr == "***" || tr == "___" {
            Box { fill: width; height: 1.2; radius: 1; background: alpha(pal.tag, 0.42) }
          } else if nm != null {
            Row {
              fill: width
              gap: 8
              padding: [ind * 16, 0, 0, 0]
              Text { text: nm[0] + "."; fontSize: bSz; font: uiFont; fontWeight: 800; color: pal.tag; minLines: 1 }
              Column {
                weight: 1
                MdSpanText { lineStr: nm[1]; sz: bSz; textCol: alpha(bodyCol, 0.92); tagCol: pal.tag; fnt: fnt; wt: wt; ital: false; algn: algn }
              }
            }
          } else if isBul {
            Row {
              fill: width
              gap: 8
              padding: [ind * 16, 0, 0, 0]
              Text { font: uiFont; text: ind == 0 ? "•" : ind == 1 ? "◦" : "▪"; fontSize: bSz; fontWeight: 900; color: pal.tag }
              Column {
                weight: 1
                MdSpanText { lineStr: sub(tr, 2, len(tr)); sz: bSz; textCol: alpha(bodyCol, 0.92); tagCol: pal.tag; fnt: fnt; wt: wt; ital: false; algn: algn }
              }
            }
          } else {
            MdSpanText { lineStr: tr; sz: bSz; textCol: alpha(bodyCol, 0.92); tagCol: pal.tag; fnt: fnt; wt: wt; ital: false; algn: algn }
          }
        }
      }

      if len(mLines) > maxLn {
        Text { text: "⋯ ${len(mLines) - maxLn} more lines"; fontSize: 11; font: uiFont; color: alpha(pal.tag, 0.7) }
      }
    }
  }

  component ImgChip(lbl, on) {
    Row {
      scale: tapBounce == "7${hash(lbl, on)}" ? 0.9 : 1
      offset: [0, tapBounce == "7${hash(lbl, on)}" ? -4 : 0]
      animate scale: spring(0.32, 520)
      animate offset: spring(0.32, 520)
      onPress: tapBounce = "7${hash(lbl, on)}"
      onRelease: tapBounce = ""
      height: 38; padding: [12, 0]; radius: 10; align: center; justify: center
      background: on ? accentCol : alpha(cCard, 0.96)
      border: 1.3; borderColor: on ? accentHot : alpha(accentCol, 0.55)
      onTap: {
        if hapticsOn { haptic() }
        imgAspect = lbl == "FREE" ? "free" : lbl
        imgZ = 1.0
        imgOX = 0
        imgOY = 0
      }
      Text { font: uiFont; text: lbl; fontSize: 12; fontWeight: 900; color: on ? hiInk : cHot; letterSpacing: 0.5 }
    }
  }

  component ImgPickScreen() {
    let inbox  = imgInbox.items ?? []
    let fwMax  = max(160, (screenWidth ?? tileWidth ?? 400) - 28)
    let aParts = imgAspect == "free" ? [0, 0] : split(imgAspect, ":").map(v => num(v, 1))
    let iw     = imgSrc == null ? 1 : max(1, imgSrc.w)
    let ih     = imgSrc == null ? 1 : max(1, imgSrc.h)
    let ar     = imgAspect == "free" ? iw / ih : aParts[0] / aParts[1]
    let fh     = min(fwMax / ar, 420)
    let fw     = fh * ar
    let s0     = imgAspect == "free" ? min(fw / iw, fh / ih) : max(fw / iw, fh / ih)
    let sc     = s0 * imgZ
    let dw     = iw * sc
    let dh     = ih * sc
    let mxX    = max(0, (dw - fw) / 2) / fw
    let mxY    = max(0, (dh - fh) / 2) / fh
    Column {
      fill: true
      background: cObs
      padding: 14
      gap: 12

      Column {
        weight: 1
        fill: width
        scroll: true
        gap: 12

        // ① tap strip  ② PICK PHOTOS — the strip is the Linux window that receives the photos
        Text { font: uiFont; text: "◈ ① TAP THE STRIP   ② PICK PHOTOS"; fontSize: 10.5; fontWeight: 900; letterSpacing: 1.4; color: alpha(accentCol, 0.85) }
        Row {
          fill: width
          gap: 8
          align: center
          Box {
            weight: 1
            height: 52
            radius: 12
            clip: true
            background: #000000
            border: 1.3
            borderColor: alpha(accentCol, 0.55)
            Terminal { command: "while true; do python3 ~/.local/bin/deck-img.py receive; sleep 1; done"; fontSize: 7 }
          }
          Row {
            scale: tapBounce == "8${0}" ? 0.9 : 1
            offset: [0, tapBounce == "8${0}" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "8${0}"
            onRelease: tapBounce = ""
            height: 52; padding: [14, 0]; radius: 12; align: center; justify: center
            background: linear(0, 0, 1, 1, [accentCol, accentGhost, accentDark])
            border: 1.6; borderColor: accentHot
            onTap: {
              if hapticsOn { haptic() }
              pickImages()
            }
            Text { font: uiFont; text: "📷 PICK PHOTOS"; fontSize: 13; fontWeight: 900; color: hiInk; letterSpacing: 0.6 }
          }
        }

        // Inbox
        if len(inbox) == 0 {
          Text { font: uiFont; text: "No photos yet. Tap the dark strip, then 📷 PICK PHOTOS and choose from your gallery."; fontSize: 12.5; color: alpha(amberInk, 0.7); fill: width }
        } else {
          Row {
            fill: width
            align: center
            Text { font: uiFont; text: "◈ INBOX · TAP ONE TO CROP"; fontSize: 10.5; fontWeight: 900; letterSpacing: 1.4; color: alpha(accentCol, 0.85); weight: 1 }
            Text {
              scale: tapBounce == "9${0}" ? 0.9 : 1
              offset: [0, tapBounce == "9${0}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "9${0}"
              onRelease: tapBounce = ""
              font: uiFont; text: "CLEAR"; fontSize: 11; fontWeight: 800; color: alpha(accentHot, 0.8); padding: [10, 6]
              onTap: { imgSrc = null; run("python3 ~/.local/bin/deck-img.py clear") }
            }
          }
          Grid {
            fill: width
            columns: 4
            gap: 6
            for it in inbox.take(24) key it.path {
              let on = imgSrc != null && imgSrc.path == it.path
              Box {
                scale: tapBounce == "10${0}${it.path}" ? 0.9 : 1
                offset: [0, tapBounce == "10${0}${it.path}" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "10${0}${it.path}"
                onRelease: tapBounce = ""
                fill: width
                height: 78
                radius: 10
                clip: true
                border: on ? 2.2 : 1
                borderColor: on ? accentEmber : alpha(accentCol, 0.35)
                onTap: {
                  if hapticsOn { haptic() }
                  imgSrc = it
                  imgZ = 1.0
                  imgOX = 0
                  imgOY = 0
                  imgRes = ""
                }
                Image { src: it.path; fill: true; fit: "cover"; label: "picked photo" }
              }
            }
          }
        }

        // Crop
        if imgSrc != null {
          Text { font: uiFont; text: "◈ CROP · DRAG TO MOVE · PINCH TO ZOOM"; fontSize: 10.5; fontWeight: 900; letterSpacing: 1.4; color: alpha(accentCol, 0.85) }
          Row {
            fill: width
            gap: 6
            for a in ["FREE", "1:1", "4:3", "3:4", "16:9"] {
              ImgChip { lbl: a; on: (a == "FREE" ? "free" : a) == imgAspect }
            }
          }
          Row {
            fill: width
            justify: center
            Box {
              width: fw
              height: fh
              clip: true
              radius: 10
              background: #000000
              border: 1.6
              borderColor: accentEmber
              onTouch: {
                let n = len(touches)
                if imgAspect == "free" {
                  imgG = ""
                } else if n >= 2 {
                  let a = touches[0]
                  let b = touches[1]
                  let pd = max(1, sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y)))
                  if imgG != "pinch" {
                    imgG = "pinch"
                    imgT0 = [pd, 0, imgOX, imgOY, imgZ]
                  } else {
                    let z = clamp(imgT0[4] * pd / imgT0[0], 1.0, 6.0)
                    let mx2 = max(0, (iw * s0 * z - fw) / 2) / fw
                    let my2 = max(0, (ih * s0 * z - fh) / 2) / fh
                    imgZ = z
                    imgOX = clamp(imgOX, -mx2, mx2)
                    imgOY = clamp(imgOY, -my2, my2)
                  }
                } else if n == 1 {
                  let f = touches[0]
                  if imgG != "pan" {
                    imgG = "pan"
                    imgT0 = [f.x, f.y, imgOX, imgOY, imgZ]
                  } else {
                    imgOX = clamp(imgT0[2] + (f.x - imgT0[0]) / fw, -mxX, mxX)
                    imgOY = clamp(imgT0[3] + (f.y - imgT0[1]) / fh, -mxY, mxY)
                  }
                } else {
                  imgG = ""
                }
              }
              Canvas {
                fill: true
                image(imgSrc.path, fw / 2 - dw / 2 + imgOX * fw, fh / 2 - dh / 2 + imgOY * fh, dw, dh)
                // rule-of-thirds guides
                line(fw / 3, 0, fw / 3, fh, color: alpha(#ffffff, 0.18), width: 1)
                line(fw * 2 / 3, 0, fw * 2 / 3, fh, color: alpha(#ffffff, 0.18), width: 1)
                line(0, fh / 3, fw, fh / 3, color: alpha(#ffffff, 0.18), width: 1)
                line(0, fh * 2 / 3, fw, fh * 2 / 3, color: alpha(#ffffff, 0.18), width: 1)
              }
            }
          }
          if imgAspect != "free" {
            Row {
              fill: width
              gap: 10
              align: center
              Text { font: uiFont; text: "ZOOM"; fontSize: 11; fontWeight: 900; color: alpha(accentCol, 0.85); letterSpacing: 1 }
              Slider {
                weight: 1
                height: 36
                color: accentHot
                track: alpha(accentCol, 0.25)
                live: true
                value: imgZ
                min: 1
                max: 6
                onChange: {
                  imgZ = value
                  let mx2 = max(0, (iw * s0 * value - fw) / 2) / fw
                  let my2 = max(0, (ih * s0 * value - fh) / 2) / fh
                  imgOX = clamp(imgOX, -mx2, mx2)
                  imgOY = clamp(imgOY, -my2, my2)
                }
              }
              Text { font: uiFont; text: "${round(imgZ * 10) / 10}×"; fontSize: 12; fontWeight: 800; color: hiInk }
            }
          }
        }
      }

      // Footer: back · use
      Row {
        fill: width
        gap: 10
        Row {
          scale: tapBounce == "11${0}" ? 0.9 : 1
          offset: [0, tapBounce == "11${0}" ? -4 : 0]
          animate scale: spring(0.32, 520)
          animate offset: spring(0.32, 520)
          onPress: tapBounce = "11${0}"
          onRelease: tapBounce = ""
          weight: 1; height: 50; radius: 12; align: center; justify: center
          background: alpha(cCard, 0.96); border: 1.3; borderColor: alpha(accentCol, 0.6)
          onTap: {
            if hapticsOn { haptic() }
            if imgTarget == "card" { screenMode = "noteEditor" } else { close() }
          }
          Text { font: uiFont; text: "‹ BACK"; fontSize: 13; fontWeight: 900; color: cHot; letterSpacing: 0.8 }
        }
        Row {
          scale: tapBounce == "12${0}" ? 0.9 : 1
          offset: [0, tapBounce == "12${0}" ? -4 : 0]
          animate scale: spring(0.32, 520)
          animate offset: spring(0.32, 520)
          onPress: tapBounce = "12${0}"
          onRelease: tapBounce = ""
          weight: 2; height: 50; radius: 12; align: center; justify: center
          opacity: imgSrc == null || imgBusy ? 0.45 : 1
          background: linear(0, 0, 1, 1, [accentCol, accentGhost, accentDark])
          border: 1.6; borderColor: accentEmber
          onTap: {
            if imgSrc != null && !imgBusy {
              if hapticsOn { haptic() }
              imgBusy = true
              imgRes = ""
              imgRes = run("python3 ~/.local/bin/deck-img.py crop ${sh(imgSrc.path)} ${sh(str(imgAspect))} ${sh(str(imgZ))} ${sh(str(imgOX))} ${sh(str(imgOY))}")
            }
          }
          Text { font: uiFont; text: imgBusy ? "… CROPPING" : (imgTarget == "card" ? "✓ ADD TO CARD" : "✓ ADD TO CANVAS"); fontSize: 14; fontWeight: 900; color: hiInk; letterSpacing: 1.0 }
        }
      }
    }
  }

  component TableBuilderScreen() {
    let colCnt = max(1, len(tblHeaders))
    let rowCnt = len(tblRows)
    let safeCol = clamp(tblEditCol, 0, colCnt - 1)
    let safeRow = tblEditRow < 0 ? -1 : clamp(tblEditRow, 0, max(0, rowCnt - 1))
    let editingLabel = safeRow < 0
      ? "EDITING HEADER · COL ${safeCol + 1}"
      : "EDITING ROW ${safeRow + 1} · COL ${safeCol + 1}"

    Column {
      fill: true
      background: cObs
      padding: 14
      gap: 12

      // Top Header Bar
      Row {
        fill: width
        align: center
        gap: 8

        Column {
          weight: 1
          gap: 2
          Text {
            font: uiFont
            text: tblTargetMode == "insertNote" ? "⊞ INSERT TABLE" : "⊞ NEW TABLE CARD"
            fontSize: 16
            fontWeight: 800
            color: accentGhost
            letterSpacing: 1.4
            maxLines: 1
          }
          Text {
            text: "${rowCnt} ROWS × ${colCnt} COLS · TAP ANY CELL TO EDIT"
            fontSize: 10.5
            font: uiFont
            color: alpha(cHot, 0.65)
            letterSpacing: 0.7
            maxLines: 1
          }
        }

        Row {
          scale: tapBounce == "13${0}" ? 0.9 : 1
          offset: [0, tapBounce == "13${0}" ? -4 : 0]
          animate scale: spring(0.32, 520)
          animate offset: spring(0.32, 520)
          onPress: tapBounce = "13${0}"
          onRelease: tapBounce = ""
          height: 44
          padding: [14, 0]
          radius: 10
          align: center
          justify: center
          background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.95), #000000, alpha(cSec, 0.11)])
          border: 1.1
          borderColor: alpha(cHot, 0.25)
          onTap: {
            if hapticsOn { haptic() }
            if tblTargetMode == "insertNote" {
              screenMode = "noteEditor"
            } else {
              close()
            }
          }
          Text { font: uiFont; text: "✕ CLOSE"; fontSize: 12; fontWeight: 700; color: cHot }
        }
      }

      // Main Scrollable Builder Body
      Column {
        weight: 1
        fill: width
        scroll: true
        gap: 12

        // Card Title Input (when creating a new Table Card from main toolbar)
        if tblTargetMode == "newCard" {
          Column {
            fill: width
            gap: 4
            Text {
              text: "CARD TITLE"
              fontSize: 10.5
              font: uiFont
              bold: true
              color: alpha(accentCol, 0.85)
              letterSpacing: 1.0
            }
            Box {
              fill: width
              height: 46
              padding: [12, 0]
              radius: 10
              background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), cObs, #000000, alpha(cSec, 0.10)])
              border: 1.2
              borderColor: alpha(accentCol, 0.55)
              align: center
              Input {
                text: tblCardTitle
                placeholder: "Table card title…"
                color: cHot
                fontSize: 14.5
                underline: false
                fill: width
                onChange: tblCardTitle = value
              }
            }
          }
        }

        // Quick 1-Tap Table Presets (Big 44px Buttons)
        Column {
          fill: width
          gap: 6
          Text {
            text: "QUICK PRESETS (1-TAP)"
            fontSize: 10.5
            font: uiFont
            bold: true
            color: alpha(accentGhost, 0.88)
            letterSpacing: 1.0
          }
          for pRow in chunk(tablePresets, 2) {
            Row {
              fill: width
              gap: 8
              for pre in pRow {
                let isSel = tblPresetId == pre.id
                Row {
                  scale: tapBounce == "14${0}" ? 0.9 : 1
                  offset: [0, tapBounce == "14${0}" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "14${0}"
                  onRelease: tapBounce = ""
                  weight: 1
                  height: 44
                  padding: [10, 0]
                  radius: 10
                  align: center
                  justify: center
                  background: isSel ? alpha(accentGhost, 0.26) : alpha(cCard, 0.94)
                  border: isSel ? 1.5 : 1
                  borderColor: isSel ? accentGhost : alpha(cHot, 0.2)
                  onTap: {
                    if hapticsOn { haptic() }
                    tblPresetId  = pre.id
                    tblCardTitle = pre.title
                    tblHeaders   = pre.headers
                    tblRows      = pre.rows
                    tblEditRow   = -1
                    tblEditCol   = 0
                    tblCellDraft = pre.headers[0] ?? ""
                  }
                  Text {
                    font: uiFont
                    text: pre.label
                    fontSize: 12.5
                    fontWeight: isSel ? 800 : 600
                    color: isSel ? cHot : alpha(cHot, 0.86)
                    maxLines: 1
                  }
                }
              }
            }
          }
        }

        // Active Cell Editor Bar (Big 48px Input + Clear + Next Cell)
        Column {
          fill: width
          gap: 6
          padding: 10
          radius: 12
          background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.96), #000000, alpha(cPri, 0.09)])
          border: 1.2
          borderColor: alpha(accentGhost, 0.6)

          Text {
            text: editingLabel
            fontSize: 10.5
            font: uiFont
            fontWeight: 800
            color: accentGhost
            letterSpacing: 0.9
          }

          Box {
            fill: width
            height: 48
            padding: [12, 0]
            radius: 10
            background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), cObs, #000000, alpha(cSec, 0.11)])
            border: 1.3
            borderColor: accentGhost
            align: center
            Input {
              text: tblCellDraft
              placeholder: safeRow < 0 ? "Header text…" : "Cell value…"
              color: cHot
              fontSize: 14.5
              underline: false
              fill: width
              onChange: tblCellDraft = value
            }
          }

          Row {
            fill: width
            gap: 8

            Row {
              scale: tapBounce == "15${0}" ? 0.9 : 1
              offset: [0, tapBounce == "15${0}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "15${0}"
              onRelease: tapBounce = ""
              weight: 1
              height: 44
              radius: 10
              align: center
              justify: center
              background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cDeep, 0.94), #000000, alpha(cSec, 0.10)])
              border: 1
              borderColor: alpha(cHot, 0.22)
              onTap: {
                if hapticsOn { haptic() }
                tblCellDraft = ""
                if safeRow < 0 {
                  tblHeaders = range(len(tblHeaders)).map(i => i == safeCol ? "" : tblHeaders[i])
                } else {
                  tblRows = range(len(tblRows)).map(ri =>
                    ri == safeRow
                      ? range(len(tblRows[ri])).map(ci => ci == safeCol ? "" : tblRows[ri][ci])
                      : tblRows[ri]
                  )
                }
              }
              Text { font: uiFont; text: "⌫ CLEAR"; fontSize: 12; fontWeight: 700; color: cHot }
            }

            Row {
              scale: tapBounce == "16${0}" ? 0.9 : 1
              offset: [0, tapBounce == "16${0}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "16${0}"
              onRelease: tapBounce = ""
              weight: 2
              height: 44
              radius: 10
              align: center
              justify: center
              background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(accentGhost, 0.22), #000000, alpha(cPri, 0.09)])
              border: 1.2
              borderColor: alpha(accentGhost, 0.78)
              onTap: {
                if hapticsOn { haptic() }
                let nextCol = safeCol + 1 < colCnt ? safeCol + 1 : 0
                let nextRow = safeCol + 1 < colCnt
                  ? safeRow
                  : (safeRow + 1 < rowCnt ? safeRow + 1 : -1)
                tblEditCol = nextCol
                tblEditRow = nextRow
                tblCellDraft = nextRow < 0
                  ? (tblHeaders[nextCol] ?? "")
                  : (tblRows[nextRow][nextCol] ?? "")
              }
              Text { font: uiFont; text: "NEXT CELL →"; fontSize: 12.5; fontWeight: 800; color: cHot; letterSpacing: 0.7 }
            }
          }
        }

        // Interactive Tap-to-Edit Table Grid (Big 42px Cells)
        Column {
          fill: width
          gap: 6
          Text {
            text: "INTERACTIVE GRID (TAP CELL TO SELECT)"
            fontSize: 10.5
            font: uiFont
            bold: true
            color: alpha(cHot, 0.72)
            letterSpacing: 0.9
          }

          Column {
            fill: width
            radius: 10
            background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cObs, 0.92), #000000, alpha(cSec, 0.11)])
            border: 1
            borderColor: alpha(accentCol, 0.45)
            padding: 4
            gap: 4

            // Tappable Header Cells
            Row {
              fill: width
              gap: 4
              for ci in range(colCnt) {
                let activeCell = safeRow < 0 && safeCol == ci
                Row {
                  scale: tapBounce == "17${0}" ? 0.9 : 1
                  offset: [0, tapBounce == "17${0}" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "17${0}"
                  onRelease: tapBounce = ""
                  weight: 1
                  height: 42
                  padding: [6, 4]
                  radius: 7
                  align: center
                  background: activeCell ? alpha(accentGhost, 0.34) : alpha(accentCol, 0.22)
                  border: activeCell ? 1.8 : 0.9
                  borderColor: activeCell ? cHot : alpha(accentCol, 0.55)
                  onTap: {
                    if hapticsOn { haptic() }
                    tblEditRow   = -1
                    tblEditCol   = ci
                    tblCellDraft = tblHeaders[ci] ?? ""
                  }
                  Text {
                    font: uiFont
                    text: (tblHeaders[ci] ?? "") == "" ? "Col ${ci + 1}" : tblHeaders[ci]
                    fontSize: 11.5
                    fontWeight: 800
                    color: activeCell ? cHot : accentHot
                    maxLines: 1
                    fill: width
                  }
                }
              }
            }

            // Tappable Body Cells
            for ri in range(rowCnt) {
              Row {
                fill: width
                gap: 4
                for ci in range(colCnt) {
                  let activeCell = safeRow == ri && safeCol == ci
                  let cellVal = tblRows[ri][ci] ?? ""
                  Row {
                    scale: tapBounce == "18${0}" ? 0.9 : 1
                    offset: [0, tapBounce == "18${0}" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "18${0}"
                    onRelease: tapBounce = ""
                    weight: 1
                    height: 42
                    padding: [6, 4]
                    radius: 7
                    align: center
                    background: activeCell
                      ? alpha(accentGhost, 0.32)
                      : (ri % 2 == 1 ? alpha(accentCol, 0.09) : alpha(cCard, 0.85))
                    border: activeCell ? 1.8 : 0.8
                    borderColor: activeCell ? cHot : alpha(cHot, 0.16)
                    onTap: {
                      if hapticsOn { haptic() }
                      tblEditRow   = ri
                      tblEditCol   = ci
                      tblCellDraft = cellVal
                    }
                    Text {
                      font: uiFont
                      text: cellVal == "" ? "·" : cellVal
                      fontSize: 11.5
                      color: activeCell ? cHot : (cellVal == "" ? alpha(cHot, 0.3) : cHot)
                      maxLines: 2
                      fill: width
                    }
                  }
                }
              }
            }
          }
        }

        // Big + ROW / - ROW / + COL / - COL Structure Buttons (46px height)
        Column {
          fill: width
          gap: 8

          Row {
            fill: width
            gap: 8

            Row {
              scale: tapBounce == "19${0}" ? 0.9 : 1
              offset: [0, tapBounce == "19${0}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "19${0}"
              onRelease: tapBounce = ""
              weight: 1
              height: 46
              radius: 10
              align: center
              justify: center
              background: rowCnt < 12 ? alpha(cPri, 0.18) : alpha(cCard, 0.6)
              border: 1.2
              borderColor: rowCnt < 12 ? alpha(cPri, 0.72) : alpha(cHot, 0.15)
              onTap: {
                if hapticsOn { haptic() }
                if len(tblRows) < 12 {
                  tblRows = tblRows + [range(len(tblHeaders)).map(i => "")]
                  tblEditRow = len(tblRows) - 1
                  tblEditCol = 0
                  tblCellDraft = ""
                }
              }
              Text { font: uiFont; text: "+ ROW"; fontSize: 13; fontWeight: 800; color: rowCnt < 12 ? cHot : alpha(cHot, 0.35); letterSpacing: 0.8 }
            }

            Row {
              scale: tapBounce == "20${0}" ? 0.9 : 1
              offset: [0, tapBounce == "20${0}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "20${0}"
              onRelease: tapBounce = ""
              weight: 1
              height: 46
              radius: 10
              align: center
              justify: center
              background: rowCnt > 1 ? alpha(cMid, 0.18) : alpha(cCard, 0.6)
              border: 1.2
              borderColor: rowCnt > 1 ? alpha(cMid, 0.72) : alpha(cHot, 0.15)
              onTap: {
                if hapticsOn { haptic() }
                if len(tblRows) > 1 {
                  tblRows = tblRows.take(len(tblRows) - 1)
                  if tblEditRow >= len(tblRows) {
                    tblEditRow = len(tblRows) - 1
                    tblCellDraft = tblRows[tblEditRow][clamp(tblEditCol, 0, len(tblHeaders) - 1)] ?? ""
                  }
                }
              }
              Text { font: uiFont; text: "− ROW"; fontSize: 13; fontWeight: 800; color: rowCnt > 1 ? cHot : alpha(cHot, 0.35); letterSpacing: 0.8 }
            }
          }

          Row {
            fill: width
            gap: 8

            Row {
              scale: tapBounce == "21${0}" ? 0.9 : 1
              offset: [0, tapBounce == "21${0}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "21${0}"
              onRelease: tapBounce = ""
              weight: 1
              height: 46
              radius: 10
              align: center
              justify: center
              background: colCnt < 6 ? alpha(accentGhost, 0.18) : alpha(cCard, 0.6)
              border: 1.2
              borderColor: colCnt < 6 ? alpha(accentGhost, 0.72) : alpha(cHot, 0.15)
              onTap: {
                if hapticsOn { haptic() }
                if len(tblHeaders) < 6 {
                  let nextColNum = len(tblHeaders) + 1
                  tblHeaders = tblHeaders + ["Col ${nextColNum}"]
                  tblRows = tblRows.map(r => r + [""])
                  tblEditRow = -1
                  tblEditCol = len(tblHeaders) - 1
                  tblCellDraft = "Col ${nextColNum}"
                }
              }
              Text { font: uiFont; text: "+ COL"; fontSize: 13; fontWeight: 800; color: colCnt < 6 ? mix(accentGhost, cHot, 0.4) : alpha(cHot, 0.35); letterSpacing: 0.8 }
            }

            Row {
              scale: tapBounce == "22${0}" ? 0.9 : 1
              offset: [0, tapBounce == "22${0}" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "22${0}"
              onRelease: tapBounce = ""
              weight: 1
              height: 46
              radius: 10
              align: center
              justify: center
              background: colCnt > 2 ? alpha(cPri, 0.16) : alpha(cCard, 0.6)
              border: 1.2
              borderColor: colCnt > 2 ? alpha(cPri, 0.72) : alpha(cHot, 0.15)
              onTap: {
                if hapticsOn { haptic() }
                if len(tblHeaders) > 2 {
                  let newCols = len(tblHeaders) - 1
                  tblHeaders = tblHeaders.take(newCols)
                  tblRows = tblRows.map(r => r.take(newCols))
                  if tblEditCol >= newCols {
                    tblEditCol = newCols - 1
                    tblCellDraft = tblEditRow < 0
                      ? (tblHeaders[tblEditCol] ?? "")
                      : (tblRows[clamp(tblEditRow, 0, len(tblRows) - 1)][tblEditCol] ?? "")
                  }
                }
              }
              Text { font: uiFont; text: "− COL"; fontSize: 13; fontWeight: 800; color: colCnt > 2 ? cHot : alpha(cHot, 0.35); letterSpacing: 0.8 }
            }
          }
        }

        // Live Rendered Card Table Preview
        Column {
          fill: width
          gap: 6
          Text {
            text: "◉ LIVE CARD PREVIEW"
            fontSize: 10.5
            font: uiFont
            bold: true
            color: alpha(accentCol, 0.82)
            letterSpacing: 1.0
          }
          MdTable {
            headers: tblHeaders
            rows: tblRows
            bSz: 12
            col: cHot
            tagCol: accentCol
            fnt: "mono"
          }
        }
      }

      // Big Primary Action Footer (50px height)
      Row {
        fill: width
        gap: 10

        Row {
          scale: tapBounce == "23${0}" ? 0.9 : 1
          offset: [0, tapBounce == "23${0}" ? -4 : 0]
          animate scale: spring(0.32, 520)
          animate offset: spring(0.32, 520)
          onPress: tapBounce = "23${0}"
          onRelease: tapBounce = ""
          weight: 1
          height: 50
          radius: 12
          align: center
          justify: center
          background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.95), #000000, alpha(cPri, 0.09)])
          border: 1.1
          borderColor: alpha(cHot, 0.24)
          onTap: {
            if hapticsOn { haptic() }
            if tblTargetMode == "insertNote" {
              screenMode = "noteEditor"
            } else {
              close()
            }
          }
          Text { font: uiFont; text: "CANCEL"; fontSize: 13; fontWeight: 700; color: alpha(cHot, 0.85); letterSpacing: 0.9 }
        }

        Row {
          scale: tapBounce == "24${0}" ? 0.9 : 1
          offset: [0, tapBounce == "24${0}" ? -4 : 0]
          animate scale: spring(0.32, 520)
          animate offset: spring(0.32, 520)
          onPress: tapBounce = "24${0}"
          onRelease: tapBounce = ""
          weight: 2
          height: 50
          radius: 12
          align: center
          justify: center
          background: linear(0, 0, 1, 1, [accentCol, accentGhost, accentDark])
          border: 1.6
          borderColor: accentEmber
          onTap: {
            if hapticsOn { haptic() }
            if tblTargetMode == "insertNote" {
              let sep = (noteBody == "" || endsWith(noteBody, "\n")) ? "" : "\n\n"
              noteBody = (noteBody ?? "") + sep + tblMarkdown + "\n"
              screenMode = "noteEditor"
            } else {
              let nid = nextNoteId
              nextNoteId = nextNoteId + 1
              let finalTitle = trim(tblCardTitle ?? "") != "" ? trim(tblCardTitle) : "TABLE #${nid}"
              holocronNotes = holocronNotes + [{
                id: nid,
                title: finalTitle,
                text: tblMarkdown + "\n#table",
                font: uiFont
                fontSizeIdx: 1,
                size: "md",
                titleSz: 17,
                bodySz: 14,
                fontWeight: 600,
                colorIdx: 8,
                borderIdx: 1,
                radiusIdx: 2,
                skin: cardSkin,
                opacity: 0.95,
                pinned: false,
                time: timeHm
              }]
              close()
            }
          }
          Text {
            font: uiFont
            text: tblTargetMode == "insertNote" ? "✓ INSERT TABLE" : "✓ CREATE TABLE CARD"
            fontSize: 13.5
            fontWeight: 900
            color: hiInk
            letterSpacing: 0.9
          }
        }
      }
    }
  }

  
  // ================= ROOT CONDITIONAL VIEW =================
  Box {
    fill: true

    if screenMode == "deck" {
      Box {
        fill: true

    // 0-Loop AGSL Obsidian Backdrop (disabled for pure AMOLED true black)
    if false {
      Box {
        fill: true; align: center; clip: true
        Shader {
          // GLOBAL THEME BACKDROP v1 — per-theme scene, page 2 of the panorama, rendered at bgRes then upscaled
          width: ((screenWidth ?? tileWidth ?? 400) ?? 400) * bgRes; height: ((screenHeight ?? tileHeight ?? 800) ?? 800) * bgRes; scale: 1 / bgRes
          fallback: #000000
          uniforms: { uSpd: effFxOn && deckView != "canvas" ? animSpeed : 0.0, uStyle: modeIdx, uPage: 2, uGlow: bgGlow,
            uBurst: effFxOn ? burstT : 0.0, uTap: [burstX, burstY],
            uPri: bgPri, uHot: bgHot, uSec: bgSec, uDim: bgDim, uBone: bgBone }
          code: """
            // GLOBAL THEME BACKDROP v1 — one panorama across all home faces (uPage shifts the view).
            // 0 Infernal: Hellforge (lava-crack floor, rising embers, soul-fire mist)
            // 1 Future:   Holo Horizon (perspective grid, striped sun, data rain)
            // 2 Mask:     Smokin' Twister (roaming tornado, gold searchlights, confetti, zoot pinstripes)
            // 3 Skeletor: Snake Mountain (ridge silhouette, acid serpent, bone moon, lightning)
            // Low-res buffer + 16-level ordered-dither posterize = deliberate pixel-craft look. Max 9 loop turns/px.
            uniform float uSpd;
            uniform float uStyle;
            uniform float uPage;
            uniform float uGlow;
            uniform float uBurst;
            uniform float2 uTap;
            uniform half4 uPri;
            uniform half4 uHot;
            uniform half4 uSec;
            uniform half4 uDim;
            uniform half4 uBone;

            float h12(float2 p) {
              float3 p3 = fract(float3(p.xyx) * 0.1031);
              p3 += dot(p3, p3.yzx + 33.33);
              return fract((p3.x + p3.y) * p3.z);
            }
            float vn(float2 p) {
              float2 i = floor(p);
              float2 f = fract(p);
              f = f * f * (3.0 - 2.0 * f);
              return mix(mix(h12(i), h12(i + float2(1.0, 0.0)), f.x),
                         mix(h12(i + float2(0.0, 1.0)), h12(i + float2(1.0, 1.0)), f.x), f.y);
            }
            float fbm(float2 p) {
              return vn(p) * 0.55 + vn(p * 2.03 + 7.1) * 0.30 + vn(p * 4.11 + 3.7) * 0.15;
            }

            half4 main(float2 fc) {
              float2 sz = max(size, float2(1.0));
              float2 uv = fc / sz;
              float asp = sz.x / sz.y;
              float pw = asp;                                   // one page width in world units
              float2 w = float2((uv.x + uPage) * asp, uv.y);     // panorama world coords
              float t = uSpd > 0.0 ? mod(time, 3600.0) * uSpd : 0.0;
              half3 pri = uPri.rgb;
              half3 hot = uHot.rgb;
              half3 sec = uSec.rgb;
              half3 dim = uDim.rgb;
              half3 bone = uBone.rgb;
              half3 col = half3(0.0);

              if (uStyle < 0.5) {
                // ===== INFERNAL · HELLFORGE =====
                float smoke = fbm(w * 2.6 + float2(t * 0.03, t * 0.07));
                col += dim * half(smoke * smoke * 0.55 * (0.35 + uv.y));
                // soul-fire mist (cold secondary) hugging the top
                float mist = fbm(w * 3.4 - float2(t * 0.05, 0.0));
                col += sec * half(mist * exp(-uv.y * 7.0) * 0.18);
                // lava-crack floor: 3x3 cellular, edge = F2-F1
                float floorM = smoothstep(0.58, 0.98, uv.y);
                if (floorM > 0.001) {
                  float2 q = float2(w.x * 10.0, (uv.y - 0.55) * 22.0 + 3.0 + sin(w.x * 4.0) * 0.6);
                  float2 qi = floor(q);
                  float2 qf = fract(q);
                  float f1 = 8.0;
                  float f2 = 8.0;
                  for (int j = -1; j <= 1; j++) {
                    for (int i = -1; i <= 1; i++) {
                      float2 g = float2(float(i), float(j));
                      float2 o = float2(h12(qi + g), h12(qi + g + 19.7));
                      o = 0.5 + 0.38 * sin(t * 0.35 + 6.2831 * o);
                      float d = length(g + o - qf);
                      if (d < f1) { f2 = f1; f1 = d; } else if (d < f2) { f2 = d; }
                    }
                  }
                  float crack = 1.0 - smoothstep(0.0, 0.07, f2 - f1);
                  crack *= 0.55 + 0.45 * vn(q * 1.7 + t * 0.2);
                  float pulse = 0.6 + 0.4 * sin(t * 1.3 + w.x * 3.0 + uv.y * 9.0);
                  col += mix(pri, hot, half(crack * 0.6)) * half(crack * floorM * pulse * 1.9);
                  col += pri * half(floorM * floorM * 0.22 * (0.7 + 0.3 * pulse));
                }
                // rising embers
                float2 e = float2(w.x * 13.0, uv.y * 13.0 + t * 1.15);
                float2 ei = floor(e);
                float eh = h12(ei);
                if (eh > 0.82) {
                  float2 ef = fract(e) - 0.5;
                  ef.x += 0.28 * sin(t * 1.7 + eh * 40.0);
                  float spark = exp(-dot(ef, ef) * 140.0);
                  float flick = 0.55 + 0.45 * sin(t * 9.0 + eh * 70.0);
                  col += mix(hot, half3(1.0, 0.85, 0.6), half(0.25)) * half(spark * flick * (0.35 + 0.9 * uv.y));
                }
              } else if (uStyle < 1.5) {
                // ===== FUTURE · HOLO HORIZON =====
                float hz = 0.63;
                float sunX = pw * 1.5;                         // sun rises over the centre page
                float2 sd = float2(w.x - sunX, (uv.y - hz + 0.02) * 1.0);
                float sr = length(sd * float2(1.0, 1.15));
                if (uv.y < hz) {
                  // striped synth sun
                  float disc = 1.0 - smoothstep(0.17, 0.18, sr);
                  float stripes = step(0.0, sin(uv.y * 140.0 - t * 2.0)) + step(uv.y, hz - 0.14);
                  col += mix(sec, hot, half(clamp((hz - uv.y) * 4.0, 0.0, 1.0))) * half(disc * min(stripes, 1.0) * 0.75);
                  col += sec * half(exp(-sr * 7.0) * 0.30);
                  // data rain columns
                  float cx = floor(w.x * 46.0);
                  float sp = 0.25 + h12(float2(cx, 3.0)) * 0.55;
                  float head = fract(t * sp * 0.35 + h12(float2(cx, 9.0)));
                  float dy = head - uv.y;
                  float trail = dy > 0.0 ? exp(-dy * 18.0) : 0.0;
                  float bit = step(0.45, h12(float2(cx, floor(uv.y * 70.0) + floor(t * 6.0 * sp))));
                  float colOn = step(0.62, h12(float2(cx, 1.0)));
                  col += pri * half(trail * bit * colOn * 0.55 * (1.0 - smoothstep(hz - 0.15, hz, uv.y)));
                  // faint holo stars
                  float st = h12(floor(w * 160.0));
                  col += hot * half(step(0.996, st) * (0.4 + 0.6 * sin(t * 3.0 + st * 90.0)) * 0.5);
                } else {
                  // perspective grid floor rolling toward the viewer
                  float dz = uv.y - hz;
                  float z = 0.32 / max(dz, 0.004);
                  float gx = (w.x - sunX) * z * 3.0;
                  float gz = z + t * 0.9;
                  float lx = abs(fract(gx) - 0.5);
                  float lz = abs(fract(gz) - 0.5);
                  float wpx = min(0.012 * z, 0.3);                          // keep lines ~constant width on screen
                  float grid = max(1.0 - smoothstep(0.0, 0.02 + wpx, lx), 1.0 - smoothstep(0.0, 0.02 + wpx, lz));
                  float fade = exp(-z * 0.05);
                  col += pri * half(grid * fade * 0.95);
                  col += sec * half(exp(-dz * 30.0) * 0.45);    // horizon bloom
                  col += dim * half(fade * 0.25);
                }
                col += sec * half(exp(-abs(uv.y - hz) * 220.0) * 0.9); // horizon laser line
              } else if (uStyle < 2.5) {
                // ===== MASK · SMOKIN' TWISTER =====
                // zoot pinstripes
                float pin = smoothstep(0.455, 0.49, abs(fract(w.x * 22.0 + uv.y * 3.0) - 0.5));
                col += dim * half(pin * 0.55) + pri * half(0.03 * (1.0 - uv.y * 0.5));
                // art-deco searchlights, one per page base, sweeping
                float pIdx = floor(w.x / pw);
                float2 base = float2((pIdx + 0.5) * pw, 1.08);
                float2 bv = w - base;
                float ang = atan(bv.x, -bv.y);
                float sweep = 0.55 * sin(t * 0.55 + pIdx * 2.1);
                float beam = exp(-abs(ang - sweep) * 26.0) * smoothstep(1.3, 0.1, length(bv));
                col += sec * half(beam * 0.55);
                // roaming tornado: drifts across the whole panorama over time
                float tx = (0.5 + 2.0 * (0.5 + 0.5 * sin(t * 0.06))) * pw;
                float cxT = tx + 0.05 * sin(t * 1.4 + uv.y * 6.0) + 0.07 * (1.0 - uv.y) * sin(t * 0.8);
                float halfW = 0.02 + 0.11 * (1.0 - uv.y) * (1.0 - uv.y);
                float rx = (w.x - cxT) / halfW;
                if (abs(rx) < 1.25) {
                  float body = 1.0 - smoothstep(0.75, 1.2, abs(rx));
                  float spin = sin(asin(clamp(rx, -1.0, 1.0)) * 3.0 - t * 7.0 + uv.y * 26.0);
                  float band = smoothstep(0.2, 1.0, spin);
                  float edge = exp(-abs(abs(rx) - 0.95) * 9.0);
                  col += mix(pri, hot, half(band)) * half(body * (0.08 + band * 0.42));
                  col += sec * half(edge * body * 0.25 * (0.5 + 0.5 * sin(t * 4.0 + uv.y * 30.0)));
                }
                // confetti stars falling and spinning
                float2 c = float2(w.x * 11.0, uv.y * 11.0 - t * 0.9);
                float2 ci = floor(c);
                float chs = h12(ci + 4.0);
                if (chs > 0.86) {
                  float2 cf = fract(c) - 0.5;
                  float a = t * 3.0 + chs * 50.0;
                  float2 r = float2(cf.x * cos(a) - cf.y * sin(a), cf.x * sin(a) + cf.y * cos(a));
                  float star = 1.0 - smoothstep(0.05, 0.09, abs(r.x) + abs(r.y) * 2.2);
                  half3 cc = chs > 0.95 ? sec : (chs > 0.905 ? hot : pri);
                  col += cc * half(star * 0.85);
                }
                col += pri * half(exp(-(1.0 - uv.y) * 6.0) * 0.18);
              } else {
                // ===== SKELETOR · SNAKE MOUNTAIN =====
                float fog = fbm(w * 2.2 + float2(t * 0.04, -t * 0.02));
                col += dim * half(fog * 0.6 * (0.4 + 0.6 * uv.y));
                // sparse stars
                float st = h12(floor(w * 150.0));
                col += bone * half(step(0.997, st) * 0.45 * (0.5 + 0.5 * sin(t * 2.0 + st * 80.0)));
                // bone moon over the right page
                float2 md = float2(w.x - pw * 2.62, uv.y - 0.2);
                float mr = length(md);
                float moon = 1.0 - smoothstep(0.105, 0.112, mr);
                float crater = vn(md * 38.0);
                col += bone * half(moon * (0.38 + 0.22 * crater));
                col += pri * half(exp(-mr * 9.0) * 0.22);
                // lightning flash (rare)
                float lk = floor(t * 0.7);
                float fl = step(0.8, h12(float2(lk, 5.0))) * exp(-fract(t * 0.7) * 7.0);
                col += pri * half(fl * 0.25 * (1.0 - uv.y));
                float bx = (h12(float2(lk, 8.0)) * 3.0) * pw;
                float bolt = exp(-abs(w.x - bx - 0.06 * (vn(float2(uv.y * 14.0, lk)) - 0.5) * 2.0) * 160.0);
                col += mix(hot, bone, half(0.5)) * half(bolt * fl * step(uv.y, 0.7) * 1.4);
                // acid serpent slithering across the sky
                float sy = 0.40 + 0.065 * sin(w.x * 3.2 - t * 1.1) + 0.02 * sin(w.x * 9.0 - t * 2.3);
                float thick = 0.007 + 0.004 * sin(w.x * 1.3 - t * 0.5);
                float sdist = abs(uv.y - sy);
                float body = 1.0 - smoothstep(thick * 0.6, thick, sdist);
                float scales = 0.75 + 0.25 * sin(w.x * 140.0 - t * 6.0);
                col += sec * half(body * scales * 0.55);
                col += sec * half(exp(-sdist * 55.0) * 0.16);
                // mountain ridge silhouette with violet rim light
                float ridge = 0.70 + 0.10 * vn(float2(w.x * 2.2, 1.0)) + 0.05 * vn(float2(w.x * 6.0, 2.0))
                              - 0.26 * exp(-abs(w.x - pw * 1.5) * 4.5);
                float below = smoothstep(ridge - 0.004, ridge + 0.004, uv.y);
                float rim = exp(-abs(uv.y - ridge) * 90.0);
                col *= half(1.0 - below * 0.92);
                col += pri * half(rim * 0.7 + below * fog * 0.05);
              }

              // tap shockwave (shared)
              if (uBurst > 0.005) {
                float2 dt2 = (uv - uTap) * float2(asp, 1.0);
                float dr = (length(dt2) - (1.0 - uBurst) * 0.7) * 24.0;
                col += mix(pri, hot, half(0.6)) * half(exp(-dr * dr) * uBurst * 0.6);
              }

              // OLED grade: vignette, soft tonemap, ordered-dither posterize (pixel-craft), true black floor
              float2 cv = (uv - float2(0.5, 0.5)) * float2(1.1, 0.9);
              col *= half(clamp(1.0 - dot(cv, cv) * 0.6, 0.3, 1.0));
              col = col / (half3(1.0) + col * half(0.55));
              col *= half(uGlow);
              float2 bp = floor(fc);
              float bay = fract((mod(bp.x, 2.0) * 2.0 + mod(bp.y, 2.0) * 3.0) * 0.25) - 0.375;
              col = floor(col * half(24.0) + half(bay + 0.5)) / half(24.0);
              col = max(col - half3(0.025), half3(0.0));
              return half4(clamp(col, half3(0.0), half3(1.0)), 1.0);
            }
          """
        }
      }
    } else {
      // Pure AMOLED true-black opaque floor (0% grey bleed, 0 GPU cost)
      Box {
        fill: true
        background: isOledMode ? #000000 : cObs
      }
    }

    // Obsidian Command Deck Layout: Header Plate + Tactical HUD + 2 Actions + Feed/Canvas
    // ◈ OVERHAUL: drifting twin crimson glows + slow light veil (frozen when FX/eco off)
    if !ecoOn {
      // OVERHAUL vignette: crush the backdrop toward AMOLED black, darkest at the edges
      Box { fill: true; background: radial(0.5, 0.42, 0.95, [alpha(#000000, 0.34), alpha(#000000, 0.66), alpha(#000000, 0.9)]) }
      Box { fill: true; background: radial(0.5 + 0.38 * sin(fxT * 0.21), 0.08 + 0.07 * cos(fxT * 0.29), 0.95, [alpha(cPri, 0.07), alpha(#000000, 0)]) }
      Box { fill: true; background: radial(0.2 + 0.3 * cos(fxT * 0.16), 0.96, 0.85, [alpha(cSec, 0.06), alpha(#000000, 0)]) }
    }

    Column {
      fill: true
      align: start
      padding: [0, 10, 0, 0]
      gap: 8

      // 1. Obsidian Header Plate (Emblem + Title/Meta + Canvas/Feed Pill + hub Gear)
      Column {
        fill: width
        padding: [12, 0]
        gap: 0
        Column {
          fill: width
          radius: 15
          clip: true
          background: linear(0, 0, 1, 1, [alpha(accentDark, 0.94), alpha(cObs, 0.96)])
          border: 1.35
          borderColor: alpha(accentCol, 0.78)
          gap: 0

          // Top specular glass rail (cPri -> cHot -> cBone)
          Box {
            fill: width
            height: 1.5
            background: linear(0, 0, 1, 0, [alpha(cPri, 0.12), cPri, cHot, cBone, alpha(cPri, 0.12)])
          }

          Row {
            fill: width
            align: center
            padding: [10, 8]
            gap: 9

            Sigil { size: 36 }

            Column {
              weight: 1
              gap: 1
              Text {
                font: dispFont
                text: curMode == "skeletor" ? "HAVOC DECK" : curMode == "mask" ? "MASK DECK" : curMode == "future" ? "CYBER DECK" : "SITH DECK"
                fontSize: 15.5
                fontWeight: 900
                color: hiInk
                letterSpacing: 1.0
                maxLines: 1
              }
              Text {
                text: "${len(holocronNotes)} CARDS · ${upper(curMode == "infernal" ? hubTheme : curMode)}"
                fontSize: 9.5
                font: bodyFont
                fontWeight: 800
                color: alpha(accentEmber, 0.92)
                letterSpacing: 1.0
                maxLines: 1
              }
            }


            Row {
              scale: tapBounce == "26" ? 0.9 : 1
              offset: [0, tapBounce == "26" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "26"
              onRelease: tapBounce = ""
              width: 40
              height: 40
              radius: 11
              align: center
              justify: center
              background: linear(0, 0, 1, 1, [alpha(accentEmber, 0.22), alpha(accentDark, 0.96)])
              border: 1.4
              borderColor: alpha(accentEmber, 0.78)
              onTap: {
                if hapticsOn { haptic() }
                if effFxOn { burstT = 1.0; burstX = 0.90; burstY = 0.08 }
                screenMode = "sith"
                tab = "customize"
                confirmKey = ""
                query = ""
                statusMsg = ""
                refresh()
                // screen()
              }
              Text { font: uiFont; text: "◈"; fontSize: 18; fontWeight: 900; color: amberInk }
            }
          }
        }
      }

      // 1b. Tactical Telemetry & 1-Tap Shader/Texture Ribbon (zero extra sources, <10 nodes)
      Row {
        fill: width
        padding: [12, 0]
        gap: 6
        align: center

        Row {
          weight: 1
          height: 30
          padding: [10, 0]
          radius: 9
          align: center
          gap: 8
          background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cObs, 0.90), #000000, alpha(cSec, 0.10)])
          border: 1
          borderColor: alpha(accentCol, 0.36)

          Text { text: timeHm; fontSize: 10.5; font: uiFont; fontWeight: 800; color: hiInk; maxLines: 1 }
          Text { text: "·"; fontSize: 10; font: uiFont; color: alpha(accentCol, 0.65) }
          Text { text: "${bat.charging ? "⚡" : "◈"}${bat.level ?? "…"}%"; fontSize: 10.5; font: uiFont; fontWeight: 800; color: bat.charging ? accentEmber : accentHot; maxLines: 1 }
          Text { text: "·"; fontSize: 10; font: uiFont; color: alpha(accentCol, 0.65) }
          Text { text: "RAM ${deckMemPct}%"; fontSize: 10; font: uiFont; fontWeight: 700; color: alpha(hiInk, 0.72); maxLines: 1 }
        }

      }

      // 2. Primary Action Row (+ ADD CARD | ⊞ TABLE)
      Row {
        fill: width
        padding: [12, 0]
        gap: 10

        Column {
          scale: tapBounce == "27" ? 0.9 : 1
          offset: [0, tapBounce == "27" ? -4 : 0]
          animate scale: spring(0.32, 520)
          animate offset: spring(0.32, 520)
          onPress: tapBounce = "27"
          onRelease: tapBounce = ""
          weight: 1
          height: 50
          radius: 13
          clip: true
          background: linear(0, 0, 1, 1, [accentCol, accentGhost, accentDark])
          border: 1.6
          borderColor: accentHot
          gap: 0
          onTap: {
            if hapticsOn { haptic() }
            if effFxOn { burstT = 1.0; burstX = 0.30; burstY = 0.22 }
            editId = 0
            noteFld = max(cvFolder, 0)
            noteTitle = ""
            noteBody = ""
            edMode = "live"
            edBlkS = -1
            noteSize = hubCardSize
            noteFont = hubCardFont
            noteBodySz = hubBodySz
            noteSkin = cardSkin
            notePinned = false
            noteAccentBar = true
            noteBorderStyle = "hairline"
            screenMode = "noteEditor"
            // screen()
          }
          Box {
            fill: width
            height: 1.6
            background: linear(0, 0, 1, 0, [alpha(hiInk, 0.15), accentEmber, alpha(hiInk, 0.35)])
          }
          Row {
            weight: 1
            fill: width
            align: center
            justify: center
            gap: 6
            Text { font: uiFont; text: "+"; fontSize: 18; fontWeight: 900; color: accentEmber }
            Text { font: uiFont; text: "ADD CARD"; fontSize: 14.5; fontWeight: 900; color: hiInk; letterSpacing: 1.1 }
          }
        }

        Column {
          scale: tapBounce == "28" ? 0.9 : 1
          offset: [0, tapBounce == "28" ? -4 : 0]
          animate scale: spring(0.32, 520)
          animate offset: spring(0.32, 520)
          onPress: tapBounce = "28"
          onRelease: tapBounce = ""
          weight: 1
          height: 50
          radius: 13
          clip: true
          background: linear(0, 0, 1, 1, [alpha(accentEmber, 0.24), alpha(accentDark, 0.96), #060002])
          border: 1.6
          borderColor: alpha(accentEmber, 0.85)
          gap: 0
          onTap: {
            if hapticsOn { haptic() }
            if effFxOn { burstT = 1.0; burstX = 0.78; burstY = 0.22 }
            tblTargetMode = "newCard"
            tblPresetId   = "tasks"
            tblCardTitle  = "Task Tracker"
            tblHeaders    = ["Task", "Status", "Priority"]
            tblRows       = [
              ["Design UI", "Done", "High"],
              ["Build Tables", "WIP", "High"],
              ["Polish Perf", "Todo", "Med"]
            ]
            tblEditRow    = -1
            tblEditCol    = 0
            tblCellDraft  = "Task"
            screenMode = "tableBuilder"
            // screen()
          }
          Box {
            fill: width
            height: 1.6
            background: linear(0, 0, 1, 0, [alpha(accentEmber, 0.12), accentEmber, alpha(accentCol, 0.3)])
          }
          Row {
            weight: 1
            fill: width
            align: center
            justify: center
            gap: 6
            Text { font: uiFont; text: "⊞"; fontSize: 16; fontWeight: 900; color: accentEmber }
            Text { font: uiFont; text: "TABLE"; fontSize: 14.5; fontWeight: 900; color: amberInk; letterSpacing: 1.1 }
          }
        }
      }


      if cvFolder < 0 {
      // ◈ FOLDER PICKER — the first thing the canvas shows. Tap to open, long-press to edit.
      Column {
        weight: 1
        fill: width
        padding: [14, 4, 14, screenInset + 12]
        gap: 12
        Row {
          fill: width
          align: center
          gap: 8
          Column {
            weight: 1
            gap: 2
            Text { font: uiFont; text: "◈ FOLDERS"; fontSize: 13; fontWeight: 900; color: cHot; letterSpacing: 2.2 }
            Text { font: uiFont; text: "${len(cvFolders) + 1} FOLDERS  ·  TAP TO OPEN  ·  HOLD TO EDIT"; fontSize: 9.5; color: cMuted; letterSpacing: 1.2; maxLines: 1 }
          }
          Box {
            width: 96; height: 40; radius: 12; align: center
            background: linear(0, 0, 1, 1, [alpha(cPri, 0.42), #000000, alpha(cSec, 0.32)]); border: 1.3; borderColor: alpha(cHot, 0.7)
            onTap: {
              if hapticsOn { haptic() }
              if fldEdit { fldEdit = false } else {
                fldEditId = 0
                fldName = ""
                fldCol = len(cvFolders) % len(fldCols)
                fldEdit = true
              }
            }
            Text { font: uiFont; text: fldEdit ? "✕" : "+ FOLDER"; fontSize: 12; fontWeight: 900; color: hiInk; letterSpacing: 1.2; align: center; fill: width }
          }
        }

        if fldEdit {
          Column {
            fill: width
            padding: [14, 14]
            radius: 16
            gap: 10
            background: linear(0, 0, 1, 1, [alpha(fldCols[fldCol], 0.30), #000000, alpha(fldCols[fldCol], 0.12)])
            border: 1.3
            borderColor: alpha(fldCols[fldCol], 0.8)
            Text { font: uiFont; text: fldEditId == 0 ? "✦  NEW FOLDER" : "✦  EDIT FOLDER"; fontSize: 11; color: fldCols[fldCol]; fontWeight: 900; letterSpacing: 1.8 }
            Box {
              fill: width
              padding: [12, 8]
              radius: 10
              background: alpha(cObs, 0.95)
              border: 1
              borderColor: alpha(fldCols[fldCol], 0.45)
              Input { text: fldName; placeholder: "Folder name"; color: cInk; fontSize: 15; underline: false; onChange: fldName = value }
            }
            Row {
              fill: width
              gap: 8
              align: center
              for ci in range(len(fldCols)) key ci {
                Box {
                  weight: 1
                  height: 30
                  radius: 99
                  background: radial(0.35, 0.3, 0.9, [fldCols[ci], alpha(fldCols[ci], 0.3)])
                  border: fldCol == ci ? 2.2 : 1
                  borderColor: fldCol == ci ? cInk : alpha(fldCols[ci], 0.5)
                  scale: fldCol == ci ? 1.18 : 1.0
                  animate scale: spring(0.4, 480)
                  onTap: {
                    if hapticsOn { haptic() }
                    fldCol = ci
                  }
                }
              }
            }
            Text { font: uiFont; text: fldNames[fldCol]; fontSize: 9.5; color: fldCols[fldCol]; letterSpacing: 2; fontWeight: 800 }
            Row {
              fill: width
              gap: 8
              Box {
                weight: 1; height: 40; radius: 12; align: center
                background: linear(0, 0, 1, 1, [alpha(fldCols[fldCol], 0.5), #000000]); border: 1.3; borderColor: fldCols[fldCol]
                onTap: {
                  if hapticsOn { haptic() }
                  let nm = trim(fldName) != "" ? upper(trim(fldName)) : "FOLDER"
                  if fldEditId == 0 {
                    cvFolders = cvFolders + [{ id: nextFldId, name: nm, col: fldCol }]
                    nextFldId = nextFldId + 1
                  } else {
                    cvFolders = cvFolders.map(f => f.id == fldEditId ? { id: f.id, name: nm, col: fldCol } : f)
                  }
                  fldEdit = false
                }
                Text { font: uiFont; text: "SAVE"; fontSize: 12; fontWeight: 900; color: hiInk; letterSpacing: 1.2; align: center; fill: width }
              }
              Box {
                width: 84; height: 40; radius: 12; align: center
                background: alpha(cCard, 0.96); border: 1.3; borderColor: alpha(accentCol, 0.6)
                onTap: {
                  if hapticsOn { haptic() }
                  fldEdit = false
                }
                Text { font: uiFont; text: "CANCEL"; fontSize: 12; fontWeight: 900; color: cInk; letterSpacing: 1.2; align: center; fill: width }
              }
              if fldEditId != 0 {
                Box {
                  width: 84; height: 40; radius: 12; align: center
                  background: alpha(#000000, 0.9); border: 1.3; borderColor: alpha(cPri, 0.8)
                  onTap: {
                    if hapticsOn { haptic() }
                    let did = fldEditId
                    holocronNotes = holocronNotes.map(c => (c.fld ?? 0) == did ? merge(c, { fld: 0 }) : c)
                    cvFolders = cvFolders.filter(f => f.id != did)
                    fldEdit = false
                  }
                  Text { font: uiFont; text: "DELETE"; fontSize: 12; fontWeight: 900; color: cPri; letterSpacing: 1.2; align: center; fill: width }
                }
              }
            }
            if fldEditId != 0 {
              Text { font: uiFont; text: "Deleting a folder moves its cards to UNSORTED."; fontSize: 10; color: cMuted }
            }
          }
        }

        Grid {
          columns: 2
          gap: 10
          lazy: true
          weight: 1
          fill: width
          for f in [{ id: 0, name: "UNSORTED", col: -1 }] + cvFolders key f.id {
            let fc = f.col < 0 ? cMuted : fldCols[f.col % len(fldCols)]
            let cnt = len(holocronNotes.filter(c => (c.fld ?? 0) == f.id))
            Box {
              height: 128
              radius: 18
              clip: true
              background: linear(0, 0, 1, 1, [alpha(fc, 0.34), #000000, #000000, alpha(fc, 0.16)])
              border: 1.3
              borderColor: alpha(fc, 0.75)
              scale: tapBounce == "fld${f.id}" ? 0.92 : 1
              offset: [0, tapBounce == "fld${f.id}" ? -5 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "fld${f.id}"
              onRelease: tapBounce = ""
              onTap: {
                if hapticsOn { haptic() }
                cvFolder = f.id
                cvPage = 0
                cvSel = 0
                fldEdit = false
              }
              onLongPress: {
                if f.id != 0 {
                  if hapticsOn { haptic() }
                  fldEditId = f.id
                  fldName = f.name
                  fldCol = f.col
                  fldEdit = true
                }
              }
              Box { fill: true; background: radial(0.88, 0.12, 0.7, [alpha(fc, 0.28), alpha(#000000, 0)]) }
              Column {
                fill: true
                padding: [14, 12]
                gap: 4
                Row {
                  fill: width
                  align: center
                  // folder glyph: tab + body in the folder's color
                  Column {
                    gap: 0
                    Box { width: 16; height: 5; radius: 2; background: fc }
                    Box { width: 30; height: 20; radius: 4; background: linear(0, 0, 0, 1, [fc, alpha(fc, 0.45)]) }
                  }
                  Box { weight: 1 }
                  Text { font: uiFont; text: "${cnt}"; fontSize: 22; fontWeight: 900; color: cInk }
                }
                Box { weight: 1 }
                Text { font: uiFont; text: f.name; fontSize: 13; fontWeight: 900; color: cInk; letterSpacing: 1.4; maxLines: 1 }
                Box { fill: width; height: 2; radius: 99; background: linear(0, 0, 1, 0, [fc, alpha(fc, 0)]) }
                Text { font: uiFont; text: cnt == 1 ? "1 CARD" : "${cnt} CARDS"; fontSize: 9; color: alpha(fc, 0.9); letterSpacing: 1.4; fontWeight: 700 }
              }
            }
          }
        }
      }
      } else {
      // Folder bar: back to folders · current folder · move the selected card to another folder
      Row {
        fill: width
        padding: [14, 0, 14, 6]
        gap: 8
        align: center
        Box {
          width: 104; height: 36; radius: 12; align: center
          background: alpha(#000000, 0.9); border: 1.3; borderColor: alpha(cvFldCol, 0.8)
          onTap: {
            if hapticsOn { haptic() }
            cvFolder = -1
            cvSel = 0
            cvGest = ""
          }
          Text { font: uiFont; text: "◂ FOLDERS"; fontSize: 12; fontWeight: 900; color: cvFldCol; letterSpacing: 1.2; align: center; fill: width }
        }
        Box { width: 12; height: 12; radius: 99; background: cvFolder == 0 ? cMuted : cvFldCol }
        Text { font: uiFont; text: cvFolder == 0 ? "UNSORTED" : (cvFld != null ? cvFld.name : "FOLDER"); fontSize: 13; fontWeight: 900; color: cInk; letterSpacing: 1.6; weight: 1; maxLines: 1 }
      }
      // 3. Card-After-Card Vertical Scrolling Feed
      Column {
        weight: 1
        fill: width
        scroll: true
        padding: [12, 2, 12, screenInset + 22]
        gap: 12

        if len(holocronNotes.filter(c => (c.fld ?? 0) == cvFolder)) == 0 {
          Column {
            fill: width
            padding: 28
            align: center
            gap: 8
            radius: 16 * corners * hubRadius
            background: linear(0, 0, 0, 1, [alpha(#ffffff, 0.03), #050001])
            border: 1
            borderColor: alpha(accentCol, 0.38)
            Text { font: uiFont; text: "NO CARDS YET"; fontSize: 18; fontWeight: 900; color: hiInk }
            Text { font: uiFont; text: "Tap + ADD CARD or ⊞ TABLE above."; fontSize: 14; color: alpha(amberInk, 0.78); align: "center" }
          }
        }

        for card in holocronNotes.filter(c => (c.fld ?? 0) == cvFolder) key card.id {
          let cid      = card.id
          let pal      = notePalettes[clamp(card.colorIdx ?? 0, 0, len(notePalettes) - 1)]
          let cSz      = card.size ?? "md"
          let cFont    = uiFont
          let cWeight  = card.fontWeight ?? 600
          let cAlign   = card.align ?? "start"
          let cPinned  = card.pinned == true
          let cBodySz  = cSz == "sm" ? 13 : cSz == "lg" ? max(15.5, card.bodySz ?? 15.5) : max(13.5, card.bodySz ?? 14)
          let cOpen    = expandId == cid
          let cHasBody = trim(card.text ?? "") != ""
          let cTags    = split(replace(card.text ?? "", "\n", " "), " ").filter(w => startsWith(w, "#") && len(w) > 1 && !startsWith(w, "##")).take(3)
          let cMeta    = join([card.time ?? ""] + cTags, "  ·  ")

          Row {
            scale: tapBounce == "40${card.id}" ? 0.9 : 1
            offset: [0, tapBounce == "40${card.id}" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "40${card.id}"
            onRelease: tapBounce = ""
            fill: width
            radius: 16 * corners * hubRadius
            clip: true
            background: linear(0, 0, 0, 1, [alpha(mix(pal.bg2 ?? pal.bg, #ffffff, 0.04), 0.96), #050001])
            border: 1
            borderColor: alpha(cOpen ? accentEmber : pal.border, cOpen ? 0.85 : 0.38)
            onTap: { if hapticsOn { haptic() }; expandId = cOpen ? 0 : cid }
            Box { width: 3; fill: height; background: linear(0, 0, 0, 1, [pal.border, alpha(pal.border, 0.15)]) }
            Column {
              weight: 1
              padding: [14, 15, 15, 14]
              gap: 8
              Row {
                fill: width
                align: center
                gap: 8
                Text { font: uiFont; text: (cPinned ? "◆ " : "") + ((card.title ?? "") != "" ? card.title : "Untitled"); fontSize: 16.5; fontWeight: 800; color: inkTitle != null ? inkTitle : pal.text; maxLines: 2; weight: 1 }
                Text {
                  scale: tapBounce == "41${card.id}" ? 0.9 : 1
                  offset: [0, tapBounce == "41${card.id}" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "41${card.id}"
                  onRelease: tapBounce = ""
                  font: uiFont; text: "✎"; fontSize: 15; color: alpha(pal.text, 0.7)
                  width: 44; height: 36; align: center; radius: 10
                  background: alpha(#ffffff, 0.04)
                  onTap: {
                    if hapticsOn { haptic() }
                    editId = cid
                    noteTitle = card.title ?? ""
                    noteBody = card.text ?? ""
                    noteSize = cSz
                    noteSkin = cardSkin
                    noteFont = cFont
                    noteBodySz = card.bodySz ?? 14
                    noteWeight = cWeight
                    noteAlign = cAlign
                    noteColorIdx = card.colorIdx ?? 0
                    noteFld = card.fld ?? 0
                    notePinned = cPinned
                    noteAccentBar = card.accentBar ?? true
                    noteBorderStyle = card.borderStyle ?? "hairline"
                    screenMode = "noteEditor"
                    // screen()
                  }
                }
              }
              if cOpen && card.table != null {
                MdTable { headers: card.table.headers ?? []; rows: card.table.rows ?? []; bSz: cBodySz; col: pal.text; tagCol: pal.tag; fnt: cFont }
              }
              if cHasBody {
                MdView { raw: card.text ?? ""; pal: pal; bSz: cBodySz; fnt: cFont; wt: cWeight; algn: cAlign; maxLn: cOpen ? 40 : 3; cid: cid; live: cOpen }
              }
              if cMeta != "" {
                Text { font: uiFont; text: cMeta; fontSize: 10.5; color: alpha(pal.tag, 0.6); letterSpacing: 0.5; maxLines: 1 }
              }
            }
          }
        }
      }
      }
    }
      }
    } else {
      Box {
        fill: true
        if screenMode == "noteEditor" {
      let edPal  = notePalettes[clamp(noteColorIdx, 0, len(notePalettes) - 1)]
      let curIdx = editId > 0 ? (range(len(holocronNotes)).find(i => holocronNotes[i].id == editId) ?? -1) : -1

      Column {
        fill: true
        background: cObs
        padding: 14
        gap: 12

        // Scrollable Simple Card Editor Body
        Column {
          weight: 1
          fill: width
          scroll: true
          gap: 12

          Row {
            scale: tapBounce == "42" ? 0.9 : 1
            offset: [0, tapBounce == "42" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "42"
            onRelease: tapBounce = ""
            fill: width; height: 46; radius: 12; align: center; justify: center; gap: 8
            background: alpha(accentDark, 0.94); border: 1.4; borderColor: alpha(accentCol, 0.8)
            onTap: {
              if hapticsOn { haptic() }
              imgTarget = "card"
              imgRes = ""
              screenMode = "imgPick"
            }
            Text { font: uiFont; text: "🖼 ADD IMAGE"; fontSize: 13.5; fontWeight: 900; color: cHot; letterSpacing: 0.8 }
          }

          // 0. Quick Card Templates Row (1-tap Markdown starters)
          Column {
            fill: width
            gap: 5
            Text {
              text: "QUICK TEMPLATES"
              fontSize: 10
              font: uiFont
              fontWeight: 800
              color: alpha(accentCol, 0.85)
              letterSpacing: 1.0
            }
            Row {
              fill: width
              gap: 6
              for tpl in cardTemplates {
                Row {
                  scale: tapBounce == "43" ? 0.9 : 1
                  offset: [0, tapBounce == "43" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "43"
                  onRelease: tapBounce = ""
                  weight: 1
                  height: 40
                  radius: 10
                  align: center
                  justify: center
                  background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.96), #000000, alpha(cPri, 0.09)])
                  border: 1.2
                  borderColor: alpha(accentCol, 0.45)
                  onTap: {
                    if hapticsOn { haptic() }
                    noteTitle = tpl.title
                    noteBody = tpl.body
                    noteFont = tpl.font
                  }
                  Text {
                    font: uiFont
                    text: tpl.label
                    fontSize: 11.5
                    fontWeight: 800
                    color: cHot
                    maxLines: 1
                  }
                }
              }
            }
          }

          // 2. 3 Card Sizes: S · M · L (Big 48dp buttons)
          Row {
            fill: width
            gap: 8
            for szOpt in [
              { id: "sm", label: "S · COMPACT" },
              { id: "md", label: "M · NORMAL"  },
              { id: "lg", label: "L · LARGE"   }
            ] {
              let isSz = noteSize == szOpt.id
              Row {
                scale: tapBounce == "44" ? 0.9 : 1
                offset: [0, tapBounce == "44" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "44"
                onRelease: tapBounce = ""
                weight: 1
                height: 48
                radius: 12
                align: center
                justify: center
                background: isSz ? linear(0, 0, 1, 1, [accentCol, accentGhost, accentDark]) : alpha(cCard, 0.96)
                border: isSz ? 1.8 : 1.2
                borderColor: isSz ? accentEmber : alpha(accentCol, 0.48)
                onTap: {
                  if hapticsOn { haptic() }
                  noteSize = szOpt.id
                }
                Text { font: uiFont; text: szOpt.label; fontSize: 12.5; fontWeight: 900; color: isSz ? hiInk : accentHot; maxLines: 1 }
              }
            }
          }

          // 3. Obsidian-style Markdown Editor: SOURCE / PREVIEW · toolbar · text zoom · copy / undo
          // (OWL has no cursor API, so every toolbar insert appends at the end of the note)
          Row {
            fill: width
            gap: 8
            align: center

            // Segmented mode switch
            Row {
              weight: 1
              height: 44
              radius: 12
              padding: 3
              gap: 3
              background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), cObs, #000000, alpha(cSec, 0.11)])
              border: 1.3
              borderColor: alpha(edPal.border, 0.6)
              for md in [
                { id: "live",    label: "◉ LIVE"    },
                { id: "edit",    label: "✎ SOURCE"  }
              ] {
                let isMd = edMode == md.id
                Row {
                  scale: tapBounce == "45" ? 0.9 : 1
                  offset: [0, tapBounce == "45" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "45"
                  onRelease: tapBounce = ""
                  weight: 1
                  fill: true
                  radius: 9
                  align: center
                  justify: center
                  background: isMd ? accentCol : alpha(#000000, 0)
                  border: isMd ? 1.2 : 0
                  borderColor: accentHot
                  animate background: tween(160ms, "ease")
                  onTap: {
                    if hapticsOn { haptic() }
                    edMode = md.id
                    edBlkS = -1
                    edCallMenu = false
                    edClearArm = false
                  }
                  Text { font: uiFont; text: md.label; fontSize: 12.5; fontWeight: 900; color: isMd ? cInk : cHot; letterSpacing: 0.8; maxLines: 1 }
                }
              }
            }

            // Text zoom: A− [size] A+
            Row {
              height: 44
              radius: 12
              gap: 0
              align: center
              background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), cObs, #000000, alpha(cSec, 0.10)])
              border: 1.3
              borderColor: alpha(edPal.border, 0.6)
              Row {
                scale: tapBounce == "46" ? 0.9 : 1
                offset: [0, tapBounce == "46" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "46"
                onRelease: tapBounce = ""
                width: 42; fill: height; align: center; justify: center
                opacity: edFont > 11 ? 1.0 : 0.35
                onTap: { if edFont > 11 { if hapticsOn { haptic() }; run("owl-hub deck.editorFont ${max(11, edFont - 1.5)}") } }
                Text { font: uiFont; text: "A−"; fontSize: 13; fontWeight: 900; color: cHot }
              }
              Text { text: "${round(edFont)}"; fontSize: 12; font: uiFont; fontWeight: 800; color: cInk; width: 26; align: center }
              Row {
                scale: tapBounce == "47" ? 0.9 : 1
                offset: [0, tapBounce == "47" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "47"
                onRelease: tapBounce = ""
                width: 42; fill: height; align: center; justify: center
                opacity: edFont < 26 ? 1.0 : 0.35
                onTap: { if edFont < 26 { if hapticsOn { haptic() }; run("owl-hub deck.editorFont ${min(26, edFont + 1.5)}") } }
                Text { font: uiFont; text: "A+"; fontSize: 15; fontWeight: 900; color: cHot }
              }
            }
          }

          if edMode != "preview" {
            if edMode == "edit" {
            // Line composer: type a line, then tap a format to apply it (empty = template)
            Row {
              fill: width
              gap: 8
              align: center
              Row {
                weight: 1
                height: 46
                padding: [14, 0]
                radius: 12
                align: center
                background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), cObs, #000000, alpha(cPri, 0.09)])
                border: 1.4
                borderColor: alpha(accentCol, edQuick != "" ? 0.9 : 0.45)
                Input {
                  text: edQuick
                  placeholder: "Type a line, tap a format ↓  (⏎ = add as text)"
                  color: cInk
                  fontSize: 14
                  underline: false
                  weight: 1
                  onChange: edQuick = value
                  onSubmit: {
                    let q = edQuick
                    if q != "" {
                      let pre = noteBody ?? ""
                      edPrev = pre
                      edCanUndo = true
                      noteBody = pre + (pre == "" || endsWith(pre, "\n") ? "" : "\n") + q
                      edQuick = ""
                    }
                  }
                }
              }
            }

            // Formatting toolbar: §  = your typed line (or the default word)
            Row {
              fill: width
              wrap: true
              gap: 6
              for ins in [
                { label: "H1",       snip: "# §",            def: "Heading", line: true  },
                { label: "H2",       snip: "## §",           def: "Heading", line: true  },
                { label: "H3",       snip: "### §",          def: "Heading", line: true  },
                { label: "B",        snip: "**§**",          def: "bold",    line: false },
                { label: "I",        snip: "*§*",            def: "italic",  line: false },
                { label: "S̶",        snip: "~~§~~",          def: "strike",  line: false },
                { label: "==H==",    snip: "==§==",          def: "highlight", line: false },
                { label: "`code`",   snip: "`§`",            def: "code",    line: false },
                { label: "```block", snip: "```bash\n§\n```", def: "",      line: true  },
                { label: "• list",   snip: "- §",            def: "Item",    line: true  },
                { label: "1. list",  snip: "1. §",           def: "Item",    line: true  },
                { label: "☐ task",   snip: "- [ ] §",        def: "Task",    line: true  },
                { label: "> quote",  snip: "> §",            def: "Quote",   line: true  },
                { label: "#tag",     snip: "#§",             def: "tag",     line: false },
                { label: "[[link]]", snip: "[[§]]",          def: "Note",    line: false },
                { label: "[url]()",  snip: "[§](https://)",  def: "text",    line: false },
                { label: "⊞ table",  snip: "| Col A | Col B |\n| --- | --- |\n| § | B1 |", def: "A1", line: true },
                { label: "———",      snip: "---",            def: "",        line: true  },
                { label: "↵",        snip: "\n",             def: "",        line: false, raw: true },
                { label: "⇥",        snip: "  ",             def: "",        line: false, raw: true }
              ] {
                Row {
                  scale: tapBounce == "48" ? 0.9 : 1
                  offset: [0, tapBounce == "48" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "48"
                  onRelease: tapBounce = ""
                  height: 38
                  padding: [11, 0]
                  radius: 10
                  align: center
                  justify: center
                  background: edQuick != "" && contains(ins.snip, "§") ? alpha(accentCol, 0.22) : alpha(cCard, 0.96)
                  border: 1.2
                  borderColor: alpha(edPal.border, 0.55)
                  onTap: {
                    if hapticsOn { haptic() }
                    let pre = noteBody ?? ""
                    let fill = edQuick != "" ? edQuick : ins.def
                    let body = replace(ins.snip, "§", fill)
                    let sep = ins.raw == true || pre == "" ? "" : (ins.line ? (endsWith(pre, "\n") ? "" : "\n") : (endsWith(pre, " ") || endsWith(pre, "\n") ? "" : " "))
                    edPrev = pre
                    edCanUndo = true
                    edClearArm = false
                    noteBody = pre + sep + body
                    edQuick = ""
                  }
                  Text { text: ins.label; fontSize: 12.5; font: uiFont; fontWeight: 800; color: cHot; maxLines: 1 }
                }
              }

              // Callout picker toggle
              Row {
                scale: tapBounce == "49" ? 0.9 : 1
                offset: [0, tapBounce == "49" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "49"
                onRelease: tapBounce = ""
                height: 38
                padding: [11, 0]
                radius: 10
                align: center
                justify: center
                background: edCallMenu ? alpha(accentCol, 0.4) : alpha(cCard, 0.96)
                border: 1.2
                borderColor: edCallMenu ? accentHot : alpha(edPal.border, 0.55)
                onTap: { if hapticsOn { haptic() }; edCallMenu = !edCallMenu }
                Text { text: edCallMenu ? "[!] ▴" : "[!] ▾"; fontSize: 12.5; font: uiFont; fontWeight: 800; color: cHot; maxLines: 1 }
              }

              // Undo
              Row {
                scale: tapBounce == "50" ? 0.9 : 1
                offset: [0, tapBounce == "50" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "50"
                onRelease: tapBounce = ""
                height: 38
                padding: [11, 0]
                radius: 10
                align: center
                justify: center
                opacity: edCanUndo ? 1.0 : 0.35
                background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.96), #000000, alpha(cSec, 0.11)])
                border: 1.2
                borderColor: edCanUndo ? accentHot : alpha(edPal.border, 0.4)
                onTap: {
                  if edCanUndo {
                    if hapticsOn { haptic() }
                    noteBody = edPrev
                    edPrev = ""
                    edCanUndo = false
                  }
                }
                Text { text: "⎌ UNDO"; fontSize: 12.5; font: uiFont; fontWeight: 800; color: cHot; maxLines: 1 }
              }
            }

            // Callout types (Obsidian's defaults)
            if edCallMenu {
              Row {
                fill: width
                wrap: true
                gap: 6
                padding: 8
                radius: 12
                background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cObs, 0.96), #000000, alpha(cSec, 0.10)])
                border: 1
                borderColor: alpha(accentCol, 0.45)
                for ct in ["note", "tip", "info", "warning", "danger", "success", "question", "example", "quote", "todo", "bug", "abstract"] {
                  Row {
                    scale: tapBounce == "51" ? 0.9 : 1
                    offset: [0, tapBounce == "51" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "51"
                    onRelease: tapBounce = ""
                    height: 36
                    padding: [10, 0]
                    radius: 9
                    align: center
                    background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.96), #000000, alpha(cPri, 0.09)])
                    border: 1
                    borderColor: alpha(edPal.border, 0.5)
                    onTap: {
                      if hapticsOn { haptic() }
                      let pre = noteBody ?? ""
                      let sep = pre == "" ? "" : (endsWith(pre, "\n") ? "" : "\n")
                      edPrev = pre
                      edCanUndo = true
                      edClearArm = false
                      edCallMenu = false
                      noteBody = pre + sep + "> [!${ct}] " + (edQuick != "" ? edQuick : capitalize(ct)) + "\n> "
                      edQuick = ""
                    }
                    Text { text: ct; fontSize: 12; font: uiFont; fontWeight: 700; color: cInk; maxLines: 1 }
                  }
                }
              }
            }

            }
            if edMode == "edit" {
              // Markdown source box (Enter = new line; long-press to paste)
              Box {
                fill: width
                height: edFont * 1.5 * 14 + 28
                padding: [14, 12]
                radius: 12
                background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), cObs, #000000, alpha(cSec, 0.11)])
                border: 1.4
                borderColor: alpha(edPal.border, 0.65)
                Input {
                  text: noteBody
                  placeholder: "Write Markdown… or long-press to paste code & scripts"
                  color: cInk
                  fontSize: edFont
                  lines: 14
                  underline: false
                  fill: true
                  onChange: noteBody = value
                }
              }
            } else {
              // LIVE: ① pick a colored style ② type ③ ADD. The card below is always rendered.
              let fmt = edFmts.find(f => f.id == edFmt) ?? edFmts[0]
              Column {
                fill: width
                gap: 10
                padding: 12
                radius: 14
                background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(fmt.c, 0.07), #000000, alpha(cSec, 0.10)])
                border: 1.6
                borderColor: fmt.c
                animate background: tween(160ms, "ease")
                Text { text: "① PICK A STYLE"; font: uiFont; fontSize: 10; fontWeight: 900; letterSpacing: 1.4; color: alpha(hiInk, 0.55) }
                Row {
                  fill: width
                  wrap: true
                  gap: 6
                  for f in edFmts {
                    Row {
                      scale: tapBounce == "52" ? 0.9 : 1
                      offset: [0, tapBounce == "52" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "52"
                      onRelease: tapBounce = ""
                      height: 36
                      padding: [11, 0]
                      radius: 9
                      align: center
                      background: edFmt == f.id ? f.c : alpha(f.c, 0.12)
                      border: 1.3
                      borderColor: f.c
                      onTap: {
                        if hapticsOn { haptic() }
                        edFmt = f.id
                        if f.id == "div" {
                          let pre = noteBody ?? ""
                          edPrev = pre
                          edCanUndo = true
                          noteBody = pre + (pre == "" || endsWith(pre, "\n") ? "" : "\n") + "---"
                          edFmt = "text"
                        }
                      }
                      Text { text: f.l; font: uiFont; fontSize: 12; fontWeight: 900; color: edFmt == f.id ? #000000 : f.c; maxLines: 1 }
                    }
                  }
                }
                Text { text: "② TYPE — it's added as " + fmt.l; font: uiFont; fontSize: 10; fontWeight: 900; letterSpacing: 1.2; color: fmt.c }
                Row {
                  fill: width
                  gap: 8
                  align: end
                  Box {
                    weight: 1
                    padding: [12, 10]
                    radius: 10
                    background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), cObs, #000000, alpha(cPri, 0.09)])
                    border: 1.4
                    borderColor: alpha(fmt.c, 0.7)
                    if edFmt == "code" {
                      Input {
                        text: edQuick
                        placeholder: "Paste or type code…"
                        color: fmt.c
                        fontSize: edFont
                        lines: 6
                        underline: false
                        fill: width
                        onChange: edQuick = value
                      }
                    } else {
                      Input {
                        text: edQuick
                        placeholder: edFmt == "text" ? "Type a sentence…" : edFmt == "task" ? "Type a task…" : "Type " + lower(fmt.tag) + " text…"
                        color: fmt.c
                        fontSize: edFont
                        underline: false
                        fill: width
                        onChange: edQuick = value
                        onSubmit: {
                          let t = edQuick
                          if t != "" {
                            let pre = noteBody ?? ""
                            edPrev = pre
                            edCanUndo = true
                            noteBody = pre + (pre == "" || endsWith(pre, "\n") ? "" : "\n") + fmt.pre + t + fmt.post
                            edQuick = ""
                            if edFmt == "h1" || edFmt == "h2" || edFmt == "h3" || edFmt == "bold" { edFmt = "text" }
                          }
                        }
                      }
                    }
                  }
                  Row {
                    scale: tapBounce == "53" ? 0.9 : 1
                    offset: [0, tapBounce == "53" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "53"
                    onRelease: tapBounce = ""
                    height: 46
                    padding: [16, 0]
                    radius: 10
                    align: center
                    background: edQuick != "" ? fmt.c : alpha(fmt.c, 0.18)
                    onTap: {
                      let t = edQuick
                      if t != "" {
                        if hapticsOn { haptic() }
                        let pre = noteBody ?? ""
                        edPrev = pre
                        edCanUndo = true
                        noteBody = pre + (pre == "" || endsWith(pre, "\n") ? "" : "\n") + fmt.pre + t + fmt.post
                        edQuick = ""
                        if edFmt == "h1" || edFmt == "h2" || edFmt == "h3" || edFmt == "code" || edFmt == "bold" { edFmt = "text" }
                      }
                    }
                    Text { text: "③ ADD"; font: uiFont; fontSize: 13; fontWeight: 900; color: edQuick != "" ? #000000 : fmt.c }
                  }
                }
                Row {
                  gap: 8
                  Row {
                    scale: tapBounce == "54" ? 0.9 : 1
                    offset: [0, tapBounce == "54" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "54"
                    onRelease: tapBounce = ""
                    height: 34; padding: [12, 0]; radius: 9; align: center
                    opacity: edCanUndo ? 1.0 : 0.35
                    background: alpha(#000000, 0.5); border: 1; borderColor: alpha(hiInk, 0.3)
                    onTap: {
                      if edCanUndo {
                        if hapticsOn { haptic() }
                        noteBody = edPrev
                        edPrev = ""
                        edCanUndo = false
                      }
                    }
                    Text { text: "⎌ UNDO"; font: uiFont; fontSize: 11.5; fontWeight: 800; color: alpha(hiInk, 0.8) }
                  }
                  Text { text: "Tap a block below to edit or change its style"; font: uiFont; fontSize: 10.5; color: alpha(hiInk, 0.45); weight: 1; align: end }
                }
              }

              let lvL  = lines(noteBody ?? "")
              let lvIn = scan(lvL, (st, l) => startsWith(trim(l), "```") ? !st : st, false)
              let lvSt = range(len(lvL)).filter(i => i == 0 || !(lvIn[i - 1] == true
                || (startsWith(trim(lvL[i]), "|") && startsWith(trim(lvL[i - 1]), "|"))
                || (startsWith(trim(lvL[i]), ">") && startsWith(trim(lvL[i - 1]), ">") && trim(lvL[i - 1]) != "")))
              Column {
                fill: width
                gap: 4
                padding: 12
                radius: 12
                background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(edPal.bg, 0.96), #000000, alpha(cSec, 0.11)])
                border: 1.4
                borderColor: alpha(edPal.border, 0.65)
                if trim(noteBody ?? "") == "" {
                  Text { font: uiFont; text: "Empty card. Type a line above, then tap a format (H1, • list, ```block…) — it appears here already formatted."; fontSize: 12.5; color: alpha(cHot, 0.6); fill: width }
                }
                for bi in range(len(lvSt)) {
                  let bs  = lvSt[bi]
                  let be  = bi + 1 < len(lvSt) ? lvSt[bi + 1] : len(lvL)
                  let raw = join(lvL.take(be).drop(bs), "\n")
                  if edBlkS == bs {
                    Column {
                      fill: width
                      gap: 8
                      padding: 10
                      radius: 10
                      background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(accentCol, 0.10), #000000, alpha(cSec, 0.10)])
                      border: 1.4
                      borderColor: accentHot
                      Text { text: "✎ EDITING · " + edBlkKind; font: uiFont; fontSize: 10; fontWeight: 900; letterSpacing: 1.2; color: accentHot }
                      if edBlkPost == "" && edBlkKind != "TABLE" {
                        Row {
                          fill: width
                          wrap: true
                          gap: 5
                          for f in edFmts.filter(x => x.line) {
                            Row {
                              scale: tapBounce == "55" ? 0.9 : 1
                              offset: [0, tapBounce == "55" ? -4 : 0]
                              animate scale: spring(0.32, 520)
                              animate offset: spring(0.32, 520)
                              onPress: tapBounce = "55"
                              onRelease: tapBounce = ""
                              height: 30
                              padding: [9, 0]
                              radius: 8
                              align: center
                              background: edBlkPre == f.pre ? f.c : alpha(f.c, 0.12)
                              border: 1.1
                              borderColor: f.c
                              onTap: {
                                if hapticsOn { haptic() }
                                edBlkPre = f.pre
                                edBlkKind = f.tag
                              }
                              Text { text: f.l; font: uiFont; fontSize: 10.5; fontWeight: 900; color: edBlkPre == f.pre ? #000000 : f.c; maxLines: 1 }
                            }
                          }
                        }
                      }
                      Input {
                        text: edBlkTxt
                        color: cInk
                        fontSize: edFont
                        lines: 8
                        underline: false
                        fill: width
                        focus: true
                        onChange: edBlkTxt = value
                      }
                      Row {
                        fill: width
                        gap: 8
                        Row {
                          scale: tapBounce == "56" ? 0.9 : 1
                          offset: [0, tapBounce == "56" ? -4 : 0]
                          animate scale: spring(0.32, 520)
                          animate offset: spring(0.32, 520)
                          onPress: tapBounce = "56"
                          onRelease: tapBounce = ""
                          weight: 1; height: 40; radius: 10; align: center; justify: center
                          background: accentCol
                          onTap: {
                            if hapticsOn { haptic() }
                            let all = lines(noteBody ?? "")
                            let s0 = edBlkS
                            let e0 = edBlkE
                            edPrev = noteBody ?? ""
                            edCanUndo = true
                            noteBody = join(all.take(s0) + [edBlkPre + edBlkTxt + edBlkPost] + all.drop(e0), "\n")
                            edBlkS = -1
                          }
                          Text { text: "✓ DONE"; font: uiFont; fontSize: 12.5; fontWeight: 900; color: hiInk }
                        }
                        Row {
                          scale: tapBounce == "57" ? 0.9 : 1
                          offset: [0, tapBounce == "57" ? -4 : 0]
                          animate scale: spring(0.32, 520)
                          animate offset: spring(0.32, 520)
                          onPress: tapBounce = "57"
                          onRelease: tapBounce = ""
                          height: 40; padding: [14, 0]; radius: 10; align: center
                          background: alpha(#000000, 0.5); border: 1; borderColor: alpha(accentCol, 0.5)
                          onTap: { edBlkS = -1 }
                          Text { text: "CANCEL"; font: uiFont; fontSize: 12; fontWeight: 800; color: alpha(hiInk, 0.7) }
                        }
                        Row {
                          scale: tapBounce == "58" ? 0.9 : 1
                          offset: [0, tapBounce == "58" ? -4 : 0]
                          animate scale: spring(0.32, 520)
                          animate offset: spring(0.32, 520)
                          onPress: tapBounce = "58"
                          onRelease: tapBounce = ""
                          height: 40; padding: [14, 0]; radius: 10; align: center
                          background: alpha(cDeep, 0.98); border: 1; borderColor: cMid
                          onTap: {
                            if hapticsOn { haptic() }
                            let all = lines(noteBody ?? "")
                            let s0 = edBlkS
                            let e0 = edBlkE
                            edPrev = noteBody ?? ""
                            edCanUndo = true
                            noteBody = join(all.take(s0) + all.drop(e0), "\n")
                            edBlkS = -1
                          }
                          Text { text: "✕"; font: uiFont; fontSize: 14; fontWeight: 900; color: cHot }
                        }
                      }
                    }
                  } else if trim(raw) == "" {
                    Spacer { height: 6 }
                  } else {
                    let tr0 = trim(lvL[bs])
                    let bk  = startsWith(tr0, "```") ? "code"
                      : startsWith(tr0, "###") ? "h3" : startsWith(tr0, "## ") ? "h2" : startsWith(tr0, "# ") ? "h1"
                      : (startsWith(tr0, "- [") || startsWith(tr0, "* [")) ? "task"
                      : (startsWith(tr0, "- ") || startsWith(tr0, "* ") || startsWith(tr0, "+ ")) ? "bullet"
                      : match(tr0, "^\\d+[.)] ") != null ? "num"
                      : startsWith(tr0, ">") ? "quote"
                      : startsWith(tr0, "|") ? "table"
                      : (tr0 == "---" || tr0 == "***") ? "div"
                      : "text"
                    let bf  = edFmts.find(f => f.id == bk)
                    let kc  = bk == "table" ? #ffb3c0 : bf != null ? bf.c : #ffe8ec
                    let ktg = bk == "table" ? "TABLE" : bf != null ? bf.tag : "TEXT"
                    Row {
                      fill: width
                      gap: 8
                    Column {
                      scale: tapBounce == "59" ? 0.9 : 1
                      offset: [0, tapBounce == "59" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "59"
                      onRelease: tapBounce = ""
                      weight: 1
                      padding: [4, 3]
                      radius: 8
                      onTap: {
                        if hapticsOn { haptic() }
                        let isFence = startsWith(trim(lvL[bs]), "```") && be - bs >= 2 && startsWith(trim(lvL[be - 1]), "```")
                        let m = be - bs == 1 ? match(lvL[bs], "^(\\s*(?:#{1,6} |[-*+] \\[[ xX/]\\] |[-*+] |\\d+[.)] |> ))(.*)$") : null
                        edBlkS = bs
                        edBlkE = be
                        edBlkPre  = isFence ? lvL[bs] + "\n" : m != null ? m[0] : ""
                        edBlkPost = isFence ? "\n" + lvL[be - 1] : ""
                        edBlkTxt  = isFence ? join(lvL.take(be - 1).drop(bs + 1), "\n") : m != null ? m[1] : raw
                        edBlkKind = isFence ? "CODE " + upper(trim(sub(trim(lvL[bs]), 3, len(trim(lvL[bs]))))) 
                          : m == null ? (startsWith(trim(raw), "|") ? "TABLE" : "TEXT")
                          : startsWith(trim(m[0]), "#") ? "HEADING ${len(trim(m[0]))}"
                          : contains(m[0], "[") ? "TASK"
                          : startsWith(trim(m[0]), ">") ? "QUOTE"
                          : match(trim(m[0]), "^\\d") != null ? "NUMBERED"
                          : "BULLET"
                      }
                      MdView { raw: raw; pal: edPal; bSz: edFont; fnt: noteFont; wt: noteWeight; algn: noteAlign; maxLn: 400; cid: 0; live: false }
                    }
                      Text { text: ktg; font: uiFont; fontSize: 8.5; fontWeight: 900; letterSpacing: 1; color: kc; padding: [0, 4, 0, 0] }
                    }
                  }
                }
              }
            }

            // Footer: stats · COPY ALL · CLEAR (two-tap)
            let edSrc   = noteBody ?? ""
            let edLines = len(lines(edSrc))
            let edWords = len(matchAll(edSrc, "\\S+"))
            let edChars = len(edSrc)
            Row {
              fill: width
              gap: 8
              align: center
              Text {
                text: "${edLines} lines · ${edWords} words · ${edChars} chars"
                fontSize: 11
                font: uiFont
                color: alpha(cHot, 0.6)
                weight: 1
                maxLines: 1
              }
              Row {
                scale: tapBounce == "60" ? 0.9 : 1
                offset: [0, tapBounce == "60" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "60"
                onRelease: tapBounce = ""
                height: 38
                padding: [12, 0]
                radius: 10
                align: center
                background: mdCopied == noteBody && noteBody != "" ? alpha(accentCol, 0.4) : alpha(cCard, 0.96)
                border: 1.2
                borderColor: alpha(edPal.border, 0.6)
                animate background: tween(180ms, "ease")
                onTap: {
                  if hapticsOn { haptic() }
                  copy(noteBody ?? "")
                  mdCopied = noteBody ?? ""
                }
                Text { text: mdCopied == noteBody && noteBody != "" ? "✓ COPIED" : "⧉ COPY ALL"; fontSize: 12; font: uiFont; fontWeight: 800; color: cHot; maxLines: 1 }
              }
              Row {
                scale: tapBounce == "61" ? 0.9 : 1
                offset: [0, tapBounce == "61" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "61"
                onRelease: tapBounce = ""
                height: 38
                padding: [12, 0]
                radius: 10
                align: center
                background: edClearArm ? alpha(cDeep, 0.98) : alpha(cCard, 0.96)
                border: 1.2
                borderColor: edClearArm ? cMid : alpha(edPal.border, 0.6)
                onTap: {
                  if hapticsOn { haptic() }
                  if edClearArm {
                    edPrev = noteBody ?? ""
                    edCanUndo = true
                    noteBody = ""
                    edClearArm = false
                  } else {
                    edClearArm = true
                  }
                }
                Text { text: edClearArm ? "TAP AGAIN" : "✕ CLEAR"; fontSize: 12; font: uiFont; fontWeight: 800; color: edClearArm ? cHot : cHot; maxLines: 1 }
              }
            }

            Text {
              font: uiFont
              text: "Long-press the box to paste code — it stays exactly as pasted inside ``` fences."
              fontSize: 11
              color: alpha(cHot, 0.6)
              fill: width
            }
          } else {
            // Live preview, rendered exactly like the card
            Column {
              fill: width
              gap: 10
              padding: 14
              radius: 14
              background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(edPal.bg, 0.96), #000000, alpha(cPri, 0.09)])
              border: 1.4
              borderColor: alpha(edPal.border, 0.75)
              if trim(noteTitle) != "" {
                Text { font: uiFont; text: noteTitle; fontSize: edFont + 4; fontWeight: 900; color: edPal.text; maxLines: 3; fill: width }
              }
              if trim(noteBody ?? "") == "" {
                Text { font: uiFont; text: "Nothing to preview yet — switch to ✎ SOURCE and write something."; fontSize: 13; color: alpha(cHot, 0.6); fill: width }
              } else {
                MdView {
                  raw: noteBody
                  pal: edPal
                  bSz: edFont
                  fnt: uiFont
                  wt: noteWeight
                  algn: noteAlign
                  maxLn: 400
                  cid: 0
                  live: true
                }
              }
            }
          }


          // 4. 48dp Insert / Edit Table Button
          Row {
            scale: tapBounce == "62" ? 0.9 : 1
            offset: [0, tapBounce == "62" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "62"
            onRelease: tapBounce = ""
            fill: width
            height: 48
            radius: 12
            align: center
            justify: center
            background: linear(0, 0, 1, 1, [alpha(accentEmber, 0.22), alpha(accentDark, 0.96)])
            border: 1.6
            borderColor: alpha(accentEmber, 0.85)
            onTap: {
              if hapticsOn { haptic() }
              tblTargetMode = "insertNote"
              tblPresetId   = "grid2x2"
              tblHeaders    = ["Col A", "Col B"]
              tblRows       = [["Item 1", "Value 1"], ["Item 2", "Value 2"]]
              tblEditRow    = -1
              tblEditCol    = 0
              tblCellDraft  = "Col A"
              screenMode    = "tableBuilder"
            }
            Text { font: uiFont; text: "⊞ ADD / EDIT TABLE"; fontSize: 14; fontWeight: 900; color: amberInk; letterSpacing: 0.9 }
          }

          // 5a. Folder: where this card lives on the feed
          Column {
            fill: width
            gap: 6
            Text { text: "FOLDER"; fontSize: 10; font: uiFont; fontWeight: 800; color: alpha(accentHot, 0.85); letterSpacing: 1.0 }
            Row {
              fill: width
              gap: 6
              wrap: true
              for nf in [{ id: 0, name: "UNSORTED", col: -1 }] + cvFolders key nf.id {
                let nc = nf.col < 0 ? cMuted : fldCols[nf.col % len(fldCols)]
                let on = noteFld == nf.id
                Box {
                  padding: [12, 8]
                  radius: 99
                  background: on ? linear(0, 0, 1, 1, [alpha(nc, 0.55), #000000]) : alpha(#000000, 0.85)
                  border: on ? 2 : 1
                  borderColor: on ? nc : alpha(nc, 0.55)
                  scale: on ? 1.06 : 1.0
                  animate scale: spring(0.4, 480)
                  onTap: { if hapticsOn { haptic() }; noteFld = nf.id }
                  Text { font: uiFont; text: nf.name; fontSize: 10.5; color: on ? cInk : nc; fontWeight: 900; letterSpacing: 1.1; maxLines: 1 }
                }
              }
            }
          }

          // 5b. All 12 Obsidian · Crimson · Molten Amber Color Swatches (3 clean rows of 4)
          Column {
            fill: width
            gap: 6
            Text { text: "CARD PALETTE"; fontSize: 10; font: uiFont; fontWeight: 800; color: alpha(accentHot, 0.85); letterSpacing: 1.0 }
            for swRow in chunk(quickSwatches, 4) {
              Row {
                fill: width
                gap: 6
                for sw in swRow {
                  let p = notePalettes[clamp(sw.idx, 0, len(notePalettes) - 1)]
                  let isCur = noteColorIdx == sw.idx
                  Row {
                    scale: tapBounce == "63" ? 0.9 : 1
                    offset: [0, tapBounce == "63" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "63"
                    onRelease: tapBounce = ""
                    weight: 1; height: 44; radius: 11; align: center; justify: center; gap: 5
                    background: linear(0, 0, 1, 1, [alpha(p.bg2 ?? p.bg, 0.98), p.bg])
                    border: isCur ? 2.2 : 1.2
                    borderColor: isCur ? accentEmber : p.border
                    onTap: { if hapticsOn { haptic() }; noteColorIdx = sw.idx }
                    Box { size: 9; radius: 99; background: p.border }
                    Text { font: uiFont; text: sw.label; fontSize: 11.5; fontWeight: 800; color: p.text; maxLines: 1 }
                  }
                }
              }
            }
          }

          // 6. Font & Text Size Controls (Big 46dp buttons)
          Row {
            fill: width
            gap: 6
            for fo in [
              { id: "sans",  label: "Sans"  },
              { id: "mono",  label: "Mono"  },
              { id: "serif", label: "Serif" }
            ] {
              let isF = noteFont == fo.id
              Row {
                scale: tapBounce == "64" ? 0.9 : 1
                offset: [0, tapBounce == "64" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "64"
                onRelease: tapBounce = ""
                weight: 1; height: 46; radius: 12; align: center; justify: center
                background: isF ? alpha(accentCol, 0.36) : alpha(cCard, 0.96)
                border: isF ? 2.0 : 1.3
                borderColor: isF ? cHot : alpha(accentCol, 0.45)
                onTap: { if hapticsOn { haptic() }; noteFont = fo.id }
                Text { text: fo.label; font: uiFont; fontSize: 13.5; fontWeight: 800; color: isF ? cHot : cHot }
              }
            }
          }

          Row {
            fill: width
            gap: 6
            Row {
              scale: tapBounce == "65" ? 0.9 : 1
              offset: [0, tapBounce == "65" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "65"
              onRelease: tapBounce = ""
              weight: 1; height: 46; radius: 12; align: center; justify: center
              background: alpha(cCard, 0.96); border: 1.3; borderColor: alpha(cHot, 0.28)
              onTap: { if hapticsOn { haptic() }; noteBodySz = max(12, noteBodySz - 1) }
              Text { font: uiFont; text: "A− ${round(noteBodySz)}"; fontSize: 13; fontWeight: 800; color: cHot }
            }
            Row {
              scale: tapBounce == "66" ? 0.9 : 1
              offset: [0, tapBounce == "66" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "66"
              onRelease: tapBounce = ""
              weight: 1; height: 46; radius: 12; align: center; justify: center
              background: alpha(accentCol, 0.30); border: 1.5; borderColor: accentCol
              onTap: { if hapticsOn { haptic() }; noteBodySz = min(22, noteBodySz + 1) }
              Text { font: uiFont; text: "A+"; fontSize: 14; fontWeight: 900; color: cHot }
            }
            Row {
              scale: tapBounce == "67" ? 0.9 : 1
              offset: [0, tapBounce == "67" ? -4 : 0]
              animate scale: spring(0.32, 520)
              animate offset: spring(0.32, 520)
              onPress: tapBounce = "67"
              onRelease: tapBounce = ""
              width: 54; height: 46; radius: 12; align: center; justify: center
              background: noteWeight >= 700 ? alpha(accentCol, 0.38) : alpha(cCard, 0.96)
              border: noteWeight >= 700 ? 2.0 : 1.3
              borderColor: noteWeight >= 700 ? cHot : alpha(cHot, 0.28)
              onTap: { if hapticsOn { haptic() }; noteWeight = noteWeight >= 700 ? 500 : 800 }
              Text { font: uiFont; text: "B"; fontSize: 15; fontWeight: 900; color: cHot }
            }
            for ao in [
              { id: "start",  label: "◧" },
              { id: "center", label: "◫" },
              { id: "end",    label: "◨" }
            ] {
              let isAl = noteAlign == ao.id
              Row {
                scale: tapBounce == "68" ? 0.9 : 1
                offset: [0, tapBounce == "68" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "68"
                onRelease: tapBounce = ""
                width: 48; height: 46; radius: 12; align: center; justify: center
                background: isAl ? alpha(accentCol, 0.38) : alpha(cCard, 0.96)
                border: isAl ? 2.0 : 1.3
                borderColor: isAl ? cHot : alpha(cHot, 0.26)
                onTap: { if hapticsOn { haptic() }; noteAlign = ao.id }
                Text { font: uiFont; text: ao.label; fontSize: 15; fontWeight: 800; color: cHot }
              }
            }
          }

          // 7. Card Style Extras: Pin to Top, Accent Bar, Border Style
          Column {
            fill: width
            gap: 8

            Row {
              fill: width
              gap: 8
              Row {
                scale: tapBounce == "69" ? 0.9 : 1
                offset: [0, tapBounce == "69" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "69"
                onRelease: tapBounce = ""
                weight: 1; height: 46; radius: 12; align: center; justify: center
                background: notePinned ? alpha(accentCol, 0.36) : alpha(cCard, 0.96)
                border: notePinned ? 2.0 : 1.3
                borderColor: notePinned ? cHot : alpha(accentCol, 0.45)
                onTap: { if hapticsOn { haptic() }; notePinned = !notePinned }
                Text { font: uiFont; text: notePinned ? "◆ PINNED TOP" : "◇ PIN TO TOP"; fontSize: 12.5; fontWeight: 800; color: notePinned ? cHot : cHot }
              }
              Row {
                scale: tapBounce == "70" ? 0.9 : 1
                offset: [0, tapBounce == "70" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "70"
                onRelease: tapBounce = ""
                weight: 1; height: 46; radius: 12; align: center; justify: center
                background: noteAccentBar ? alpha(accentCol, 0.36) : alpha(cCard, 0.96)
                border: noteAccentBar ? 2.0 : 1.3
                borderColor: noteAccentBar ? cHot : alpha(accentCol, 0.45)
                onTap: { if hapticsOn { haptic() }; noteAccentBar = !noteAccentBar }
                Text { font: uiFont; text: noteAccentBar ? "▎ ACCENT BAR ON" : "▎ ACCENT BAR OFF"; fontSize: 12.5; fontWeight: 800; color: noteAccentBar ? cHot : cHot }
              }
            }

            Row {
              fill: width
              gap: 6
              for bs in [
                { id: "hairline", label: "HAIRLINE" },
                { id: "bold",     label: "BOLD"     },
                { id: "none",     label: "NO BORDER" }
              ] {
                let isBs = noteBorderStyle == bs.id
                Row {
                  scale: tapBounce == "71" ? 0.9 : 1
                  offset: [0, tapBounce == "71" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "71"
                  onRelease: tapBounce = ""
                  weight: 1; height: 44; radius: 12; align: center; justify: center
                  background: isBs ? alpha(accentCol, 0.36) : alpha(cCard, 0.96)
                  border: isBs ? 2.0 : 1.3
                  borderColor: isBs ? cHot : alpha(cHot, 0.24)
                  onTap: { if hapticsOn { haptic() }; noteBorderStyle = bs.id }
                  Text { font: uiFont; text: bs.label; fontSize: 12; fontWeight: 800; color: isBs ? cHot : cHot; maxLines: 1 }
                }
              }
            }
          }

          // 8. Reorder, Duplicate & Delete Actions (only when editing an existing card)
          if editId > 0 {
            Column {
              fill: width
              gap: 8
              Row {
                fill: width
                gap: 8
                Row {
                  scale: tapBounce == "72" ? 0.9 : 1
                  offset: [0, tapBounce == "72" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "72"
                  onRelease: tapBounce = ""
                  weight: 1; height: 46; radius: 12; align: center; justify: center
                  background: alpha(cCard, 0.96); border: 1.4; borderColor: curIdx > 0 ? accentCol : alpha(cHot, 0.16)
                  opacity: curIdx > 0 ? 1.0 : 0.4
                  onTap: {
                    if curIdx > 0 {
                      if hapticsOn { haptic() }
                      let prevItem = holocronNotes[curIdx - 1]
                      let currItem = holocronNotes[curIdx]
                      holocronNotes = range(len(holocronNotes)).map(i =>
                        i == curIdx - 1 ? currItem : i == curIdx ? prevItem : holocronNotes[i]
                      )
                    }
                  }
                  Text { font: uiFont; text: "▲ UP"; fontSize: 13; fontWeight: 800; color: cHot }
                }
                Row {
                  scale: tapBounce == "73" ? 0.9 : 1
                  offset: [0, tapBounce == "73" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "73"
                  onRelease: tapBounce = ""
                  weight: 1; height: 46; radius: 12; align: center; justify: center
                  background: alpha(cCard, 0.96); border: 1.4; borderColor: (curIdx >= 0 && curIdx < len(holocronNotes) - 1) ? accentCol : alpha(cHot, 0.16)
                  opacity: (curIdx >= 0 && curIdx < len(holocronNotes) - 1) ? 1.0 : 0.4
                  onTap: {
                    if curIdx >= 0 && curIdx < len(holocronNotes) - 1 {
                      if hapticsOn { haptic() }
                      let nextItem = holocronNotes[curIdx + 1]
                      let currItem = holocronNotes[curIdx]
                      holocronNotes = range(len(holocronNotes)).map(i =>
                        i == curIdx ? nextItem : i == curIdx + 1 ? currItem : holocronNotes[i]
                      )
                    }
                  }
                  Text { font: uiFont; text: "▼ DOWN"; fontSize: 13; fontWeight: 800; color: cHot }
                }
                Row {
                  scale: tapBounce == "74" ? 0.9 : 1
                  offset: [0, tapBounce == "74" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "74"
                  onRelease: tapBounce = ""
                  weight: 1; height: 46; radius: 12; align: center; justify: center
                  background: alpha(cDeep, 0.96); border: 1.4; borderColor: alpha(accentGhost, 0.72)
                  onTap: {
                    if hapticsOn { haptic() }
                    let nid = nextNoteId
                    nextNoteId = nextNoteId + 1
                    let dupBase = trim(noteTitle) != "" ? trim(noteTitle) : "CARD #${editId}"
                    let dupCard = {
                      id: nid,
                      title: "${dupBase} (Copy)",
                      text: noteBody ?? "",
                      size: noteSize,
                      skin: noteSkin,
                      font: uiFont
                      bodySz: noteBodySz,
                      fontWeight: noteWeight,
                      align: noteAlign,
                      colorIdx: noteColorIdx,
                      pinned: notePinned,
                      accentBar: noteAccentBar,
                      borderStyle: noteBorderStyle,
                      time: timeHm
                    }
                    let combined = [dupCard] + holocronNotes
                    holocronNotes = combined.filter(x => x.pinned == true) + combined.filter(x => x.pinned != true)
                    screenMode = "deck"
                  }
                  Text { font: uiFont; text: "⧉ COPY"; fontSize: 13; fontWeight: 800; color: cHot }
                }
              }

              Row {
                scale: tapBounce == "75" ? 0.9 : 1
                offset: [0, tapBounce == "75" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "75"
                onRelease: tapBounce = ""
                fill: width; height: 46; radius: 12; align: center; justify: center
                background: alpha(cDeep, 0.98); border: 1.6; borderColor: cMid
                onTap: {
                  if hapticsOn { haptic() }
                  let delId = editId
                  holocronNotes = holocronNotes.filter(it => it.id != delId)
                  editId = 0
                  screenMode = "deck"
                }
                Text { font: uiFont; text: "✕ DELETE CARD"; fontSize: 13; fontWeight: 800; color: cHot; letterSpacing: 0.7 }
              }
            }
          }
        }

        // Sticky Bottom Bar: CANCEL | SAVE CARD (50dp)
        Row {
          fill: width
          gap: 10
          Row {
            scale: tapBounce == "76" ? 0.9 : 1
            offset: [0, tapBounce == "76" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "76"
            onRelease: tapBounce = ""
            weight: 1; height: 50; radius: 12; align: center; justify: center
            background: alpha(cCard, 0.96); border: 1.2; borderColor: alpha(cHot, 0.24)
            onTap: { if hapticsOn { haptic() }; screenMode = "deck" }
            Text { font: uiFont; text: "CANCEL"; fontSize: 13.5; fontWeight: 800; color: cHot }
          }
          Row {
            scale: tapBounce == "77" ? 0.9 : 1
            offset: [0, tapBounce == "77" ? -4 : 0]
            animate scale: spring(0.32, 520)
            animate offset: spring(0.32, 520)
            onPress: tapBounce = "77"
            onRelease: tapBounce = ""
            weight: 2; height: 50; radius: 12; align: center; justify: center
            background: linear(0, 0, 1, 1, [accentCol, accentGhost, accentDark])
            border: 1.6; borderColor: accentEmber
            onTap: {
              if hapticsOn { haptic() }
              let t = trim(noteTitle)
              let b = trim(noteBody)
              if t != "" || b != "" {
                let eid = editId
                let nextList = editId > 0
                  ? holocronNotes.map(it => it.id == eid ? merge(it, {
                      title: t != "" ? t : "CARD #${eid}",
                      text: b,
                      size: noteSize,
                      skin: noteSkin,
                      font: uiFont
                      bodySz: noteBodySz,
                      fontWeight: noteWeight,
                      align: noteAlign,
                      colorIdx: noteColorIdx,
                      pinned: notePinned,
                      accentBar: noteAccentBar,
                      borderStyle: noteBorderStyle,
                      fld: noteFld,
                      time: timeHm
                    }) : it)
                  : [{
                      id: nextNoteId,
                      title: t != "" ? t : "CARD #${nextNoteId}",
                      text: b,
                      size: noteSize,
                      skin: noteSkin,
                      font: uiFont
                      bodySz: noteBodySz,
                      fontWeight: noteWeight,
                      align: noteAlign,
                      colorIdx: noteColorIdx,
                      pinned: notePinned,
                      accentBar: noteAccentBar,
                      borderStyle: noteBorderStyle,
                      time: timeHm,
                      pg: 0,
                      fld: noteFld
                    }] + holocronNotes
                if editId <= 0 {
                  nextNoteId = nextNoteId + 1
                }
                holocronNotes = nextList.filter(x => x.pinned == true) + nextList.filter(x => x.pinned != true)
              }
              screenMode = "deck"
            }
            Text { font: uiFont; text: editId > 0 ? "✓ SAVE CARD" : "✓ ADD CARD"; fontSize: 14; fontWeight: 900; color: hiInk; letterSpacing: 1.0 }
          }
        }
      }
    }
    else if screenMode == "tableBuilder" {
      TableBuilderScreen {}
    }
    else if screenMode == "imgPick" {
      ImgPickScreen {}
    }
    else {
      let q = lower(trim(query))
      let sum = panel.summary ?? {}
    
    
      let rawOwls = panel.owlModules ?? []
      let viewOwls = owlView == "active" ? rawOwls.filter(w => w.active) : rawOwls.filter(w => !w.active)
      let filtOwls = q == "" ? viewOwls : viewOwls.filter(w => contains(lower(w.name), q) || contains(lower(w.file), q) || contains(lower(w.kind), q))
      let shownOwls = filtOwls.take(36)
    
      let allDrawerApps = d.apps ?? []
      let baseDrawerApps = appFilter == "all" ? allDrawerApps
        : appFilter == "android" ? allDrawerApps.filter(a => a.kind == "android")
        : appFilter == "owl" ? allDrawerApps.filter(a => a.kind == "owl")
        : allDrawerApps.filter(a => a.kind == "linux")
      let filtDrawerApps = q == "" ? baseDrawerApps.sortBy(a => lower(a.name)) : rank(baseDrawerApps, q)
      let shownDrawerApps = filtDrawerApps.take(36)
    
      let rawPkgs = panel.linuxPkgs ?? []
      let sortedPkgs = pkgSort == "size" ? rawPkgs : rawPkgs.sortBy(p => lower(p.name))
      let filtPkgs = q == "" ? sortedPkgs : sortedPkgs.filter(p => contains(lower(p.name), q) || contains(lower(p.desc ?? ""), q))
      let shownPkgs = filtPkgs.take(36)
    
      let rawLinuxApps = panel.linuxApps ?? []
      let filtLinuxApps = q == "" ? rawLinuxApps : rawLinuxApps.filter(a => contains(lower(a.name), q) || contains(lower(a.pkg ?? ""), q) || contains(lower(a.exec ?? ""), q))
      let shownLinuxApps = filtLinuxApps.take(36)
    
      let orphans = panel.orphans ?? []
    
      let memUsed = sys.memory.used ?? 0
      let memTotal = max(sys.memory.total ?? 1, 1)
      let memPct = round(memUsed / memTotal * 100)
      let stoUsed = sys.storage.used ?? 0
      let stoTotal = max(sys.storage.total ?? 1, 1)
      let stoPct = round(stoUsed / stoTotal * 100)
      let volOut = vol.output ?? {}
      let volOutLabel = volOut.name != null && volOut.name != "" ? volOut.name : upper(volOut.type ?? "SPEAKER")
      // Full Sith Lyfe Control Panel & Screen Customization hub
      Box {
        scale: tapBounce == "78" ? 0.9 : 1
        offset: [0, tapBounce == "78" ? -4 : 0]
        animate scale: spring(0.32, 520)
        animate offset: spring(0.32, 520)
        onPress: tapBounce = "78"
        onRelease: tapBounce = ""
        fill: true
        background: linear(0, 0, 0, 1, [cDeep, cObs, cObs])

        Column {
          fill: true
          padding: 12
          gap: 10

          // Tactical Header (single-line obsidian chrome + molten crimson-amber bevel)
          Column {
            fill: width
            radius: 13 * corners
            clip: true
            background: linear(0, 0, 1, 1, [alpha(accentDark, 0.96), alpha(cObs, 0.96)])
            border: 1.3
            borderColor: alpha(accentCol, 0.72)
            gap: 0

            Box {
              fill: width
              height: 1.5
              background: linear(0, 0, 1, 0, [alpha(cPri, 0.12), cPri, cHot, cBone, alpha(cPri, 0.12)])
            }

            Row {
              fill: width
              align: center
              gap: 8
              padding: [11, 9]

              Sigil { size: 32 }

              Column {
                weight: 1
                gap: 1
                Text {
                  font: dispFont
                  text: curMode == "skeletor" ? "HAVOC HUB" : curMode == "mask" ? "MASK HUB" : curMode == "future" ? "CYBER HUB" : "SITH HUB"
                  fontSize: 14.5
                  color: hiInk
                  bold: true
                  letterSpacing: 1.1
                  maxLines: 1
                }
                Text {
                  text: "HUB · PLUGINS · APPS · CORE"
                  fontSize: 8.5
                  font: bodyFont
                  fontWeight: 700
                  color: alpha(accentEmber, 0.90)
                  letterSpacing: 0.9
                  maxLines: 1
                }
              }

              Text {
                scale: tapBounce == "79" ? 0.9 : 1
                offset: [0, tapBounce == "79" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "79"
                onRelease: tapBounce = ""
                font: uiFont
                text: busy ? "…" : "↻"
                fontSize: 14
                color: accentEmber
                bold: true
                padding: [9, 5]
                radius: 99
                background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.96), #000000, alpha(cSec, 0.11)])
                border: 1.1
                borderColor: alpha(accentEmber, 0.60)
                onTap: {
                  if hapticsOn { haptic() }
                  statusMsg = "Rescanning system vault…"
                  statusOk = true
                  refresh()
                }
              }

              Text {
                scale: tapBounce == "80" ? 0.9 : 1
                offset: [0, tapBounce == "80" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "80"
                onRelease: tapBounce = ""
                font: uiFont
                text: "CLOSE"
                fontSize: 10
                color: hiInk
                bold: true
                letterSpacing: 1.2
                padding: [11, 6]
                radius: 99
                background: linear(0, 0, 1, 1, [accentCol, accentGhost])
                border: 1.1
                borderColor: accentEmber
                onTap: {
                  if hapticsOn { haptic() }
                  confirmKey = ""
                  query = ""
                  screenMode = "deck"
                }
              }
            }
          }

          // Status feedback banner
          if statusMsg != "" || busy {
            Row {
              fill: width
              align: center
              gap: 8
              padding: [10, 7]
              radius: 10 * corners
              background: busy ? alpha(cDeep, 0.92) : statusOk ? alpha(cDeep, 0.94) : alpha(cDim, 0.96)
              border: 1
              borderColor: busy ? accentEmber : statusOk ? alpha(accentCol, 0.65) : cPri

              Box {
                size: 7
                radius: 99
                background: busy ? accentEmber : statusOk ? accentCol : cPri
              }
              Text {
                font: uiFont
                text: statusMsg
                fontSize: 11
                color: hiInk
                weight: 1
                maxLines: 2
              }
              if !busy {
                Text {
                  scale: tapBounce == "81" ? 0.9 : 1
                  offset: [0, tapBounce == "81" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "81"
                  onRelease: tapBounce = ""
                  font: uiFont
                  text: "✕"
                  fontSize: 11
                  color: alpha(accentHot, 0.78)
                  padding: [4, 2]
                  onTap: statusMsg = ""
                }
              }
            }
          }

          // 5 Primary Navigation Tabs
          Row {
            fill: width
            gap: 5

            for tItem in [
              { id: "customize", label: "◈ HUB" },
              { id: "plugins",   label: "PLUGINS" },
              { id: "apps",      label: "APPS" },
              { id: "linux",     label: "LINUX" },
              { id: "control",   label: "CORE" }
            ] {
              let active = tab == tItem.id
              Box {
                scale: tapBounce == "82" ? 0.9 : 1
                offset: [0, tapBounce == "82" ? -4 : 0]
                animate scale: spring(0.32, 520)
                animate offset: spring(0.32, 520)
                onPress: tapBounce = "82"
                onRelease: tapBounce = ""
                weight: 1
                padding: [3, 8]
                radius: 9 * corners
                align: center
                background: active
                  ? linear(0, 0, 1, 1, [alpha(accentCol, 0.44), alpha(accentDark, 0.98)])
                  : alpha(cCard, 0.90)
                border: active ? 1.4 : 1
                borderColor: active ? accentEmber : alpha(accentCol, 0.28)
                onTap: {
                  if hapticsOn { haptic() }
                  tab = tItem.id
                  confirmKey = ""
                  query = ""
                }
                Text {
                  font: uiFont
                  text: tItem.label
                  fontSize: 9.5
                  color: active ? hiInk : alpha(accentHot, 0.72)
                  bold: active
                  letterSpacing: 0.9
                  align: center
                  maxLines: 1
                }
              }
            }
          }

          // ================= TAB 1: ◈ THE HUB — the only customization center (hub.json via owl-hub) =================
          if tab == "customize" {
            Column {
              fill: width
              weight: 1
              scroll: true
              gap: 10
              Column {
                fill: width
                gap: 8
                padding: 14
                radius: 18 * hubRadius
                background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.94), #000000, alpha(cPri, 0.09)])
                border: 1
                borderColor: alpha(accentCol, 0.34)
                Box { fill: width; height: 1.5; radius: 99; background: linear(0, 0, 1, 0, [alpha(cPri, 0.08), cPri, cHot, cBone, alpha(cPri, 0.08)]) }
                HubHead { label: "① theme"; hint: "${upper(curMode)}${curMode == "infernal" ? " · " + upper(hubTheme) : ""}" }
                HubLabel { label: "launcher theme mode" }
                Row {
                  fill: width
                  gap: 8
                  for mItem in [
                    { id: "infernal", glyph: "⛧", label: "INFERNAL", sub: "CRIMSON",   dot: #ff1e3c },
                    { id: "future",   glyph: "⬡", label: "FUTURE",   sub: "CYBER",     dot: #18d8ff }
                  ] key mItem.id {
                    let isM = hubPend == "mode ${mItem.id}" || (curMode == mItem.id && !startsWith(hubPend, "mode "))
                    Row {
                      scale: tapBounce == "83:${mItem.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "83:${mItem.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "83:${mItem.id}"
                      onRelease: tapBounce = ""
                      weight: 1
                      height: 50
                      padding: [11, 0]
                      gap: 8
                      radius: 12 * hubRadius
                      align: center
                      background: isM ? linear(0, 0, 1, 1, [alpha(mItem.dot, 0.34), alpha(cDeep, 0.98)]) : alpha(cObs, 0.96)
                      border: isM ? 1.6 : 1
                      borderColor: isM ? mItem.dot : alpha(mItem.dot, 0.32)
                      onTap: {
                        if hapticsOn { haptic() }
                        hubPend = "mode ${mItem.id}"
                        run("owl-hub mode ${mItem.id}")
                      }
                      Box { size: 12; radius: 99; background: mItem.dot; border: isM ? 1.5 : 0; borderColor: #ffffff }
                      Column {
                        weight: 1
                        gap: 1
                        Text { font: dispFont; text: "${mItem.glyph} ${mItem.label}"; fontSize: 11; fontWeight: 800; letterSpacing: 0.8; color: isM ? hiInk : alpha(hiInk, 0.68); maxLines: 1 }
                        Text { font: bodyFont; text: mItem.sub; fontSize: 8.5; fontWeight: 700; letterSpacing: 1.0; color: isM ? mItem.dot : alpha(hiInk, 0.40); maxLines: 1 }
                      }
                    }
                  }
                }
                Row {
                  fill: width
                  gap: 8
                  for mItem in [
                    { id: "mask",     glyph: "✦", label: "MASK",     sub: "NEON LIME", dot: #1aff5c },
                    { id: "skeletor", glyph: "☩", label: "SKELETOR", sub: "HAVOC",     dot: #b44aff }
                  ] key mItem.id {
                    let isM = hubPend == "mode ${mItem.id}" || (curMode == mItem.id && !startsWith(hubPend, "mode "))
                    Row {
                      scale: tapBounce == "84:${mItem.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "84:${mItem.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "84:${mItem.id}"
                      onRelease: tapBounce = ""
                      weight: 1
                      height: 50
                      padding: [11, 0]
                      gap: 8
                      radius: 12 * hubRadius
                      align: center
                      background: isM ? linear(0, 0, 1, 1, [alpha(mItem.dot, 0.34), alpha(cDeep, 0.98)]) : alpha(cObs, 0.96)
                      border: isM ? 1.6 : 1
                      borderColor: isM ? mItem.dot : alpha(mItem.dot, 0.32)
                      onTap: {
                        if hapticsOn { haptic() }
                        hubPend = "mode ${mItem.id}"
                        run("owl-hub mode ${mItem.id}")
                      }
                      Box { size: 12; radius: 99; background: mItem.dot; border: isM ? 1.5 : 0; borderColor: #ffffff }
                      Column {
                        weight: 1
                        gap: 1
                        Text { font: dispFont; text: "${mItem.glyph} ${mItem.label}"; fontSize: 11; fontWeight: 800; letterSpacing: 0.8; color: isM ? hiInk : alpha(hiInk, 0.68); maxLines: 1 }
                        Text { font: bodyFont; text: mItem.sub; fontSize: 8.5; fontWeight: 700; letterSpacing: 1.0; color: isM ? mItem.dot : alpha(hiInk, 0.40); maxLines: 1 }
                      }
                    }
                  }
                }
                HubLabel { label: "signature editions · custom layouts" }
                Row {
                  fill: width
                  gap: 8
                  for mItem in [
                    { id: "pluto-faust", glyph: "⚡", label: "FAUST", sub: "OUTRUN STUDIO", dot: #ff2ae6, sec: #00f0ff },
                    { id: "hulk-gamma",  glyph: "☢", label: "HULK",  sub: "GAMMA BRUTAL",  dot: #2bff4a, sec: #b8ff1a }
                  ] key mItem.id {
                    let isM = hubPend == "mode ${mItem.id}" || (curMode == mItem.id && !startsWith(hubPend, "mode "))
                    Row {
                      scale: tapBounce == "84b:${mItem.id}" ? 0.92 : 1
                      offset: [0, tapBounce == "84b:${mItem.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "84b:${mItem.id}"
                      onRelease: tapBounce = ""
                      weight: 1
                      height: 56
                      padding: [10, 0]
                      gap: 8
                      radius: 13 * hubRadius
                      align: center
                      background: isM ? linear(0, 0, 1, 0.35, [alpha(mItem.dot, 0.38), alpha(cDeep, 0.96), alpha(mItem.sec, 0.22)]) : linear(0, 0, 1, 0.35, [alpha(mItem.dot, 0.12), alpha(cObs, 0.97), alpha(mItem.sec, 0.08)])
                      border: isM ? 1.8 : 1.1
                      borderColor: isM ? mItem.dot : alpha(mItem.dot, 0.45)
                      onTap: {
                        if hapticsOn { haptic() }
                        hubPend = "mode ${mItem.id}"
                        run("owl-hub mode ${mItem.id}")
                      }
                      Box {
                        size: 32
                        radius: 99
                        background: linear(0, 0, 1, 1, [alpha(mItem.dot, isM ? 0.52 : 0.26), alpha(mItem.sec, isM ? 0.42 : 0.20)])
                        border: isM ? 1.8 : 1.2
                        borderColor: isM ? mItem.dot : alpha(mItem.sec, 0.68)
                        Column {
                          fill: true
                          justify: center
                          align: center
                          Text { font: dispFont; text: mItem.glyph; fontSize: 14; fontWeight: 900; color: isM ? hiInk : mItem.dot; align: center }
                        }
                      }
                      Column {
                        weight: 1
                        gap: 2
                        Text { font: dispFont; text: "${mItem.glyph} ${mItem.label}"; fontSize: 11; fontWeight: 800; letterSpacing: 0.9; color: isM ? hiInk : alpha(hiInk, 0.88); maxLines: 1 }
                        Text { font: bodyFont; text: mItem.sub; fontSize: 8; fontWeight: 700; letterSpacing: 0.9; color: isM ? mItem.sec : alpha(mItem.dot, 0.78); maxLines: 1 }
                      }
                    }
                  }
                }
                let forgedCustom = (forgeData.custom ?? []).filter(x => x.id != "pluto-faust" && x.id != "hulk-gamma")
                if len(forgedCustom) > 0 {
                  HubLabel { label: "forged themes · ${len(forgedCustom)} custom" }
                  for fRow in chunk(forgedCustom, 2) {
                    Row {
                      fill: width
                      gap: 8
                      for ct in fRow key ct.id {
                        let ctPri = ct.pri ?? cPri
                        let ctSec = ct.sec ?? cSec
                        let ctGlyph = ct.glyph ?? "◈"
                        let ctName = ct.name ?? upper(ct.id)
                        let ctSub = ct.sub ?? ct.tagline ?? "FORGED THEME"
                        let isM = hubPend == "mode ${ct.id}" || (curMode == ct.id && !startsWith(hubPend, "mode "))
                        Row {
                          scale: tapBounce == "84f:${ct.id}" ? 0.92 : 1
                          offset: [0, tapBounce == "84f:${ct.id}" ? -4 : 0]
                          animate scale: spring(0.32, 520)
                          animate offset: spring(0.32, 520)
                          onPress: tapBounce = "84f:${ct.id}"
                          onRelease: tapBounce = ""
                          weight: 1
                          height: 54
                          padding: [10, 0]
                          gap: 8
                          radius: 13 * hubRadius
                          align: center
                          background: isM ? linear(0, 0, 1, 0.35, [alpha(ctPri, 0.36), alpha(cDeep, 0.96), alpha(ctSec, 0.22)]) : linear(0, 0, 1, 0.35, [alpha(ctPri, 0.12), alpha(cObs, 0.97), alpha(ctSec, 0.08)])
                          border: isM ? 1.8 : 1.1
                          borderColor: isM ? ctPri : alpha(ctPri, 0.45)
                          onTap: {
                            if hapticsOn { haptic() }
                            hubPend = "mode ${ct.id}"
                            run("owl-hub mode ${sh(ct.id)}")
                          }
                          Box {
                            size: 30
                            radius: 99
                            background: linear(0, 0, 1, 1, [alpha(ctPri, isM ? 0.52 : 0.26), alpha(ctSec, isM ? 0.42 : 0.20)])
                            border: isM ? 1.8 : 1.2
                            borderColor: isM ? ctPri : alpha(ctSec, 0.68)
                            Column {
                              fill: true
                              justify: center
                              align: center
                              Text { font: dispFont; text: ctGlyph; fontSize: 13; fontWeight: 900; color: isM ? hiInk : ctPri; align: center }
                            }
                          }
                          Column {
                            weight: 1
                            gap: 2
                            Text { font: dispFont; text: ctName; fontSize: 10.5; fontWeight: 800; letterSpacing: 0.8; color: isM ? hiInk : alpha(hiInk, 0.88); maxLines: 1 }
                            Text { font: bodyFont; text: ctSub; fontSize: 8; fontWeight: 700; letterSpacing: 0.8; color: isM ? ctSec : alpha(ctPri, 0.78); maxLines: 1 }
                          }
                        }
                      }
                      if len(fRow) == 1 {
                        Box { weight: 1 }
                      }
                    }
                  }
                }
                HubLabel { label: "forge new theme · type vibe or character" }
                Row {
                  fill: width
                  gap: 8
                  align: center
                  Row {
                    weight: 1
                    height: 44
                    padding: [12, 0]
                    gap: 6
                    radius: 12 * hubRadius
                    align: center
                    background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), cObs, #000000, alpha(cPri, 0.09)])
                    border: 1.2
                    borderColor: quickThemeIn != "" ? accentHot : alpha(accentCol, 0.45)
                    Input {
                      weight: 1
                      text: quickThemeIn
                      placeholder: "e.g. neon joker, cyber samurai..."
                      color: hiInk
                      fontSize: 12.5
                      underline: false
                      onChange: quickThemeIn = value
                      onSubmit: {
                        let fq = trim(value ?? quickThemeIn)
                        if fq != "" {
                          if hapticsOn { haptic() }
                          forgeMsg = "FORGING..."
                          forgeRes = run("python3 ~/.local/bin/theme-forge.py quick ${sh(fq)}")
                          quickThemeIn = ""
                        }
                      }
                    }
                    if quickThemeIn != "" {
                      Text {
                        font: uiFont
                        text: "✕"
                        fontSize: 11
                        color: alpha(accentHot, 0.72)
                        padding: [4, 2]
                        onTap: quickThemeIn = ""
                      }
                    }
                  }
                  Row {
                    scale: tapBounce == "84g" ? 0.92 : 1
                    offset: [0, tapBounce == "84g" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "84g"
                    onRelease: tapBounce = ""
                    height: 44
                    padding: [14, 0]
                    radius: 12 * hubRadius
                    align: center
                    justify: center
                    background: linear(0, 0, 1, 1, [alpha(accentCol, 0.42), alpha(cDeep, 0.96)])
                    border: 1.4
                    borderColor: accentHot
                    onTap: {
                      let fq = trim(quickThemeIn)
                      if hapticsOn { haptic() }
                      if fq == "" {
                        forgeMsg = "Type a vibe or character first"
                      } else {
                        forgeMsg = "FORGING..."
                        forgeRes = run("python3 ~/.local/bin/theme-forge.py quick ${sh(fq)}")
                        quickThemeIn = ""
                      }
                    }
                    Text { font: dispFont; text: "⚡ FORGE"; fontSize: 10.5; fontWeight: 800; letterSpacing: 0.9; color: hiInk; maxLines: 1 }
                  }
                }
                if forgeMsg != "" {
                  Row {
                    fill: width
                    padding: [10, 6]
                    gap: 8
                    radius: 10 * hubRadius
                    align: center
                    background: alpha(cDeep, 0.92)
                    border: 1
                    borderColor: alpha(accentHot, 0.52)
                    onTap: forgeMsg = ""
                    Box { size: 7; radius: 99; background: accentHot }
                    Text { font: uiFont; text: forgeMsg; fontSize: 10; fontWeight: 700; letterSpacing: 0.6; color: hiInk; weight: 1; maxLines: 1 }
                    Text { font: uiFont; text: "✕"; fontSize: 10; color: alpha(accentHot, 0.72) }
                  }
                }
                Row {
                  fill: width
                  gap: 8
                  Row {
                    scale: tapBounce == "84h" ? 0.92 : 1
                    offset: [0, tapBounce == "84h" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "84h"
                    onRelease: tapBounce = ""
                    weight: 1.4
                    height: 44
                    padding: [10, 0]
                    radius: 12 * hubRadius
                    align: center
                    justify: center
                    background: linear(0, 0, 1, 1, [alpha(cSec, 0.24), alpha(cDeep, 0.96)])
                    border: 1.2
                    borderColor: alpha(cSec, 0.62)
                    onTap: {
                      if hapticsOn { haptic() }
                      open("o:theme-forge.owl")
                    }
                    Text { font: dispFont; text: "🎨 OPEN THEME FORGE STUDIO ↗"; fontSize: 9.5; fontWeight: 800; letterSpacing: 0.6; color: hiInk; maxLines: 1 }
                  }
                  Row {
                    scale: tapBounce == "84i" ? 0.92 : 1
                    offset: [0, tapBounce == "84i" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "84i"
                    onRelease: tapBounce = ""
                    weight: 1
                    height: 44
                    padding: [10, 0]
                    radius: 12 * hubRadius
                    align: center
                    justify: center
                    background: linear(0, 0, 1, 1, [alpha(cPri, 0.22), alpha(cObs, 0.96)])
                    border: 1.2
                    borderColor: alpha(cPri, 0.55)
                    onTap: {
                      if hapticsOn { haptic() }
                      forgeMsg = "FORGING RANDOM..."
                      forgeRes = run("python3 ~/.local/bin/theme-forge.py quick random")
                    }
                    Text { font: dispFont; text: "🎲 SURPRISE ME"; fontSize: 9.5; fontWeight: 800; letterSpacing: 0.6; color: hiInk; maxLines: 1 }
                  }
                }
                HubLabel { label: curMode == "infernal" ? "infernal crystal" : "infernal crystals · tap to switch" }
                Row {
                  fill: width
                  gap: 6
                  opacity: curMode == "infernal" ? 1.0 : 0.72
                  for th in [
                    { id: "vader",  label: "VADER",  c: #ff1e3c },
                    { id: "maul",   label: "MAUL",   c: #ff3b1f },
                    { id: "revan",  label: "REVAN",  c: #b517ff },
                    { id: "bane",   label: "BANE",   c: #ffae00 },
                    { id: "matrix", label: "MATRIX", c: #00ff88 }
                  ] key th.id {
                    let isT = curMode == "infernal" && hubTheme == th.id
                    Column {
                      scale: tapBounce == "85:${th.id}" ? 0.9 : 1
                      offset: [0, tapBounce == "85:${th.id}" ? -4 : 0]
                      animate scale: spring(0.32, 520)
                      animate offset: spring(0.32, 520)
                      onPress: tapBounce = "85:${th.id}"
                      onRelease: tapBounce = ""
                      weight: 1
                      height: 54
                      radius: 12 * hubRadius
                      align: center
                      justify: center
                      gap: 5
                      background: isT ? alpha(th.c, 0.18) : alpha(cObs, 0.96)
                      border: isT ? 1.6 : 1
                      borderColor: isT ? th.c : alpha(th.c, 0.28)
                      onTap: {
                        if hapticsOn { haptic() }
                        hubPend = "mode infernal"
                        run("owl-hub mode infernal && owl-hub theme ${th.id}")
                      }
                      Box { size: 14; radius: 99; background: th.c; border: isT ? 1.8 : 0; borderColor: #ffffff }
                      Text { text: th.label; font: bodyFont; fontSize: 8.5; fontWeight: 800; letterSpacing: 0.6; align: center; color: isT ? hiInk : alpha(hiInk, 0.55); maxLines: 1 }
                    }
                  }
                }
              }
              Column {
                fill: width
                gap: 8
                padding: 14
                radius: 18 * hubRadius
                background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cCard, 0.94), #000000, alpha(cSec, 0.11)])
                border: 1
                borderColor: alpha(accentCol, 0.34)
                Box { fill: width; height: 1.5; radius: 99; background: linear(0, 0, 1, 0, [alpha(cPri, 0.08), cPri, cHot, cBone, alpha(cPri, 0.08)]) }
                HubHead { label: "② look"; hint: "${upper(hubSurface)} · ${upper(hubTexture)}" }
                HubLabel { label: "surface" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "OBSIDIAN"; on: hubSurface == "obsidian"; cmd: "surface obsidian" }
                  HubChip { label: "GLASS"; on: hubSurface == "glass"; cmd: "surface glass" }
                  HubChip { label: "OLED"; on: hubSurface == "oled"; cmd: "surface oled" }
                }
                HubLabel { label: "texture" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "NONE"; on: hubTexture == "none"; cmd: "texture none" }
                  HubChip { label: "GRID"; on: hubTexture == "grid"; cmd: "texture grid" }
                  HubChip { label: "HEX"; on: hubTexture == "hex"; cmd: "texture hex" }
                }
                HubLabel { label: "glow" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "SOFT"; on: hubGlow == 0; cmd: "glow 0" }
                  HubChip { label: "NORMAL"; on: hubGlow == 1; cmd: "glow 1" }
                  HubChip { label: "BLAZE"; on: hubGlow == 2; cmd: "glow 2" }
                }
                HubLabel { label: "corner radius" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "0.6"; on: hubRadius == 0.6; cmd: "radius 0.6" }
                  HubChip { label: "0.8"; on: hubRadius == 0.8; cmd: "radius 0.8" }
                  HubChip { label: "1.0"; on: hubRadius == 1; cmd: "radius 1" }
                  HubChip { label: "1.2"; on: hubRadius == 1.2; cmd: "radius 1.2" }
                  HubChip { label: "1.4"; on: hubRadius == 1.4; cmd: "radius 1.4" }
                }
                HubLabel { label: "font" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "SITH"; on: hubFont == "sith"; cmd: "font sith" }
                  HubChip { label: "SANS"; on: hubFont == "sans"; cmd: "font sans" }
                  HubChip { label: "MONO"; on: hubFont == "mono"; cmd: "font mono" }
                }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "ANTON"; on: hubFont == "anton"; cmd: "font anton" }
                  HubChip { label: "BEBAS"; on: hubFont == "bebas"; cmd: "font bebas" }
                  HubChip { label: "ARCHIVO"; on: hubFont == "archivo"; cmd: "font archivo" }
                  HubChip { label: "OPS"; on: hubFont == "blackops"; cmd: "font blackops" }
                }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "BOWLBY"; on: hubFont == "bowlby"; cmd: "font bowlby" }
                  HubChip { label: "TITAN"; on: hubFont == "titan"; cmd: "font titan" }
                  HubChip { label: "PASSION"; on: hubFont == "passion"; cmd: "font passion" }
                  HubChip { label: "OSWALD"; on: hubFont == "oswald"; cmd: "font oswald" }
                }
              }
              Column {
                fill: width
                gap: 8
                padding: 14
                radius: 18 * hubRadius
                background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cCard, 0.94), #000000, alpha(cSec, 0.10)])
                border: 1
                borderColor: alpha(accentCol, 0.34)
                Box { fill: width; height: 1.5; radius: 99; background: linear(0, 0, 1, 0, [alpha(cPri, 0.08), cPri, cHot, cBone, alpha(cPri, 0.08)]) }
                HubHead { label: "③ motion"; hint: hubEco ? "ECO" : hubFx ? "LIVE" : "STILL" }
                HubSwitch { label: "Animations"; hint: "master FX for every page"; on: hubFx; key: "fx" }
                HubLabel { label: "fx level" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "LOW"; on: hubFxLevel == 0; cmd: "fxLevel 0" }
                  HubChip { label: "NORMAL"; on: hubFxLevel == 1; cmd: "fxLevel 1" }
                  HubChip { label: "EPIC"; on: hubFxLevel == 2; cmd: "fxLevel 2" }
                }
                HubLabel { label: "speed" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "0.5×"; on: hubSpeed == 0.5; cmd: "speed 0.5" }
                  HubChip { label: "1×"; on: hubSpeed == 1; cmd: "speed 1" }
                  HubChip { label: "1.5×"; on: hubSpeed == 1.5; cmd: "speed 1.5" }
                  HubChip { label: "2×"; on: hubSpeed == 2; cmd: "speed 2" }
                }
                HubLabel { label: "resolution · lower = faster" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "FULL"; on: gpuRes >= 1; cmd: "res 1" }
                  HubChip { label: "75%"; on: gpuRes == 0.75; cmd: "res 0.75" }
                  HubChip { label: "50%"; on: gpuRes == 0.5; cmd: "res 0.5" }
                  HubChip { label: "33%"; on: gpuRes < 0.4; cmd: "res 0.34" }
                }
                HubSwitch { label: "Haptics"; hint: "buzz on tap"; on: hubHaptics; key: "haptics" }
                HubSwitch { label: "Eco mode"; hint: "dim + freeze FX, save battery"; on: hubEco; key: "eco" }
                HubSwitch { label: "Busy mode"; hint: "half-res + 24fps cap, saves battery"; on: rzBusy; key: "busy" }
              }
              Column {
                fill: width
                gap: 8
                padding: 14
                radius: 18 * hubRadius
                background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.94), #000000, alpha(cPri, 0.09)])
                border: 1
                borderColor: alpha(accentCol, 0.34)
                Box { fill: width; height: 1.5; radius: 99; background: linear(0, 0, 1, 0, [alpha(cPri, 0.08), cPri, cHot, cBone, alpha(cPri, 0.08)]) }
                HubHead { label: "④ deck & cards"; hint: upper(deckView) }
                HubLabel { label: "view" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "FEED"; on: deckView == "feed"; cmd: "deck.view feed" }
                  }
                HubLabel { label: "canvas pages" }
                Row {
                  fill: width
                  gap: 6
                  align: center
                  Box {
                    scale: tapBounce == "86" ? 0.9 : 1
                    offset: [0, tapBounce == "86" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "86"
                    onRelease: tapBounce = ""
                    width: 56; height: 44; radius: 12 * hubRadius; align: center
                    background: alpha(cObs, 0.96); border: 1; borderColor: alpha(accentCol, 0.4)
                    onTap: { if cvPages > 1 { if hapticsOn { haptic() }; run("owl-hub deck.canvasPages ${cvPages - 1}") } }
                    Text { font: uiFont; text: "−"; fontSize: 18; fontWeight: 900; color: hiInk; align: center }
                  }
                  Text { font: uiFont; text: "${cvPages} PAGES"; fontSize: 13; fontWeight: 900; letterSpacing: 1; color: hiInk; align: center; weight: 1 }
                  Box {
                    scale: tapBounce == "87" ? 0.9 : 1
                    offset: [0, tapBounce == "87" ? -4 : 0]
                    animate scale: spring(0.32, 520)
                    animate offset: spring(0.32, 520)
                    onPress: tapBounce = "87"
                    onRelease: tapBounce = ""
                    width: 56; height: 44; radius: 12 * hubRadius; align: center
                    background: alpha(cObs, 0.96); border: 1; borderColor: alpha(accentCol, 0.4)
                    onTap: { if cvPages < 50 { if hapticsOn { haptic() }; run("owl-hub deck.canvasPages ${cvPages + 1}") } }
                    Text { font: uiFont; text: "+"; fontSize: 18; fontWeight: 900; color: hiInk; align: center }
                  }
                  HubChip { label: "+5"; on: false; cmd: "deck.canvasPages ${min(50, cvPages + 5)}" }
                }
                HubLabel { label: "new card font" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "SANS"; on: hubCardFont == "sans"; cmd: "deck.cardFont sans" }
                  HubChip { label: "MONO"; on: hubCardFont == "mono"; cmd: "deck.cardFont mono" }
                  HubChip { label: "SERIF"; on: hubCardFont == "serif"; cmd: "deck.cardFont serif" }
                }
                HubLabel { label: "new card size" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "S"; on: hubCardSize == "sm"; cmd: "deck.cardSize sm" }
                  HubChip { label: "M"; on: hubCardSize == "md"; cmd: "deck.cardSize md" }
                  HubChip { label: "L"; on: hubCardSize == "lg"; cmd: "deck.cardSize lg" }
                }
                HubLabel { label: "body text" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "12"; on: hubBodySz == 12; cmd: "deck.bodySz 12" }
                  HubChip { label: "14"; on: hubBodySz == 14; cmd: "deck.bodySz 14" }
                  HubChip { label: "16"; on: hubBodySz == 16; cmd: "deck.bodySz 16" }
                  HubChip { label: "18"; on: hubBodySz == 18; cmd: "deck.bodySz 18" }
                }
                HubLabel { label: "editor text" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "12.5"; on: edFont == 12.5; cmd: "deck.editorFont 12.5" }
                  HubChip { label: "14.5"; on: edFont == 14.5; cmd: "deck.editorFont 14.5" }
                  HubChip { label: "16.5"; on: edFont == 16.5; cmd: "deck.editorFont 16.5" }
                  HubChip { label: "18.5"; on: edFont == 18.5; cmd: "deck.editorFont 18.5" }
                }
                HubSwitch { label: "Canvas grid"; hint: "snap tiles on the board"; on: hubCvGrid; key: "deck.canvasGrid" }
              }
              Column {
                fill: width
                gap: 12
                padding: 14
                radius: 18 * hubRadius
                background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cCard, 0.94), #000000, alpha(cSec, 0.11)])
                border: 1
                borderColor: alpha(accentCol, 0.34)
                Box { fill: width; height: 1.5; radius: 99; background: linear(0, 0, 1, 0, [alpha(cPri, 0.08), cPri, cHot, cBone, alpha(cPri, 0.08)]) }
                HubHead { label: "✎ markdown ink"; hint: "ALL CARDS" }
                Text { text: "A = card's own color. Pick a swatch to recolor that element on every card."; font: uiFont; fontSize: 10.5; color: alpha(hiInk, 0.5); fill: width }
                for ik in inkKeys {
                  InkRow { label: ik.l; key: ik.k }
                }
                Column {
                  fill: width
                  padding: 12
                  radius: 10
                  background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), cObs, #000000, alpha(cSec, 0.10)])
                  border: 1
                  borderColor: alpha(accentCol, 0.25)
                  MdView { raw: "# Heading\n## Sub heading\nBody with **bold**, *italic*, `code` and [a link](https://x).\n> quoted line\n```\nsudo pacman -Syu --noconfirm  # update\n```"; pal: notePalettes[0]; bSz: 13; live: false }
                }
                Row {
                  scale: tapBounce == "88" ? 0.9 : 1
                  offset: [0, tapBounce == "88" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "88"
                  onRelease: tapBounce = ""
                  height: 40; fill: width; radius: 10; align: center; justify: center
                  background: alpha(accentCol, 0.12); border: 1; borderColor: alpha(accentCol, 0.5)
                  onTap: {
                    if hapticsOn { haptic() }
                    mdInk = {}
                  }
                  Text { text: "↺ RESET INK"; font: uiFont; fontSize: 11.5; fontWeight: 900; letterSpacing: 1; color: accentHot }
                }
              }
              Column {
                fill: width
                gap: 8
                padding: 14
                radius: 18 * hubRadius
                background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.94), #000000, alpha(cPri, 0.09)])
                border: 1
                borderColor: alpha(accentCol, 0.34)
                Box { fill: width; height: 1.5; radius: 99; background: linear(0, 0, 1, 0, [alpha(cPri, 0.08), cPri, cHot, cBone, alpha(cPri, 0.08)]) }
                HubHead { label: "⑤ drawer"; hint: "${num(hubDrawer.cellDp, 76)}dp" }
                HubLabel { label: "icon cell (dp)" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "64"; on: num(hubDrawer.cellDp, 76) == 64; cmd: "drawer.cellDp 64" }
                  HubChip { label: "72"; on: num(hubDrawer.cellDp, 76) == 72; cmd: "drawer.cellDp 72" }
                  HubChip { label: "76"; on: num(hubDrawer.cellDp, 76) == 76; cmd: "drawer.cellDp 76" }
                  HubChip { label: "84"; on: num(hubDrawer.cellDp, 76) == 84; cmd: "drawer.cellDp 84" }
                  HubChip { label: "96"; on: num(hubDrawer.cellDp, 76) == 96; cmd: "drawer.cellDp 96" }
                }
                HubSwitch { label: "Sort by name"; hint: "A→Z instead of most used"; on: (hubDrawer.byName ?? false) == true; key: "drawer.byName" }
                HubSwitch { label: "Show work apps"; hint: "work profile in drawer"; on: (hubDrawer.showWork ?? true) == true; key: "drawer.showWork" }
                HubLabel { label: "voice" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "SITH"; on: (hubDrawer.voice ?? "sith") == "sith"; cmd: "drawer.voice sith" }
                  HubChip { label: "PLAIN"; on: (hubDrawer.voice ?? "sith") == "plain"; cmd: "drawer.voice plain" }
                  HubChip { label: "OFF"; on: (hubDrawer.voice ?? "sith") == "off"; cmd: "drawer.voice off" }
                }
                HubLabel { label: "◈ icon fx" }
                HubSwitch { label: "Icon shimmer"; hint: "light sweep across every icon"; on: (hubDrawer.shimmer ?? true) == true; key: "drawer.shimmer" }
                HubLabel { label: "shimmer speed" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "SLOW"; on: num(hubDrawer.shimSpeed, 1) == 0.6; cmd: "drawer.shimSpeed 0.6" }
                  HubChip { label: "MED"; on: num(hubDrawer.shimSpeed, 1) == 1; cmd: "drawer.shimSpeed 1" }
                  HubChip { label: "FAST"; on: num(hubDrawer.shimSpeed, 1) == 1.7; cmd: "drawer.shimSpeed 1.7" }
                }
                HubLabel { label: "icon glitch" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "OFF"; on: num(hubDrawer.glitch, 1) == 0; cmd: "drawer.glitch 0" }
                  HubChip { label: "SUBTLE"; on: num(hubDrawer.glitch, 1) == 1; cmd: "drawer.glitch 1" }
                  HubChip { label: "CHAOS"; on: num(hubDrawer.glitch, 1) == 2; cmd: "drawer.glitch 2" }
                }
                HubLabel { label: "scroll fx" }
                Row {
                  fill: width
                  gap: 6
                  HubChip { label: "OFF"; on: num(hubDrawer.scrollFx, 1) == 0; cmd: "drawer.scrollFx 0" }
                  HubChip { label: "WARP"; on: num(hubDrawer.scrollFx, 1) == 1; cmd: "drawer.scrollFx 1" }
                  HubChip { label: "CHAOS"; on: num(hubDrawer.scrollFx, 1) == 2; cmd: "drawer.scrollFx 2" }
                }
              }
              Column {
                fill: width
                gap: 8
                padding: 14
                radius: 18 * hubRadius
                background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cCard, 0.94), #000000, alpha(cSec, 0.11)])
                border: 1
                borderColor: alpha(accentCol, 0.34)
                Box { fill: width; height: 1.5; radius: 99; background: linear(0, 0, 1, 0, [alpha(cPri, 0.08), cPri, cHot, cBone, alpha(cPri, 0.08)]) }
                HubHead { label: "⑥ keybar"; hint: "" }
                HubSwitch { label: "Compact key bar"; hint: "smaller keys, more room"; on: (hubKeybar.compact ?? false) == true; key: "keybar.compact" }
              }
              Column {
                fill: width
                gap: 8
                padding: 14
                radius: 18 * hubRadius
                background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cCard, 0.94), #000000, alpha(cSec, 0.10)])
                border: 1
                borderColor: alpha(accentCol, 0.34)
                Box { fill: width; height: 1.5; radius: 99; background: linear(0, 0, 1, 0, [alpha(cPri, 0.08), cPri, cHot, cBone, alpha(cPri, 0.08)]) }
                HubHead { label: "⑦ reset all"; hint: hubResetArm ? "ARMED" : "" }
                Box {
                  scale: tapBounce == "89" ? 0.9 : 1
                  offset: [0, tapBounce == "89" ? -4 : 0]
                  animate scale: spring(0.32, 520)
                  animate offset: spring(0.32, 520)
                  onPress: tapBounce = "89"
                  onRelease: tapBounce = ""
                  fill: width
                  height: 48
                  radius: 12 * hubRadius
                  align: center
                  background: hubResetArm ? alpha(accentCol, 0.55) : alpha(cObs, 0.96)
                  border: 1.2
                  borderColor: hubResetArm ? accentHot : alpha(accentCol, 0.35)
                  onTap: {
                    if hapticsOn { haptic() }
                    if hubResetArm {
                      run("owl-hub reset")
                      hubResetArm = false
                    } else {
                      hubResetArm = true
                    }
                  }
                  Text { font: uiFont; text: hubResetArm ? "TAP AGAIN TO RESET EVERYTHING" : "RESET ALL SETTINGS"; fontSize: 11; fontWeight: 800; letterSpacing: 1.2; align: center; color: hiInk; maxLines: 1 }
                }
              }
              Text { text: "Every page reads hub.json · changes apply instantly"; font: uiFont; fontSize: 9; align: center; fill: width; color: alpha(hiInk, 0.3) }
              Spacer { height: 16 }
            }
          }

          // ================= TAB 2: PLUGINS =================
          else if tab == "plugins" {
        // Search bar
        Row {
        fill: width
        align: center
        gap: 8
        padding: [10, 5]
        radius: 10 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), cCard, #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: alpha(cMid, 0.42)
        Text { font: uiFont; text: "⌕"; color: cMid; fontSize: 15 }
        Input {
        weight: 1
        text: query
        placeholder: "Search OWL widgets, faces, apps…"
        underline: false
        color: cHot
        onChange: query = value
        }
        if query != "" {
        Text {
          font: uiFont
        text: "✕"
        color: alpha(cHot, 0.72)
        padding: [4, 2]
        onTap: query = ""
        }
        }
        }

        // Filter pills
        Row {
        fill: width
        gap: 6
        for ow in [
        { id: "active", label: "ACTIVE (${sum.owlActive ?? 0})" },
        { id: "archive", label: "ARCHIVED (${sum.owlDisabled ?? 0})" }
        ] {
        let on = owlView == ow.id
        Box {
        weight: 1
        padding: [6, 5]
        radius: 99
        align: center
        background: on ? cDim : alpha(cCard, 0.88)
        border: 1
        borderColor: on ? cMid : alpha(cMid, 0.24)
        onTap: {
        haptic()
        owlView = ow.id
        confirmKey = ""
        }
        Text {
          font: uiFont
        text: ow.label
        fontSize: 9.5
        color: on ? cHot : alpha(cHot, 0.72)
        bold: on
        letterSpacing: 0.9
        align: center
        }
        }
        }
        }

        // Plugin / OWL List
        Column {
        scroll: true
        weight: 1
        fill: width
        gap: 6

        // OWL Launcher Modules
        for w in shownOwls key w.file {
        let ck = "owl:" + w.file
        let armed = confirmKey == ck
        Row {
        fill: width
        align: center
        gap: 8
        padding: [10, 9]
        radius: 10 * corners
        background: w.active ? alpha(cDeep, 0.92) : alpha(cCard, 0.85)
        border: 1
        borderColor: armed ? cPri : w.active ? alpha(cMid, 0.42) : alpha(cMid, 0.18)

        Text {
          font: uiFont
        text: upper(w.kind)
        fontSize: 8.5
        color: w.active ? cHot : alpha(cHot, 0.55)
        bold: true
        letterSpacing: 0.7
        padding: [6, 3]
        radius: 6 * corners
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.95), #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: alpha(cMid, 0.32)
        }

        Column {
        weight: 1
        gap: 1
        Text {
          font: uiFont
        text: w.name
        fontSize: 12.5
        color: cHot
        bold: w.active
        maxLines: 1
        }
        Text {
          font: uiFont
        text: "${w.file} · ${w.size}"
        fontSize: 9.5
        color: alpha(cHot, 0.56)
        maxLines: 1
        }
        }

        if w.protected {
        Text {
          font: uiFont
        text: "CORE"
        fontSize: 9
        color: alpha(cHot, 0.55)
        bold: true
        letterSpacing: 1.0
        padding: [8, 5]
        radius: 8 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cDeep, 0.9), #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: alpha(cMid, 0.24)
        }
        } else if w.active {
        if armed {
        Text {
          font: uiFont
        text: "DISABLE"
        fontSize: 9.5
        color: cHot
        bold: true
        padding: [9, 6]
        radius: 8 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), cPri, #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: cHot
        onTap: {
        haptic()
        busy = true
        statusOk = true
        statusMsg = "Disabling ${w.file}…"
        cmdOut = ""
        cmdOut = run("python3 ~/.local/share/omalauncher/synth-pads/sith_panel.py owl-disable ${sh(w.file)}")
        }
        }
        Text {
          font: uiFont
        text: "✕"
        fontSize: 10
        color: alpha(cHot, 0.78)
        padding: [6, 6]
        radius: 8 * corners
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.95), #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: alpha(cMid, 0.35)
        onTap: confirmKey = ""
        }
        } else {
        Text {
          font: uiFont
        text: "OFF"
        fontSize: 9.5
        color: cHot
        bold: true
        letterSpacing: 1.0
        padding: [9, 6]
        radius: 8 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cDeep, 0.95), #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: alpha(cMid, 0.55)
        onTap: {
        haptic()
        confirmKey = ck
        }
        }
        }
        } else {
        Text {
          font: uiFont
        text: "RESTORE"
        fontSize: 9.5
        color: cHot
        bold: true
        letterSpacing: 0.8
        padding: [8, 6]
        radius: 8 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cDim, 0.92), #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: alpha(cMid, 0.68)
        onTap: {
        haptic()
        busy = true
        statusOk = true
        statusMsg = "Restoring ${w.file}…"
        cmdOut = ""
        cmdOut = run("python3 ~/.local/share/omalauncher/synth-pads/sith_panel.py owl-restore ${sh(w.file)}")
        }
        }
        if armed {
        Text {
          font: uiFont
        text: "DEL!"
        fontSize: 9.5
        color: cHot
        bold: true
        padding: [8, 6]
        radius: 8 * corners
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), cPri, #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: cHot
        onTap: {
        haptic()
        busy = true
        statusOk = true
        statusMsg = "Deleting ${w.file}…"
        cmdOut = ""
        cmdOut = run("python3 ~/.local/share/omalauncher/synth-pads/sith_panel.py owl-purge ${sh(w.file)}")
        }
        }
        } else {
        Text {
          font: uiFont
        text: "✕"
        fontSize: 10
        color: cHot
        bold: true
        padding: [7, 6]
        radius: 8 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cDeep, 0.95), #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: alpha(cMid, 0.45)
        onTap: {
        haptic()
        confirmKey = ck
        }
        }
        }
        }
        }
        }

        if len(filtOwls) == 0 {
        Text {
          font: uiFont
        text: "No matching OWL modules"
        style: muted
        align: center
        fill: width
        padding: [0, 24]
        }
        }
        // end owl list
        }
          }

          // ================= TAB 3: APPS =================
          else if tab == "apps" {
        // Search bar
        Row {
        fill: width
        align: center
        gap: 8
        padding: [10, 5]
        radius: 10 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), cCard, #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: alpha(cMid, 0.42)
        Text { font: uiFont; text: "⌕"; color: cMid; fontSize: 15 }
        Input {
        weight: 1
        text: query
        placeholder: "Search apps to uninstall or inspect…"
        underline: false
        color: cHot
        onChange: query = value
        }
        if query != "" {
        Text {
          font: uiFont
        text: "✕"
        color: alpha(cHot, 0.72)
        padding: [4, 2]
        onTap: query = ""
        }
        }
        }

        // App kind filter pills
        Row {
        fill: width
        gap: 6
        for af in [
        { id: "android", label: "ANDROID" },
        { id: "all", label: "ALL (${len(allDrawerApps)})" },
        { id: "owl", label: "OWL" },
        { id: "linux", label: "LINUX" }
        ] {
        let on = appFilter == af.id
        Box {
        weight: 1
        padding: [4, 5]
        radius: 99
        align: center
        background: on ? cDim : alpha(cCard, 0.88)
        border: 1
        borderColor: on ? cMid : alpha(cMid, 0.24)
        onTap: {
        haptic()
        appFilter = af.id
        }
        Text {
          font: uiFont
        text: af.label
        fontSize: 9.5
        color: on ? cHot : alpha(cHot, 0.72)
        bold: on
        letterSpacing: 0.9
        align: center
        }
        }
        }
        }

        Column {
        scroll: true
        weight: 1
        fill: width
        gap: 6

        for a in shownDrawerApps key a.key {
        let acts = a.actions ?? []
        let canUninstall = any(acts, x => x == "uninstall")
        let canRemove = any(acts, x => x == "remove")
        let canInfo = any(acts, x => x == "info")

        Row {
        fill: width
        align: center
        gap: 9
        padding: [9, 8]
        radius: 10 * corners
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cCard, 0.90), #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: alpha(cMid, 0.24)

        // App icon framed in obsidian crimson
        Box {
        size: 34
        align: center
        onTap: {
        haptic()
        open(a.key)
        }
        TraySigil { src: a.hasIcon ? a.icon : null; sz: 34; lbl: a.label; ini: a.initials }
        }

        Column {
        weight: 1
        gap: 1
        onTap: {
        haptic()
        open(a.key)
        }
        Text {
          font: uiFont
        text: a.name
        fontSize: 12.5
        color: cHot
        bold: true
        maxLines: 1
        }
        Text {
          font: uiFont
        text: a.profile != null ? "${upper(a.kind)} · ${upper(a.profile)}" : upper(a.kind)
        fontSize: 9
        color: alpha(cHot, 0.56)
        letterSpacing: 0.8
        maxLines: 1
        }
        }

        if canInfo {
        Text {
          font: uiFont
        text: "INFO"
        fontSize: 9.5
        color: alpha(cHot, 0.85)
        bold: true
        letterSpacing: 0.8
        padding: [8, 6]
        radius: 8 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cDeep, 0.95), #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: alpha(cMid, 0.36)
        onTap: {
        haptic()
        appAction("info", a.key)
        }
        }
        }

        if canUninstall {
        Text {
          font: uiFont
        text: "UNINSTALL"
        fontSize: 9.5
        color: cHot
        bold: true
        letterSpacing: 0.8
        padding: [8, 6]
        radius: 8 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), cDim, #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: cMid
        onTap: {
        haptic()
        appAction("uninstall", a.key)
        }
        }
        } else if canRemove {
        Text {
          font: uiFont
        text: "REMOVE"
        fontSize: 9.5
        color: cHot
        bold: true
        letterSpacing: 0.8
        padding: [8, 6]
        radius: 8 * corners
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), cDim, #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: cMid
        onTap: {
        haptic()
        appAction("remove", a.key)
        }
        }
        } else if canInfo {
        Text {
          font: uiFont
        text: "SYS"
        fontSize: 9
        color: alpha(cHot, 0.55)
        bold: true
        letterSpacing: 0.8
        padding: [8, 6]
        radius: 8 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cDeep, 0.9), #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: alpha(cMid, 0.22)
        onTap: {
        haptic()
        appAction("info", a.key)
        }
        }
        } else {
        Text {
          font: uiFont
        text: "OPEN"
        fontSize: 9.5
        color: cHot
        bold: true
        letterSpacing: 0.8
        padding: [8, 6]
        radius: 8 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cDeep, 0.95), #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: alpha(cMid, 0.42)
        onTap: {
        haptic()
        open(a.key)
        }
        }
        }
        }
        }

        if len(filtDrawerApps) == 0 {
        Text {
          font: uiFont
        text: "No matching apps"
        style: muted
        align: center
        fill: width
        padding: [0, 24]
        }
        } else if len(filtDrawerApps) > 36 {
        Text {
          font: uiFont
        text: "Showing 36 of ${len(filtDrawerApps)} apps — search to narrow"
        fontSize: 10
        color: alpha(cHot, 0.52)
        align: center
        fill: width
        padding: [0, 8]
        }
        }
        }
          }

          // ================= TAB 4: LINUX =================
          else if tab == "linux" {
        // Sub-mode switcher
        Row {
        fill: width
        gap: 6
        for lv in [
        { id: "pkgs", label: "PKGS (${sum.linuxPkgs ?? 0})" },
        { id: "apps", label: "APPS (${sum.linuxApps ?? 0})" },
        { id: "orphans", label: "ORPHANS (${sum.orphans ?? 0})" }
        ] {
        let on = linuxView == lv.id
        Box {
        weight: 1
        padding: [4, 6]
        radius: 8 * corners
        align: center
        background: on ? alpha(cDeep, 0.95) : alpha(cCard, 0.85)
        border: 1
        borderColor: on ? cMid : alpha(cMid, 0.22)
        onTap: {
        haptic()
        linuxView = lv.id
        confirmKey = ""
        }
        Text {
          font: uiFont
        text: lv.label
        fontSize: 9.5
        color: on ? cHot : alpha(cHot, 0.65)
        bold: on
        letterSpacing: 0.9
        align: center
        }
        }
        }
        }

        // Search + sort bar (for pkgs and apps)
        if linuxView != "orphans" {
        Row {
        fill: width
        align: center
        gap: 6
        Row {
        weight: 1
        align: center
        gap: 8
        padding: [10, 5]
        radius: 10 * corners
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), cCard, #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: alpha(cMid, 0.42)
        Text { font: uiFont; text: "⌕"; color: cMid; fontSize: 15 }
        Input {
        weight: 1
        text: query
        placeholder: linuxView == "pkgs" ? "Search pacman packages…" : "Search Linux apps…"
        underline: false
        color: cHot
        onChange: query = value
        }
        if query != "" {
        Text {
          font: uiFont
        text: "✕"
        color: alpha(cHot, 0.72)
        padding: [4, 2]
        onTap: query = ""
        }
        }
        }

        if linuxView == "pkgs" {
        Text {
          font: uiFont
        text: pkgSort == "size" ? "SIZE" : "A–Z"
        fontSize: 10
        color: cHot
        bold: true
        letterSpacing: 1.0
        padding: [10, 8]
        radius: 10 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), cCard, #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: alpha(cMid, 0.42)
        onTap: {
        haptic()
        pkgSort = pkgSort == "size" ? "name" : "size"
        }
        }
        }
        }
        }

        Column {
        scroll: true
        weight: 1
        fill: width
        gap: 6

        if linuxView == "pkgs" {
        for p in shownPkgs key p.name {
        let ck = "pkg:" + p.name
        let armed = confirmKey == ck
        Row {
        fill: width
        align: center
        gap: 8
        padding: [10, 8]
        radius: 10 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.90), #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: armed ? cPri : alpha(cMid, 0.22)

        Column {
        weight: 1
        gap: 1
        Row {
        align: center
        gap: 6
        Text {
          font: uiFont
        text: p.name
        fontSize: 12.5
        color: cHot
        bold: true
        maxLines: 1
        }
        Text {
          font: uiFont
        text: p.size
        fontSize: 9.5
        color: cHot
        bold: true
        padding: [5, 1]
        radius: 4 * corners
        background: alpha(cDeep, 0.95)
        }
        }
        Text {
          font: uiFont
        text: p.desc != "" ? p.desc : p.ver
        fontSize: 9.5
        color: alpha(cHot, 0.56)
        maxLines: 1
        }
        }

        if p.core {
        Text {
          font: uiFont
        text: "CORE"
        fontSize: 9
        color: alpha(cHot, 0.55)
        bold: true
        letterSpacing: 1.0
        padding: [8, 5]
        radius: 8 * corners
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.9), #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: alpha(cMid, 0.24)
        }
        } else if armed {
        Text {
          font: uiFont
        text: "CONFIRM"
        fontSize: 9.5
        color: cHot
        bold: true
        padding: [8, 6]
        radius: 8 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), cPri, #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: cHot
        onTap: {
        haptic()
        busy = true
        statusOk = true
        statusMsg = "Purging ${p.name}…"
        cmdOut = ""
        cmdOut = run("python3 ~/.local/share/omalauncher/synth-pads/sith_panel.py pkg-remove ${sh(p.name)}")
        }
        }
        Text {
          font: uiFont
        text: "✕"
        fontSize: 10
        color: alpha(cHot, 0.78)
        padding: [6, 6]
        radius: 8 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cDeep, 0.95), #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: alpha(cMid, 0.35)
        onTap: confirmKey = ""
        }
        } else {
        Text {
          font: uiFont
        text: "PURGE"
        fontSize: 9.5
        color: cHot
        bold: true
        letterSpacing: 0.9
        padding: [9, 6]
        radius: 8 * corners
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.95), #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: alpha(cMid, 0.55)
        onTap: {
        haptic()
        confirmKey = ck
        }
        }
        }
        }
        }

        if len(filtPkgs) == 0 {
        Text {
          font: uiFont
        text: panel == null ? "Scanning Arch packages…" : "No matching packages"
        style: muted
        align: center
        fill: width
        padding: [0, 24]
        }
        } else if len(filtPkgs) > 36 {
        Text {
          font: uiFont
        text: "Showing 36 of ${len(filtPkgs)} explicit packages — search to narrow"
        fontSize: 10
        color: alpha(cHot, 0.52)
        align: center
        fill: width
        padding: [0, 8]
        }
        }
        } else if linuxView == "apps" {
        for la in shownLinuxApps key la.id {
        let ck = "lapp:" + la.id
        let armed = confirmKey == ck
        Row {
        fill: width
        align: center
        gap: 8
        padding: [10, 8]
        radius: 10 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cCard, 0.90), #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: armed ? cPri : alpha(cMid, 0.22)

        Column {
        weight: 1
        gap: 1
        Text {
          font: uiFont
        text: la.name
        fontSize: 12.5
        color: cHot
        bold: true
        maxLines: 1
        }
        Text {
          font: uiFont
        text: la.pkg != "" ? "pkg: ${la.pkg} · ${la.exec}" : "user shortcut · ${la.exec}"
        fontSize: 9.5
        color: alpha(cHot, 0.56)
        maxLines: 1
        }
        }

        if la.core {
        Text {
          font: uiFont
        text: "CORE"
        fontSize: 9
        color: alpha(cHot, 0.55)
        bold: true
        padding: [8, 5]
        radius: 8 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cDeep, 0.9), #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: alpha(cMid, 0.24)
        }
        } else if la.pkg != "" || !la.sys {
        if armed {
        Text {
          font: uiFont
        text: "CONFIRM"
        fontSize: 9.5
        color: cHot
        bold: true
        padding: [8, 6]
        radius: 8 * corners
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), cPri, #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: cHot
        onTap: {
        haptic()
        busy = true
        statusOk = true
        statusMsg = "Removing ${la.name}…"
        cmdOut = ""
        if la.pkg != "" {
        cmdOut = run("python3 ~/.local/share/omalauncher/synth-pads/sith_panel.py pkg-remove ${sh(la.pkg)}")
        } else {
        cmdOut = run("python3 ~/.local/share/omalauncher/synth-pads/sith_panel.py desktop-remove ${sh(la.path)}")
        }
        }
        }
        Text {
          font: uiFont
        text: "✕"
        fontSize: 10
        color: alpha(cHot, 0.78)
        padding: [6, 6]
        radius: 8 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cDeep, 0.95), #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: alpha(cMid, 0.35)
        onTap: confirmKey = ""
        }
        } else {
        Text {
          font: uiFont
        text: "UNINSTALL"
        fontSize: 9.5
        color: cHot
        bold: true
        letterSpacing: 0.8
        padding: [8, 6]
        radius: 8 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cDeep, 0.95), #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: alpha(cMid, 0.55)
        onTap: {
        haptic()
        confirmKey = ck
        }
        }
        }
        }
        }
        }

        if len(filtLinuxApps) == 0 {
        Text {
          font: uiFont
        text: "No matching Linux apps"
        style: muted
        align: center
        fill: width
        padding: [0, 24]
        }
        }
        } else {
        // Orphans tab
        if len(orphans) > 0 {
        Row {
        fill: width
        align: center
        gap: 8
        padding: [12, 10]
        radius: 10 * corners
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.94), #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: alpha(cMid, 0.65)
        Column {
        weight: 1
        gap: 1
        Text {
          font: uiFont
        text: "${len(orphans)} UNUSED DEPENDENCY ORPHAN(S)"
        fontSize: 11
        color: cHot
        bold: true
        letterSpacing: 0.8
        }
        Text {
          font: uiFont
        text: "Safe to purge with pacman -Rns"
        fontSize: 9.5
        color: alpha(cHot, 0.65)
        }
        }
        Text {
          font: uiFont
        text: "PURGE ALL"
        fontSize: 10
        color: cHot
        bold: true
        letterSpacing: 1.0
        padding: [10, 7]
        radius: 8 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), cPri, #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: cHot
        onTap: {
        haptic()
        busy = true
        statusOk = true
        statusMsg = "Purging orphan packages…"
        cmdOut = ""
        cmdOut = run("python3 ~/.local/share/omalauncher/synth-pads/sith_panel.py purge-orphans")
        }
        }
        }

        for o in orphans key o {
        Row {
        fill: width
        align: center
        gap: 8
        padding: [10, 8]
        radius: 10 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.88), #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: alpha(cMid, 0.22)
        Text { font: uiFont; text: "◆"; color: cMid; fontSize: 10 }
        Text { font: uiFont; text: o; fontSize: 12.5; color: cHot; weight: 1 }
        Text {
          font: uiFont
        text: "PURGE"
        fontSize: 9.5
        color: cHot
        bold: true
        padding: [8, 5]
        radius: 8 * corners
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.95), #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: alpha(cMid, 0.50)
        onTap: {
        haptic()
        busy = true
        statusOk = true
        statusMsg = "Purging ${o}…"
        cmdOut = ""
        cmdOut = run("python3 ~/.local/share/omalauncher/synth-pads/sith_panel.py pkg-remove ${sh(o)}")
        }
        }
        }
        }
        } else {
        Text {
          font: uiFont
        text: "No orphan packages — system is clean"
        style: muted
        align: center
        fill: width
        padding: [0, 28]
        }
        }
        }
        }
          }

          // ================= TAB 5: CONTROL / CORE =================
          else {
        Column {
        scroll: true
        weight: 1
        fill: width
        gap: 10

        // --- TELEMETRY GRID (CORE METERS) ---
        Row {
        fill: width
        gap: 8
        Column {
        weight: 1
        gap: 5
        padding: [10, 9]
        radius: 11 * corners
        background: linear(0, 0, 1, 1, [alpha(accentDark, 0.94), alpha(cObs, 0.96)])
        border: 1.1
        borderColor: alpha(bat.charging ? accentEmber : accentCol, 0.52)
        Text { font: uiFont; text: "POWER CORE"; fontSize: 9; color: alpha(amberInk, 0.68); bold: true; letterSpacing: 1.2 }
        Text { font: uiFont; text: "${bat.level ?? "…"}%"; fontSize: 18; color: hiInk; bold: true }
        Progress { value: bat.level ?? 0; max: 100; color: bat.charging ? accentEmber : accentCol; track: alpha(accentCol, 0.20) }
        Text { font: uiFont; text: "${bat.charging ? "CHARGING" : "DRAIN"} · ${bat.temp ?? "…"}°C"; fontSize: 9.5; color: bat.charging ? accentEmber : accentHot }
        }

        Column {
        weight: 1
        gap: 5
        padding: [10, 9]
        radius: 11 * corners
        background: linear(0, 0, 1, 1, [alpha(accentDark, 0.94), alpha(cObs, 0.96)])
        border: 1.1
        borderColor: alpha(accentCol, 0.45)
        Text { font: uiFont; text: "MEMORY"; fontSize: 9; color: alpha(amberInk, 0.68); bold: true; letterSpacing: 1.2 }
        Text { font: uiFont; text: "${memPct}%"; fontSize: 18; color: hiInk; bold: true }
        Progress { value: memPct; max: 100; color: memPct > 80 ? accentEmber : accentCol; track: alpha(accentCol, 0.20) }
        Text { font: uiFont; text: "${fmtBytes(memUsed)} / ${fmtBytes(memTotal)}"; fontSize: 9.5; color: accentHot; maxLines: 1 }
        }
        }

        Row {
        fill: width
        gap: 8
        Column {
        weight: 1
        gap: 5
        padding: [10, 9]
        radius: 11 * corners
        background: linear(0, 0, 1, 1, [alpha(accentDark, 0.94), alpha(cObs, 0.96)])
        border: 1.1
        borderColor: alpha(accentCol, 0.45)
        Text { font: uiFont; text: "STORAGE"; fontSize: 9; color: alpha(amberInk, 0.68); bold: true; letterSpacing: 1.2 }
        Text { font: uiFont; text: "${stoPct}%"; fontSize: 18; color: hiInk; bold: true }
        Progress { value: stoPct; max: 100; color: stoPct > 85 ? accentEmber : accentCol; track: alpha(accentCol, 0.20) }
        Text { font: uiFont; text: "${fmtBytes(stoUsed)} / ${fmtBytes(stoTotal)}"; fontSize: 9.5; color: accentHot; maxLines: 1 }
        }

        Column {
        weight: 1
        gap: 5
        padding: [10, 9]
        radius: 11 * corners
        background: linear(0, 0, 1, 1, [alpha(accentDark, 0.94), alpha(cObs, 0.96)])
        border: 1.1
        borderColor: alpha(accentEmber, 0.48)
        Text { font: uiFont; text: "ARSENAL"; fontSize: 9; color: alpha(amberInk, 0.68); bold: true; letterSpacing: 1.2 }
        Text { font: uiFont; text: "${len(allDrawerApps)} APPS"; fontSize: 16; color: amberInk; bold: true }
        Text { font: uiFont; text: "${sum.linuxPkgs ?? 0} PKGS · ${sum.owlActive ?? 0} OWL"; fontSize: 9.5; color: accentHot; maxLines: 1 }
        Text { text: "${len(holocronNotes)} DECK CARDS"; fontSize: 9; font: uiFont; color: alpha(accentEmber, 0.85); maxLines: 1 }
        }
        }

        // --- HARDWARE & AUDIO CONTROLS ---
        Column {
        fill: width
        gap: 8
        padding: [12, 10]
        radius: 10 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cCard, 0.92), #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: alpha(cMid, 0.38)

        Row {
        fill: width
        align: center
        Text { font: uiFont; text: "HARDWARE & AUDIO"; fontSize: 10; color: cMid; bold: true; letterSpacing: 1.5; weight: 1 }
        Text { font: uiFont; text: volOutLabel; fontSize: 9.5; color: alpha(cHot, 0.70); maxLines: 1 }
        }

        Row {
        fill: width
        gap: 8

        Box {
        weight: 1
        padding: [8, 9]
        radius: 9 * corners
        align: center
        background: modes.torch == true ? cDim : alpha(cDeep, 0.92)
        border: 1
        borderColor: modes.torch == true ? cHot : alpha(cMid, 0.35)
        onTap: {
        haptic()
        torch("toggle")
        }
        Text {
          font: uiFont
        text: modes.torch == true ? "TORCH ON" : "TORCH OFF"
        fontSize: 10
        color: cHot
        bold: true
        letterSpacing: 1.0
        align: center
        }
        }

        Box {
        weight: 1
        padding: [8, 9]
        radius: 9 * corners
        align: center
        background: modes.dnd == true ? cDim : alpha(cDeep, 0.92)
        border: 1
        borderColor: modes.dnd == true ? cHot : alpha(cMid, 0.35)
        onTap: {
        haptic()
        dnd("toggle")
        }
        Text {
          font: uiFont
        text: modes.dnd == true ? "DND ON" : "DND OFF"
        fontSize: 10
        color: cHot
        bold: true
        letterSpacing: 1.0
        align: center
        }
        }

        Box {
        weight: 1
        padding: [8, 9]
        radius: 9 * corners
        align: center
        background: vol.muted == true ? cDim : alpha(cDeep, 0.92)
        border: 1
        borderColor: vol.muted == true ? cHot : alpha(cMid, 0.35)
        onTap: {
        haptic()
        volume("toggle")
        }
        Text {
          font: uiFont
        text: vol.muted == true ? "MUTED" : "VOL ${vol.level ?? 0}%"
        fontSize: 10
        color: cHot
        bold: true
        letterSpacing: 1.0
        align: center
        }
        }
        }

        Slider {
        value: vol.level ?? 50
        min: 0
        max: 100
        color: cPri
        track: alpha(cMid, 0.22)
        live: true
        onChange: volume(value)
        }
        }

        // --- ANDROID SYSTEM PANELS ---
        Column {
        fill: width
        gap: 8
        padding: [12, 10]
        radius: 10 * corners
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cCard, 0.92), #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: alpha(cMid, 0.35)

        Text { font: uiFont; text: "ANDROID PANELS"; fontSize: 10; color: cMid; bold: true; letterSpacing: 1.5 }

        Grid {
        columns: 3
        gap: 6
        fill: width
        for sp in [
        { id: "wifi", label: "WI-FI" },
        { id: "bluetooth", label: "BLUETOOTH" },
        { id: "output", label: "AUDIO OUT" },
        { id: "display", label: "DISPLAY" },
        { id: "battery", label: "BATTERY" },
        { id: "notifications", label: "NOTIFS" }
        ] {
        Box {
        padding: [6, 9]
        radius: 8 * corners
        align: center
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.92), #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: alpha(cMid, 0.34)
        onTap: {
        haptic()
        settings(sp.id)
        }
        Text {
          font: uiFont
        text: sp.label
        fontSize: 9.5
        color: cHot
        bold: true
        letterSpacing: 0.9
        align: center
        }
        }
        }
        }
        }

        // --- LAUNCHER & LINUX COMMAND DECK ---
        Column {
        fill: width
        gap: 8
        padding: [12, 10]
        radius: 10 * corners
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cCard, 0.92), #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: alpha(cMid, 0.35)

        Text { font: uiFont; text: "LAUNCHER & LINUX COMMAND DECK"; fontSize: 10; color: cMid; bold: true; letterSpacing: 1.5 }

        Grid {
        columns: 2
        gap: 6
        fill: width

        for lp in [
        { id: "style", label: "OMARCHY STYLE" },
        { id: "agents", label: "AI AGENTS" },
        { id: "store", label: "WIDGET STORE" },
        { id: "settings", label: "LAUNCHER CFG" }
        ] {
        Box {
        padding: [8, 9]
        radius: 8 * corners
        align: center
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cDeep, 0.92), #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: alpha(cMid, 0.34)
        onTap: {
        haptic()
        launcher(lp.id)
        }
        Text {
          font: uiFont
        text: lp.label
        fontSize: 9.5
        color: cHot
        bold: true
        letterSpacing: 1.0
        align: center
        }
        }
        }
        }

        Row {
        fill: width
        gap: 6

        Box {
        weight: 1
        padding: [8, 10]
        radius: 8 * corners
        align: center
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), cDim, #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: cMid
        onTap: {
        haptic()
        terminal("pacman -Syu; echo; read -p 'Press Enter to close...'", "SITH · SYSTEM UPDATE")
        }
        Text { font: uiFont; text: "PACMAN -SYU"; fontSize: 10; color: cHot; bold: true; letterSpacing: 1.0; align: center }
        }

        Box {
        weight: 1
        padding: [8, 10]
        radius: 8 * corners
        align: center
        background: linear(0, 0, 1, 1, [alpha(cPri, 0.13), alpha(cDeep, 0.95), #000000, alpha(cSec, 0.10)])
        border: 1
        borderColor: alpha(cMid, 0.55)
        onTap: {
        haptic()
        busy = true
        statusOk = true
        statusMsg = "Purging pacman cache…"
        cmdOut = ""
        cmdOut = run("python3 ~/.local/share/omalauncher/synth-pads/sith_panel.py clean-cache")
        }
        Text { font: uiFont; text: "CLEAN CACHE"; fontSize: 10; color: cHot; bold: true; letterSpacing: 1.0; align: center }
        }
        }

        Row {
        fill: width
        gap: 6

        Box {
        weight: 1
        padding: [8, 10]
        radius: 8 * corners
        align: center
        background: linear(1, 0, 0, 1, [alpha(cSec, 0.12), alpha(cDeep, 0.95), #000000, alpha(cPri, 0.09)])
        border: 1
        borderColor: alpha(cMid, 0.40)
        onTap: {
        haptic()
        terminal("btop", "SITH · BTOP")
        }
        Text { font: uiFont; text: "BTOP"; fontSize: 10; color: cHot; bold: true; letterSpacing: 1.1; align: center }
        }

        Box {
        weight: 1
        padding: [8, 10]
        radius: 8 * corners
        align: center
        background: linear(0, 1, 1, 0, [alpha(cHot, 0.07), alpha(cDeep, 0.95), #000000, alpha(cSec, 0.11)])
        border: 1
        borderColor: alpha(cMid, 0.40)
        onTap: {
        haptic()
        terminal("bash", "SITH · ROOT SHELL")
        }
        Text { font: uiFont; text: "ROOT SHELL"; fontSize: 10; color: cHot; bold: true; letterSpacing: 1.1; align: center }
        }
        }
        }
        }
          }
        }
      }
    }
      }
    }
  }
}
