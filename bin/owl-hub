#!/usr/bin/env python3
"""owl-hub KEY VALUE  — Single-source-of-truth 4-Theme Compiler & Hub Settings Manager.
Writes in-place (same inode) to ~/.config/omalauncher/hub.json (with pre-resolved `tok`
RGB 0..255 arrays, hex strings, font paths, synth pads, and copy), plus mirrors:
  - ~/.config/omalauncher/ui-mode.json
  - ~/.config/omalauncher/animations.json
  - ~/.config/omalauncher/eco-mode.json
  - ~/.config/omalauncher/sith-theme.json
  - ~/.config/omalauncher/style/style.toml
  - ~/.config/omalauncher/drawer.css
owl-hub reset  — restore defaults. Prints {"ok":..,"msg":..} for OWL cmd sources."""
import json, os, re, sys

C = os.path.expanduser("~/.config/omalauncher")
HUB = os.path.join(C, "hub.json")
WIDGETS_DIR = os.path.join(C, "widgets")

